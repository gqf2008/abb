# Rust
target/
target-ci/
**/*.rs.bk
*.pdb

# macOS
.DS_Store
*.app/

# 敏感信息（config.json 含 App Secret，不入库）
config.json
*.secret

# 日志
logs/
*.log

# 临时文件
*.tmp
*.swp
*~

# 开发脚本不入库（本地自用，避免公开仓库暴露内部工具链）。
# 锚定根目录：无锚点 `scripts/` 会匹配任意层级，曾静默吞掉子包的
# vendor JSON（include_str! 硬依赖，release 爆）。
/scripts/

# CI 生成的安装包，不入库
app-assets/Output/
.claude/worktrees/
tools-dist/

# rpi（本仓的开发用 harness）的运行期数据。**只收运行期子路径**：rpi 把 `.rpi/` 同时
# 当作项目级共享资源目录（SYSTEM.md / APPEND_SYSTEM.md / settings.json / skills/ /
# prompts/ / themes/ / extensions/ 都可能需要提交），无锚点地忽略整个 `.rpi/` 会把
# 那些一起静默吞掉——与本文件里 `/scripts/` 那条注释记过的是同类事故。
.rpi/sessions/
.rpi/extensions/.dev/
# rpi-todo 扩展写的每会话待办（项目级运行期数据，同 sessions/）。
.rpi/todos/
