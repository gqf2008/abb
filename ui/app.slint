// Agent Bridge — Slint 托盘 + 设置窗（macOS 菜单栏 accessory 应用）。
// 托盘模式对齐 ../brewfs（同为 Slint 1.17 SystemTrayIcon 的可用工程）：图标 @image-url、
// 托盘常驻、设置窗 show/hide。
// 注意（Slint 1.17 实测坑，勿改回 enabled 绑定）：托盘菜单项的 `enabled` 标量绑定在属性
//   变化后**不会**重建原生 NSMenu（PropertyTracker 依赖注册不全，首次求值后冻结；title 会变
//   但 enabled 不变）。可靠做法是**结构性** `if cond: MenuItem{...}`——条件翻转触发菜单重建
//   （appkit.rs 对 if/for 结构变化会 detach+重建 NSMenu，已实测生效）。故启停按钮用互斥 if。
import { LineEdit, ComboBox, Button, CheckBox, ScrollView, VerticalBox, HorizontalBox, GridBox, ListView, Palette } from "std-widgets.slint";
// 视觉改造（像素风）：slint-pixel 组件库。试点从环境配置页开始（PixelButton/
// PixelScrollPanel），推广后逐步移除 std 控件。
import { PixelBadge, PixelButton, PixelCard, PixelCheckBox, PixelComboBox, PixelMenu, PixelPresets, PixelScrollPanel, PixelSelect, PixelTabs, PixelTextArea, PixelTextInput, PixelTheme, PixelTitleBar, PixelWindowResize } from "@slint_pixel";

// 托盘菜单里逐 bot 状态行：文字 + 状态小圆点图标（后端会转成 muda::IconMenuItem）。
// ═══════════ 设计令牌（UI/UX 审查）：语义色集中定义，替换全部硬编码彩色 ═══════════
// 原则：基础层走 PixelTheme（2026-09-30 起主题 = soft 预设：暖米底 #fdf6e9 + 墨黑描边
// #1c1a17 + 暖黄主色 #ffc61a）；状态语义色/文字层级走本令牌。
// **accent 是「填色」不是「墨色」**：压在其上的前景必须用 PixelTheme.on-accent
// （soft 下 #1c1a17 on #ffc61a = 11.0:1；库默认 classic 下 21:1）；要墨色的图标/文字/描边
// 一律用 PixelTheme.text。这两条由评审 R1 的阻塞项踩出来：把 accent 当黑用的写法在 soft 下
// 只有 1.46–1.57:1，首页主状态读数与三处列表选中项几乎看不见。
// 全部色值收敛于此，改一处全局生效；已按 PixelTheme.scheme 内置暗色适配值
// （未来开暗色模式时零改动兼容）。下表对比度按**生效底色 #fdf6e9（soft）**验算：
//   ok #0b8a3e ≈4.14:1 / info #0a6fc2 ≈4.80:1 / warn #b86f00 ≈3.68:1（配加粗）/ error #d13438 ≈4.59:1
//   text-dim #5c5c5c ≈6.22:1（替代原 #888/#aaa）；text-disabled #9a9a9a ≈2.62:1（仅停用态）
// 半径：库组件跟随 PixelTheme.radius（soft = 8px）；ABB 自绘处保留 4px 是刻意的「小件更紧」
// 取舍（不跟随主题）——若要统一，把那 4 处 border-radius: 4px 改成 PixelTheme.radius 即可。
export global UiTokens {
    // 语义状态色
    in property <color> ok: PixelTheme.scheme == "dark" ? #4caf50 : #0b8a3e;      // 成功/已安装/已授权
    in property <color> info: PixelTheme.scheme == "dark" ? #5ab0e8 : #0a6fc2;    // 信息/进行中/链接
    in property <color> warn: PixelTheme.scheme == "dark" ? #e0a800 : #b86f00;    // 警示/待处理（强调用加粗）
    in property <color> error: PixelTheme.scheme == "dark" ? #ff6b6b : #d13438;   // 错误/危险/超限
    // 语义色浅底（提示卡/横幅背景）
    in property <color> warn-bg: PixelTheme.scheme == "dark" ? #33280a : #fff8e6;    // 待处理卡底色
    in property <color> banner-bg: PixelTheme.scheme == "dark" ? #332b0a : #fff3cd;  // 环境横幅底色
    in property <color> error-bg: PixelTheme.scheme == "dark" ? #3a1212 : #fff1f0;   // 安装失败详情底色
    // C2 拖入高亮底色（winit 的 HoveredFile；非 macOS 也能用同一条路径）
    in property <color> drop-bg: PixelTheme.scheme == "dark" ? #10233a : #e8f1fd;
    // 窗口描边（no-frame 自绘窗）：**纯黑**（用户明确要求，不用灰）。
    // 已知代价（审查实测，别当成已解决）：纯黑只在浅底上成立——白底对比 21:1，但压在
    // #1a1a1a 深色桌面上只有 1.21:1，纯黑桌面则为 1:1（描边与底色重合时**加粗不会**产生
    // 对比，只会让同色区域更大）。那种情况下窗口边界主要靠白色内容区与桌面的反差。
    // 想换色只改这一处；若日后要兼顾深色桌面，得换亮色或加第二圈亮色描边。
    in property <color> window-frame: #000000;
    // 文字层级
    in property <color> text-dim: PixelTheme.scheme == "dark" ? #9a9a9a : #5c5c5c;        // 次要说明/占位（替代 #888）
    in property <color> text-disabled: PixelTheme.scheme == "dark" ? #6b6b6b : #9a9a9a;   // 停用/禁用态（弱化）
}

// 划词（文本选区）信号总线：消息块里的只读 `TextInput` 在光标/选区变化时把
// （正文、anchor 字节偏移、focus 字节偏移、窗内坐标）发给对话窗。
// 用 global 而不是在每个 `ConvoSelectableText` 使用点各接一条线：消息区有 7 处实例化。
// 偏移是 **UTF-8 字节偏移**（Slint 内置属性 `*-position-byte-offset`），Rust 侧按字节切片。
export global TextSelection {
    callback moved(string, int, int, length, length);
}

export struct BotMenuRow {
    title: string,
    icon: image,
}

// 托盘：SystemTrayIcon 是内置元素（macOS → NSStatusItem）。
export component Tray inherits SystemTrayIcon {
    // 托盘图标随整体状态变色：online=绿 / connecting=黄 / offline=红 / none=原灰白
    // #74 未读红点：unread-count>0 时换用 Rust 侧运行时合成的红点版图标
    // （合成选型：托盘图标是 16-22px 小图，加 4 张红点版资产与运行时合成二选一——
    // 运行时合成无新资产、不随源图配色漂移，且能复用既有 get_icon_online 等取图，
    // 代价是一次性合成代码；这里走合成，见 ui.rs composite_tray_dot）。
    in-out property <int> unread-count: 0;
    in-out property <string> tray-status: "none";
    in-out property <image> icon-online-dot: @image-url("tray-green.png");
    in-out property <image> icon-connecting-dot: @image-url("tray-yellow.png");
    in-out property <image> icon-offline-dot: @image-url("tray-red.png");
    in-out property <image> icon-dark-dot: @image-url("tray-dark.png");
    // 属性驱动而非 Rust 侧直接 set_icon：icon 是 tray-status/unread-count 的绑定，
    // 直接 set_icon 会破坏绑定（后续状态变化不再刷新图标）。
    icon: root.unread-count > 0 ?
        (root.tray-status == "online" ? root.icon-online-dot :
         root.tray-status == "connecting" ? root.icon-connecting-dot :
         root.tray-status == "offline" ? root.icon-offline-dot :
         root.icon-dark-dot) :
        (root.tray-status == "online" ? @image-url("tray-green.png") :
         root.tray-status == "connecting" ? @image-url("tray-yellow.png") :
         root.tray-status == "offline" ? @image-url("tray-red.png") :
         @image-url("tray-dark.png"));
    tooltip: "ABB";

    in-out property <[BotMenuRow]> bots-menu: [];  // 逐 bot 状态行（文字 + 状态图标）
    in-out property <image> icon-online: @image-url("tray-green.png");
    in-out property <image> icon-connecting: @image-url("tray-yellow.png");
    in-out property <image> icon-offline: @image-url("tray-red.png");
    in-out property <image> icon-disabled: @image-url("tray-gray.png");
    in-out property <image> icon-dark: @image-url("tray-dark.png");
    in-out property <bool> service-running: false;
    in-out property <bool> configured: false;
    in-out property <bool> autostart: false;
    // 全局锚点气泡开关（系统级对话入口）：结构性 if 重建菜单项（同 autostart 的坑）
    in-out property <bool> bubble-enabled: true;
    in-out property <string> version: "";          // 当前版本号（Rust 启动时注入，菜单里常驻显示）
    // 版本升级：0=未查 1=检查中 2=已最新 3=有新版本 4=下载安装中 5=下载/安装失败 6=检查失败
    // （结构性 if 重建菜单，见文件头注释：enabled 绑定不可靠）
    in-out property <int> update-state: 0;
    in-out property <string> update-version: "";   // 发现的新版本号（state=3/4 用）
    in-out property <bool> update-can-install: false; // 本机平台有安装包（Linux 无 → 只提示）
    in-out property <string> update-progress: "";  // 下载安装中的进度文案（连接中…/45%（3.6/7.9 MB）/正在安装…）

    callback start-service();
    callback stop-service();
    callback restart-service();
    callback open-settings();   // 菜单「设置…」
    callback open-chat();       // 左键点托盘图标：打开系统对话窗
    callback open-logs();
    callback open-folder();
    callback toggle-autostart(bool);
    callback toggle-bubble(bool);   // 全局锚点气泡显示/隐藏
    callback check-update();     // 手动检查更新（托盘菜单）
    callback install-update();   // 点「升级」：下载+安装+重启
    callback quit-app();

    // 左键点图标 = 打开系统对话窗（owner 2026-10-17：与点气泡/点 Dock 同一口径）；
    // 设置窗仍从菜单「设置…」进入。
    clicked => { root.open-chat(); }

    Menu {
        // Bot 状态：分区标题（仅在有 bot 时出现）+ 逐 bot 行直接铺在主菜单（不嵌套子菜单）。
        if root.bots-menu.length > 0: MenuItem { title: "Bot 状态"; enabled: false; }
        for st in root.bots-menu: MenuItem { title: st.title; icon: st.icon; enabled: false; }
        if root.bots-menu.length > 0: MenuSeparator {}
        // 启停互斥（结构性，见文件头注释：enabled 绑定不可靠，用 if 翻转重建）
        if !root.service-running: MenuItem { title: "启动"; activated => { root.start-service(); } }
        if root.service-running: MenuItem { title: "停止"; activated => { root.stop-service(); } }
        if root.service-running: MenuItem { title: "重启"; activated => { root.restart-service(); } }
        MenuSeparator {}
        MenuItem { title: "设置…"; activated => { root.open-settings(); } }
        MenuItem { title: "打开日志"; activated => { root.open-logs(); } }
        MenuItem { title: "打开桥目录"; activated => { root.open-folder(); } }
        MenuSeparator {}
        // 开机自启：结构性 if（同启停，enabled/checkbox 绑定不可靠），点一下切换
        if !root.autostart: MenuItem { title: "开机自动启动：关"; activated => { root.toggle-autostart(true); } }
        if root.autostart: MenuItem { title: "开机自动启动：开"; activated => { root.toggle-autostart(false); } }
        // 全局锚点气泡（系统级对话入口）：结构性 if
        if !root.bubble-enabled: MenuItem { title: "全局气泡：关"; activated => { root.toggle-bubble(true); } }
        if root.bubble-enabled: MenuItem { title: "全局气泡：开"; activated => { root.toggle-bubble(false); } }
        MenuSeparator {}
        // ── 版本升级：永远只一项，标题常驻当前版本；可点的态点击即动作（结构性 if 重建，见文件头注释）──
        if root.update-state == 0: MenuItem { title: "版本 v" + root.version + " · 检查更新…"; activated => { root.check-update(); } }
        if root.update-state == 1: MenuItem { title: "版本 v" + root.version + " · 正在检查更新…"; enabled: false; }
        if root.update-state == 2: MenuItem { title: "版本 v" + root.version + " · 已是最新 ✓（点击重查）"; activated => { root.check-update(); } }
        if root.update-state == 3 && root.update-can-install: MenuItem { title: "⬆ 升级到新版本 v" + root.update-version + "（当前 v" + root.version + "）"; activated => { root.install-update(); } }
        if root.update-state == 3 && !root.update-can-install: MenuItem { title: "有新版本 v" + root.update-version + "（当前 v" + root.version + " · 请从源码更新，点击重查）"; activated => { root.check-update(); } }
        if root.update-state == 4: MenuItem { title: "正在下载安装 v" + root.update-version + "：" + root.update-progress; enabled: false; }
        if root.update-state == 5: MenuItem { title: "下载/安装失败，点击重试 v" + root.update-version + "（当前 v" + root.version + "）"; activated => { root.install-update(); } }
        if root.update-state == 6: MenuItem { title: "版本 v" + root.version + " · 检查失败，点击重试"; activated => { root.check-update(); } }
        MenuSeparator {}
        MenuItem { title: "退出"; activated => { root.quit-app(); } }
    }
}

// 一个已授权用户（owner_open_id 白名单是事实源，name 供展示）
export struct OwnerRow {
    name: string,        // 展示名（飞书反查；查不到=open_id）
    open_id: string,     // 飞书 open_id（事实键）
}

// 互斥选项行（对话权限等单选组）：checked 由 Rust 按选中 bot 重算后整体替换
// model → for 循环重建 CheckBox 实例，绕开「用户交互移除 checked 绑定、状态残留到其它 bot」的坑。
export struct OptionRow {
    name: string,
    checked: bool,
}

// 编辑框/下拉的单元素行（value 存显示值）：交互（输入/选择）同样移除 text/value 绑定，
// 直接绑 root.bots[selected].x 会在切 bot 后残留上一 bot 的值；走单元素 model +
// for 循环重建实例（refresh_editors 装载/切 bot 时整体替换），与 OptionRow 同款绕法。
export struct EditorRow {
    value: string,
}

// 单个 bot 行的数据（与 Rust 侧 BotRow 对应）
export struct BotRow {
    name: string,        // 显示名
    kind: string,        // feishu | wechat | dingtalk
    enabled: bool,       // 是否启用（false 则 service 不启动此 bot）
    provider: string,    // 该 bot 的模型供应商名（""=跟随全局 default_provider）
    owner-open-id: string, // 飞书：owner（管理员）白名单（逗号分隔 open_id）；微信 bot 不用
    wx-owner-configured: bool, // 微信：扫码登录时自动写入 wx_user_id（登录者即管理员）；false=未配置（fail-closed 拒绝所有人）
    owners: [OwnerRow],  // 飞书：owner 展示名（手填的没名字，列表备用；实际以输入框为准）
    app-id: string,
    app-secret: string,
    bot-name: string,    // 运行时获取的 bot 名
    bot-open-id: string,
    ding-user-id: string,    // 钉钉：旧单值 owner staffId（迁移到 ding-owner-ids）
    ding-owner-ids: string,  // 钉钉：owner（管理员）白名单（逗号分隔 staffId）
    ding-robot-code: string, // 钉钉：机器人编码（空=默认 AppKey）
    tidy-enabled: bool, // 每日工作目录整理（默认关：孤儿会话/临时文件/超期历史/文档归档 + git 留痕）
}

// 单个模型供应商行的数据（与 Rust 侧 ProviderRow 对应）
export struct ProviderRow {
    name: string,        // 唯一键
    kind: string,        // anthropic | openai-chat | openai-responses | openrouter | deepseek
    kind-index: int,     // kind 在类型下拉里的下标（Rust 侧按 PROVIDER_KINDS 算，未知类型=0）
    base-url: string,
    api-key: string,     // 密码框、加载后留空（编辑时重输=覆盖，留空=保留旧值）
    model: string,
    is-default: bool,    // 是否为全局默认供应商
    // E3：该模型的上下文窗口（token；空串 = 没设 ⇒ 走内置兜底表）。
    // 用字符串而不是数字：「没设」与「0」在 UI 上要能区分（数字框里 0 是有效输入）。
    context-window: string,
}

// 虚拟 Bot 登记行（#75，与 Rust 侧 VirtualBotRow 对应）
export struct VirtualBotRow {
    role-name: string,   // 角色名（=平台群名）
    platform: string,    // 飞书 / 钉钉（微信排除）
    chat-id: string,     // 平台群会话 id（编辑/解散用）
    created-at: string,  // 登记时间（已格式化 YYYY-MM-DD HH:MM）
    mention-off: bool,   // #91 该角色群是否免 @ 参与（事实源 mention_modes[chat-id]）
}

// 角色模板行（#75）：内置 + 自定义（前 builtin-count 个为内置，不可编辑/删除）
export struct RoleTemplateRow {
    name: string,
    prompt: string,
    checked: bool,   // 模板批量创建时是否勾选
}

// #74 历史记录页的单条消息（与 Rust 侧 HistoryRow 对应）
// 会话行（历史页左列表）：同一 chat_id 的消息聚合为一个会话（微信式会话列表）
export struct ChatSessionRow {
    bot-key: string,     // bot key（Rust 侧定位会话消息流用）
    chat-id: string,     // 会话 id
    bot: string,         // bot 展示名
    sender: string,      // 会话展示名（群聊 = 群名；私聊 = 授权者名）
    kind-tag: string,    // "群" / ""（私聊不标——默认语义）
    time: string,        // 最后消息 MM-DD HH:MM
    count: string,       // 消息条数（"12 条"）
    preview: string,     // 最后消息摘要
}

// 消息流行（历史页右详情）：选中会话内的逐条消息
export struct ChatMsgRow {
    time: string,        // MM-DD HH:MM
    direction: string,   // 用户 / 回复
    sender: string,      // 该条展示名
    text: string,        // 完整文本（wrap 换行）
}

// 微信扫码登录二维码弹窗：直接在 GUI 里显示二维码，避免依赖系统看图。
export component QrDialog inherits Window {
    title: "微信扫码登录";
    width: 360px;
    height: 440px;
    preferred-width: 360px;
    preferred-height: 440px;
    background: PixelTheme.bg;
    in-out property <image> qr-image;
    in-out property <string> tip: "请用微信扫描二维码";
    callback close-clicked();

    // 根 Rectangle 铺满不透明背景：透明标题栏 + 内容铺满时防止「窗口透明只剩红绿灯」
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;
            spacing: 12px;
            alignment: center;
        Text { text: root.tip; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
        Rectangle {
            background: white;
            border-radius: 4px;
            min-height: 300px;
            Image {
                source: root.qr-image;
                width: 300px;
                height: 300px;
                image-fit: contain;
            }
        }
        Text { text: "扫不上就点「取消」重新获取"; font-size: 12px; color: UiTokens.text-dim; horizontal-alignment: center; }
        HorizontalBox {
            alignment: center;
            PixelButton { text: "取消"; clicked => { root.close-clicked(); } }
            }
        }
    }
}

// #74 授权者私聊提醒弹窗（toast）：屏幕右上角弹出，展示 unread.json 里最近几条
// （发送者/摘要/时间，最新在上，最多 8 条），约 5 秒自动收起；点条目 → 打开设置窗
// 历史记录页（弹窗内容即「已读」，收起后 unread.json 已清）。
// no-frame 无系统标题栏（toast 不该有标题栏）；根 Rectangle 铺满不透明背景防透明坑
// （同 QrDialog 纪律）。
export struct NotifyRow {
    sender: string,   // 展示名（GUI 经 config 授权者名单反查，查不到用 id）
    bot: string,      // bot 展示名（经 config 反查，查不到用 key）
    preview: string,
    time: string,     // MM-DD HH:MM
}
export component NotificationsWindow inherits Window {
    title: "新消息提醒";
    width: 340px;
    height: 88px;
    preferred-width: 340px;
    preferred-height: 88px;
    no-frame: true;
    background: PixelTheme.bg;
    in-out property <[NotifyRow]> items: [];
    callback open-history();   // 点面板：打开设置窗历史记录页（已读）
    callback dismiss();        // 手动收起（5s 自动收起在 Rust 侧走同一路径）

    // 8-20 用户反馈：toast 是"小面板"——88px 高，标题行（含条数）+ 最新一条摘要，
    // 整面板可点（点击 = 已读 + 跳历史页）；更多条数在标题里提示。
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        // 整面板点击热区（声明在底层，文字在上层可读）
        TouchArea { clicked => { root.open-history(); } }
        VerticalBox {
            padding: 10px;
            spacing: 4px;
            Text {
                text: root.items.length > 1 ? "🔔 多条新消息" : "🔔 新消息提醒";
                font-size: 12px;
                font-weight: 700;
                color: PixelTheme.text;
            }
            Text {
                text: root.items.length > 0
                    ? root.items[0].sender + "：" + root.items[0].preview
                    : "";
                font-size: 12px;
                overflow: elide;
                width: 100%;
                color: PixelTheme.text.with-alpha(0.85);
            }
        }
    }
}

// 设置窗：微软电脑管家式布局 —— 左侧导航 + 首页仪表盘 + 卡片化三个配置页。
// 底部共享状态行 + 保存/取消。页面切换用 current-page 结构性 if（与托盘菜单同手法）。

// ═══════════ 复用小组件（干净扁平：SVG 单色图标 + 1px 描边卡片，深浅色自适应） ═══════════

// 单色 SVG 图标：颜色随 Palette 着色（colorize），避免 Unicode 字符在字体里缺字形渲染成方框。
component ImageIcon inherits Image {
    in property <image> icon;
    in property <brush> tint: PixelTheme.text.with-alpha(0.7);
    source: root.icon;
    colorize: root.tint;
    width: 18px;
    height: 18px;
    image-fit: contain;
    // 「整图裁剪」必须显式写出来：`Image` 作为**自定义组件根**且 `source` 是动态属性时，编译器
    // 把它降成 ClippedImage 却**不**合成 source-clip-* 的默认绑定（上游 default_geometry 只在
    // 「有绑定或属性被用到」时才补默认值），于是运行期裁剪恒为 0×0 —— i-slint-core 的 `fit()` /
    // `adjust_for_tiling()` 会算出 `0 * inf` = NaN：software 渲染器在该 NaN 上 `Rect::cast`
    // unwrap 直接 panic，GL 后端（femtovg/skia）按 NaN 几何画不出 ⇒ 设置窗与两个弹窗里的图标
    // 全是空白。这两行就是编译器本该合成的那两条绑定（见上游 adjust_image_clip_rect）。
    // 直接 `Image { source: <动态> }`（如 QrDialog 的二维码）不受影响：那种会降为 ImageItem，
    // source_clip() 返回 None。回归守卫见 ui_headless_render_test.rs 的设置窗用例。
    source-clip-width: root.icon.width - root.source-clip-x;
    source-clip-height: root.icon.height - root.source-clip-y;
}

// 复制图标按钮（授权码旁）：24px 触达区 + 18px 图标，hover 高亮底色。
component CopyIconButton inherits Rectangle {
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: ta.has-hover ? PixelTheme.hover : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    ImageIcon {
        icon: @image-url("icons/copy.svg");
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// ═══════════ 全局页面样式（所有 tab 页统一，改一处全生效） ═══════════
// 页面根容器：padding 20 + spacing 14（各页切换视觉稳定）。
// 不设 alignment：VerticalBox 默认让 vertical-stretch>0 的子元素（机器人/环境/供应商页
// 的列表+编辑区）拉伸填满主体；首页内容少且全 fixed/无 stretch 时自然顶对齐 + 底留白
// （靠 PageHeader 的 vertical-stretch:0 避免 PageHeader 被分配剩余空间把内容顶下去）。
component PageContainer inherits VerticalBox {
    width: 100%;
    height: 100%;
    padding: 20px;
    spacing: 14px;
    @children
}

// 页头：标题 + 副标题（统一字号/间距/颜色）
// vertical-stretch: 0 —— 页头不参与剩余空间拉伸，保持 natural 高（标题+副标题），
// 避免首页内容少时 PageHeader 被分配剩余空间撑高、把 hero/快捷卡顶到中下部。
component PageHeader inherits VerticalBox {
    in property <string> title: "";
    in property <string> subtitle: "";
    spacing: 4px;
    vertical-stretch: 0;
    Text { text: root.title; font-size: 18px; font-weight: 700; color: PixelTheme.text; }
    Text { text: root.subtitle; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
}

// 状态小胶囊：半透明底 + 语义色文字（比实底更柔和）。
// 状态徽章：slint-pixel PixelBadge 外壳（像素阴影块 + 边框），ok/warn 语义色映射。
component StatusPill inherits PixelBadge {
    in property <bool> ok: false;
    in property <bool> warn: false;
    width: 84px;
    font-size: 12px;
    face: root.ok ? UiTokens.ok : (root.warn ? UiTokens.warn : UiTokens.error);
    text-color: #ffffff;
    border: PixelTheme.edge;
}

// 待处理建议行：左文案 + 右侧「去处理」小按钮，点击跳对应页（火绒「主页建议」同款交互）。
component ProblemRow inherits HorizontalBox {
    in property <string> text: "";
    in property <string> action: "去处理 ›";
    callback clicked();
    height: 28px;
    spacing: 8px;
    Text {
        text: root.text;
        font-size: 13px;
        color: PixelTheme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Rectangle {
        width: 84px;
        height: 24px;
        border-radius: 4px;
        background: UiTokens.warn-bg;
        TouchArea {
            clicked => { root.clicked(); }
            Text {
                text: root.action;
                font-size: 12px;
                font-weight: 600;
                color: UiTokens.warn;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
}

// 首页快捷操作卡：slint-pixel PixelCard 外壳（阴影块 + 硬边框像素观感），
// 内容（icon/desc/action）在 PixelCard 插槽内自排；TouchArea 覆盖整卡响应点击。
component QuickCard inherits Rectangle {
    in property <string> title: "";
    in property <string> desc: "";
    in property <image> icon;
    in property <string> action-label: "前往 ›";
    callback clicked();
    height: 122px;
    horizontal-stretch: 1;
    PixelCard {
        width: 100%;
        height: 100%;
        title: root.title;
        title-color: PixelTheme.text;
        VerticalLayout {
            spacing: 6px;
            ImageIcon { icon: root.icon; tint: PixelTheme.text; }
            Text { text: root.desc; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); wrap: word-wrap; }
            Text { text: root.action-label; font-size: 12px; font-weight: 600; color: PixelTheme.text; }
        }
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// 通用确认弹窗：关闭/取消时未保存编辑、以及打开时发现草稿，两种场景复用。
// 文案/按钮由 Rust 侧按场景设置（title-text/message/primary/discard/stay；show-stay=false 隐藏中间按钮）。
export component UnsavedDialog inherits Window {
    title: root.title-text;
    width: 460px;
    height: 200px;
    preferred-width: 460px;
    preferred-height: 200px;
    background: PixelTheme.bg;
    in-out property <string> title-text: "未保存的修改";
    in-out property <string> message: "保存会写入配置，服务在跑时会重启使其生效。";
    in-out property <string> primary-text: "保存并关闭";
    in-out property <string> discard-text: "不保存";
    in-out property <string> stay-text: "取消";
    in-out property <bool> show-stay: true;
    callback save-close();    // 主操作（保存并关闭 / 恢复草稿）
    callback discard-close(); // 次操作（不保存关闭 / 丢弃草稿）
    callback stay();          // 留在设置窗

    // 根 Rectangle 铺满不透明背景（同 QrDialog：透明标题栏 + 内容铺满防透明坑）
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;
            spacing: 10px;
        Text {
            text: root.title-text;
            font-size: 15px;
            font-weight: 700;
            color: PixelTheme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.message;
            font-size: 13px;
            color: PixelTheme.text.with-alpha(0.7);
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            PixelButton { text: root.discard-text; clicked => { root.discard-close(); } }
            if root.show-stay: PixelButton { text: root.stay-text; clicked => { root.stay(); } }
            PixelButton { text: root.primary-text; variant: "primary"; clicked => { root.save-close(); } }
            }
        }
    }
}

// 通用确认弹窗（#75）：取消登记（轻确认）/ 解散群（danger=红色主按钮强确认）复用。
// 文案与按钮由 Rust 侧按场景设置（title-text/message/confirm-text/danger）。
export component ConfirmDialog inherits Window {
    title: root.title-text;
    width: 460px;
    height: 210px;
    preferred-width: 460px;
    preferred-height: 210px;
    background: PixelTheme.bg;
    in-out property <string> title-text: "确认操作";
    in-out property <string> message: "";
    in-out property <string> confirm-text: "确认";
    in-out property <string> cancel-text: "取消";
    in-out property <bool> danger: false;   // true=主按钮红色（强确认）
    // busy（8-20）：确认后转"执行中"（按钮禁用，防连点）；结果回来由 Rust 侧
    // 更新 message/按钮文案——成功即关，失败显示错误让用户看到（不再静默关窗）
    in-out property <bool> busy: false;
    // failed（8-20）：操作失败态——主按钮变「重试」（action 保留可重发），
    // 取消按钮禁用（成功才能正常关闭；红点 X 仍是放弃出口）
    in-out property <bool> failed: false;
    // 「停止 / 重启服务」的管理密码（2026-10-04 owner 要求）：need-password=true 时
    // 多一个密码输入框；输入值由 Rust 侧读 password-input 校验（首设/校验两种文案由 Rust 定）。
    in-out property <bool> need-password: false;
    in-out property <string> password-input: "";
    callback confirmed();
    callback canceled();

    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;
            spacing: 10px;
        Text {
            text: root.title-text;
            font-size: 15px;
            font-weight: 700;
            color: PixelTheme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.message;
            font-size: 13px;
            color: PixelTheme.text.with-alpha(0.7);
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if root.need-password: LineEdit {
            placeholder-text: "管理密码";
            // std 的 LineEdit 要枚举值（ABB 自有 PixelTextInput 才收字符串，别抄错）
            input-type: password;
            text <=> root.password-input;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            PixelButton { text: root.cancel-text; enabled: !root.busy && !root.failed; clicked => { root.canceled(); } }
            PixelButton { text: root.confirm-text; variant: root.danger ? "danger" : "primary"; enabled: !root.busy; clicked => { root.confirmed(); } }
            }
        }
    }
}

// 虚拟 Bot 创建/编辑/登记弹窗（#75）。
// 模式：0=自定义创建 1=模板批量创建 2=手动登记（降级路径） 3=编辑。
// 数据流：Rust 侧读写 in-out 属性（预填/校验计数/进度/结果），slint 只负责布局与交互。
// 群名 ≤60、提示词 ≤100 为飞书群名/群描述限制（钉钉暂同）——字符计数由 Rust 侧按
// 字符数（非字节）计算后回填（slint 的 string.length 在中文上不可靠，双保险）。
export component VirtualBotDialog inherits Window {
    title: root.window-title;
    width: 620px;
    height: 680px;
    preferred-width: 620px;
    preferred-height: 680px;
    background: PixelTheme.bg;

    in-out property <string> window-title: "创建虚拟 Bot";
    in-out property <string> bot-label: "";        // 归属 bot 展示名
    in-out property <string> platform-label: "";   // 飞书 / 钉钉
    // 模式：0=自定义创建 1=模板批量创建 2=手动登记 3=编辑
    in-out property <int> mode: 0;
    in-out property <string> name-input: "";
    in-out property <string> prompt-input: "";
    in-out property <string> prefix-input: "";     // 模板批量：群名前缀（可选）
    in-out property <[RoleTemplateRow]> templates: [];
    in-out property <int> builtin-count: 0;        // 前 N 个为内置模板（不可编辑/删除）
    in-out property <int> selected-count: 0;       // 勾选模板数（Rust 维护，summary 用）
    // 模板编辑内嵌表单（template-editing=true 时显示；idx=-1=新建）
    in-out property <bool> template-editing: false;
    in-out property <int> template-edit-idx: -1;
    in-out property <string> template-edit-name: "";
    in-out property <string> template-edit-prompt: "";
    // 手动登记（降级路径）：chat_id 输入
    in-out property <string> register-chat-id: "";
    // 编辑模式：目标 chat_id（保存 = PATCH 平台 + 登记同步）
    in-out property <string> edit-chat-id: "";
    // 进度与结果（创建中 2/4 → 逐群汇总）
    in-out property <bool> busy: false;
    in-out property <string> progress-text: "";
    in-out property <[string]> results: [];
    // 字符计数（Rust 侧 chars().count() 回填；中文安全）
    in-out property <int> name-count: 0;
    in-out property <int> prompt-count: 0;
    // 表单校验提示
    in-out property <string> hint-text: "";
    in-out property <bool> hint-error: false;

    callback close-clicked();
    callback create-clicked();        // Rust 按 mode 分发：创建/批量/登记/保存编辑
    callback mode-switched(int);
    callback name-edited();
    callback prompt-edited();
    callback generate-prompt();       // ✨ 生成提示词（根据群名，LLM 生成群介绍）
    callback template-toggled(int);
    callback template-save-clicked();
    callback template-cancel-clicked();
    callback template-edit-clicked(int);
    callback template-delete-clicked(int);

    // 创建/保存按钮可用性（busy 时全部禁用防连点；字符计数由 Rust 回填，见 name-edited）
    property <bool> create-ok: !root.busy && (
        root.mode == 0 ? (root.name-count > 0 && root.name-count <= 60 && root.prompt-count <= 100)
        : root.mode == 1 ? root.selected-count > 0
        : root.mode == 2 ? (root.name-count > 0 && root.name-count <= 60 && root.register-chat-id != "")
        : (root.name-count > 0 && root.name-count <= 60 && root.prompt-count <= 100));

    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
            spacing: 8px;

            // ── 标题行：归属 bot + 平台 ──
            HorizontalBox {
                spacing: 8px;
                ImageIcon { icon: @image-url("icons/bot.svg"); tint: PixelTheme.text; vertical-alignment: center; }
                Text {
                    text: root.window-title + "（" + root.bot-label + " · " + root.platform-label + "）";
                    font-size: 15px;
                    font-weight: 700;
                    color: PixelTheme.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            // ── 模式切换（编辑模式隐藏：固定为保存流） ──
            if root.mode != 3: HorizontalBox {
                spacing: 8px;
                PixelButton { text: "自定义创建"; size: "small"; variant: root.mode == 0 ? "primary" : "default"; enabled: !root.busy; clicked => { root.mode = 0; root.mode-switched(0); } }
                PixelButton { text: "从模板批量创建"; size: "small"; variant: root.mode == 1 ? "primary" : "default"; enabled: !root.busy; clicked => { root.mode = 1; root.mode-switched(1); } }
                PixelButton { text: "手动登记"; size: "small"; variant: root.mode == 2 ? "primary" : "default"; enabled: !root.busy; clicked => { root.mode = 2; root.mode-switched(2); } }
            }

            // ── 模式 0/3：自定义创建 / 编辑 ──
            if root.mode == 0 || root.mode == 3: VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群名（角色名）"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.name-input;
                        placeholder: "如：后端开发（≤60 字符）";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.name-input = self.text; root.name-edited(); }
                    }
                    Text { text: root.name-count + "/60"; font-size: 12px; color: root.name-count > 60 ? UiTokens.error : UiTokens.text-dim; vertical-alignment: center; }
                    // 「✨ 生成」：根据群名让 LLM 写系统提示词（≤100 字符，回填下方输入框）
                    PixelButton {
                        text: root.busy ? "生成中…" : "✨ 生成";
                        size: "small";
                        variant: "ghost";
                        enabled: !root.busy && root.name-input != "";
                        clicked => { root.generate-prompt(); }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "提示词（群介绍）"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: top; }
                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        // 多行文本域（8-20 需求）：system prompt 通常是多行角色设定
                        PixelTextArea {
                            text: root.prompt-input;
                            placeholder: "system prompt，≤100 字符（如：你是后端开发工程师……）";
                            frame-height: 110px;
                            enabled: !root.busy;
                            edited => { root.prompt-input = self.text; root.prompt-edited(); }
                        }
                        Text {
                            text: root.prompt-count + "/100";
                            font-size: 12px;
                            color: root.prompt-count > 100 ? UiTokens.error : UiTokens.text-dim;
                        }
                    }
                }
                if root.mode == 3: Text {
                    text: "保存 = 平台改群名/群介绍（PATCH）+ 本地登记同步。改名会改变 deliver 的 @角色名 寻址。";
                    font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                }
                // 预览卡：所见即所得（群资料卡样式）
                Rectangle {
                    border-radius: 4px;
                    background: PixelTheme.panel;
                    border-width: 1px;
                    border-color: PixelTheme.edge;
                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "预览（群资料卡）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                        HorizontalBox {
                            spacing: 10px;
                            Rectangle {
                                width: 42px; height: 42px;
                                border-radius: 21px;
                                background: PixelTheme.accent;
                                HorizontalBox {
                                    width: 100%; height: 100%;
                                    alignment: center;
                                    ImageIcon { icon: @image-url("icons/bot.svg"); tint: PixelTheme.on-accent; }
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                Text { text: root.name-input == "" ? "（群名）" : root.name-input; font-weight: 600; font-size: 13px; color: PixelTheme.text; }
                                Text { text: root.prompt-input == "" ? "（群介绍）" : root.prompt-input; font-size: 12px; color: PixelTheme.text.with-alpha(0.6); wrap: word-wrap; }
                            }
                        }
                    }
                }
            }

            // ── 模式 1：模板批量创建 ──
            if root.mode == 1: VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群名前缀"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.prefix-input;
                        placeholder: "可选，如：智能硬件项目 → 群名「智能硬件项目·后端开发」";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.prefix-input = self.text; }
                    }
                }
                Text { text: "勾选要创建的角色群（内置 + 自定义模板）："; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); }
                // 模板列表：勾选 + 自定义模板的编辑/删除
                Rectangle {
                    height: 150px;
                    border-radius: 4px;
                    background: PixelTheme.panel;
                    border-width: 1px;
                    border-color: PixelTheme.edge;
                    PixelScrollPanel {
                        VerticalBox {
                            width: 100%;
                            spacing: 2px;
                            for t[i] in root.templates: HorizontalBox {
                                height: 30px;
                                spacing: 8px;
                                PixelCheckBox {
                                    text: t.name;
                                    checked: t.checked;
                                    enabled: !root.busy;
                                    toggled => { root.template-toggled(i); }
                                }
                                Text {
                                    text: t.prompt;
                                    font-size: 11px;
                                    color: PixelTheme.text.with-alpha(0.5);
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if i >= root.builtin-count: PixelButton { text: "编辑"; size: "small"; enabled: !root.busy; clicked => { root.template-edit-clicked(i); } }
                                if i >= root.builtin-count: PixelButton { text: "删"; size: "small"; enabled: !root.busy; clicked => { root.template-delete-clicked(i); } }
                            }
                        }
                    }
                }
                // 模板编辑内嵌表单（新建/编辑自定义模板）
                if root.template-editing: Rectangle {
                    border-radius: 4px;
                    background: PixelTheme.bg;
                    border-width: 1px;
                    border-color: PixelTheme.text;
                    VerticalBox {
                        padding: 8px;
                        spacing: 5px;
                        Text { text: root.template-edit-idx < 0 ? "＋ 自定义模板" : "编辑自定义模板"; font-size: 12px; font-weight: 700; color: PixelTheme.text; }
                        PixelTextInput {
                            text: root.template-edit-name;
                            placeholder: "模板名（≤60 字符，不可与内置/其它自定义重名）";
                            edited => { root.template-edit-name = self.text; }
                        }
                        PixelTextInput {
                            text: root.template-edit-prompt;
                            placeholder: "提示词（≤100 字符）";
                            edited => { root.template-edit-prompt = self.text; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            PixelButton { text: "取消"; size: "small"; clicked => { root.template-cancel-clicked(); } }
                            PixelButton { text: "保存模板"; size: "small"; variant: "primary"; clicked => { root.template-save-clicked(); } }
                        }
                    }
                }
                if !root.template-editing: PixelButton { text: "＋ 自定义模板"; size: "small"; variant: "ghost"; clicked => { root.template-edit-clicked(-1); } }
                Text {
                    text: "将创建 " + root.selected-count + " 个群" + (root.prefix-input == "" ? "" : "（前缀「" + root.prefix-input + "·」）");
                    font-size: 12px;
                    font-weight: 600;
                    color: root.selected-count > 0 ? UiTokens.info : UiTokens.text-dim;
                }
            }

            // ── 模式 2：手动登记（降级路径：平台手动建群后登记 chat_id） ──
            if root.mode == 2: VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群名（角色名）"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.name-input;
                        placeholder: "如：后端开发（≤60 字符）";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.name-input = self.text; root.name-edited(); }
                    }
                    Text { text: root.name-count + "/60"; font-size: 12px; color: root.name-count > 60 ? UiTokens.error : UiTokens.text-dim; vertical-alignment: center; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群 chat_id"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.register-chat-id;
                        placeholder: "飞书 oc_xxx / 钉钉 cidxxx（群消息日志里有）";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.register-chat-id = self.text; }
                    }
                }
                Text {
                    text: root.platform-label == "钉钉" ? "降级路径：机器人建群失败时，在钉钉手动建群（群名=角色名），把群内消息日志里的 chat_id 填这里。钉钉群无「群介绍」字段，角色提示词只能注入群名。" : "降级路径：API 建群失败时，平台手动建群（群名=角色名、群介绍=提示词），把 chat_id 填这里。";
                    font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                }
            }

            // ── 校验提示 ──
            if root.hint-text != "": Text {
                text: root.hint-text;
                font-size: 12px;
                color: root.hint-error ? UiTokens.error : UiTokens.text-dim;
                wrap: word-wrap;
            }

            // ── 进度与结果（busy 或已有结果时显示） ──
            if root.busy || root.results.length > 0: Rectangle {
                border-radius: 4px;
                background: PixelTheme.panel;
                border-width: 1px;
                border-color: PixelTheme.edge;
                VerticalBox {
                    padding: 8px;
                    spacing: 4px;
                    if root.busy: Text { text: root.progress-text; font-size: 12px; font-weight: 600; color: UiTokens.info; }
                    PixelScrollPanel {
                        height: 110px;
                        VerticalBox {
                            width: 100%;
                            spacing: 2px;
                            for r[i] in root.results: Text { text: r; font-size: 12px; color: PixelTheme.text.with-alpha(0.8); wrap: word-wrap; }
                        }
                    }
                }
            }

            // ── 底部按钮 ──
            HorizontalBox {
                alignment: center;
                spacing: 10px;
                PixelButton {
                    text: root.mode == 0 ? "创建群" : (root.mode == 1 ? "批量创建" : (root.mode == 2 ? "登记" : "保存修改"));
                    enabled: root.create-ok;
                    clicked => { root.create-clicked(); }
                }
                PixelButton { text: "关闭"; variant: "ghost"; enabled: !root.busy; clicked => { root.close-clicked(); } }
            }
        }
    }
}

// #124 一键创建团队弹窗（P2）。三态：0=目标输入 → 1=方案预览 → 2=创建结果。
// mock 阶段：生成/确认为预设数据（后端 #123 修复后换真数据流），UI 骨架先定型。
// 视觉规范：#98 token（UiTokens.ok/warn/error/info + text-dim）、4px 圆角、12px 起、不用 emoji。
export struct TeamRoleRow {
    role-name: string,   // 角色名
    member: string,      // 成员名（""=待任命）
    duty: string,        // 职责摘要
}
// 创建结果行：ok=true 成功（绿）/ false 失败（红）
export struct TeamResultRow {
    text: string,
    ok: bool,
}
// #147 团队卡片行（团队列表）：角色子行复用 TeamRoleRow（角色名（成员名）— 职责）。
export struct TeamRow {
    team-name: string,
    role-count: int,
    status: string,      // "运行中" / "部分失败"
    status-ok: bool,     // true=ok 色 / false=warn 色
    created-at: string,
    roles: [TeamRoleRow],
}
// #147 任命成员弹窗：小表单（成员名输入 + 确认/取消）。
export component TeamAppointDialog inherits Window {
    title: root.window-title;
    width: 420px;
    height: 240px;
    preferred-width: 420px;
    preferred-height: 240px;
    background: PixelTheme.bg;

    in-out property <string> window-title: "任命成员";
    in-out property <string> team-label: "";
    in-out property <string> role-name: "";
    in-out property <string> member-input: "";

    callback confirm-clicked();
    callback cancel-clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;
            spacing: 10px;
            Text {
                text: root.window-title;
                font-size: 15px;
                font-weight: 700;
                color: PixelTheme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "团队「" + root.team-label + "」角色「" + root.role-name + "」：输入成员名（留空 = 恢复「待任命」）";
                font-size: 12px;
                color: PixelTheme.text.with-alpha(0.7);
                wrap: word-wrap;
            }
            PixelTextInput {
                text: root.member-input;
                placeholder: "成员名（≤30 字符；留空 = 待任命）";
                edited => { root.member-input = self.text; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                alignment: center;
                spacing: 10px;
                PixelButton { text: "取消"; variant: "ghost"; clicked => { root.cancel-clicked(); } }
                PixelButton { text: "保存任命"; variant: "primary"; clicked => { root.confirm-clicked(); } }
            }
        }
    }
}
export component TeamDialog inherits Window {
    title: root.window-title;
    width: 560px;
    height: 560px;
    preferred-width: 560px;
    preferred-height: 560px;
    background: PixelTheme.bg;

    in-out property <string> window-title: "一键创建团队";
    in-out property <string> bot-label: "";       // 归属 bot 展示名
    // 模式：0=目标输入 1=方案预览 2=创建结果
    in-out property <int> mode: 0;
    in-out property <string> target-input: "";
    in-out property <string> team-name: "";
    in-out property <string> flow: "";
    in-out property <[TeamRoleRow]> roles: [];
    in-out property <[TeamResultRow]> results: [];
    in-out property <bool> busy: false;            // 创建中（防连点 + 加载提示）

    callback close-clicked();      // 关闭（结果态 = 完成）
    callback generate-clicked();   // 模式0 → 生成方案
    callback confirm-clicked();    // 模式1 → 确认创建
    callback back-clicked();       // 模式1 → 回模式0 修改目标

    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;
            spacing: 10px;

            // ── 标题行 ──
            HorizontalBox {
                spacing: 8px;
                ImageIcon { icon: @image-url("icons/plus.svg"); tint: PixelTheme.text; vertical-alignment: center; }
                Text {
                    text: root.window-title + "（" + root.bot-label + "）";
                    font-size: 15px;
                    font-weight: 700;
                    color: PixelTheme.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            // ── 模式 0：目标输入 ──
            if root.mode == 0: VerticalBox {
                spacing: 8px;
                Text { text: "一句话描述你的团队目标"; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); }
                PixelTextArea {
                    text: root.target-input;
                    placeholder: "如：做一个记账 App，需要产品、UI、开发、测试";
                    frame-height: 90px;
                    enabled: !root.busy;
                    edited => { root.target-input = self.text; }
                }
                Text { text: "生成方案后可在预览中调整角色与成员（成员分配功能开发中，当前为待任命）"; font-size: 12px; color: UiTokens.text-dim; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: center;
                    spacing: 10px;
                    PixelButton { text: "取消"; variant: "ghost"; enabled: !root.busy; clicked => { root.close-clicked(); } }
                    PixelButton { text: "生成方案"; variant: "primary"; enabled: root.target-input != "" && !root.busy; clicked => { root.generate-clicked(); } }
                }
            }

            // ── 模式 1：方案预览 ──
            if root.mode == 1: VerticalBox {
                spacing: 8px;
                Text { text: "团队「" + root.team-name + "」方案预览"; font-size: 14px; font-weight: 700; color: PixelTheme.text; }
                Rectangle {
                    border-radius: 4px;
                    background: PixelTheme.panel;
                    border-width: 1px;
                    border-color: PixelTheme.edge;
                    PixelScrollPanel {
                        height: 230px;
                        VerticalBox {
                            width: 100%;
                            spacing: 6px;
                            for r[i] in root.roles: HorizontalBox {
                                spacing: 8px;
                                Text {
                                    text: r.role-name + "（" + (r.member == "" ? "待任命" : r.member) + "）";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: PixelTheme.text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: r.duty;
                                    font-size: 12px;
                                    color: UiTokens.text-dim;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            if root.roles.length == 0: Text { text: "（方案为空，点「修改」重新生成）"; font-size: 12px; color: UiTokens.text-dim; }
                        }
                    }
                }
                if root.flow != "": Text { text: "协作流程：" + root.flow; font-size: 12px; color: UiTokens.text-dim; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: center;
                    spacing: 10px;
                    PixelButton { text: "修改"; variant: "ghost"; clicked => { root.back-clicked(); } }
                    PixelButton { text: "取消"; variant: "ghost"; clicked => { root.close-clicked(); } }
                    PixelButton { text: "确认创建"; variant: "primary"; clicked => { root.confirm-clicked(); } }
                }
            }

            // ── 模式 2：创建结果 ──
            if root.mode == 2: VerticalBox {
                spacing: 8px;
                if root.busy: Text { text: "正在创建角色群…"; font-size: 13px; font-weight: 600; color: UiTokens.info; }
                if !root.busy: Text {
                    text: "团队「" + root.team-name + "」创建完成";
                    font-size: 14px;
                    font-weight: 700;
                    color: UiTokens.ok;
                }
                if !root.busy: Rectangle {
                    border-radius: 4px;
                    background: PixelTheme.panel;
                    border-width: 1px;
                    border-color: PixelTheme.edge;
                    PixelScrollPanel {
                        height: 220px;
                        VerticalBox {
                            width: 100%;
                            spacing: 4px;
                            for r[i] in root.results: Text {
                                text: r.text;
                                font-size: 12px;
                                color: r.ok ? UiTokens.ok : UiTokens.error;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: center;
                    spacing: 10px;
                    PixelButton { text: "关闭"; variant: "primary"; enabled: !root.busy; clicked => { root.close-clicked(); } }
                }
            }
        }
    }
}

// ── 无边框窗缩放热区（v11c 起用于对话窗，2026-10-15 起设置窗也用） ─────────────
// ⚠️ 必须声明在**两个窗口之前**：Slint 不允许前向引用元素（放到后面会编译失败：
//    "Unknown element 'WindowResizeZones'"——实测踩过，不是猜的）。
// 8 个 6px 边条 + 14px 角块（几何与 slint-pixel 的 `PixelWindowResize` **逐像素一致**，
// 只是它是封闭组件、只回调方向）。
// 为什么不用 `PixelWindowResize`：macOS 上系统路径（`winit drag_resize_window`）直接
// `NotSupported`，自管缩放需要**按下时的指针位置**当锚点——只报方向的话只能等第一次
// `CursorMoved` 再补锚，快甩手时窗口边会**恒定**落后指针十几像素（不是抖动，是不跟手）。
//
// 两条路径由 `self-managed` 选一条（Rust 按平台写）：
//   - `false`（Windows/Linux）：`begin-resize(dir)` → `slint_pixel::install_window_resize`
//     → 系统级 `drag_resize_window` 缩放循环（既有行为，不动）；
//   - `true`（macOS）：`self-resize-begin(dir, x, y)` → Rust 自管缩放会话
//     （`ui::SelfResize`：屏坐标跟指针算尺寸 + `Window::set_size/set_position`）。
component ResizeZone inherits TouchArea {
    in property <string> dir: "";
    in property <bool> self-managed: false;
    callback begin(string);
    callback begin-at(string, length, length);
    // 只认左键按下（右键/中键不缩放），与 `PixelWindowResize` 同口径。
    pointer-event(ev) => {
        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
            if root.self-managed {
                // 热区自己是窗边上的条/块 ⇒ 它的绝对位置随窗口尺寸变；但 `mouse-x` 就是按
                // **当前**绝对位置算出来的（slint-core 每次事件分发都刷新几何）
                // ⇒ 两者相加恒等于「指针的窗口坐标」，与布局是否已跟上无关。
                root.begin-at(root.dir, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else {
                root.begin(root.dir);
            }
        }
    }
}

component WindowResizeZones inherits Rectangle {
    in property <bool> self-managed: false;
    callback begin-resize(string);
    callback self-resize-begin(string, length, length);
    width: 100%;
    height: 100%;
    // 顺序照 `PixelWindowResize`：四角声明在四边**之后**（重叠处角赢）。
    ResizeZone { x: 0px; y: 0px; width: parent.width; height: 6px; dir: "north"; mouse-cursor: ns-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
    ResizeZone { x: 0px; y: parent.height - 6px; width: parent.width; height: 6px; dir: "south"; mouse-cursor: ns-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
    ResizeZone { x: 0px; y: 0px; width: 6px; height: parent.height; dir: "west"; mouse-cursor: ew-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
    ResizeZone { x: parent.width - 6px; y: 0px; width: 6px; height: parent.height; dir: "east"; mouse-cursor: ew-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
    ResizeZone { x: 0px; y: 0px; width: 14px; height: 14px; dir: "north-west"; mouse-cursor: nwse-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
    ResizeZone { x: parent.width - 14px; y: 0px; width: 14px; height: 14px; dir: "north-east"; mouse-cursor: nesw-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
    ResizeZone { x: 0px; y: parent.height - 14px; width: 14px; height: 14px; dir: "south-west"; mouse-cursor: nesw-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
    ResizeZone { x: parent.width - 14px; y: parent.height - 14px; width: 14px; height: 14px; dir: "south-east"; mouse-cursor: nwse-resize; self-managed: root.self-managed; begin(d) => { root.begin-resize(d); } begin-at(d, x, y) => { root.self-resize-begin(d, x, y); } }
}

// 设置窗主体。
export component SettingsWindow inherits Window {
    // 主题：slint-pixel 0.3.0 的「soft（柔彩）」预设 —— 暖米底 + 墨黑硬描边 + 暖黄主色 + 8px 圆角
    // （owner 2026-09-30 指定：主题选 soft）。预设只写 PixelTheme token，因此 ABB 自己的语义色
    // （UiTokens 按 PixelTheme.scheme 分支）与各处对组件属性的覆盖都照旧生效。
    // 为什么挂在 SettingsWindow 的 init：`init` 回调只有 Window 派生组件才有（Tray 继承的是
    // SystemTrayIcon，构建期实测报 "init is not a callback in SystemTrayIcon"），而 SettingsWindow
    // 是 GUI 启动时**无条件实例化**的窗口 ⇒ 这里套一次，全局 PixelTheme 对所有窗口生效。
    // 以后要开放「主题选择」：把这行换成 `PixelPresets.apply(name)`（10 套清单见 PixelPresets.names）。
    init => { PixelPresets.soft(); }

    // 像素风自绘窗口：无系统边框/红绿灯，PixelTitleBar 自绘标题栏（拖拽/最小化/最大化/关闭）
    no-frame: true;
    // D5 起：macOS 也在 accessory 策略下跑（**不进 Dock**），打开时只由 Rust 激活抢前台聚焦。
    // 不用 always-on-top：那会浮在别的 app 之上却没焦点，别扭。标题带实时 bot 数。
    title: root.window-title;
    // 窗口 + 图标（Windows 任务栏/Dock 曾用；D5 起 macOS 不进 Dock，这里留给 Windows）。
    // 1024px 源，系统自动缩放。
    icon: @image-url("../app-assets/icon-1024.png");
    // 可缩放窗口（8-20 用户实测决策）：不设固定 width/height 绑定——固定尺寸与
    // set_maximized 冲突（最大化后被 size 拉回，视觉"越点越小"）。preferred-* 定初始
    // 尺寸，min-* 防内容塌陷（初始 bots 为空时内容高度算 0 的坑由 min-height 兜住）。
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 880px;
    min-height: 620px;
    // **透明**：根 Rectangle 带圆角，圆角外的区域必须透出桌面。若这里给不透明色，
    // 圆角外会露出该色的方块（圆角等于白做）。
    // 归因要准确（审查核对过 winit 后端）：窗口在 Slint 的 winit 后端**本来**就是非
    // 不透明的（`window_attributes()` 无条件 `with_transparent(true)`）；这里给
    // `transparent` 的实际作用是**不再铺一层不透明填充**，四角的 alpha=0 才能透出去。
    // 整窗可见区域仍由下面铺满的根 Rectangle 提供。
    background: transparent;

    in-out property <string> window-title: "ABB 设置";
    // 无边框窗口的缩放入口（Windows/Linux 没有系统缩放边框，靠自绘热区触发；
    // Rust 侧用 `slint_pixel::install_window_resize` 接到 winit 的 drag_resize_window）。
    callback begin-resize(string);
    // macOS 那条路（卡 `abb-v11-resize-maximize-macos` 的同一套，2026-10-15 扩到设置窗）：
    // 热区按下时带上**按下点的窗口坐标**，由 Rust 自管缩放会话跟指针算尺寸
    // （`ui::SelfResize`）。走这条的原因见 `WindowResizeZones` 的注释。
    callback self-resize-begin(string, length, length);
    // 是否启用自绘缩放热区。**由 Rust 侧显式设置**（两个窗口都是 `true`：透明无边框窗在
    // macOS 拿不到系统边角缩放，不画热区就等于完全不能缩放），不用 `platform` 属性——
    // 那个是权限页回填路径顺带设的，将来重构容易忘，一旦没设到热区会静默消失
    // （这类静默失效在本仓库踩过）。
    in-out property <bool> resize-hit-areas: false;
    // 热区走**哪条路**（同对话窗 `SystemChatWindow`）：`true` = macOS 自管缩放；
    // `false` = Windows/Linux 交给系统 `drag_resize_window`。由 Rust 按平台写。
    in-out property <bool> resize-self-managed: false;
    // 应用版本号（Rust 侧 env!("CARGO_PKG_VERSION") 注入；空 = 不显示）
    in-out property <string> version: "";
    // 当前页：0=首页 1=机器人配置 2=环境配置 3=模型供应商
    in-out property <int> current-page: 0;
    // 硬闸配套引导：全局默认供应商缺失/悬空（push_settings_status 每 tick 推导）。
    // true 时首页待处理卡提示并跳模型供应商页（current-page=3）。
    in-out property <bool> provider-unconfigured: false;
    // 首页 hero / 状态卡用的结构化状态（running-line 保留给底部状态行）
    in-out property <bool> service-running: false;
    in-out property <bool> autostart: false;
    in-out property <int> bot-count: 0;
    in-out property <int> online-count: 0;
    in-out property <string> running-line: "";   // 底部运行概览（N 个 bot 在线…）；status-line 非空时优先显示 status-line
    in-out property <[BotRow]> bots: [];
    in-out property <int> selected: -1;   // 当前选中的 bot 下标，-1=无
    // 三个独立开关（启用/授权者隔离/每日整理）的显示态。刻意不直接绑
    // root.bots[selected].x 或独立 bool property：PixelCheckBox 交互内部赋值
    // 会移除 checked 绑定（无论绑什么），切 bot 后残留上一 bot 的状态（#80 回归：
    // 点 A 的每日整理 B 也显示改）。绕法：单元素 model + for 循环重建实例，
    // 由 Rust 侧在装载/切 bot/写回时整体替换 model。
    in-out property <[OptionRow]> enabled-options: [];
    in-out property <[OptionRow]> tidy-options: [];
    // #91 群聊提及默认策略（bot 级）：true=免 @ 参与（该 bot 所有群默认免 @；per-chat 覆盖优先）
    in-out property <[OptionRow]> mention-options: [];
    // 文本编辑框/下拉的单元素 model（name/provider/owner/app_id/app_secret/
    // ding_robot_code/ding_owner_ids 各一）：输入/选择交互断绑后显示不跟随，切 bot
    // 时由 refresh_editors 整体替换 model → for 重建实例（同 OptionRow 绕法）。
    in-out property <[EditorRow]> name-editor-options: [];
    in-out property <[EditorRow]> kind-editor-options: [];       // 类型下拉：点选同样断 index 绑定，切 bot 须重建实例
    in-out property <[EditorRow]> provider-editor-options: [];
    in-out property <[EditorRow]> owner-editor-options: [];
    in-out property <[EditorRow]> app-id-editor-options: [];
    in-out property <[EditorRow]> app-secret-editor-options: [];
    in-out property <[EditorRow]> ding-robot-code-editor-options: [];
    in-out property <[EditorRow]> ding-owner-ids-editor-options: [];
    in-out property <string> status-line;
    in-out property <bool> status-is-error: true;   // true=红（报错）/ false=绿（成功/信息）
    // 跨会话投递总开关（#21）：打开后 agent 可用 `$ABB_BIN deliver` 投递到其它 bot 的会话。
    in-out property <bool> cross-delivery-enabled: false;
    // #74 历史记录页：提醒总开关 / 保留期（天）/ 消息列表（Rust 侧整体替换 model 刷新）
    in-out property <bool> notify-enabled: true;
    in-out property <int> history-retention-days: 30;
    in-out property <bool> session-gc-enabled: false;   // 每日会话归纳清理（#78，默认关）
    in-out property <int> session-gc-days: 7;           // 过期判定天数（3/7/14/30）
    in-out property <[ChatSessionRow]> chat-sessions: [];   // 会话列表（chat_id 分组）
    in-out property <[ChatMsgRow]> history-msgs: [];         // 选中会话的消息流（ts 正序）
    in-out property <string> chat-title: "";                 // 选中会话标题（会话名 · bot · N 条）
    // 虚拟 Bot 手动刷新进行中（#75）：禁用刷新按钮防连点 + 按钮文字"同步中"
    in-out property <bool> vb-syncing: false;
    in-out property <int> chat-selected: -1;   // 历史页选中的会话下标（chat-sessions 内）

    // 环境配置（依赖检测）：各项是否在本机可执行路径上。
    // P4.3：claude/codex/pi 三后端 CLI 与 ACP 适配器行已下架——执行层收口随包
    // abb-agent（零安装）；余下为 agent 扩展能力依赖（node/lark-cli/dingtalk-cli/git），
    // python3 仅信息展示（运行时无消费方）。
    in-out property <bool> node-installed: false;
    in-out property <bool> python-installed: false;
    in-out property <bool> lark-installed: false;
    in-out property <bool> dingtalk-installed: false; // dingtalk-cli (dws)
    // #105 git 三态：git-version=检测到的版本串；git-ok=已装且版本 >= MIN_GIT_VERSION。
    in-out property <bool> git-installed: false;
    in-out property <string> git-version: "";
    in-out property <bool> git-ok: false;
    // 正在安装的依赖 id（""=空闲）。用于禁用其它安装按钮 + 显示进度文案。
    in-out property <string> dep-busy: "";
    in-out property <string> dep-detail: ""; // 安装失败详情（分类 + 怎么办 + 原始错误）
    // 最近一次一键安装的失败项数（>0 = 首页「待处理」卡显示安装失败行，点击切环境配置页）。
    in-out property <int> dep-failed-count: 0;

    // 系统权限（仅 macOS）：完全磁盘/辅助功能/屏幕录制/自动化/摄像头/麦克风。
    // 0=未授权 1=被拒绝 2=已授权 3=受系统策略限制（MDM/家长控制，面板里授不了，不给「去授权」）
    in-out property <int> perm-full-disk: 0;
    in-out property <int> perm-accessibility: 0;
    in-out property <int> perm-screen: 0;
    in-out property <int> perm-automation: 0;
    in-out property <int> perm-camera: 0;
    in-out property <int> perm-microphone: 0;
    // Windows 专用：是否以管理员身份运行（0=否 2=是）
    in-out property <int> perm-admin: 0;
    // 平台：macos | windows | linux（决定权限区显示什么）
    in-out property <string> platform: "macos";
    // 权限请求子进程是否在跑（防连点；同时给个进度提示）
    in-out property <bool> perm-busy: false;
    // 是否为 macOS（非 mac 不显示系统权限区，显示「仅 macOS 需要」）
    in-out property <bool> perms-supported: false;

    // 模型供应商配置
    in-out property <[ProviderRow]> providers: [];
    in-out property <int> provider-selected: -1;
    in-out property <[string]> provider-names: [];   // 供 bot 页的供应商下拉（[""] + 各 name）
    // 决策模型（Jev）：授权者/受限会话的工具调用门禁（独立于主 LLM 的 key）。
    in-out property <string> jev-api-key: "";
    in-out property <string> jev-base-url: "";
    in-out property <string> jev-model: "";
    // 当前选中 bot 的未过期授权码展示（管理员码行）
    // （"授权码：xxxx（剩 N 分钟）"；无则空）。生成后/热刷新更新。
    in-out property <string> owner-code-info: "";
    // 互斥 CheckBox 的勾选状态（Rust 侧按选中 bot 重算；slint 表达式绑定会被用户交互破坏——
    // 点击后 in-out 属性绑定失效、状态残留到其它 bot，故用显式 property 驱动）
    // #118：访问控制收紧后无「公开」一档，对话权限固定为「仅授权用户」
    in-out property <[OptionRow]> access-options: [
        { name: "仅授权用户", checked: true },
    ];
    in-out property <[OptionRow]> ding-access-options: [
        { name: "仅授权用户", checked: true },
    ];
    // 虚拟 Bot（#75）：当前选中 bot 的登记列表（Rust 按选中 bot 刷新）
    in-out property <[VirtualBotRow]> virtual-bots: [];
    // ⋯ 菜单展开的行下标（-1=收起；点击行内「⋯」切换）
    in-out property <int> vb-menu-open: -1;
    // #147 团队（#124 §3.2/§3.3）：当前选中 bot 的团队列表（Rust 按选中 bot 刷新，热读 teams.json）
    in-out property <[TeamRow]> teams: [];
    // #147 团队卡片 ⋯ 菜单展开的卡片下标（-1=收起）
    in-out property <int> team-menu-open: -1;

    callback save-clicked();
    callback cancel-clicked();
    callback start-service();       // 首页 hero：启动后台服务
    callback stop-service();        // 首页 hero：停止后台服务
    callback restart-service();     // 预留：与托盘一致
    callback open-logs();           // 首页 hero：打开日志目录
    callback fetch-bot-info(int);          // 对某个 bot 拉 name/open_id（飞书）
    callback wx-login(int);                // 对某个 bot 微信扫码登录
    callback add-bot();
    callback remove-bot(int);
    callback selection-changed(int);   // 切中别的 bot：让 Rust 侧重建 model 强制刷新编辑区（ComboBox current-value 不随 model 变，需 model 变更通知）

    // 编辑区变更时回写 bots[selected]。**只回写被改的那一个字段**（field+value）——
    // 旧版 bot-edited 一次传全部字段、未改字段从 model 读，而 model 在编辑后不同步（过期），
    // 连改两个字段会用过期值把前一个字段的修改静默回滚。按字段回写则无此问题。
    callback bot-field-edited(int, string, string); // idx, field(name/kind/provider/owner/app_id/app_secret), value
    callback access-option-toggled(int);   // 飞书对话权限下标（0=仅授权 1=任何人）
    callback ding-access-option-toggled(int); // 钉钉对话权限下标
    callback generate-owner-code(int); // 生成管理员授权码：bot idx（作废旧管理员码）
    callback copy-owner-code(string);          // 复制指定 role 的授权码到剪贴板
    callback set-bot-enabled(int, bool); // 启用/停用某 bot（保存重启后生效）
    callback set-tidy-enabled(int, bool); // 每日工作目录整理开关（默认关，保存后即时生效）
    callback set-mention-default(int, bool); // #91 群聊提及默认开关（true=免 @ 参与，保存后即时生效）
    callback virtual-bot-mention-toggle(int); // #91 虚拟 Bot 免 @ 开关（按行索引切换 mention_modes[chat-id]）
    callback set-cross-delivery(bool);   // 跨会话投递总开关（保存重启后生效）
    callback open-url(string); // 打开外部链接（依赖文档 / 申请 token 等，默认浏览器）
    callback recheck-deps();            // 重新检测依赖是否已装
    callback install-dep(string);       // 安装某个依赖（node/lark-cli/dingtalk-cli/git）
    callback install-all-missing();     // #60 一键安装全部缺失组件（node 前置自动装）
    // 像素自绘标题栏回调（Rust 侧 install_title_bar_controls_no_quit 接线：
    // 关闭=隐藏窗口不退出——托盘应用惯例）
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback open-perm-settings(string); // 打开某项系统权限对应的设置面板（full-disk/accessibility/screen/automation）
    callback request-perms();           // 触发屏幕录制/摄像头/麦克风授权弹框（拉起子进程逐项请求）
    callback restart-service-request(); // 环境页授权后一键重启服务（权限对运行中进程不实时刷新）
    callback relaunch-as-admin();       // Windows：以管理员身份重启（弹 UAC）

    // 供应商编辑（同样 per-field 回写纪律，禁止整行回写）
    callback provider-field-edited(int, string, string); // idx, field(name/kind/base_url/api_key/model), value
    callback provider-selection-changed(int);
    callback add-provider();
    callback remove-provider(int);
    callback set-default-provider(int);
    callback test-provider(int);
    // 决策模型（Jev）配置回写（per-field，与供应商同纪律）。
    callback jev-field-edited(string, string);

    // 虚拟 Bot（#75）：登记列表操作（i=virtual-bots 行下标；create 用选中 bot 下标）
    callback virtual-bot-create(int);     // 「＋ 创建虚拟 Bot」→ 弹窗（自定义/模板/登记）
    callback virtual-bot-edit(int);       // 编辑登记（预填弹窗 → PATCH + 登记同步）
    callback virtual-bot-deregister(int); // ⋯ 菜单：取消登记（轻确认）
    callback virtual-bot-disband(int);    // ⋯ 菜单：解散群（红色强确认，仅飞书）
    callback virtual-bot-refresh();       // ⟳ 刷新：验证登记群存在性（平台解散兜底 + 历史归档）
    callback team-create-clicked(int);    // #124 一键创建团队（P2，mock）→ 打开 TeamDialog
    callback team-appoint(int, int);      // #147 任命成员：团队行下标 + 角色行下标
    callback team-jump(int, int);         // #147 跳转角色群：打开对应平台会话
    callback team-dissolve(int);          // #147 解散团队（红色强确认）
    // #74 历史记录页
    callback history-selection-changed(int);   // 选中某会话 → Rust 侧载入该会话消息流
    callback clear-history();                  // 「清除全部历史」→ Rust 侧弹二次确认
    callback set-notify-enabled(bool);         // 提醒开关 → Rust 侧写工作副本（保存时落盘）
    callback set-history-retention(int);       // 保留期下拉下标（0=7天 1=30天 2=90天）
    callback set-session-gc-enabled(bool);     // 会话归纳清理开关（#78 默认关）
    callback set-session-gc-days(int);         // 过期天数下拉下标（0=3 1=7 2=14 3=30）

    // 首页「待处理」卡用到的统计（纯表达式，跟随各 *_installed / perm-* 属性自动更新）。
    // P4.3：只统计 agent 扩展能力依赖（缺失不影响聊天，只限制技能/扩展能力）；
    // python3 信息项不计；git 版本过低也算待处理（git-ok = 已装且版本满足）。
    property <int> missing-deps: (root.node-installed ? 0 : 1)
        + (root.lark-installed ? 0 : 1)
        + (root.dingtalk-installed ? 0 : 1)
        + (root.git-ok ? 0 : 1);
    property <int> missing-perms: root.perms-supported && root.platform == "macos" ?
        (root.perm-full-disk != 2 ? 1 : 0) + (root.perm-accessibility != 2 ? 1 : 0)
        + (root.perm-screen != 2 ? 1 : 0) + (root.perm-automation != 2 ? 1 : 0)
        + (root.perm-camera != 2 ? 1 : 0) + (root.perm-microphone != 2 ? 1 : 0)
        : (root.perms-supported && root.platform == "windows" ? (root.perm-admin != 2 ? 1 : 0) : 0);

    // 关键：内容必须包在一个显式铺满窗口的根 Rectangle 里。
    // 直接把 HorizontalBox 当 Window 子元素时，在某些路径下其尺寸算成 0 → 整个内容区不渲染（黑/空），
    // 只剩系统画的标题栏。根 Rectangle width/height:100% 强制铺满，布局才有确定容器。
    // 窗口描边（no-frame 自绘窗没有系统边框）：**贴窗口边、单色纯黑、2px**。
    // 曾经试过「外白内黑」双色描边：那会在窗口边外多出一条亮线，看起来像描边没贴住
    // 窗口（用户反馈）；也试过中灰，用户否决。现在是纯黑贴边 2px。
    Rectangle {
        width: 100%;
        height: 100%;
        // 描边用**两层圆角填充**画，不用 Rectangle 的 border-width/border-color：
        // Windows 上 border-* 那条渲染路径没跟着 border-radius 走（用户实测：白底圆了、
        // 黑边还是直角），而「背景 + 圆角」是各平台都在走的路。外黑内白同心（10px / 8px，
        // 内缩 2px）等价于 2px 描边，且天然贴边。
        background: UiTokens.window-frame;
        // ⚠ Windows：这个圆角**不能只靠 Slint 画出来**。DWM 对普通（非分层）窗口按不透明
        // 合成，圆角外 alpha=0 的那圈会被铺成实心 → 看起来仍是直角方块（用户实测）。
        // 真正把角「切掉」的是 Rust 侧 `apply_round_window_region`（`SetWindowRgn` 硬裁剪，
        // 与系统透明效果开关无关，Win10/Win11 都成立）。**两边半径必须同值**：
        // 不一致会在弧线外残留黑边或露底（ui.rs 的 `WINDOW_CORNER_RADIUS` = 这里的 10px）。
        border-radius: 10px;

        // 内层面板：白底、内缩 2px、圆角 8px（= 10px − 2px 描边），与上面共同构成描边环
        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: PixelTheme.panel;
            border-radius: 8px;
        }

        VerticalBox {
            // 关键：VerticalBox/HorizontalBox 自带 StyleMetrics.layout-padding（fluent=8px），
            // 不归零会让内容四周多出 16px，顶部透出根背景形成「标题栏白条」。这里留 2px：
            // 正好让上面的 2px 描边露出四周——Slint 的 Rectangle 不会为子元素自动让开
            // border-width，铺满的子元素会把描边整个盖掉（实测顶/底被标题栏与内容区盖死，
            // 只剩左右两侧露线）。
            padding: 2px;
            // ── 像素自绘标题栏（no-frame）：拖拽/最小化/最大化/关闭（窗口可缩放，三按钮全开）──
            PixelTitleBar {
                title: root.window-title;
                logo: @image-url("../app-assets/icon-1024.png");
                has-logo: true;
                // 标题栏是贴着窗口上边的**子元素**，它自己的直角会把根 Rectangle 的圆角
                // 内圈盖成直角（现象：边框看着圆、背景看着方，实测确认白角来自子元素而非
                // 根背景）。这里给等值的内圈圆角：外圆角 10px − 描边 2px = 8px。
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
                drag-start => { root.drag-start(); }
                minimize => { root.minimize(); }
                toggle-maximize => { root.toggle-maximize(); }
                close-window => { root.close-window(); }
            }
            // ── 顶部 Tab 栏（菜单改 tab）：在 VerticalBox 层（titlebar 与主体之间），
            // 占满整行——错误地放进主体 HorizontalBox 会与页面区并排（左侧列） ──
            Rectangle {
                height: 40px;
                background: PixelTheme.bg;
                HorizontalBox {
                    padding-left: 6px;
                    padding-right: 10px;
                    spacing: 0px;
                    PixelTabs {
                        // horizontal-stretch 占满整行：5 tab 均分窗口宽（tab 下面才是内容区）
                        horizontal-stretch: 1;
                        tabs: ["首页", "机器人配置", "环境配置", "模型供应商", "历史记录"];
                        active: root.current-page;
                        changed(i) => { root.current-page = i; }
                    }
                }
            }
            // ── 主体：页面区 ──
            HorizontalBox {
                vertical-stretch: 1;
                spacing: 0;
                padding: 0;

                // 页面区：结构性 if 切页（同托盘菜单手法，属性翻转会重建子树）。
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                                        // ═══════════ 首页：hero + 待处理建议 + 快捷卡（PCM「首页/智能提醒」同款） ═══════════
                    if root.current-page == 0: PageContainer {
                        // 页头（与其他页同结构）
                        PageHeader { title: "首页"; subtitle: "你的 AI 助理管家 — 一眼看清运行状态"; }

                        // hero：状态 + 大按钮（PCM「立即加速」同款）。未运行时可从这里直接启动（原来只能去托盘）。
                        Rectangle {
                            height: 132px;
                            border-radius: 8px;
                            background: PixelTheme.accent;
                            HorizontalBox {
                                padding-top: 16px; padding-right: 24px; padding-bottom: 16px; padding-left: 24px;
                                spacing: 16px;
                                VerticalBox {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text {
                                        text: root.service-running
                                            ? "服务运行中 · " + root.bot-count + " 个机器人 · " + root.online-count + " 在线"
                                            : "服务已停止";
                                        font-size: 19px;
                                        font-weight: 700;
                                        color: PixelTheme.on-accent;
                                    }
                                    Text {
                                        text: root.service-running
                                            ? "飞书 / 微信 / 钉钉消息自动转给怹处理（随包执行层 abb-agent，零安装）"
                                            : "点右侧「启动服务」，或在托盘菜单点「启动」";
                                        font-size: 13px;
                                        color: PixelTheme.on-accent.with-alpha(0.75);
                                        wrap: word-wrap;
                                    }
                                    // 状态点（Defender 式「一目了然」）：在线/离线一眼可见；用文字点而非胶囊，避免在 accent 底上发闷
                                    HorizontalBox {
                                        spacing: 12px;
                                        Text { text: root.service-running ? "● 服务运行中" : "● 服务已停止"; font-size: 12px; font-weight: 600; color: PixelTheme.on-accent; vertical-alignment: center; }
                                        if root.online-count > 0: Text { text: "● " + root.online-count + " 在线"; font-size: 12px; color: PixelTheme.on-accent.with-alpha(0.85); vertical-alignment: center; }
                                        if root.bot-count - root.online-count > 0: Text { text: "● " + (root.bot-count - root.online-count) + " 离线"; font-size: 12px; color: PixelTheme.on-accent.with-alpha(0.85); vertical-alignment: center; }
                                    }
                                }
                                VerticalBox {
                                    alignment: center;
                                    spacing: 8px;
                                    // 启停互斥：结构性 if（同托盘菜单，enabled 绑定在原生菜单/样式上不可靠）
                                    if !root.service-running: PixelButton {
                                        text: "启动服务";
                                        variant: "primary";
                                        clicked => { root.start-service(); }
                                    }
                                    if root.service-running: PixelButton {
                                        text: "停止服务";
                                        clicked => { root.stop-service(); }
                                    }
                                    Rectangle {
                                        width: 140px;
                                        height: 32px;
                                        border-radius: 4px;
                                        background: PixelTheme.on-accent.with-alpha(0.15);
                                        TouchArea {
                                            clicked => { root.open-logs(); }
                                            Text { text: "打开日志"; color: PixelTheme.on-accent; font-size: 13px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                        }
                                    }
                                }
                            }
                        }

                        // 待处理建议（火绒「主页建议」/ PCM「智能提醒」同款）：只有异常才出现，每行点一下直达对应页。
                        if root.dep-failed-count > 0 || root.missing-deps > 0 || root.missing-perms > 0 || root.bot-count - root.online-count > 0 || root.provider-unconfigured: Rectangle {
                            border-radius: 4px;
                            background: UiTokens.warn-bg;
                            VerticalBox {
                                padding-top: 12px; padding-right: 16px; padding-bottom: 10px; padding-left: 16px;
                                spacing: 4px;
                                HorizontalBox {
                                    spacing: 8px;
                                    ImageIcon { icon: @image-url("icons/alert.svg"); tint: UiTokens.warn; width: 18px; height: 18px; }
                                    Text { text: "待处理"; font-size: 13px; font-weight: 700; color: UiTokens.warn; vertical-alignment: center; }
                                }
                                if root.provider-unconfigured: ProblemRow {
                                    text: "未配置模型供应商 — 机器人将拒绝回复，点击去配置";
                                    clicked => { root.current-page = 3; }
                                }
                                if root.dep-failed-count > 0: ProblemRow {
                                    text: "一键安装失败 " + root.dep-failed-count + " 项 — 点击查看详情与处理指引";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.missing-deps > 0: ProblemRow {
                                    text: "扩展依赖未装齐（" + root.missing-deps + " 项）— 聊天不受影响，技能等扩展能力受限";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.missing-perms > 0: ProblemRow {
                                    text: "有 " + root.missing-perms + " 项系统权限不可用";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.bot-count - root.online-count > 0: ProblemRow {
                                    text: "" + (root.bot-count - root.online-count) + " 个机器人离线";
                                    clicked => { root.current-page = 1; }
                                }
                            }
                        }

                        // 快捷操作卡（一行 4 个平铺）：加机器人 / 环境体检 / 权限中心 / 跨会话投递。
                        HorizontalBox {
                            spacing: 12px;
                            QuickCard {
                                title: "添加机器人";
                                desc: "接入飞书 / 微信 / 钉钉，30 秒上手";
                                icon: @image-url("icons/plus.svg");
                                clicked => { root.current-page = 1; root.add-bot(); }
                            }
                            QuickCard {
                                title: "环境体检";
                                desc: "Node.js / lark-cli / git 等扩展依赖检测";
                                icon: @image-url("icons/search.svg");
                                clicked => { root.current-page = 2; root.recheck-deps(); }
                            }
                            QuickCard {
                                title: "权限中心";
                                desc: "磁盘 / 辅助功能 / 屏幕录制一键授权";
                                icon: @image-url("icons/lock.svg");
                                action-label: "去授权 ›";
                                clicked => { root.current-page = 2; }
                            }
                            // 跨会话投递是开关不是跳转，卡片内直接放 CheckBox（PixelCard 外壳）。
                            // 内容必须少于 122px（与 QuickCard 同高）：曾因 wrap 说明 + 状态行
                            // 溢出卡外（「已开启」漂出底边）——状态由勾选态表达，文案缩一行。
                            PixelCard {
                                height: 122px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    spacing: 6px;
                                    ImageIcon { icon: @image-url("icons/switch.svg"); tint: PixelTheme.text; }
                                    PixelCheckBox {
                                        text: "跨会话投递";
                                        checked: root.cross-delivery-enabled;
                                        toggled => { root.set-cross-delivery(self.checked); }
                                    }
                                    Text { text: "允许怹把结果投递到其它 bot"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); wrap: no-wrap; overflow: elide; }
                                }
                            }
                        }
                        // 占底部剩余空间：首页内容少（hero+快捷卡全 fixed）时把内容顶到上面，
                        // 不被默认布局推到中下部；其它页有 vertical-stretch:1 列表填满，不需此 spacer。
                        Rectangle { vertical-stretch: 1; }
                    }

// ═══════════ 机器人配置：左列表 + 右编辑（卡片面板） ═══════════
                    if root.current-page == 1: PageContainer {
                        PageHeader { title: "机器人配置"; subtitle: "管理接入的飞书 / 微信 / 钉钉机器人"; }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 4px;
                            background: PixelTheme.bg;
                            HorizontalBox {
                                spacing: 0;
                                // ── 左：bot 列表 ──
                                VerticalBox {
                                    spacing: 6px;
                                    width: 190px;
                                    padding: 8px;
                                    Rectangle {
                                        background: PixelTheme.panel;
                                        border-radius: 4px;
                                        vertical-stretch: 1;
                                        PixelScrollPanel {
                                            vertical-stretch: 1;
                                            VerticalBox {
                                                spacing: 2px;
                                                for bot[idx] in root.bots: Rectangle {
                                                height: 38px;
                                                vertical-stretch: 0; // 禁 VerticalBox 拉伸：bot 少时列表项不撑满整列（38px 恒定）
                                                background: idx == root.selected ? PixelTheme.accent : transparent;
                                                border-radius: 0px;
                                                TouchArea {
                                                    clicked => { root.selected = idx; root.selection-changed(idx); }
                                                    VerticalBox {
                                                        padding-left: 10px;
                                                        spacing: 2px;
                                                        Text {
                                                            // 停用的 bot 前缀 ⚪ 并显灰，一眼可辨（启用的维持原色）
                                                            text: (bot.enabled ? "" : "⚪ ") + (bot.name == "" ? "(未命名)" : bot.name);
                                                            color: idx == root.selected ? PixelTheme.on-accent : (bot.enabled ? PixelTheme.text : UiTokens.text-disabled);
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: bot.kind + (bot.enabled ? "" : " · 停用");
                                                            font-size: 12px;
                                                            color: idx == root.selected ? PixelTheme.on-accent.with-alpha(0.85) : UiTokens.text-dim;
                                                        }
                                                    }
                                                }
                                                // spacer：ScrollPanel 的 viewport 会被拉伸到视口高，无 spacer 时
                                                // 唯一内容（for 项）跟着被拉高成大色块——spacer 吸收剩余空间，
                                                // 列表项保持 38px 恒定（bot 少时空白沉底）
                                                Rectangle { vertical-stretch: 1; }
                                            }
                                        }
                                        }
                                    }
                                    HorizontalBox {
                                        spacing: 8px;
                                        PixelButton { text: "＋ 添加"; clicked => { root.add-bot(); } }
                                        PixelButton {
                                            text: "－ 删除";
                                            enabled: root.selected >= 0;
                                            clicked => { root.remove-bot(root.selected); }
                                        }
                                    }
                                }
                                // ── 右：编辑选中 bot ──
                                VerticalBox {
                                    spacing: 5px;
                                    horizontal-stretch: 1;
                                    padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            width: 100%; // 钳制内容宽度=视口宽：禁止横向滚动，超宽行裁剪而不撑出滚动条
                                            spacing: 8px;
                                            alignment: start;
                                            GridBox {
                                                spacing: 5px;
                                                vertical-stretch: 0;
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Rectangle { width: 80px; }
                                                    // for 循环必须独占容器（slint 限制：RepeatedItemTree 不能直接占 grid 单元格）
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.enabled-options: PixelCheckBox {
                                                            text: "启用此 bot";
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.set-bot-enabled(root.selected, self.checked); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "名称"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.name-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "如：庆小丰（隔离目录名）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "name", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "类型"; width: 80px; vertical-alignment: center; }
                                                    // 下拉与编辑框同款绕法：PixelComboBox 点选内部赋值 index 会
                                                    // 断绑，直接绑 model 行属性切 bot 后残留上一 bot 的类型
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.kind-editor-options: PixelComboBox {
                                                            model: ["feishu", "wechat", "dingtalk"];
                                                            index: opt.value == "feishu" ? 0 : opt.value == "wechat" ? 1 : 2;
                                                            horizontal-stretch: 1;
                                                            selected(idx) => { root.bot-field-edited(root.selected, "kind", self.model[idx]); }
                                                        }
                                                    }
                                                }
                                                // 模型供应商（per-bot 覆盖；""=跟随全局默认）。下拉项 = [""] + provider-names
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "模型供应商"; width: 80px; vertical-alignment: center; }
                                                    // provider 下拉：PixelSelect（value 字符串驱动，动态 options）
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.provider-editor-options: PixelSelect {
                                                            options: root.provider-names;
                                                            value: opt.value;
                                                            horizontal-stretch: 1;
                                                            changed(v) => { root.bot-field-edited(root.selected, "provider", v); }
                                                        }
                                                    }
                                                }
                                                // 授权者 agent 隔离（安全默认开启；三种 kind 都显示）：
                                                // 每日工作目录整理（默认关）：孤儿会话文件/临时文件/超期历史截断/
                                                // 文档归档 + git 留痕。同独立 callback 模式（避开 CheckBox 绑定坑）。
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "每日整理"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.tidy-options: PixelCheckBox {
                                                            text: "每日工作目录整理（孤儿会话/临时文件/超期历史/文档归档 + git 留痕）";
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.set-tidy-enabled(root.selected, self.checked); }
                                                        }
                                                    }
                                                }
                                                // #91 群聊提及默认策略：true=该 bot 所有群免 @ 参与（per-chat /mention 可单独覆盖）。
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "群聊提及"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.mention-options: PixelCheckBox {
                                                            text: "免 @ 参与（该 bot 所有群默认无需 @；群内 /mention 指令可单独覆盖）";
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.set-mention-default(root.selected, self.checked); }
                                                        }
                                                    }
                                                }
                                                // ── 飞书字段（owner/授权者/对话权限）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "对话权限"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.access-options: PixelCheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.access-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "Owner（管理员）"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.owner-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "ou_xxx（管理员 open_id，逗号分隔多个）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "owner", self.text); }
                                                        }
                                                    }
                                                    PixelButton {
                                                        text: "生成管理员授权码";
                                                        clicked => { root.generate-owner-code(root.selected); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu" && root.owner-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.owner-code-info;
                                                        color: UiTokens.warn;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    CopyIconButton {
                                                        clicked => { root.copy-owner-code("owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "App ID"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-id-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "cli_xxxxxxxx";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_id", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "App Secret"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-secret-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            input-type: "password";
                                                            placeholder: "飞书应用密钥";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_secret", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Rectangle { width: 80px; }
                                                    HorizontalBox {
                                                        spacing: 8px;
                                                        Text { text: "bot：" + root.bots[root.selected].bot-name + "  " + root.bots[root.selected].bot-open-id; font-size: 12px; color: PixelTheme.text.with-alpha(0.6); vertical-alignment: center; wrap: word-wrap; }
                                                        PixelButton { text: "自动获取"; clicked => { root.fetch-bot-info(root.selected); } }
                                                    }
                                                }
                                                // ── 微信字段（扫码登录，无需 app_id/secret）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "wechat": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.bots[root.selected].bot-name == ""
                                                            ? "未登录。点下方按钮，用微信扫码登录。"
                                                            : "已登录：" + root.bots[root.selected].bot-name;
                                                        wrap: word-wrap;
                                                        color: root.bots[root.selected].bot-name == "" ? UiTokens.text-dim : UiTokens.ok;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "wechat": Row {
                                                    Rectangle { width: 80px; }
                                                    PixelButton { text: "📱 扫码登录微信"; clicked => { root.wx-login(root.selected); } }
                                                }
                                                // #118 复核：微信 owner 判据 = wx_user_id（扫码登录时自动写入，登录者即管理员）。
                                                // 未配置 → fail-closed 拒绝所有人（私聊/群聊均静默拦截）。GUI 给可见提示，
                                                // 避免「扫码后没人能聊」无从排查。复用 UiTokens.warn-bg/warn（与首页待处理卡同视觉）。
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "wechat" && !root.bots[root.selected].wx-owner-configured: Row {
                                                    Rectangle { width: 80px; }
                                                    Rectangle {
                                                        horizontal-stretch: 1;
                                                        border-radius: 4px;
                                                        background: UiTokens.warn-bg;
                                                        VerticalBox {
                                                            padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px;
                                                            spacing: 3px;
                                                            Text {
                                                                text: "⚠️ 尚未配置管理员（fail-closed）";
                                                                font-size: 12px;
                                                                font-weight: 700;
                                                                color: UiTokens.warn;
                                                            }
                                                            Text {
                                                                text: "当前拒绝所有人对话：尚未配置管理员，所有人（含你自己）的私聊/群聊均被静默拦截。扫码登录后，登录者自动成为管理员（wx_user_id），即可对话。";
                                                                font-size: 12px;
                                                                color: UiTokens.text-dim;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                }
                                                // ── 钉钉字段（企业内部应用机器人，Stream 模式长连接，无需公网地址）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "App Key"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-id-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "钉钉应用 AppKey（dingxxxx）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_id", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "App Secret"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-secret-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            input-type: "password";
                                                            placeholder: "钉钉应用 AppSecret";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_secret", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "机器人编码"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.ding-robot-code-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "留空=默认 AppKey（个别后台单独展示才填）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "ding_robot_code", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "对话权限"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.ding-access-options: PixelCheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.ding-access-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "Owner（管理员）"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.ding-owner-ids-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "员工 staffId（管理员，逗号分隔多个）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "ding_owner_ids", self.text); }
                                                        }
                                                    }
                                                    PixelButton {
                                                        text: "生成管理员授权码";
                                                        clicked => { root.generate-owner-code(root.selected); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk" && root.owner-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.owner-code-info;
                                                        color: UiTokens.warn;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: "要求：企业自建应用已添加「机器人」能力，消息接收模式选 Stream 模式；群聊需 @ 机器人。";
                                                        font-size: 12px;
                                                        color: UiTokens.text-dim;
                                                        wrap: word-wrap;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                            }
                                            // ── 虚拟 Bot 区（#75）：平台真实群 + ABB 登记 ──
                                            // 群名=角色名、群介绍=system prompt（平台群资料为准，改群介绍=改角色即时生效）。
                                            // 仅飞书/钉钉显示（微信排除：虚拟 Bot 需要平台群概念）。
                                            if root.selected >= 0 && root.selected < root.bots.length && (root.bots[root.selected].kind == "feishu" || root.bots[root.selected].kind == "dingtalk"): VerticalBox {
                                                spacing: 6px;
                                                HorizontalBox {
                                                    Text { text: "虚拟 Bot"; font-size: 13px; font-weight: 700; color: PixelTheme.text; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    // 手动刷新：平台解散群的兜底（im.chat.deleted 事件未订阅/丢失时）——
                                                    // 验证登记群存在性，已解散的移除登记并归档会话历史。
                                                    // syncing 期间禁用防连点 + 文字变"同步中"（可视反馈）
                                                    PixelButton {
                                                        text: root.vb-syncing ? "⟳ 同步中…" : "⟳ 刷新";
                                                        size: "small";
                                                        variant: "ghost";
                                                        enabled: !root.vb-syncing;
                                                        clicked => { root.virtual-bot-refresh(); }
                                                    }
                                                }
                                                Text {
                                                    text: "平台真实群 + ABB 登记：群名=角色名、群介绍=system prompt（改群介绍=改角色，即时生效）。群内 @ 机器人自动注入角色；AI 可用 deliver --bot <此 bot> --chat @角色名 寻址。";
                                                    font-size: 12px; color: UiTokens.text-dim; wrap: word-wrap;
                                                }
                                                // #147 团队区（#124 §3.2）：团队卡片列表（位于虚拟 Bot 列表上方）。
                                                // 与聊天入口创建结果双向一致（热读 teams.json，不双写）；状态=全角色有群运行中/有失败部分失败。
                                                Text { text: "团队"; font-size: 13px; font-weight: 700; color: PixelTheme.text; }
                                                for t[i] in root.teams: Rectangle {
                                                    background: PixelTheme.panel;
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: PixelTheme.edge;
                                                    VerticalBox {
                                                        padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;
                                                        spacing: 6px;
                                                        HorizontalBox {
                                                            spacing: 8px;
                                                            Text { text: t.team-name; font-weight: 600; font-size: 13px; color: PixelTheme.text; vertical-alignment: center; }
                                                            Text { text: t.role-count + " 个角色 · " + t.status; font-size: 12px; color: t.status-ok ? UiTokens.ok : UiTokens.warn; vertical-alignment: center; }
                                                            Rectangle { horizontal-stretch: 1; }
                                                            Text { text: t.created-at; font-size: 12px; color: UiTokens.text-dim; vertical-alignment: center; }
                                                            PixelButton { text: "⋯"; size: "small"; clicked => { root.team-menu-open = root.team-menu-open == i ? -1 : i; } }
                                                        }
                                                        // 角色子行：角色名（成员名）— 职责；右侧「任命」「跳转」（行内右侧排列）
                                                        for r[j] in t.roles: HorizontalBox {
                                                            spacing: 8px;
                                                            Text {
                                                                text: r.role-name + "（" + (r.member == "" ? "待任命" : r.member) + "）";
                                                                font-size: 13px;
                                                                font-weight: 600;
                                                                color: PixelTheme.text;
                                                                vertical-alignment: center;
                                                            }
                                                            Text {
                                                                text: r.duty;
                                                                font-size: 12px;
                                                                color: UiTokens.text-dim;
                                                                horizontal-stretch: 1;
                                                                vertical-alignment: center;
                                                                wrap: word-wrap;
                                                            }
                                                            PixelButton { text: "任命"; size: "small"; clicked => { root.team-appoint(i, j); } }
                                                            PixelButton { text: "跳转"; size: "small"; clicked => { root.team-jump(i, j); } }
                                                        }
                                                        // ⋯ 菜单（行内展开）：解散团队（红色强确认，避免误触）
                                                        if root.team-menu-open == i: HorizontalBox {
                                                            spacing: 8px;
                                                            Rectangle { horizontal-stretch: 1; }
                                                            PixelButton { text: "解散团队"; size: "small"; variant: "danger"; clicked => { root.team-dissolve(i); root.team-menu-open = -1; } }
                                                        }
                                                    }
                                                }
                                                if root.teams.length == 0: Text { text: "还没有团队，点「一键创建团队」开始"; font-size: 12px; color: UiTokens.text-dim; }
                                                for vb[i] in root.virtual-bots: Rectangle {
                                                    background: PixelTheme.panel;
                                                    border-radius: 4px;
                                                    VerticalBox {
                                                        padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;
                                                        spacing: 6px;
                                                        HorizontalBox {
                                                            spacing: 8px;
                                                            ImageIcon { icon: @image-url("icons/bot.svg"); tint: PixelTheme.text; vertical-alignment: center; }
                                                            Text { text: vb.role-name; font-weight: 600; font-size: 13px; color: PixelTheme.text; vertical-alignment: center; }
                                                            Text { text: vb.platform; font-size: 12px; color: UiTokens.text-dim; vertical-alignment: center; }
                                                            Rectangle { horizontal-stretch: 1; }
                                                            Text { text: vb.created-at; font-size: 12px; color: UiTokens.text-dim; vertical-alignment: center; }
                                                            PixelButton { text: "编辑"; size: "small"; clicked => { root.virtual-bot-edit(i); } }
                                                            PixelButton { text: "⋯"; size: "small"; clicked => { root.vb-menu-open = root.vb-menu-open == i ? -1 : i; } }
                                                        }
                                                        // ⋯ 菜单（行内展开）：免@开关（#91）/ 取消登记（轻确认）/ 解散群（强确认，仅飞书有解散 API）
                                                        if root.vb-menu-open == i: HorizontalBox {
                                                            spacing: 8px;
                                                            Rectangle { horizontal-stretch: 1; }
                                                            PixelCheckBox {
                                                                text: vb.mention-off ? "免 @ 参与：开" : "免 @ 参与：关";
                                                                checked: vb.mention-off;
                                                                toggled => { root.virtual-bot-mention-toggle(i); }
                                                            }
                                                            PixelButton { text: "取消登记"; size: "small"; variant: "ghost"; clicked => { root.virtual-bot-deregister(i); root.vb-menu-open = -1; } }
                                                            if root.bots[root.selected].kind == "feishu": PixelButton { text: "解散群"; size: "small"; variant: "danger"; clicked => { root.virtual-bot-disband(i); root.vb-menu-open = -1; } }
                                                        }
                                                    }
                                                }
                                                if root.virtual-bots.length == 0: Text { text: "暂无登记。点下方按钮一键建群（平台 API 失败时手动建群后「手动登记」）。"; font-size: 12px; color: UiTokens.text-dim; }
                                                PixelButton { text: "＋ 创建虚拟 Bot"; clicked => { root.virtual-bot-create(root.selected); } }
                                                // #124 一键创建团队（P2，mock 阶段）：一句话生成角色群方案，确认后批量建群。
                                                // 视觉：PixelCard 外壳 + 现有 token；按钮与「创建虚拟 Bot」并列，主操作优先。
                                                Rectangle {
                                                    border-radius: 4px;
                                                    background: PixelTheme.bg;
                                                    border-width: 1px;
                                                    border-color: PixelTheme.edge;
                                                    HorizontalBox {
                                                        padding: 10px;
                                                        spacing: 10px;
                                                        ImageIcon { icon: @image-url("icons/plus.svg"); tint: PixelTheme.text; vertical-alignment: center; }
                                                        VerticalBox {
                                                            horizontal-stretch: 1;
                                                            spacing: 2px;
                                                            Text { text: "一键创建团队"; font-size: 13px; font-weight: 700; color: PixelTheme.text; }
                                                            Text { text: "一句话生成角色群方案，确认后批量建群（当前为预览版）"; font-size: 12px; color: UiTokens.text-dim; wrap: word-wrap; }
                                                        }
                                                        PixelButton { text: "去创建"; variant: "primary"; clicked => { root.team-create-clicked(root.selected); } }
                                                    }
                                                }
                                                if root.bots[root.selected].kind == "dingtalk": Text {
                                                    text: "钉钉提示：机器人建群能力待平台实测；失败时手动建群（群名=角色名）后走弹窗「手动登记」。钉钉群无「群介绍」字段，角色提示词只能注入群名。";
                                                    font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                                                }
                                            }
                                            if root.selected < 0: Text { text: "← 选择或添加一个机器人"; color: UiTokens.text-dim; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ═══════════ 环境配置：依赖 + 权限（卡片化） ═══════════
                    if root.current-page == 2: PageContainer {
                        PageHeader { title: "环境配置"; subtitle: "依赖检测与系统权限"; }

                        PixelScrollPanel {
                            // 铺满父宽：Rectangle natural 宽=内容宽(~300)，不拉伸则 ScrollView
                            // 视口窄，行右侧「去授权/安装」按钮被裁（width:100% 只等于内容宽）。
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            VerticalBox {
                                // 钳制内容宽=视口（同机器人配置页）：否则内容宽=preferred(~300)，
                                // 权限卡行 Text+StatusPill+按钮(~324) 超宽 → 行右侧「去授权/安装」
                                // 按钮被裁剪看不到（用户报「未授权也没有授权按钮」）。
                                width: 100%;
                                spacing: 14px;
                                alignment: start;

                                // ── 依赖卡片 ──
                                Rectangle {
                                    vertical-stretch: 0;
                                    border-radius: 4px;
                                    background: PixelTheme.bg;
                                    VerticalBox {
                                        padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
                                        spacing: 6px;
                                        HorizontalBox {
                                            spacing: 8px;
                                            Text { text: "依赖（agent 扩展能力运行环境）"; font-weight: 700; color: PixelTheme.text; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            // #60：标题行入口——缺 node/lark 等也要有一键装入口
                                            if root.missing-deps > 0: PixelButton {
                                                text: "一键安装缺失";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-all-missing(); }
                                            }
                                            PixelButton { text: "重新检测"; clicked => { root.recheck-deps(); } }
                                        }
                                        if root.dep-busy != "": Text {
                                            text: "⏳ 正在安装 " + root.dep-busy + " …（可能要几分钟，期间请勿重复点）";
                                            color: UiTokens.warn;
                                            wrap: word-wrap;
                                        }
                                        // 安装失败详情区（与 busy 提示为**兄弟**节点——失败路径先清
                                        // busy 再设 detail，嵌套在 busy 内会让错误区永不渲染，审查 C1）
                                        if root.dep-detail != "": Rectangle {
                                            // 分类 + 怎么办 + 原始错误。醒目样式：粗边框 + 大字号
                                            // ——失败即所见（ui.rs 失败时自动切到本页）。
                                            border-width: 2px;
                                            border-color: UiTokens.error;
                                            background: UiTokens.error-bg;
                                            border-radius: 4px;
                                            VerticalBox {
                                                padding: 10px;
                                                spacing: 6px;
                                                Text {
                                                    text: "⚠️ 安装失败";
                                                    font-size: 14px;
                                                    font-weight: 700;
                                                    color: UiTokens.error;
                                                }
                                                Text {
                                                    text: root.dep-detail;
                                                    color: UiTokens.error;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                        // nodejs
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Node.js"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.node-installed ? "已安装" : "未安装"; ok: root.node-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.node-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("node"); }
                                            }
                                        }
                                        if !root.node-installed: Text { text: "brew install node"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // python3（P4.3 降为信息项：运行时无消费方，仅源码开发的
                                        // 测试 fixture 用；不算缺失、不提供安装入口）
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Python 3"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.python-installed ? "已安装" : "未安装"; ok: root.python-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "信息项：运行时已不依赖（仅源码开发跑测试需要）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); vertical-alignment: center; }
                                        }
                                        // lark-cli
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "lark-cli"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.lark-installed ? "已安装" : "未安装"; ok: root.lark-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.lark-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("lark-cli"); }
                                            }
                                        }
                                        if !root.lark-installed: Text { text: "npm install -g @larksuite/cli"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // dingtalk-cli
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "dingtalk-cli"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.dingtalk-installed ? "已安装" : "未安装"; ok: root.dingtalk-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.dingtalk-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("dingtalk-cli"); }
                                            }
                                            if !root.dingtalk-installed: PixelButton { text: "文档"; clicked => { root.open-url("https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli"); } }
                                        }
                                        if !root.dingtalk-installed: Text { text: "npm install -g dingtalk-workspace-cli"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // git（larkskills 技能同步 + 受限会话 agent 只读 git 白名单用系统 git；
                                        // 最低版本 v2.30——删除保护/tidy 留痕已内置 libgit2，不依赖系统 git）
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Git"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            if root.git-ok: StatusPill { text: "已安装"; ok: true; }
                                            if root.git-installed && !root.git-ok: StatusPill { text: "版本过低"; ok: false; warn: true; }
                                            if !root.git-installed: StatusPill { text: "未安装"; ok: false; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.git-ok: PixelButton {
                                                text: root.git-installed ? "升级" : "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("git"); }
                                            }
                                            if !root.git-installed: PixelButton { text: "文档"; clicked => { root.open-url("https://git-scm.com/downloads"); } }
                                        }
                                        // #105：版本满足显示实际版本；版本过低给升级指引；未装保留官方下载链接
                                        if root.git-ok && root.git-version != "": Text { text: "已安装 v\{root.git-version}（最低要求 v2.30）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        if root.git-installed && !root.git-ok: Text { text: "当前 v\{root.git-version} 低于最低要求 v2.30，请升级"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        if !root.git-installed: Text { text: "git-scm.com/downloads（Windows 静默安装 /VERYSILENT）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                    }
                                }

                                // ── 系统权限卡片（仅支持平台才显示）──
                                if root.perms-supported: Rectangle {
                                    vertical-stretch: 0;
                                    border-radius: 4px;
                                    background: PixelTheme.bg;
                                    VerticalBox {
                                        padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
                                        spacing: 6px;
                                        HorizontalBox {
                                            spacing: 8px;
                                            Text { text: "系统权限"; font-weight: 700; color: PixelTheme.text; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            // 授权提示按钮只在 macOS 显示（Windows 走管理员重启）
                                            if root.platform == "macos": PixelButton { text: "📹 请求授权"; enabled: !root.perm-busy; clicked => { root.request-perms(); } }
                                        }
                                        if root.perms-supported && root.platform == "macos" && root.perm-busy: Text {
                                            text: "⏳ 正在逐项弹系统授权框（屏幕录制→摄像头→麦克风），请在弹框里点「允许」。完成后点「重新检测」刷新。";
                                            font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                                        }
                                        // Windows：管理员身份
                                        if root.perms-supported && root.platform == "windows": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "管理员身份"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.perm-admin == 2 ? "已提权" : "未提权"; ok: root.perm-admin == 2; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-admin != 2: PixelButton { text: "以管理员重启"; clicked => { root.relaunch-as-admin(); } }
                                        }
                                        if root.perms-supported && root.platform == "windows" && root.perm-admin != 2: Text {
                                            text: "Windows 无需逐项授权；以管理员身份运行即可完全控制本机（文件/鼠标键盘/屏幕/摄像头/麦克风）。点击上方按钮会弹 UAC 确认框。";
                                            font-size: 12px; color: UiTokens.text-dim; wrap: word-wrap;
                                        }
                                        // macOS 六项权限
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "完全磁盘访问"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-full-disk == 2 ? "已授权" : (root.perm-full-disk == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-full-disk == 2;
                                                warn: root.perm-full-disk == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-full-disk != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("full-disk"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "辅助功能"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-accessibility == 2 ? "已授权" : (root.perm-accessibility == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-accessibility == 2;
                                                warn: root.perm-accessibility == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-accessibility != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("accessibility"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "屏幕录制"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-screen == 2 ? "已授权" : (root.perm-screen == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-screen == 2;
                                                warn: root.perm-screen == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-screen != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("screen"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "自动化"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-automation == 2 ? "已授权" : (root.perm-automation == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-automation == 2;
                                                warn: root.perm-automation == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-automation != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("automation"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "摄像头"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-camera == 2 ? "已授权" : (root.perm-camera == 3 ? "受策略限制" : (root.perm-camera == 1 ? "被拒绝" : "未授权"));
                                                ok: root.perm-camera == 2;
                                                warn: root.perm-camera == 1 || root.perm-camera == 3;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-camera == 3: Text { text: "受 MDM / 家长控制限制"; font-size: 12px; color: UiTokens.warn; vertical-alignment: center; }
                                            if root.perm-camera != 2 && root.perm-camera != 3: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("camera"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "麦克风"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-microphone == 2 ? "已授权" : (root.perm-microphone == 3 ? "受策略限制" : (root.perm-microphone == 1 ? "被拒绝" : "未授权"));
                                                ok: root.perm-microphone == 2;
                                                warn: root.perm-microphone == 1 || root.perm-microphone == 3;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-microphone == 3: Text { text: "受 MDM / 家长控制限制"; font-size: 12px; color: UiTokens.warn; vertical-alignment: center; }
                                            if root.perm-microphone != 2 && root.perm-microphone != 3: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("microphone"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos" && (root.perm-full-disk != 2 || root.perm-screen != 2 || root.perm-camera != 2 || root.perm-microphone != 2): Text {
                                            text: "💡 不可用项：「完全磁盘访问」可点「去授权」后在面板里 ＋ 添加本程序；「屏幕录制/摄像头/麦克风」须先点上方「📹 请求…」按钮触发系统弹框（否则设置列表里看不到本程序）。显示「受策略限制」则不弹框也授不了，需改 MDM / 屏幕使用时间策略。改完可能需要重启服务生效。";
                                            font-size: 12px;
                                            color: UiTokens.warn;
                                            wrap: word-wrap;
                                        }
                                        if root.perms-supported: HorizontalBox {
                                            spacing: 8px;
                                            Text {
                                                text: "授权/改权限后，运行中的服务要重启才认：";
                                                font-size: 12px; color: UiTokens.text-dim; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
                                            }
                                            PixelButton { text: "🔁 重启服务生效"; clicked => { root.restart-service-request(); } }
                                        }
                                    }
                                }
                                if !root.perms-supported: Text {
                                    text: "系统权限检测仅 macOS 需要（本机为其它系统）。";
                                    font-size: 12px;
                                    color: UiTokens.text-dim;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "说明：模型供应商的 key 在「模型供应商」页提供，未配置供应商的 bot 会拒答并引导配置；nodejs 是 lark-cli/dingtalk-cli 的前置；接入飞书 bot 时会自动装 lark 技能。";
                                    font-size: 12px;
                                    color: UiTokens.text-dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ═══════════ 模型供应商：左列表 + 右编辑（卡片面板） ═══════════
                    if root.current-page == 3: PageContainer {
                        PageHeader { title: "模型供应商"; subtitle: "Claude / Codex 或任意 OpenAI 兼容供应商"; }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 4px;
                            background: PixelTheme.bg;
                            HorizontalBox {
                                spacing: 0;
                                // ── 左：供应商列表 ──
                                VerticalBox {
                                    spacing: 8px;
                                    width: 210px;
                                    padding: 10px;
                                    Rectangle {
                                        background: PixelTheme.panel;
                                        border-radius: 4px;
                                        vertical-stretch: 1;
                                        PixelScrollPanel {
                                            vertical-stretch: 1;
                                            VerticalBox {
                                                spacing: 2px;
                                                for prov[idx] in root.providers: Rectangle {
                                                // 同历史页：两行内容按 min-height 走，别钉死（soft 预设下行高变大）
                                                min-height: 44px;
                                                background: idx == root.provider-selected ? PixelTheme.accent : transparent;
                                                border-radius: 0px;
                                                TouchArea {
                                                    clicked => { root.provider-selected = idx; root.provider-selection-changed(idx); }
                                                    VerticalBox {
                                                        padding-left: 10px;
                                                        spacing: 2px;
                                                        Text {
                                                            text: prov.name == "" ? "(未命名)" : prov.name;
                                                            color: idx == root.provider-selected ? PixelTheme.on-accent : PixelTheme.text;
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: prov.kind + (prov.is-default ? " · 默认" : "");
                                                            font-size: 12px;
                                                            color: idx == root.provider-selected ? PixelTheme.on-accent.with-alpha(0.85) : UiTokens.text-dim;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                    HorizontalBox {
                                        spacing: 8px;
                                        PixelButton { text: "＋ 添加"; clicked => { root.add-provider(); } }
                                        PixelButton {
                                            text: "－ 删除";
                                            enabled: root.provider-selected >= 0;
                                            clicked => { root.remove-provider(root.provider-selected); }
                                        }
                                    }
                                }
                                // ── 右：编辑选中供应商 ──
                                VerticalBox {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    padding-top: 12px; padding-right: 14px; padding-bottom: 12px; padding-left: 14px;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            spacing: 10px;
                                            alignment: start;
                                            GridBox {
                                                spacing: 6px;
                                                vertical-stretch: 0;
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "名称"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].name;
                                                        placeholder: "唯一键，如 my-claude";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "name", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "类型"; width: 96px; vertical-alignment: center; }
                                                    PixelComboBox {
                                                        // 顺序与 Rust 侧 config::PROVIDER_KINDS 一致（openrouter/deepseek 是预置端点）
                                                        model: ["anthropic", "openai-chat", "openai-responses", "openrouter", "deepseek"];
                                                        index: root.providers[root.provider-selected].kind-index;
                                                        horizontal-stretch: 1;
                                                        selected(idx) => { root.provider-field-edited(root.provider-selected, "kind", self.model[idx]); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "Base URL"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].base-url;
                                                        placeholder: "如 https://api.openai.com/v1；openrouter/deepseek 留空=官方端点";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "base_url", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "API Key"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].api-key;
                                                        input-type: "password";
                                                        placeholder: "sk-...（留空=保留已存密钥）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "api_key", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "模型"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].model;
                                                        placeholder: "如 claude-sonnet-4-5 / gpt-5（空=agent 默认）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "model", self.text); }
                                                    }
                                                }
                                                // E3：上下文窗口（状态栏「已用/上限」的分母）。
                                                // 留空 = 走内置兜底表；表里没有的模型才需要填。
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "上下文窗口"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].context-window;
                                                        placeholder: "如 200000；留空 = 按内置表（状态栏上限）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "context_window", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Rectangle { width: 96px; }
                                                    HorizontalBox {
                                                        spacing: 8px;
                                                        PixelButton {
                                                            text: root.providers[root.provider-selected].is-default ? "★ 已是默认" : "设为默认";
                                                            enabled: !root.providers[root.provider-selected].is-default;
                                                            clicked => { root.set-default-provider(root.provider-selected); }
                                                        }
                                                        PixelButton { text: "测试连接"; clicked => { root.test-provider(root.provider-selected); } }
                                                    }
                                                }
                                            }
                                            if root.provider-selected < 0: Text { text: "← 选择或添加一个供应商"; color: UiTokens.text-dim; }

                                            Text {
                                                text: "随包 agent 支持 Anthropic 原生与 OpenAI 兼容（chat / responses 两种接口）供应商，按供应商类型填对应 key。桥内配置优先于 CC Switch。「上下文窗口」只作状态栏「已用/上限」的分母：留空按内置表（只覆盖常见模型名），表里没有的模型可在这里填。";
                                                font-size: 12px;
                                                color: UiTokens.text-dim;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }

                                // ── 决策模型（Jev）：授权者/受限会话的工具调用门禁 ──
                                VerticalBox {
                                    spacing: 8px;
                                    width: 300px;
                                    padding: 10px;
                                    Rectangle {
                                        background: PixelTheme.panel;
                                        border-radius: 4px;
                                        vertical-stretch: 0;
                                        VerticalBox {
                                            spacing: 8px;
                                            padding: 10px;
                                            Text {
                                                text: "决策模型（Jev）";
                                                font-weight: 600;
                                                color: PixelTheme.text;
                                            }
                                            Text {
                                                text: "授权者（受限）会话的工具调用门禁：每个工具调用前由 Jev 判定是否放行。不配置时受限会话会拒答。";
                                                font-size: 12px;
                                                color: UiTokens.text-dim;
                                                wrap: word-wrap;
                                            }
                                            Text { text: "API Key"; font-size: 12px; color: UiTokens.text-dim; }
                                            PixelTextInput {
                                                text: root.jev-api-key;
                                                input-type: "password";
                                                placeholder: "OpenRouter key（留空 = 保留已存密钥）";
                                                edited => { root.jev-field-edited("api_key", self.text); }
                                            }
                                            Text { text: "Base URL"; font-size: 12px; color: UiTokens.text-dim; }
                                            PixelTextInput {
                                                text: root.jev-base-url;
                                                placeholder: "默认 https://openrouter.ai/api/alpha/decisions";
                                                edited => { root.jev-field-edited("base_url", self.text); }
                                            }
                                            Text { text: "模型"; font-size: 12px; color: UiTokens.text-dim; }
                                            PixelTextInput {
                                                text: root.jev-model;
                                                placeholder: "默认 ~typesafe/jev-latest";
                                                edited => { root.jev-field-edited("model", self.text); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ═══════════ 历史记录：授权者私聊消息 + bot 回复（#74） ═══════════
                if root.current-page == 4: PageContainer {
                    PageHeader { title: "历史记录"; subtitle: "授权者私聊本机器人的消息与回复（默认保留 30 天，可手动清除）"; }

                    // 顶部工具区：提醒开关 + 保留期 + 归纳清理。两行合一个 GridBox——
                    // 共享列宽让 checkbox/标签/下拉三列严格对齐（两张独立 HorizontalBox 卡
                    // 会各自排版，checkbox 文本宽度不同导致下拉起点错位）。
                    Rectangle {
                        vertical-stretch: 0;
                        background: PixelTheme.bg;
                        border-radius: 4px;
                        GridBox {
                            padding: 10px;
                            spacing: 12px;
                            Row {
                                PixelCheckBox {
                                    text: "消息提醒";
                                    checked: root.notify-enabled;
                                    toggled => { root.notify-enabled = self.checked; root.set-notify-enabled(self.checked); }
                                }
                                Text {
                                    text: "保留期";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    color: PixelTheme.text;
                                }
                                PixelComboBox {
                                    width: 110px;
                                    model: ["7 天", "30 天", "90 天"];
                                    index: root.history-retention-days == 7 ? 0 : root.history-retention-days == 90 ? 2 : 1;
                                    selected(idx) => { root.set-history-retention(idx); }
                                }
                                HorizontalBox {
                                    horizontal-stretch: 1;
                                    Rectangle { horizontal-stretch: 1; }
                                    PixelButton {
                                        text: "🗑 清除全部历史";
                                        clicked => { root.clear-history(); }
                                    }
                                }
                            }
                            Row {
                                PixelCheckBox {
                                    text: "每日会话归纳清理";
                                    checked: root.session-gc-enabled;
                                    toggled => { root.session-gc-enabled = self.checked; root.set-session-gc-enabled(self.checked); }
                                }
                                Text {
                                    text: "过期判定";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    color: PixelTheme.text;
                                }
                                PixelComboBox {
                                    width: 110px;
                                    model: ["3 天", "7 天", "14 天", "30 天"];
                                    index: root.session-gc-days == 3 ? 0 : root.session-gc-days == 14 ? 2 : root.session-gc-days == 30 ? 3 : 1;
                                    selected(idx) => { root.set-session-gc-days(idx); }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "超过该天数未活跃的会话，由随包 agent 归纳成摘要存档（summaries/）并清理工作区内的历史/会话文件；摘要下次会话自动注入衔接上下文。仅清理本 bot 工作区，不触碰 agent 私有目录。";
                                    font-size: 12px;
                                    color: UiTokens.text-dim;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // 主体：左会话列表（chat_id 分组，微信式）+ 右消息流（ts 正序）
                    Rectangle {
                        vertical-stretch: 1;
                        background: PixelTheme.bg;
                        border-radius: 4px;
                        HorizontalBox {
                            spacing: 0;
                            // ── 左：会话列表（同一 chat 的消息聚合为一个会话）──
                            VerticalBox {
                                width: 300px;
                                padding: 10px;
                                spacing: 8px;
                                Rectangle {
                                    background: PixelTheme.panel;
                                    border-radius: 4px;
                                    vertical-stretch: 1;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            spacing: 2px;
                                            for s[idx] in root.chat-sessions: Rectangle {
                                                // ⚠️ std-widgets 的 HorizontalBox/VerticalBox 默认 padding 是
                                                //    StyleMetrics.layout-padding（本机 8px）：行内每个 HorizontalBox
                                                //    光上下 padding 就 16px，一行文本实测 30px（8+14+8），两行 62px 塞进
                                                //    52px 行框 ⇒ 布局压缩后第二行画到行外、选中高亮只盖第一行
                                                //    （用户报的「会话列表错位」）。故行内 box 的 padding 全部显式归零，
                                                //    行内留白只用 padding-left 表达（18px = 原 10px + HBox 的 8px）；
                                                //    内容块 14+2+14 = 30px，在 52px 行内居中。
                                                // 行高取**确定值**：ScrollView 的内容高度 = max(视口高, 内容布局
                                                //    min-height)，而 min-height 求和使用每行的 min；行若「按内容自动
                                                //    增高」，渲染高度就会大于参与换算的 min，末尾几行永远滚不到
                                                //    （用户报的「拉不到底」）。
                                                height: 52px;
                                                vertical-stretch: 0;
                                                background: idx == root.chat-selected ? PixelTheme.accent : transparent;
                                                TouchArea {
                                                    clicked => { root.chat-selected = idx; root.history-selection-changed(idx); }
                                                    VerticalBox {
                                                        padding: 0px;
                                                        padding-left: 18px;
                                                        spacing: 2px;
                                                        alignment: LayoutAlignment.center;
                                                        HorizontalBox {
                                                            padding: 0px;
                                                            spacing: 6px;
                                                            Text {
                                                                text: (s.kind-tag == "" ? "" : "[" + s.kind-tag + "] ") + s.sender;
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                                overflow: elide;
                                                                horizontal-stretch: 1;
                                                                color: idx == root.chat-selected ? PixelTheme.on-accent : PixelTheme.text;
                                                            }
                                                            Text {
                                                                text: s.time;
                                                                font-size: 11px;
                                                                vertical-alignment: center;
                                                                color: idx == root.chat-selected ? PixelTheme.on-accent.with-alpha(0.85) : UiTokens.text-dim;
                                                            }
                                                        }
                                                        HorizontalBox {
                                                            padding: 0px;
                                                            spacing: 6px;
                                                            Text {
                                                                text: s.preview;
                                                                font-size: 12px;
                                                                overflow: elide;
                                                                horizontal-stretch: 1;
                                                                color: idx == root.chat-selected ? PixelTheme.on-accent.with-alpha(0.85) : PixelTheme.text.with-alpha(0.6);
                                                            }
                                                            Text {
                                                                text: s.count;
                                                                font-size: 11px;
                                                                vertical-alignment: center;
                                                                color: idx == root.chat-selected ? PixelTheme.on-accent.with-alpha(0.85) : UiTokens.text-dim;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if root.chat-sessions.length == 0: Text {
                                                text: "暂无记录：授权者私聊本机器人后，同一会话的消息会聚合显示在这里";
                                                font-size: 12px;
                                                color: UiTokens.text-dim;
                                                wrap: word-wrap;
                                            }
                                            Rectangle { vertical-stretch: 1; } // spacer：防会话项被 viewport 拉伸成大色块
                                        }
                                    }
                                }
                            }
                            // ── 右：选中会话的消息流（wrap 换行，纵向滚动）──
                            VerticalBox {
                                horizontal-stretch: 1;
                                padding-top: 14px; padding-right: 14px; padding-bottom: 14px; padding-left: 14px;
                                spacing: 8px;
                                Text {
                                    text: root.chat-title == "" ? "← 选择左侧一个会话查看消息流" : root.chat-title;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: PixelTheme.text;
                                }
                                Rectangle {
                                    background: PixelTheme.panel;
                                    border-radius: 4px;
                                    vertical-stretch: 1;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;

                                        VerticalLayout {
                                            width: 100%; // 钳制视口宽：wrap 生效，长文换行纵向滚动（#223 同款坑）
                                            spacing: 10px;
                                            padding-right: 12px;
                                            for m in root.history-msgs: VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: m.time + " · " + m.direction + " · " + m.sender;
                                                    font-size: 11px;
                                                    color: UiTokens.text-dim;
                                                }
                                                Text {
                                                    // 宽度必须绑 **px 值**（parent.width），不能写 width: 100%：
                                                    // ScrollView 的内容高度取内容布局的 min-height，而布局算子项
                                                    // min/preferred 时给换行 Text 的横轴约束未定，百分比宽度在这条
                                                    // 路径上解析不出来 —— Slint 按「整段一行」估高（每条消息少算一行），
                                                    // 内容高度小于真实渲染高度 ⇒ 末尾几条消息永远滚不到
                                                    // （用户报的「对话历史消息拉不到底」）。
                                                    // 实测（2026-10-01，30 条）：100% → content-height 1160 / 实际渲染
                                                    // 1272（末尾 3 条不可达）；parent.width → 1272。
                                                    width: parent.width;
                                                    text: m.text;
                                                    font-size: 12px;
                                                    color: PixelTheme.text;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            if root.history-msgs.length == 0 && root.chat-title != "": Text {
                                                text: "（该会话暂无消息）";
                                                font-size: 12px;
                                                color: UiTokens.text-dim;
                                            }

                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── 底部共享：状态行 + 保存/取消（钉底；首页无表单，保存/取消只出现在配置页）──
            Rectangle {
                height: 46px;
                background: PixelTheme.bg;
                // 同标题栏：贴窗口下边的状态条也要跟着圆（内圈 8px）
                border-bottom-left-radius: 8px;
                border-bottom-right-radius: 8px;
                HorizontalBox {
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 8px;
                    Text {
                        // 有临时状态（保存/测试结果）优先显示；平时显示服务运行概览行
                        text: root.status-line != "" ? root.status-line : root.running-line;
                        color: root.status-line != "" && root.status-is-error ? UiTokens.error : UiTokens.ok;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.current-page != 0: PixelButton { text: "关闭"; clicked => { root.cancel-clicked(); } }
                    if root.current-page != 0: PixelButton {
                        // 保存后的行为即「写盘 + 服务在跑时重启」（对用户只说「保存」，重启是实现细节）
                        text: "保存";
                        variant: "primary";
                        clicked => { root.save-clicked(); }
                    }
                }
            }
        }

        // 无边框窗口的缩放热区。**全平台都画**（同对话窗，2026-10-15 更正）：
        //   - 旧注释「macOS 刻意不加：系统对 no-frame 窗口自带边角缩放」是**错的**——
        //     决定项是**透明度**：ABB 的窗都是 Slint `no-frame` ⇒ winit 后端一律
        //     `with_transparent(true)`（圆角靠它），而透明无边框窗在 macOS **拿不到**
        //     系统边角缩放（A/B 实测见 `docs/syschat-handover.md` §5.1；锁屏期合成拖拽）。
        //     不画热区 = 设置窗在 macOS 上**完全不能缩放**（D6 之后就是这个状态）。
        //   - 所以这里与对话窗同构：热区恒画，macOS 走 `self-managed: true` 的**自管缩放**，
        //     Windows/Linux 仍走系统的 `drag_resize_window`（`begin-resize`，行为不变——
        //     `WindowResizeZones` 的几何与 `PixelWindowResize` 逐条同值：6px 边 / 14px 角 /
        //     只认左键，见其注释）。
        // 放在 VerticalBox 之后（更晚声明 = 更上层），保证边角热区优先于内容命中。
        if root.resize-hit-areas : WindowResizeZones {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            self-managed: root.resize-self-managed;
            begin-resize(dir) => { root.begin-resize(dir); }
            self-resize-begin(dir, x, y) => { root.self-resize-begin(dir, x, y); }
        }
    }   // 关闭根 Rectangle（外层纯黑圆角填充 + 包内容防塌缩）
}

// ═══════════════════════════════════════════════════════════════════════════
// 系统级对话：全局锚点气泡 + AI 对话框
// ═══════════════════════════════════════════════════════════════════════════
// 与「渠道对话」的区别：这里不经任何飞书/微信/钉钉 bot，直接与随包 abb-agent 对话
// （owner 全权限、专用工作区 syschat、历史落盘）——即一个「系统级 Owner Bot」。
// 入口是托盘进程里的全局锚点气泡，**GUI 专属**；ABB 无头时不实例化任何窗口。

// 系统级对话的渲染块（B 批，与 `src/mdblocks.rs` 的 `MdBlock` 对应）。
// 行内 markdown 由 Rust 侧解析成 Slint `styled-text`（`src/mdblocks.rs::styled`）；
// GUI 直绑 `text: b.styled`。**不要**在 .slint 里写 `@markdown("{b.text}")`——那不是插值
// 模板，会被当编译期常量渲染成字面量（评审 B1/B2，2026-10-13）。
// 行内公式混排的一段（`kind == "mathp"`）：由 Rust 侧 `inlineflow` 用 parley 算好坐标，
// 这里只按坐标绝对定位——文字仍交给 `Text`（清晰、字体一致），公式交给 `Image`（ratex SVG）。
// 为什么不用 `HorizontalBox`/`FlexboxLayout`：Slint 的 flex 对齐里**没有 baseline**
//（`CrossAxisAlignment` 只有 auto/stretch/start/end/center）⇒ 公式对不上文字基线。
export struct ConvoFlowPiece {
    is-math: bool,
    text: string,
    img: image,
    x: length,
    y: length,
    w: length,
    h: length,
}

// 表格的一行（整表一个块）。为什么不是「一行一个块」：列宽/该行最高单元格只有**拿到整表**才算得出来；
// 旧版一行一个 `SysChatBlockRow` ⇒ 每行各自一个 Flickable、各自套 min 列宽，结果是左列被裁 +
// 列间距巨大 + 各行能独立横滑（`4bb9cbb` 残留，2026-10-15 owner 实录）。
export struct TableRow {
    cells: [string],
    header: bool,
    // 每格的混排片段（Rust 侧 `inlineflow::layout_cell` 排好）与它的高：
    // 嵌套模型（`[[ConvoFlowPiece]]`）—— 一格里既有文字又有公式时必须能分别定位。
    flows: [[ConvoFlowPiece]],
    flow-hs: [length],
    // 该行的高（Rust 侧 = 本行最高格的 flow-h + 8px）——**行高必须显式给**，
    // 否则 `HorizontalBox` 里各格各自算高、行间会露出空隙（实测约 8–10px）。
    row-h: length,
}

export struct SysChatBlockRow {
    kind: string,        // role|h1|h2|h3|p|list|task|code|quote|table|hr|image|audio|video
    text: string,        // 纯文本（code 原文 / 角色名 / 表格单元格）
    // 角色块的**身份判据**（卡 `abb-wording-role-label-kind-20261013`）：true = 助手轮。
    // **不要**用 `text == "怹"` 判身份——角色名是展示文案，改名（「ABB」→「怹」那次）会让
    // 判据恒假、着色静默失效。身份由 Rust 侧 `ui::role_row(label, assistant)` 给。
    role-assistant: bool,
    styled: styled-text, // 行内 markdown 解析结果（h*/p/list/task/quote 用）
    level: int,
    order: int,
    checked: bool,
    marker: string,     // 列表标记（• / 1. / ☑ / ☐）——Rust 侧算好，避 Slint int→string
    lang: string,
    cells: [string],     // 表格行单元格（旧字段，保留给旧用例/兼容；渲染已改用 table-rows）
    header: bool,
    // 表格（`kind == "table"`，**整表一个块**）：`table-rows` = 全部行（含表头行）；
    // `col-ws` = Rust 侧按字符类别估的每列宽（px）——「行高取该行最高格」靠它。
    table-rows: [TableRow],
    col-ws: [length],
    src: string,         // 图片/媒体地址（本地路径或 http(s)）
    alt: string,
    img: image,          // 已加载的图片（本地/已缓存）；未加载时为空
    img-ok: bool,        // 图片是否已成功加载（否则显示链接回退）
    // 图片显示高用的**源宽高比**（源高/源宽）；`0` = 未知/未加载（按旧值 200px 回退）。
    // 为什么要它：裸 `Rectangle` 不会因 `Image` 子项而长高（实测该块只向布局报 ~30px，
    // 图片却实画 ~200px ⇒ 后面的块全被图片盖住、滞底也算不到底）。
    img-aspect: float,
    // 块级公式图片的**自然尺寸**（px，`kind == "math"` 且排版成功时才有意义；其余恒 0）。
    // 与 `img-aspect` 的分工：那个用于「按气泡宽铺满」的媒体图，这两个用于「保持自然大小」
    // 的公式图（公式不该被拉到满宽）。
    img-w: length,
    img-h: length,
    // 行内公式混排（`kind == "mathp"`，见 `src/inlineflow.rs`）：
    //   `flow` = 定位好的片段（文字/公式图）；`flow-h` = 整段高（裸容器不会被绝对定位的子项撑高）；
    //   `flow-size` = 文字字号；`math-off`/`math-tex` = 源信息（宽变时原地重排用，见 `ui::relayout_flow_rows`）。
    flow: [ConvoFlowPiece],
    flow-h: length,
    flow-size: length,
    math-off: [int],
    math-tex: [string],
    // 思考块（E2 需求 #11：`kind == "think"`）专用字段。默认**折叠**；`think-live` = 思考仍在
    // 进行（流式展开让打字机可见，进正文/收尾即收起）；`think-elapsed` 由 Rust 格式化（如 3.2s）。
    think-expanded: bool,
    think-live: bool,
    think-elapsed: string,
    // 卡 `abb-v11-message-actions`：**无行内样式**的块用只读 `TextInput` 渲染 ⇒ 可拖选 + ⌘C。
    // `plain` 是这个块的**展示文本**（由 `mdblocks::selectable_plain` 一并判定与产出）；
    // `selectable` 为 false 时继续走 `styled`（有行内样式，`TextInput` 渲染不了 ⇒ 不做视觉回退）。
    selectable: bool,
    plain: string,
    // 稿 v15：**用户输入靠右、怹的输出靠左**。Rust 侧按轮次角色置位（`rows_for_w`）。
    align-right: bool,
    // 稿 v16：音视频内联播放器的状态（`kind == "video" | "audio"`；见 `src/mediaplay.rs`）。
    //   `media-playing` = 正在播；`media-progress` = 0..1；`media-time` = `0:03 / 0:12`。
    media-playing: bool,
    media-progress: float,
    media-time: string,
    // 动作行（`kind == "acts"`）对应的助手轮在**历史里的真实下标**（由 Rust 在收尾时定位，
    // 见 `syschat::last_assistant_index`）；其它 kind 恒 `-1`（无意义）。**不许**用负值当
    //「最后一条助手轮」的哨兵：两条同值哨兵会一起解析到同一轮（独立评审判 Critical）。
    turn: int,
}

// 卡 `abb-v11-message-actions`：**无行内样式**的消息文本用只读 `TextInput` 渲染。
//
// 为什么可行（实核，不是外推）：Slint 1.18 的 `TextInput.read-only` 文档原文是
// 「text editing via keyboard and mouse is disabled but **selecting text is still enabled**」
//（`i-slint-compiler-1.18.0/builtin_elements.rs:2320`）；且 `⌘C` / `⌘A` 在
// `i-slint-core/items/text.rs:1089`（`SelectAll`）/ `:1093`（`Copy`）两分支上**没有**
// `read_only` 守卫，紧随其后的 `Paste`（:1097）/ `Cut`（:1101）/ `Undo`/`Redo` 才有
// ——即 `read-only: true` 正是「可选不可改」。
//
// 观感零变化的前提：该块的 `StyledText` 本来就与纯文本逐字等价——由
// `mdblocks::selectable_plain` 判定（块内行内文本的字面量元字符都已转义 ⇒ 未转义元字符 =
// 真有样式；代码块原文不转义，单独按原样取用）。
component ConvoSelectableText inherits TextInput {
    in property <string> body;
    in property <length> avail: 100px;
    in property <length> size: 13px;
    in property <brush> tone: PixelTheme.text;
    // 稿 v15：用户消息靠右、怹的输出靠左（Rust 侧按轮次角色给）。
    in property <bool> align-right: false;
    horizontal-alignment: root.align-right ? right : left;
    read-only: true;
    // `single-line` 在 Slint 里**不管换行**（换行由下面的 `wrap` 决定）：它只改
    // 「多行文本按单行做垂直对齐」的 `baseline_y` 与省略号的判据
    //（`i-slint-core/textlayout.rs:233` / `:254`）。默认 `vertical-alignment: top` 下
    // 它与 `false` 逐像素一致（无头台实测 4 类块差异为 0），这里显式写 `false`
    // 只为表明意图：这是一个**多行**文本域（哪天改成居中对齐就不至于踩空）。
    single-line: false;
    // ⚠️ **这一行才是载荷**：`TextInput.wrap` 的默认值是 `no-wrap`，漏掉它长段落与
    // 多行代码块都会被压成一行（无头台 `selectable_blocks_render_same_height_as_legacy_element`
    // 会立刻红——这条做过负向实测）。
    wrap: word-wrap;
    text: root.body;
    font-size: root.size;
    color: root.tone;
    width: root.avail;
    selection-background-color: PixelTheme.accent;
    selection-foreground-color: PixelTheme.text;

    // 划词（类似飞书的划词菜单）：光标/选区一变就上报。
    // - 拖选过程中会连续触发；是否弹条由 Rust 侧**防抖**决定（见 ui.rs 的 on_text_selected）；
    // - 坐标 = 本元素在窗口里的绝对位置 + 光标在元素内的位置 ⇒ 工具条可贴着选区落位。
    cursor-position-changed(pos) => {
        TextSelection.moved(
            root.body,
            root.anchor-position-byte-offset,
            root.cursor-position-byte-offset,
            root.absolute-position.x + pos.x,
            root.absolute-position.y + pos.y,
        );
    }
}

// 等宽变体（代码块 / 思考块）：只多一行 `font-family`——不给非等宽块写空族名。
component ConvoSelectableMonoText inherits ConvoSelectableText {
    font-family: "ui-monospace, Menlo, Consolas, monospace";
}

// v11（卡 `abb-v11-panels-align`）：历史会话 / 模型列表面板的一行。
// `tag` = 右侧文字（当前/时间/provider）；`tick` = 当前项右侧画 ✓（模型面板用）。
// **一个结构体装两栏**（而不是两个平行数组）：配对关系由类型保证，不会因一处只更新
// 一个数组而错位。
export struct SysChatMenuRow {
    text: string,
    tag: string,
    tick: bool,
}

// v11（卡 `abb-v11-session-archive`）：会话面板的**文案**（普通视图 / 已归档视图两种）。
// 由 Rust 的 `syschat::session_panel_text` 算好写进来——文案里有「已归档（N）」这种**与列表
// 同源**的数字，写死在 `.slint` 就没法单测，也没法保证与列表一致。
export struct SessionPanelCopy {
    heading: string,
    foot: string,
    extra_text: string,
    extra_tag: string,
    extra2_text: string,
    extra2_tag: string,
}

// 待发附件 chip（D 批 3+N）：`index` 是它在**完整待发列表**里的下标——✕ 按它精确移除。
// Rust 侧已按折叠态裁好可见行，这里只负责画（图片缩略图 / 文件 chip）。
export struct PendingAttachRow {
    index: int,
    name: string,
    is-image: bool,
    thumb: image,        // 图片缩略图（未加载/失败时为空，走 thumb-ok=false 的字形回落）
    thumb-ok: bool,
    ext: string,         // 类型角标（PNG / PDF / ...）
}

// v11（卡 `abb-v11-popup-anchor`）：输入区功能钮在**窗口坐标**下的矩形。
// 为什么要让 Slint 报给 Rust：`crow` 整体右对齐，功能区左缘 = 输入框右缘 − 发送钮宽，而发送钮
// 宽随文案/字体变 ⇒ Rust 侧复算不出来；而面板落位的**算术**（贴按钮上方、靠窗边内移）必须可
// 单测 ⇒ 几何由这里给，算术留在 `syschat::pop_anchor`（纯函数）。
export struct PopBtnRect {
    x: length,
    y: length,
    w: length,
    h: length,
}

// 全局锚点气泡：常驻屏幕的系统级对话入口。
// 透明 + 无边框 + always-on-top；WindowMoveArea 负责拖动（带阈值：单击不移动），
// 单纯单击落到下层 TouchArea → open-chat。位置由 Rust 持久化（syschat/bubble.json）。
export component AnchorBubble inherits Window {
    title: "ABB";
    // 窗口 = **36px 可视气泡 + 四周各 4px 透明边距**（D 批）。
    // 留边距的原因：稿 `.bub` 悬停放大到 1.06（≈38.2px）、按下缩到 0.9 并加墨黑描边；
    // 窗口级裁剪关不掉，36px 窗口会把放大后的圆角裁平。位置记忆存的是**窗口**左上角，
    // 几何换算见 Rust `BUBBLE_INSET`（可视气泡 = 窗口内缩 4px）。
    // ⚠️ 透明边距由 Rust 按平台写（`set_inset`）：**Windows 上必须为 0**——
    // 那里 GL/透明合成不保证逐像素 alpha，4px 透明边距会被画成**黑色**，看着就是「气泡有黑边」
    //（owner 2026-10-17 真机反馈）。macOS 保持 4px（悬停放大 1.06 要这点余量）。
    in property <length> inset: 4px;
    // Windows 上没有余量 ⇒ 关掉悬停放大，否则 38.16px 会被 36px 窗口裁掉边缘。
    in property <bool> allow-scale: true;
    width: 36px + self.inset * 2;
    height: 36px + self.inset * 2;
    preferred-width: 36px + self.inset * 2;
    preferred-height: 36px + self.inset * 2;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <bool> busy: false;   // 回合进行中（透明反馈）
    // 按下态：由 `TouchArea.pointer-event` 驱动；窗口开始移动（`Moved`）时由 Rust 清掉——
    // 原生移动会吞掉 release，否则按下态会残留在气泡上（卡内明确要求）。
    in-out property <bool> pressed: false;
    callback open-chat();

    WindowMoveArea {
        // 底层全窗点击热区：WindowMoveArea 只处理「按住拖动超过阈值」的移动，
        // 普通单击仍会落到这里的 clicked（对齐 slint-pixel PixelTitleBar 的 native-move 语义）。
        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.pressed = true; }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    root.pressed = false;
                }
            }
            clicked => { root.open-chat(); }
        }
        // 按下态的墨黑描边（稿 `.bub:active` 的 `box-shadow: 0 0 0 2px edge`）：
        // 画在 36px 可视框上；图片缩到 0.9 后描边即露出。
        Rectangle {
            visible: root.pressed;
            x: root.inset;
            y: root.inset;
            width: 36px;
            height: 36px;
            background: transparent;
            border-width: 2px;
            border-color: #1c1a17;
            border-radius: 8px;
        }
        // 直接用**应用图标**当气泡（蓝色品牌色圆角方块，自带圆角与品牌色），
        // 不用主题 accent 填色——之前暖黄 accent 与蓝色图标撞色（owner 2026-10-13）。
        // 悬停放大 1.06 / 按下缩到 0.9（稿 `.bub:hover` / `.bub:active`）：用宽高缩放而不是
        // transform，避开子元素变换原点/裁剪的不确定性。
        Image {
            property <float> sc: root.pressed
                ? 0.9
                : ((root.allow-scale && touch.has-hover) ? 1.06 : 1.0);
            width: 36px * self.sc;
            height: 36px * self.sc;
            x: root.inset + (36px - self.width) / 2;
            y: root.inset + (36px - self.height) / 2;
            source: @image-url("../app-assets/icon-1024.png");
            image-fit: fill;
            opacity: root.busy ? 0.6 : 1.0;   // 回合进行中的轻反馈
        }
    }
}

// 齿轮字形（Path 手绘；见 `TitlebarIconButton` 的注释为什么不用 SVG/字形）
component GearGlyph inherits Rectangle {
    in property <brush> tint: PixelTheme.text;
    width: 16px;
    height: 16px;
    Path {
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.4px;
        fill: transparent;
        // 两段半弧拼成整圆（8,4.8)→(8,11.2) 右半 + 回程左半；3.2 = 半径。
        commands: "M 8 4.8 A 3.2 3.2 0 0 1 8 11.2 A 3.2 3.2 0 0 1 8 4.8 Z";
    }
    Path {
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 8 0.8 L 8 3.4 M 8 12.6 L 8 15.2 M 0.8 8 L 3.4 8 M 12.6 8 L 15.2 8 M 2.9 2.9 L 4.7 4.7 M 11.3 11.3 L 13.1 13.1 M 13.1 2.9 L 11.3 4.7 M 4.7 11.3 L 2.9 13.1";
    }
}


// 对话气泡字形（稿 v9 第 1 条：新建会话图标，14px、墨黑描边色）——只描边不填色。
// 与 `GearGlyph` 同口径：手绘 Path（字形/SVG 的不可靠性见 `TitlebarIconButton` 注释）。
component BubbleGlyph inherits Rectangle {
    in property <brush> tint: PixelTheme.text;
    width: 16px;
    height: 16px;
    Path {
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.5px;
        fill: transparent;
        // 圆角矩形气泡（1..15 × 2..11，圆角 2）+ 左下尾巴（5,11 → 5,13.5 → 7,11）。
        commands: "M 3 2 L 13 2 A 2 2 0 0 1 15 4 L 15 9 A 2 2 0 0 1 13 11 L 7 11 L 5 13.5 L 5 11 L 3 11 A 2 2 0 0 1 1 9 L 1 4 A 2 2 0 0 1 3 2 Z";
    }
}

// 标题栏图标钮（稿 `.tb-btn`）：26×26、2px 墨黑描边、hover 暖底。
// 图标为什么是 **Path** 而不是 `ImageIcon` + SVG：① 字形（`icon: string`）在本机字体对 ⚙ 这类
// 符号覆盖不可靠（排版审计 4656a34 踩过「⚠️ 渲染成空心方框」）；② SVG 靠图片解码器，
// Slint 的软件渲染后端（`SLINT_BACKEND=winit-software` 兜底排查路径）没有 SVG 解码器，
// 会把 0×0 图像喂给 `draw_image_impl` 直接 panic（本批无头渲染台实测：`Rect<f32>::cast::<i32>`
// 遇 NaN 直接 `unwrap()` 崩）——而 Path 是渲染器无关的。
component TitlebarIconButton inherits Rectangle {
    in property <string> tip: "";
    in property <bool> enabled: true;
    // 图形：false = ⚙设置（稿 `.tb-btn[data-m="4"]`）；true = 新建会话气泡图标
    //（稿 v9 第 1 条：同 logo 里那个气泡，14px、墨黑描边色）。
    in property <bool> bubble: false;
    callback clicked();
    width: 26px;
    height: 26px;
    opacity: root.enabled ? 1.0 : 0.5;
    background: hit.pressed ? PixelTheme.hover : (hit.has-hover ? PixelTheme.hover : PixelTheme.panel);
    border-width: 2px;
    border-color: PixelTheme.edge;
    border-radius: 6px;
    // 齿轮：中心圆环（两段半弧）+ 8 根辐条（轴 4 + 对角 4），16×16 居中。
    if !root.bubble: GearGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.bubble: BubbleGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    // `Tooltip.text` 是 styled-text：必须用 @markdown，插值要带反斜杠（同 ComposerIcon）。
    Tooltip { text: @markdown("\{root.tip}"); }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 标题栏「历史会话」图标钮（稿 v10：**只有 🗂 图标**，点开列历史会话、可随时切回继续聊）。
//
// 为什么不用 PixelMenu：它把 `button-text` 画在 `x: 10px; width: parent.width - 36px` 的文本格
// 里、右侧再留 26px 固定箭头格，26px 宽的图标钮根本放不下文案；稿也明确要求这一格「只要图标」。
//
// v11（卡 `abb-v11-panels-align`）：列表**不再是 `PopupWindow`**，而是窗内自绘的
// `MenuPanel`（标题 + 每项右侧 tag + footer，稿 `.menu`）。两个理由：
// ① `PopupWindow` 的 `close-policy: close-on-click-outside` 在**按下**就关，而按钮的
//    `clicked` 在**松开**才到 ⇒「再点按钮」只会重开、收不起来（卡 d9 已实测，同一结论）；
// ② 面板需要标题/footer/右侧 tag 这套结构，`PixelMenu` 撑不起。
component SessionIconButton inherits Rectangle {
    in property <bool> enabled: true;
    // 面板开着时钮保持按下观感（面板本体在 `SystemChatWindow` 末尾自绘）。
    in property <bool> open: false;
    callback clicked();
    width: 26px;
    height: 26px;
    opacity: root.enabled ? 1.0 : 0.5;
    background: root.open || hit.has-hover ? PixelTheme.hover : PixelTheme.panel;
    border-width: 2px;
    border-color: PixelTheme.edge;
    border-radius: 6px;
    // 🗂 是唯一依赖本机字形的图标（其余图标都是 Path）；它与输入区的 emoji 图标同风险档：
    // 系统字体有、无头软件渲染的测试字体可能画成 tofu（不影响布局与命中）。
    Text {
        width: 100%;
        height: 100%;
        text: "🗂";
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Tooltip { text: @markdown("历史会话（历史保留，可随时切回）"); }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// v11（稿 `.menu .item`）：面板里的一行 = 标题 + 右侧 tag/✓（当前项 accent 底）。
// 点击整行触发 `clicked()`（行内没有其它可点元素，不需要抽回调）。
component MenuChoiceRow inherits Rectangle {
    in property <string> text: "";
    // 右侧 tag（`当前` / 时间 / provider）；空 = 不画。
    in property <string> tag: "";
    // 当前项：右侧画 ✓（模型面板）且整行 accent 底（`.item.on`）。
    in property <bool> on: false;
    in property <bool> tick: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    opacity: root.enabled ? 1.0 : 0.5;
    background: root.on ? PixelTheme.accent : (hit.has-hover ? PixelTheme.hover : transparent);
    Text {
        x: 10px;
        // 右侧留出 tag/✓ 的位置（tag 是 auto 宽，从右往左算）。
        width: parent.width - 20px - right-item.width;
        height: 100%;
        text: root.text;
        font-size: 12px;
        color: root.on ? PixelTheme.on-accent : PixelTheme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    // 右侧 tag / ✓ 是**同一个**文本格：只有一份，避免两个 auto 宽元素互相推。
    right-item := Text {
        x: parent.width - 10px - self.width;
        height: 100%;
        text: root.tick ? "✓" : root.tag;
        font-size: root.tick ? 13px : 10px;
        font-weight: root.tick ? 800 : 400;
        color: root.on ? PixelTheme.on-accent : PixelTheme.dim;
        vertical-alignment: center;
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// v11（稿 `.menu`）：自绘面板 —— 标题（`h6`）+ 若干行 + 可选「🗄 归档…」行 + footer（`.foot`）。
// 宽 250px、2px 描边、8px 圆角、面板底/描边同主题；**高度由内容自然决定**（不写死，
// 否则行数变了会多出空白）。定位由调用方给（`x`/`y`，由 Rust 按 `menu_anchor` 算）。
component MenuPanel inherits Rectangle {
    in property <string> heading: "";
    in property <string> foot: "";
    in property <[SysChatMenuRow]> rows: [];
    in property <int> current: -1;
    // 额外行（历史会话面板用）：第 1 行随视图变义（普通 = 「🗄 归档…」/ 已归档 = 「← 返回」），
    // 第 2 行只普通视图有（「🗄 已归档（N）…」）。text 为空 = 不画。语义判据在 Rust。
    in property <string> extra-text: "";
    in property <string> extra-tag: "";
    in property <string> extra-text2: "";
    in property <string> extra-tag2: "";
    in property <bool> enabled: true;
    callback picked(int);
    callback extra-clicked();
    callback extra-clicked2();
    width: 250px;
    // 高度按内容自然高（`Window` 的直属子元素不写 height 会铺满整窗——实测 820 高）。
    height: self.preferred-height;
    background: PixelTheme.panel;
    border-width: 2px;
    border-color: PixelTheme.edge;
    border-radius: 8px;
    // 吃掉面板空白处的点击，别让它穿到后面的整窗 backdrop 上把面板关了。
    TouchArea { width: 100%; height: 100%; }
    VerticalLayout {
        // 2px = 面板自己的 border：Slint 的 `border-width` **不会**给子元素留内容盒，
        // 不写这个 padding 行背景会盖住面板描边（实测 accent 行会盖掉左右描边）。
        padding: 2px;
        spacing: 0px;
        // 标题（稿 `.menu h6{padding:8px 10px;font-size:10px;border-bottom:2px}`）
        Rectangle {
            height: 28px;
            background: PixelTheme.bg;
            // v11c：上两角必须跟**面板内圈**同半径（8 − 2 = 6）。
            // 为什么：`border-radius` 只裁面板自己的背景/描边，**不裁子元素**——标题这块不透明的
            // `--bg` 面是方形，正好盖掉面板上角的弧（描边被吃、看起来就是「圆角变方」）。
            border-top-left-radius: 6px;
            border-top-right-radius: 6px;
            Text {
                x: 10px;
                width: parent.width - 20px;
                height: 100%;
                text: root.heading;
                font-size: 10px;
                color: PixelTheme.dim;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { y: parent.height - 2px; width: 100%; height: 2px; background: PixelTheme.edge; }
        }
        for r[i] in root.rows: MenuChoiceRow {
            text: r.text;
            tag: r.tag;
            tick: r.tick;
            on: i == root.current;
            enabled: root.enabled;
            clicked => { root.picked(i); }
        }
        if root.extra-text != "": MenuChoiceRow {
            text: root.extra-text;
            tag: root.extra-tag;
            enabled: root.enabled;
            clicked => { root.extra-clicked(); }
        }
        if root.extra-text2 != "": MenuChoiceRow {
            text: root.extra-text2;
            tag: root.extra-tag2;
            enabled: root.enabled;
            clicked => { root.extra-clicked2(); }
        }
        // footer（稿 `.foot{padding:6px 10px;font-size:10px;border-top:2px}`）
        if root.foot != "": Rectangle {
            // 高度 = 文案**换行后**的真实高 + 上下各 6px。必须显式撑高：绝对定位的 Text 不参与
            // 父 Rectangle 的 preferred-height（实测：只写 `min-height` 时两行 footer 会被面板
            // 底边切掉一行）。
            height: foot-text.height + 12px;
            background: PixelTheme.bg;
            // v11c：下两角同标题（面板内圈半径 6），理由见上面标题那条注释。
            border-bottom-left-radius: 6px;
            border-bottom-right-radius: 6px;
            Rectangle { y: 0px; width: 100%; height: 2px; background: PixelTheme.edge; }
            foot-text := Text {
                x: 10px;
                y: 6px;
                width: parent.width - 22px;
                text: root.foot;
                font-size: 10px;
                color: PixelTheme.dim;
                wrap: word-wrap;
            }
        }
    }
}

// v11（稿 `.chipbtn.accent`）：模型 chip —— 只画 chip；列表由 `MenuPanel` 自绘
//（`PixelMenu` 没有 accent 面，也撑不起「标题 + footer + 当前项 ✓ / 其它项 provider」）。
component ModelChip inherits Rectangle {
    in property <string> text: "";
    in property <bool> open: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 26px;
    opacity: root.enabled ? 1.0 : 0.5;
    // 稿 `.chipbtn.accent{background:var(--accent)}`；开着时给 hover 底色作按下反馈。
    background: hit.has-hover ? PixelTheme.hover : PixelTheme.accent;
    border-width: 2px;
    border-color: PixelTheme.edge;
    border-radius: 6px;
    Text {
        x: 8px;
        width: parent.width - 26px;
        height: 100%;
        text: root.text;
        font-size: 12px;
        font-weight: 700;
        color: PixelTheme.on-accent;
        vertical-alignment: center;
        overflow: elide;
    }
    // 稿的 `.caret`（▾）。
    Text {
        x: parent.width - 16px;
        width: 12px;
        height: 100%;
        text: "▾";
        font-size: 9px;
        color: PixelTheme.on-accent;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    Tooltip { text: @markdown("选择模型（本会话生效）"); }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 输入区功能区图标钮（稿 `.ib{width:24px;height:24px;border:2px;border-radius:6px}`）：
// 24×24、2px 描边、6px 圆角；hover 变底、按下下沉 1px；图标文案不显示在按钮上，
// 而是作为 tooltip（owner 口径：图标 + 文案作 tooltip）。
// v10 位置：输入框**内**底部功能区的**一行**（右对齐：😊 📎 ✂ 🗑 ⋯），
// 不再有框外左竖排图标列（稿 v9 第 2 条）。
// 消息动作的**图标按钮**（稿 v14 `.acts .a`）：26×22、2px 边框、暖底、图标居中；
// 文案走 `Tooltip`——owner 口径「按钮上不要文字」。
component ActsIcon inherits Rectangle {
    in property <string> icon: "";
    in property <string> tip: "";
    callback clicked();
    width: 26px;
    height: 22px;
    background: hit2.has-hover ? PixelTheme.hover : PixelTheme.bg;
    border-width: 2px;
    border-color: PixelTheme.edge;
    border-radius: 6px;
    Text {
        width: 100%;
        height: 100%;
        text: root.icon;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit2 := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// 划词工具条的单颗按钮：小号、纯文字，hover 高亮。
component SelToolbarBtn inherits Rectangle {
    in property <string> caption: "";
    callback clicked;
    width: max(34px, txt.preferred-width + 14px);
    height: 26px;
    border-radius: 4px;
    background: hit.has-hover ? PixelTheme.hover : transparent;
    txt := Text {
        width: 100%;
        height: 100%;
        text: root.caption;
        font-size: 12px;
        color: PixelTheme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 划词工具条（类似飞书的划词菜单）：选中消息正文后浮在选区旁。
// 显隐/锚点由 Rust 写（拖选防抖后）；条外点击由根组件里的透明吸收层收起。
component SelectionToolbar inherits Rectangle {
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    // 可用宽（= 窗口宽）：组件定义里拿不到 `parent`，由实例处传。
    in property <length> avail-width: 0px;
    callback copy-clicked();
    callback quote-clicked();
    callback speak-clicked();
    callback close-clicked();

    width: bar.preferred-width;
    height: bar.preferred-height;
    background: PixelTheme.panel;
    border-width: 2px;
    border-color: PixelTheme.edge;
    border-radius: 8px;
    // 贴着选区：优先放上方 10px；上方不够就放下方；左右夹在窗内（8px 边距）。
    x: min(max(root.anchor-x - self.width / 2, 8px), root.avail-width - self.width - 8px);
    y: root.anchor-y > self.height + 18px
        ? root.anchor-y - self.height - 10px
        : root.anchor-y + 18px;

    bar := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        SelToolbarBtn { caption: "复制"; clicked => { root.copy-clicked(); } }
        SelToolbarBtn { caption: "引用"; clicked => { root.quote-clicked(); } }
        SelToolbarBtn { caption: "朗读"; clicked => { root.speak-clicked(); } }
        Rectangle { width: 1px; height: 100%; background: PixelTheme.edge; }
        SelToolbarBtn { caption: "×"; clicked => { root.close-clicked(); } }
    }
}

component ComposerIcon inherits Rectangle {
    in property <string> icon: "";
    in property <string> tip: "";
    in property <bool> enabled: true;
    // 开关型按钮（置顶）的选中态：accent 底，一眼看出当前是开还是关。
    in property <bool> active: false;
    callback clicked();
    // 24px（稿 `.ib`）。
    width: 24px;
    height: 24px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.5;
    face := Rectangle {
        x: hit.pressed ? 1px : 0px;
        y: hit.pressed ? 1px : 0px;
        width: parent.width;
        height: parent.height;
        background: root.active
            ? PixelTheme.accent
            : (hit.has-hover ? PixelTheme.hover : PixelTheme.panel);
        border-width: 2px;
        border-color: PixelTheme.edge;
        border-radius: 6px;
        Text {
            width: 100%;
            height: 100%;
            text: root.icon;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // `Tooltip.text` 是 styled-text：必须用 @markdown，插值要带反斜杠（Slint 语法），
        // 且插值实参按**纯文本**注入（不会被当 markdown 解析）。
        Tooltip { text: @markdown("\{root.tip}"); }
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 卡 d9：「更多」菜单里的一行（定时档位 / 取消全部）。左对齐、hover 变色，点击即触发。
component MenuRow inherits Rectangle {
    in property <string> text: "";
    callback clicked();
    height: 26px;
    background: hit.has-hover ? PixelTheme.hover : transparent;
    border-radius: 4px;
    Text {
        x: 8px;
        width: parent.width - 16px;
        height: 100%;
        text: root.text;
        font-size: 12px;
        color: PixelTheme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// D 批：待发附件右上角 ✕（稿 `.x`）——**只从待发列表移除，不删已落盘文件**。
component PendingRemoveBadge inherits Rectangle {
    callback remove();
    width: 17px;
    height: 17px;
    background: UiTokens.error;
    border-width: 2px;
    border-color: #ffffff;
    border-radius: 9px;
    Text {
        width: 100%;
        height: 100%;
        text: "✕";
        font-size: 9px;
        font-weight: 800;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.remove(); }
    }
}

// 系统级 AI 对话框：气泡点击后打开；关闭 = 隐藏（托盘应用惯例）。
export component SystemChatWindow inherits Window {
    // 与 SettingsWindow 同款主题预设（幂等；SettingsWindow 通常已设过一次，这里兜底）
    init => { PixelPresets.soft(); }

    title: "ABB 系统对话";
    no-frame: true;
    preferred-width: 520px;
    preferred-height: 560px;
    min-width: 340px;
    min-height: 380px;
    // **必须有显式的 max-\***（2026-10-15 实测定性）：本窗的子树里有一批**固定 px 宽**的元素
    // （消息块的 `convo-text-width` 一系、分割条/功能区等），Slint 由它们推出根布局的最大尺寸
    // ≈ preferred（520×560）⇒ 窗口的 `contentMaxSize` 就被钉在 520×560：
    // **只能缩小、不能放大**（请求 400×400 落地；请求 1470×923 / 700×700 全被夹回 —— 这就是
    // 「⤢ 无效／向外拖不动」的真正根因，跟 macOS/无边框/透明/跟随都无关）。设置窗的子树没有
    // 这种固定 px 组合，所以它一直正常。给一个远大于任何屏幕的上界即可解除夹取。
    max-width: 100000px;
    max-height: 100000px;
    // 圆角靠根 Rectangle 的两层填充画（外层黑 + 内层面板）；窗口本身透明，否则四角会露白。
    background: transparent;
    // 置顶（always-on-top）：**持久**状态，Rust 从 config.syschat_pinned 读入并回写。
    // 与「点托盘图标把窗口提到前台」区分：那是一次性置前，不改这个状态。
    always-on-top: root.pinned;
    in-out property <bool> pinned: false;

    in property <[SysChatBlockRow]> blocks: [];
    in property <bool> busy: false;
    in property <string> status-line: "与怹直接对话（系统级 · 整机权限）";
    in property <bool> status-is-error: false;
    // 请求滞底：Rust 每追加一条消息 / 打开对话框时递增它（处理见本组件末尾的 changed 处理器）。
    // **不能**改成给 content-y 绑一个「超大值」属性：绑了值后 Slint 就不再夹取
    //（flickable.rs:113-119 带 `!y.has_binding()`），越界值原样生效 ⇒ 消息区空白。
    in-out property <int> scroll-epoch: 0;
    // 流式每拍：**已贴底才跟随**（见文件末尾两个 changed 处理器的分工）。
    in-out property <int> follow-epoch: 0;
    // 「有新内容就贴底」（见 `scroll-epoch` 处理器）：请求过滞底就不再清零 —— v15 口径
    // 「生成中始终贴底」。用于 `content-height` 迟到（处理器先跑、布局后定高）时补跟。
    property <bool> stick-latch: false;
    // 输入框内容（与 PixelTextInput.text 双向绑定；发送后 Rust 置空）
    in-out property <string> draft: "";

    // 划词工具条（类似飞书）：选中消息正文后在选区旁浮出。
    // 可见性/坐标由 Rust 在**防抖后**写（拖选过程中不弹，见 ui.rs 的 on_text_selected）。
    // 面板（表情/会话/模型/更多）打开时临时不显示（见 `sel-toolbar-shown`），避免叠在一起。
    in-out property <bool> sel-toolbar-visible: false;
    in-out property <length> sel-toolbar-x: 0px;
    in-out property <length> sel-toolbar-y: 0px;
    property <bool> sel-toolbar-shown: root.sel-toolbar-visible
        && !root.emoji-open && !root.more-open
        && !root.session-menu-open && !root.model-menu-open;

    // D 批待发附件（3+N chips，稿 `.pending`）：`attach-count` = 完整待发数（>0 才渲染附件行），
    // `pending-rows` = Rust 按折叠态裁好的**可见**行（≤3 或展开后全部），`pending-more` = 折叠数 N。
    in property <int> attach-count: 0;
    in property <[PendingAttachRow]> pending-rows: [];
    in property <int> pending-more: 0;
    in property <string> pending-more-text: "";   // `+N` 文案由 Rust 拼（Slint int→string 拼接不可靠）
    in property <bool> pending-expanded: false;
    // C2 拖入高亮：由 Rust 从 winit 的 `HoveredFile` / `HoveredFileCancelled` 驱动。
    // 注意：成功 drop 后 winit **不发** `HoveredFileCancelled`（它只发 `concludeDragOperation:`，
    // 而 winit 那个方法不下发事件），所以「何时收起高亮」由 Rust 侧自己收尾（见 syschat::DropTracker）。
    in property <bool> drag-hover: false;

    // 会话 / 模型选择（A 批）：labels 给 ComboBox，选中索引由 Rust 回写；
    // 「模型选择」按**会话**生效，候选只来自「设置 → 供应商」。
    in property <[string]> session-labels: [];
    in property <[string]> model-labels: [];
    // v11（卡 `abb-v11-panels-align`）：两个自绘面板的数据/开关/锚点。
    // 行内容用 `SysChatMenuRow`（标题 + 右侧 tag/✓），Rust 侧与 labels 同一次刷新写入。
    in property <[SysChatMenuRow]> session-rows: [];
    in property <[SysChatMenuRow]> model-rows: [];
    // 面板开关：由 Rust 接线驱动（点按钮切换、点外部/选中项收起）。
    in-out property <bool> session-menu-open: false;
    in-out property <bool> model-menu-open: false;
    // 面板落位（窗口坐标）：由 Rust 按 `syschat::menu_anchor` 算（纯函数带单测）。
    in property <length> session-menu-x: 0px;
    in property <length> session-menu-y: 0px;
    in property <length> model-menu-x: 0px;
    in property <length> model-menu-y: 0px;
    // v11：状态栏右侧的上下文用量（稿 `.tok` + `.meter`）。
    // `usage-text` 由 Rust 格式化（K/M + 百分比）；`usage-meter-fill` 是进度条内条宽；
    // `usage-level` = 档位 0 正常 / 1 ≥70% 橙 / 2 ≥90% 红。
    // **数据来源待 E3**（卡 `abb-syschat-e3-tokens-20261013`）：当前如实传空档文案。
    in property <string> usage-text: "";
    in property <string> usage-tip: "";
    in property <length> usage-meter-fill: 0px;
    in property <int> usage-level: 0;
    // v11（卡 `abb-v11-session-archive`）：会话面板的三处动作。
    // `session-extra` = 面板第 1 额外行——**同一行两义**（普通视图「🗄 归档…」= 归档当前会话 /
    // 已归档视图「← 返回会话列表」），判据只在 Rust 一处；`session-extra2` = 「🗄 已归档（N）…」；
    // `session-menu-opened` = 面板被点开（Rust 复位到普通视图并刷新行）。
    in property <SessionPanelCopy> session-panel-copy: { heading: "", foot: "", extra_text: "", extra_tag: "", extra2_text: "", extra2_tag: "" };
    callback session-extra();
    callback session-extra2();
    callback session-menu-opened();
    in-out property <int> session-index: -1;
    in-out property <int> model-index: -1;

    // ── 稿 v10：标题栏内联控件（①新建会话 / ②历史会话 / ③模型 chip / ④⚙设置）──────
    // `PixelTitleBar` 是 slint-pixel 的封闭组件（不能塞子元素），所以这四件改成在根 Rectangle
    // 里、VerticalLayout **之后**叠一条控件条（后画 = 上层），靠右贴窗口按钮组左侧。
    // 位置/可见性/宽度由 Rust 计划算出后写进下面这几个属性（`crate::syschat::titlebar_plan`，
    // 纯函数带单测）；这里只负责画。**不要在 .slint 里重算**：那套「放不下就换档」的阶梯算术
    // 需要可负向验证的单测，而 GUI 观感无法自动断言。
    in property <length> titlebar-strip-x: -1px; // < 0 = 空档不够，整条不画
    // 标题文字（Rust 在窄窗时置空——控件让位优先于标题，见 `titlebar_plan`）。
    in property <string> titlebar-title: "ABB · 系统对话";
    in property <length> titlebar-session-w: 0px;   // 0 = 该项不画
    in property <length> titlebar-model-w: 0px;
    in property <length> titlebar-settings-w: 0px;
    // chip 显示文案（Rust 按 chip 宽截断；PixelMenu 内部 Text 不会 elide，长标题会画出框外）
    in property <string> titlebar-session-text: "";
    in property <string> titlebar-model-text: "";
    // 消息区正文块的**可用宽**（= 窗宽 − 根 padding 4 − col padding 24 − 块内 padding 16）。
    // **由 Rust 写**（`apply_syschat_layout`，同窗口宽变化一起更新），默认值仅供资源未就绪时兜底。
    // ⚠️ 为什么不让各文本直接绑 `root.width - …`：实测 Slint 编译器会报
    //    「binding loop: root.layoutinfo-h -> width -> … -> flick.max-width -> root.layoutinfo-h」
    //    （Window 的 width 与整窗布局信息互为一体）——**允许但已弃用、运行时可能 panic**。
    //    由 Rust 写成一个普通值就完全断开这个环，同时保留「估高不依赖横轴约束」这个关键点。
    in property <length> convo-text-width: 416px;
    // 窗口宽变化（首帧 realize / 缩放 / DPI 变化）→ 通知 Rust 重算计划。
    callback titlebar-width-changed(length);
    // 监视 root.width：`changed` 处理器在**值变化时**触发（含绑定重算导致的变化），
    // 所以首帧拿到真实宽度后一定能回调一次。Rust 侧对 width <= 0 会回落到 preferred-width。
    property <length> titlebar-watch: root.width;
    changed titlebar-watch => { root.titlebar-width-changed(titlebar-watch); }

    callback new-session();
    callback session-pick(int);
    callback model-pick(int);

    callback send(string);
    callback stop-streaming();   // ⏹ 停止：取消在途回合（Rust 侧发 external_cancel）
    callback toggle-think(int);  // 思考块展开/收起（E2）：参数是该块在 `blocks` 里的下标
    // 卡 `abb-v11-message-actions`：助手轮动作行（稿 v11.1 `.acts`）。
    // 参数是该助手轮的**真实历史下标**——文本/提示词由 Rust 在点击时按序号解析
    //（`syschat::action_target`，它拒绝任何越界/非助手轮/哨兵值），这样 Slint 侧不必搬正文。
    callback copy-turn(int);     // ⧉ 复制（整轮正文 → 系统剪贴板）
    callback regen-turn(int);    // ⟳ 重新生成（用该轮的用户提示重跑，落历史、可停止）
    callback speak-turn(int);    // 🔊/⏹ 朗读（macOS `say`；再点一次 = 停止）
    // 划词工具条：选中文本由全局 `TextSelection.moved` 直接交给 Rust（见 ui.rs），
    // 这里只声明工具条按钮的三个动作。
    callback sel-copy();         // 复制选中文字 → 系统剪贴板
    callback sel-quote();        // 引用到输入框（逐行加 `> `）
    callback sel-speak();        // 朗读选中文字
    // 正在朗读的助手轮序号：`-2` = 没有朗读在跑。**UI 状态哨兵**（与动作行的 `turn` 无关：
    // 真实下标从 0 起，-1 不会被当作合法轮号），由 Rust 写。
    // 名字不能叫 `speak-turn`：Slint 不允许 callback 与属性同名（`callback speak-turn(int)`
    // 会直接编译失败），所以属性用 `speaking-turn` 与回调区分开。
    in-out property <int> speaking-turn: -2;
    callback attach-pick();
    callback attach-clear();       // 清空待发列表（只清内存，不删已落盘文件）
    callback attach-remove(int);   // 按完整列表下标移除单个待发附件（✕）
    callback pending-toggle();     // 展开/收起 +N
    callback reset-history();
    callback toggle-pin();       // 置顶开关（持久：写 config.json，重启后保持）
    callback close-window();
    callback open-settings();   // ③ ⚙设置：唤起既有设置窗（D2 稿需求 #3）
    // 输入区占位按钮（稿 v9 第 2 条）：只剩 ✂ 截图仍是「有反馈的占位」——按下走既有
    // 状态行通道给一句「尚未实现」，不做成死按钮。参数 = 功能名。
    // （😊 表情与 ⋯ 更多在卡 d9 已做成真功能，见下面的属性/回调；截图需 macOS 屏幕录制
    //  TCC 授权 + 原生采集，另立卡，本卡只留占位。）
    callback composer-todo(string);

    // ── 卡 d9：表情面板 /「更多（定时）」菜单 ────────────────────────────────
    // 两个面板都是**窗口内 overlay**（根级、绝对定位在输入框上方，见本组件末尾），由这对
    // `in-out` 开关控制显隐。收起路径 = 面板外那层整窗透明 TouchArea（所以「点外部」与
    // 「再点按钮」都会收起——`PopupWindow` 的 close-on-click-outside 做不到，见末尾注释）。
    in-out property <bool> emoji-open: false;
    in-out property <bool> more-open: false;

    // ── v11（卡 `abb-v11-popup-anchor`）：`.pop` 面板的锚点 ─────────────────────
    // 稿 v11 第 1 条：「表情 / 更多 的面板必须**紧贴对应按钮上方**弹出」（此前锚在输入框顶边，
    // 底边离按钮有「待发附件行 + 文本区」那么高）。锚点算术在 `syschat::pop_anchor`（纯函数带
    // 单测，含「靠窗边整体内移、不出窗」）；这里只报几何、只画。
    // 输入（Slint → Rust）：两个功能钮的**窗口坐标矩形**（`crow` 整体右对齐 ⇒ Rust 算不出来）。
    // `changed` 只认单值属性 ⇒ 用一个几何指纹（`pop-watch`）触发回调，真矩形在实参里传。
    property <PopBtnRect> emoji-btn-rect: {
        x: emoji-btn.absolute-position.x,
        y: emoji-btn.absolute-position.y,
        w: emoji-btn.width,
        h: emoji-btn.height,
    };
    property <PopBtnRect> more-btn-rect: {
        x: more-btn.absolute-position.x,
        y: more-btn.absolute-position.y,
        w: more-btn.width,
        h: more-btn.height,
    };
    property <length> pop-watch: emoji-btn-rect.x + emoji-btn-rect.y + emoji-btn-rect.w
        + emoji-btn-rect.h + more-btn-rect.x + more-btn-rect.y + more-btn-rect.w
        + more-btn-rect.h + root.width + root.height + root.sched-count * 1px;
    changed pop-watch => {
        root.pop-anchor-changed(emoji-btn-rect, more-btn-rect, root.width, root.height);
    };
    callback pop-anchor-changed(PopBtnRect, PopBtnRect, length, length);
    // 输出（Rust → Slint）：面板的落位与尺寸（全由 Rust 写 ⇒ 与锚点算术同源；面板高随待发条数变，
    // 也由 `syschat::more_pop_h` 算）。
    in property <length> emoji-pop-x: 0px;
    in property <length> emoji-pop-y: 0px;
    in property <length> emoji-pop-w: 300px;
    in property <length> emoji-pop-h: 220px;
    in property <length> more-pop-x: 0px;
    in property <length> more-pop-y: 0px;
    in property <length> more-pop-w: 250px;
    in property <length> more-pop-h: 122px;

    // 表情面板：分组/分页的**状态与内容都由 Rust 算**（`emoji.rs` 纯函数带单测），这里只画。
    // `emoji-cells` = 当前页的格子（≤ 32 个，8 列 × 4 行）。
    in property <[string]> emoji-cats: [];
    in property <[string]> emoji-cells: [];
    in property <int> emoji-cat-index: 0;
    in property <string> emoji-page-label: "";
    in property <bool> emoji-prev-enabled: false;
    in property <bool> emoji-next-enabled: false;
    callback emoji-opened();   // 打开时让 Rust 重置分组/页码并刷新（文案随日期也不旧）
    callback emoji-cat(int);
    callback emoji-page(int);  // 参数 = 翻页方向（-1 / +1），由 Rust 夹取
    callback emoji-pick(string);

    // 「更多（⋯）」菜单：固定档位定时发送 + 待发列表（可逐条取消 / 全部取消）。
    in property <[string]> sched-preset-labels: [];
    in property <[string]> sched-items: [];
    in property <int> sched-count: 0;
    in property <string> sched-cancel-all-label: "";
    callback more-opened();
    callback sched-preset(int);
    callback sched-cancel(int);
    callback sched-cancel-all();
    // 无边框窗口缩放（同 SettingsWindow：`impl_resize_ui!` + `install_window_resize`）。
    // owner 2026-10-13：「窗口不能缩放的吗？」——此前对话窗没接缩放契约。
    callback begin-resize(string);
    // v11c：macOS 自管缩放的按下事件（热区给出**方向 + 指针的窗口坐标**，见 `ResizeZone`）。
    callback self-resize-begin(string, length, length);
    in-out property <bool> resize-hit-areas: false;
    // v11c：热区走哪条路径。`true` = macOS 自管（不用系统的 `drag_resize_window`），
    // `false` = Windows/Linux 的既有系统路径。由 Rust 按平台写。
    in property <bool> resize-self-managed: false;
    // 消息区几何的**只读观测面**（D2「底部文字重叠」定性的直接证据）：
    // 「内容高是否小于真实渲染高」在像素上量不出来（溢出部分被裁掉了），只能由窗口自报。
    // 消费者是`cargo test` 里的无头渲染台（`src/ui_headless_render_test.rs`，用软件渲染后端把本窗
    // 画到位图后断言）；**只读、无副作用**，不改生产行为。
    // 消息区是否已经贴底（Rust 侧决定「流式时要不要强制滞底」）：
    // 用户在生成中往上滚去看历史时，**不许**每个分片把他拽回底部（owner 2026-10-16：
    // 生成中滚动会白屏/被打断）。判据带 4px 容差，贴底时的亚像素差不影响。
    out property <bool> convo-at-bottom: flick.content-y
        >= flick.content-height - flick.height - 4px;
    out property <length> dbg-flick-y: flick.y;
    out property <length> dbg-flick-h: flick.height;
    out property <length> dbg-content-h: flick.content-height;
    out property <length> dbg-content-y: flick.content-y;
    out property <length> dbg-col-h: col.height;
    // 输入区几何的**只读观测面**（v10 对稿用；同 dbg-flick-* 的口径：只读、无副作用）：
    // 「zone padding 是不是 10 / 文本区是不是 66 / send 是不是 30 / 功能区是不是靠右同线」
    // 在像素上能量但受描边与抗锯齿干扰（2px 边框算不算在「盒」里差好几像素），
    // 布局的**真实值**由窗口自报，`ui_headless_render_test` 直接断言。
    out property <length> dbg-composer-x: composer.x;
    out property <length> dbg-composer-y: composer.y;
    out property <length> dbg-composer-w: composer.width;
    out property <length> dbg-composer-h: composer.height;
    out property <length> dbg-area-y: area.y;
    out property <length> dbg-area-h: area.height;
    out property <length> dbg-crow-y: crow.y;
    out property <length> dbg-crow-h: crow.height;
    out property <length> dbg-fnbar-x: fnbar.x;
    out property <length> dbg-fnbar-y: fnbar.y;
    out property <length> dbg-fnbar-w: fnbar.width;
    out property <length> dbg-fnbar-h: fnbar.height;
    out property <length> dbg-send-x: send-btn.x;
    out property <length> dbg-send-y: send-btn.y;
    out property <length> dbg-send-w: send-btn.width;
    out property <length> dbg-send-h: send-btn.height;
    // v11（卡 `abb-v11-popup-anchor`）：面板锚点用的**按钮矩形**观测面（无头出图台对稿用；
    // 同 dbg-* 口径：只读、无副作用）。面板自己的 x/y/w/h 是 in 属性，测试直接用 getter 读。
    out property <length> dbg-emoji-btn-x: root.emoji-btn-rect.x;
    out property <length> dbg-emoji-btn-y: root.emoji-btn-rect.y;
    out property <length> dbg-emoji-btn-w: root.emoji-btn-rect.w;
    out property <length> dbg-more-btn-x: root.more-btn-rect.x;
    out property <length> dbg-more-btn-y: root.more-btn-rect.y;
    out property <length> dbg-more-btn-w: root.more-btn-rect.w;
    // v11（卡 `abb-v11-resizable-split`）：分割条与两区的真实几何（同 dbg-* 口径）。
    // 「对稿」要量的东西：分割条夹在消息区与输入区**之间**、拖动改的是两区高度、输入区不被
    // 压到内容以下（待发附件行变高时消息区让位）。
    out property <length> dbg-split-y: split-bar.y;
    out property <length> dbg-split-h: split-bar.height;
    out property <length> dbg-convo-zone-y: composer-zone.y;
    out property <length> dbg-convo-zone-h: composer-zone.height;
    out property <length> dbg-flick-bottom: flick.y + flick.height;
    // v11（卡 `abb-v11-panels-align`）：面板与用量条的几何观测面（无头出图台对稿用；
    // 同 dbg-* 口径：只读、无副作用）。面板的 `x/width` 在**未展开**时取不到（元素不存在），
    // 所以这里报的是**算好的锚点值与常量宽**（面板宽 250 在 Rust 侧也有一份）。
    out property <length> dbg-session-menu-x: root.session-menu-x;
    out property <length> dbg-session-menu-y: root.session-menu-y;
    out property <length> dbg-model-menu-x: root.model-menu-x;
    out property <length> dbg-model-menu-y: root.model-menu-y;
    // 展开时的真实几何（未展开时为 0）——面板“高度由内容决定”这类事只能展开后量。
    out property <length> dbg-session-menu-w: root.session-menu-open && session-panel.width > 0px ? session-panel.width : 0px;
    out property <length> dbg-session-menu-h: root.session-menu-open && session-panel.height > 0px ? session-panel.height : 0px;
    // v11c：模型面板同样的观测面（面板高度跟内容走：行数/页脚行数不同 ⇒ 高度不同，
    // 不能拿会话面板的高去量它——角部像素判据要的是**自己的**高）。
    out property <length> dbg-model-menu-h: root.model-menu-open && model-panel.height > 0px ? model-panel.height : 0px;
    out property <length> dbg-usage-meter-w: usage-meter.width;
    out property <length> dbg-usage-meter-h: usage-meter.height;
    out property <length> dbg-usage-fill-w: usage-fill.width;
    // 第二行「模型 · 状态」是否在画（稿 `.status .st2 .l2`）——无头断言用。
    out property <bool> dbg-status-second-line: root.model-index >= 0 && root.model-index < root.model-labels.length;
    callback open-media(string);   // 音视频媒体卡：「用系统播放器打开」（保留给未知格式兜底）
    // 稿 v16：内联播放器的控制（播放/暂停、拖动进度）。参数 = 媒体地址（= 行里的 `src`）。
    callback media-toggle(string);
    callback media-seek(string, float);
    // 图片**右键 = 复制到系统剪贴板**（稿 v14：图片不做「打开」，右键才是复制）。
    callback copy-image(string);
    callback open-link(string);    // 图片 http 失败/普通链接：用浏览器打开
    // slint-pixel 标题栏契约（impl_title_bar_ui! 要求这四个回调存在）
    callback drag-start();
    callback minimize();
    callback toggle-maximize();

    Rectangle {
        width: 100%;
        height: 100%;
        // 与设置窗同款「外黑 10px 圆角 + 内面板 8px 圆角（内缩 2px）」两层填充 = 2px 描边且贴边
        //（设置窗注释：border-* 在 Windows 上不跟 border-radius 走，故用两层圆角填充）。
        // Windows 的角用 Rust 侧 apply_round_window_region 硬裁剪；半径必须同值（WINDOW_CORNER_RADIUS=10）。
        background: UiTokens.window-frame;
        border-radius: 10px;

        // 内层面板：内缩 2px、圆角 8px（= 10 − 2）。
        // 拖入时换底色（C2 拖放反馈）：只换内层面板色，不叠叠加层——叠加层会盖住内容且
        // 多一层命中面；面板色在暗/亮两套主题下都有定义（UiTokens.drop-bg）。
        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: root.drag-hover ? UiTokens.drop-bg : PixelTheme.panel;
            border-radius: 8px;
        }

        VerticalLayout {
            // 留 2px 让外层黑描边露出四周（铺满的子元素会把描边盖掉，同设置窗）
            padding: 2px;
            // 自绘标题栏：native-move（平台拖动，宿主无需 drag-start 接线）。
            // **v10（稿 v8 第 3 条）：恢复最大化** —— 三钮 `— ⤢ ✕`；窗口最小 340×380、可缩放，
            // 不再与尺寸绑定冲突（老口径「固定尺寸窗才关掉最大化」已作废）。
            // `show-maximize: true` 与 `syschat::TB_BTN_ZONE_W`（按三颗按钮预留 106px）
            // 的一致性由 `titlebar_plan_button_count_matches_show_maximize` 守着。
            //
            // 高度说明：`PixelTitleBar` 是**上游封闭组件**、内部固定 `height: 34px`，且那排窗口
            // 按钮是绝对定位 `y: 4px; height: 26px`（不随外框高度居中）。强行改成稿子的 38px
            // 只会让底部多 4px 空白、控件条（y: 6..32）看起来偏上；故保留 34px——标题栏项高
            // **仍是稿子的 26px**，且与窗口按钮严格同线（绝对 y 6..32）。
            PixelTitleBar {
                // 标题可用 Rust 置空（窄窗时给 ①②③④ 让位——控件比标题重要，且它们必须与
                // 最小化/最大化/关闭同在标题栏这一行）。
                title: root.titlebar-title;
                has-logo: true;
                logo: @image-url("../app-assets/icon-1024.png");
                native-move: true;
                show-maximize: true;
                // 标题栏是贴窗口上边的子元素，直角会盖掉根圆角 → 补等值内圈圆角（10 − 2 = 8）
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
                // ⚠️ 三颗窗口按钮的回调**必须逐个转发**：`PixelTitleBar` 是上游封闭组件，
                // 它只负责「画出按钮并回调自己的 minimize/toggle-maximize/close-window」，
                // **不会**自动冒泡到宿主组件。D6 真机 bug 就是这个：三钮里只有 close-window
                // 接了线，`—`/`⤢` 看起来在（布局在、墨迹在、点击也被吃掉成按下态）但点了没反应。
                // 守卫：`ui_headless_render_test::titlebar_window_buttons_receive_clicks`
                // （事件注入，按坐标点三颗按钮，断言各自回调都触发）+
                // `ui::tests::systemchat_forwards_every_title_bar_callback`（结构：四个都不许漏）。
                minimize => { root.minimize(); }
                toggle-maximize => { root.toggle-maximize(); }
                close-window => { root.close-window(); }
                // `drag-start` 在 `native-move: true` 时**由上游刻意不发**（移动交给平台，避免同一次
                // 拖动发起两遍）；这里仍接线，是为了「native-move 一旦关掉」时拖动不会静默失效
                // （SettingsWindow 就是这条路径：Rust `on_drag_start` → winit `drag_window()`）。
                drag-start => { root.drag-start(); }
            }

            // 标题栏底部分隔线（稿 `.titlebar{border-bottom:2px solid var(--edge)}`）：
            // `PixelTitleBar` 是上游封闭组件、自己不带底边，用一条 2px 子矩形补上（同状态行/
            // 输入区的做法）。放在标题栏与状态行**之间**，宽度由布局铺满（两端 2px 是窗口黑描边）。
            Rectangle { height: 2px; background: PixelTheme.edge; }

            // 状态行（稿 `.status{min-height:38px;padding:4px 12px}`）：**独立一行**、**两行文本**。
            // 稿 v7 起就是两行：第一行状态文案（ok 绿）+ 第二行 `<模型> · <就绪|正在回复…>`；
            // 右侧仍留给 token 占用（E3 批实现）。
            // 为什么是 `min-height` 而不是 `height`：稿子写的就是 `min-height`。`height` 只是
            // 布局的 preferred，窗口/内容吃紧时 VerticalLayout 可把它压向 min（min 默认 0）；
            // `min-height` 才是「不许矮于 38px」这个硬约束（修复前用旧 `HorizontalBox` 时，
            // 8px 默认 padding 把这一行撑到 52px；换成现代 Layout 后正常高度就是 38px）。
            Rectangle {
                min-height: 38px;
                background: PixelTheme.bg;
                // ⚠️ 用 `HorizontalLayout`/`VerticalLayout` 而**不是** `HorizontalBox`/`VerticalBox`：
                // 后者是 std-widgets 的旧别名，自带 `padding: StyleMetrics.layout-padding`（= 8px）。
                // 实测：它的 8px 会与显式 `padding-left` **叠加**（稿的 12px 生效成 20px），
                // 并且把本行撑高到 52px——直接破坏稿 `.status{min-height:38px;padding:4px 12px}`。
                // 本窗凡是要精确落位的容器一律用现代 Layout（默认 padding 0），边距自己写。
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.status-line;
                            font-size: 11px;
                            color: root.status-line != "" && root.status-is-error ? UiTokens.error : UiTokens.ok;
                            overflow: elide;
                        }
                        // 第二行「模型 · 状态」（稿 `.status` 是两行；此前只实现了第一行）
                        Text {
                            visible: root.model-index >= 0 && root.model-index < root.model-labels.length;
                            text: root.model-labels[root.model-index] + " · " + (root.busy ? "正在回复…" : "就绪");
                            font-size: 10px;
                            color: PixelTheme.dim;
                            overflow: elide;
                        }
                    }
                    // v11（卡 `abb-v11-panels-align`）：右侧上下文用量（稿 `.tok` + `.meter`）。
                    // 数据源：`syschat::context_usage()`（**待 E3 卡**，当前如实为空档）；
                    // 文案/百分比/档位都在 Rust 纯函数里算好（带单测），这里只负责画。
                    Text {
                        text: root.usage-text;
                        font-size: 11px;
                        color: PixelTheme.dim;
                        vertical-alignment: center;
                        Tooltip { text: @markdown("\{root.usage-tip}"); }
                    }
                    usage-meter := Rectangle {
                        width: 56px;
                        height: 9px;
                        // v11c（owner 真机复查）：用量条要与相邻文字（两行状态 + `.tok`）**垂直居中**。
                        // 为什么原来不居中：`HorizontalLayout` 的横轴对齐默认是 `stretch`，而本元素
                        // 有固定 `height: 9px` ⇒ `solve_box_layout_ortho` 给它的位置是**容器顶边**
                        // （`CrossAxisAlignment::Stretch => data.padding.begin`），于是它贴在 38px
                        // 状态行的最顶上（实测条身 y 38..46、行中心 57，偏上 ~14px）。
                        // 逐项覆盖即可（不动整行的 `cross-axis-alignment`，免得回退位的 chip 跟着变）。
                        cross-axis-self-alignment: center;
                        background: PixelTheme.panel;
                        border-width: 2px;
                        border-color: PixelTheme.edge;
                        border-radius: 3px;
                        // 内条贴内容盒（同稿 `.meter i{display:block;height:100%}`）并裁圆角。
                        clip: true;
                        usage-fill := Rectangle {
                            x: 2px;
                            y: 2px;
                            width: min(root.usage-meter-fill, 52px);
                            height: parent.height - 4px;
                            background: root.usage-level == 2 ? UiTokens.error : (root.usage-level == 1 ? UiTokens.warn : PixelTheme.accent);
                        }
                    }
                    // D2 回退位（窄窗才出现）：标题栏控件条放不下的项落在这里——
                    // 不静默丢功能，也绝不可能与窗口按钮重叠。
                    // 为什么要有它：标题栏控件条按**整个 106px 按钮区**让位（`TB_BTN_ZONE_W`）；
                    // 换档顺序见 `syschat::titlebar_plan`（先让 ⚙ → 再让模型 → 再让历史会话）。
                    // v10：历史会话在标题栏里只剩 26px 图标钮 ⇒ 让位判据改为 `titlebar-session-w <= 0`
                    // （旧版是「整条不画」`strip-x < 0`，因为那时会话 chip 是 84px、放不下就整条不画）。
                    if root.titlebar-session-w <= 0px && root.session-labels.length > 0: PixelMenu {
                        width: 84px;
                        height: 22px;
                        items: root.session-labels;
                        index <=> root.session-index;
                        button-text: root.titlebar-session-text;
                        enabled: !root.busy;
                        selected(i) => { root.session-pick(i); }
                    }
                    if root.titlebar-model-w <= 0px && root.model-labels.length > 0: PixelMenu {
                        width: 112px;
                        height: 22px;
                        items: root.model-labels;
                        index <=> root.model-index;
                        button-text: root.titlebar-model-text;
                        enabled: !root.busy;
                        selected(i) => { root.model-pick(i); }
                    }
                    if root.titlebar-settings-w <= 0px: TitlebarIconButton {
                        tip: "打开设置";
                        enabled: !root.busy;
                        clicked => { root.open-settings(); }
                    }
                    // 注：`清空对话` / `新建会话` / `附件` 都不在本行的回退位里——它们分别在
                    // 输入框功能区（🗑）与标题栏控件条（①新建会话 / 📎 在功能区），这里只兜底会话/模型/⚙。
                }
                // 底部分隔线（Rectangle 无 border-bottom-* 属性，用 2px 子矩形代替；稿
                // `.status{border-bottom:2px solid var(--edge)}`）。
                Rectangle {
                    y: parent.height - 2px;
                    width: 100%;
                    height: 2px;
                    background: PixelTheme.edge;
                }
            }

            // 消息区：贴底滚动；空态给一句引导
            // 对话内容：**单一内容区**（不是「一轮一个 box」），整体可滚动、新消息滞底。
            // 用裸 Flickable：ScrollView/PixelScrollPanel/ScrollBar 会给 content-y 加绑定，
            // 使 Slint 的「越界延迟夹取」失效（见本组件末尾 changed scroll-epoch 的注释）。
            // content-height 显式取内层列的自然高：不设时 Flickable 会把内容高当成视口高，
            // 超出一屏的内容被裁且滑不动（owner 2026-10-13「滚动不对」）。
            //
            // ⚠️ **消息区里每一个会换行的文本都必须带 px 宽绑定**（下面各处绑 `convo-text-width`）。
            // 为什么（D2 实测，两条证据）：
            //   1. `for b in root.blocks` 的每个子组件是被 `layout_item_info(Vertical, None)` 查询的
            //     （生成代码里就是 `None` —— 无横轴约束），无约束时换行文本按「整段一行」估高；
            //   2. `content-height: col.preferred-height` 就来自这条估计，于是内容高偏小 ⇒
            //      滞底夹取算不到底（最后几行掉到视口下方、被输入区盖住）+ 块间被挤压重叠。
            // 实测（无头渲染台，460 宽、13px 字号）：一个长段落估 96px / 真实 ~174px。
            // 给了 px 宽后估计不依赖约束，实测 96 → 174（= 真实），回归守卫见
            // `ui::headless_render::convo_bottom_not_clipped_by_composer`。
            // **同一坑的姊妹案例**：6871680（历史记录页「拉不到底」）就是同一机制。
            // 下面各处的减数 = 各级 padding 之和（块内基准 416 已在 Rust 里扣掉根+col padding），
            // 宁可略窄（估高偏大 ⇒ 最多底部多留空白），**不能偏宽**（偏宽就回到估高不足）。
            flick := Flickable {
                // 内容（迟到的）长起来后补跟底部：处理器先于布局跑时，`scroll-epoch` 那条算不出
                // 真值（`content-height` 还是 0）。赋值恒合法 ⇒ 与 Slint 的夹取不冲突。
                changed content-height => {
                    if (root.stick-latch) {
                        self.content-y = min(0px, self.height - self.content-height);
                        // 一次性：稳态跟随交给 `scroll-epoch`（生成中每分片都来一次），
                        // 免得你正往上翻的时候被「内容长高」拽回去。
                        root.stick-latch = false;
                    }
                }
                // 消息区高由 Rust 按分割条比例写（`syschat::split_convo_h`）；**不**用
                // `vertical-stretch: 1` —— 否则它会吃掉全部剩余高度，分割条拖动就没意义了。
                height: root.convo-h;
                vertical-stretch: 0;
                content-width: self.width;
                content-height: col.preferred-height;
                col := VerticalBox {
                    width: 100%;
                    padding: 12px;
                    spacing: 14px;
                    // 内容不足一屏时靠上排，不把消息拉高。
                    alignment: start;
                    if root.blocks.length == 0: Text {
                        text: "怹在这里，有什么可以帮你？\n\n怹（tān）：ABB 对 AI agent 的专称，表示非人对话主体，不表示怹有意识或人格。怹运行在本机，能直接读写文件、执行命令。";
                        font-size: 12px;
                        color: PixelTheme.text.with-alpha(0.5);
                        wrap: word-wrap;
                        width: root.convo-text-width + 16px;   // col 内（块外）= 块内可用宽 + 块内 padding 16
                        vertical-stretch: 0;
                    }
                    // 一块一元素（B 批：完整 markdown 渲染）。整个对话是一个内容区，
                    // 一轮 = 角色名块 + 若干内容块（无外框、无底色）。
                    for b[i] in root.blocks: VerticalBox {
                        width: 100%;
                        vertical-stretch: 0;
                        spacing: 2px;
                        if b.kind == "role": Text {
                            text: b.text;
                            font-size: 11px;
                            font-weight: 700;
                            color: b.role-assistant ? UiTokens.info : PixelTheme.text.with-alpha(0.5);
                            width: 100%;
                            horizontal-alignment: b.align-right ? right : left;
                        }
                        // 思考块（E2 需求 #11）：独立成块、默认折叠，标题显示耗时；展开看推理
                        //（等宽、保留换行）。进行中的思考块自动展开（让打字机可见）。
                        // 思考块（稿 v15）：**默认关闭**（生成中也不自动展开）；关闭态只有标题一行，
                        // 生成中在标题下方给一个**一行高的滚动窗口**看最新思考；展开后正文**最多 10 行**，
                        // 超出块内滚动并贴底。
                        if b.kind == "think": Rectangle {
                            width: 100%;
                            background: PixelTheme.bg;
                            // 稿 `details.think{border:2px solid #d9cdb4}`：**浅暖灰** 2px，不是墨黑边。
                            // （展开态的 `border-top:2px dashed #e2d7bf` 做不了：Slint 无 dashed 边框，见 §6）
                            border-width: 2px;
                            border-color: #d9cdb4;
                            border-radius: 6px;
                            VerticalBox {
                                // 几何口径（owner 2026-10-16）：**标题带自己带高与内边距**，外层不再给
                                // padding/spacing——`padding 6 + 标题 18 + spacing 4 + 虚线 2` 那种拼法
                                // 一旦布局多摊一点空间就把标题行拉高、虚线整体下沉（「虚线与顶部的高度太大」）。
                                // 现在：标题带 26px（= 折叠态卡片的内高，上下描边各 2px ⇒ 卡片总高 30px），
                                // 「思考」垂直居中；虚线紧随其后（spacing 0）⇒ 它的位置**正好落在折叠态的下边缘**。
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-bottom: 6px;
                                spacing: 0px;
                                alignment: start;
                                Rectangle {
                                    width: 100%;
                                    height: 26px;
                                    background: transparent;
                                    Text {
                                        // 文案按设计稿（唯一视觉事实源）：`思考 · 用时 3.2s`；
                                        // 思考进行中写 `思考中`（不带用时，避免跳动）。
                                        text: (b.think-expanded ? "▾ " : "▸ ")
                                            + (b.think-live ? "思考中" : "思考")
                                            + (b.think-elapsed == "" ? "" : " · 用时 " + b.think-elapsed);
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        color: UiTokens.text-dim;
                                        vertical-alignment: center;
                                        // 稿的 `summary{display:flex;gap:6px}` = **左对齐**（实测不写会居中）。
                                        horizontal-alignment: left;
                                        width: 100%;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-think(i); }
                                    }
                                }
                                // 稿 `details.think .body{border-top:2px dashed …}`：展开态标题与正文
                                // 之间那条**虚线**。Slint 没有 dashed 边框（§6），用一排小块拼：
                                // 每块 `horizontal-stretch: 1` ⇒ 无论块多宽都铺满，缝宽固定 4px。
                                // ⚠️ 颜色不能照抄稿的 `#e2d7bf`：它和卡片暖底几乎同色，**真机上看不见**
                                //（owner 2026-10-16 反馈「思考下面没有虚线」）⇒ 用卡片描边同色 `#d9cdb4`。
                                if b.think-expanded: HorizontalBox {
                                    width: 100%;
                                    height: 2px;
                                    spacing: 4px;
                                    // Slint 的重复语法：整数当模型（`for i in 20`），不是 range。
                                    for _i in 20: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 2px;
                                        background: #d9cdb4;
                                    }
                                }
                                // 正文窗口：展开（最多 10 行）或生成中（一行滚动的打字机窗口）。
                                // 用 `Text`（不是 `TextInput`）：要放进 Flickable 做块内滚动，
                                // 代价是思考文字不再可拖选（正文与整轮的复制不受影响）。
                                // ⚠️ 不要再套一层 `Rectangle` 去引用 Flickable 的 height —— 那会形成
                                // `width → layoutinfo-h → …` 绑定环（编译器警告「可能 panic」）。直接
                                // 把 Flickable 当块，文本宽用 **px**（`convo-text-width`，见消息区顶部注释）。
                                // ⚠️ **必须有这层裁剪用的 `Rectangle`**：① Slint 的 `clip` 默认是
                                // **false**（`builtin_elements.rs`：「clip: false; the default」），
                                // 不裁的话「最多 10 行」的正文会**整段画出来、溢出卡片**（owner 2026-10-16
                                // 真机截图）；② `clip` **只能给 Rectangle/Path**，给 Flickable 直接编译报错。
                                // 高度用 `think-txt.preferred-height`（文本宽是 px，不成环、估高也准），
                                // **不要**引用 `think-flick.height`——那会成绑定环（踩过）。
                                if b.think-expanded || b.think-live: Rectangle {
                                    width: 100%;
                                    // 正文行与虚线之间**显式留白**（owner：先要 5px、再说「再上移 10px」
                                    // ⇒ 合计 15px）。做法是把留白做进容器高 + `Flickable.y`，**不用 spacer
                                    // 子项**（spacer 会被行高吃掉、实测无效），也不用给布局子项写 `y`
                                    // （布局会覆盖它）——所以改的是「文字下移多少」。
                                    // ⚠️ Slint **不许同时写 `height` 与 `max-height`** ⇒ 用
                                    // `min-height` + `max-height` 同一表达式把高度**钉死**：
                                    // 这样既定「画多大」，又把布局问的 **preferred** 夹回真实可见高。
                                    min-height: (b.think-expanded
                                        ? min(think-txt.preferred-height + 2px, 10 * 16px)
                                        : 16px) + 15px;
                                    // ⚠️ **必须同时给 `max-height`**：`height` 只定「画多大」，布局问的是
                                    // **preferred**，而里面那个 `Flickable` 的 preferred 会带上
                                    // `content-height`（= 整段思考文本的高）⇒ 这个容器会**虚报高度**
                                    //（实测：布局相信 512px、真实内容只到 450px；思考越长报得越多）。
                                    // 后果就是 owner 反复报的**白屏**：滞底把 `content-y` 夹到
                                    // 「虚报出来的底部」，而那里什么都没有 ⇒ 消息区整片空白
                                    //（状态行还在「正在思考」）。`max-height` 把 preferred 钉回真实可见高。
                                    max-height: (b.think-expanded
                                        ? min(think-txt.preferred-height + 2px, 10 * 16px)
                                        : 16px) + 15px;
                                    clip: true;
                                    background: transparent;
                                    think-flick := Flickable {
                                        y: 15px;
                                        width: 100%;
                                        height: b.think-expanded
                                            ? min(think-txt.preferred-height + 2px, 10 * 16px)
                                            : 16px;
                                        content-width: self.width;
                                        content-height: think-txt.preferred-height + 2px;
                                        // 没展开时那 1 行窗口不需要用户去滚（它就是看最新一行的）。
                                        interactive: b.think-expanded;
                                        // ⚠️ 这里以前也是「写 `-999999px` 让 Slint 夹取」——**同一个失效模式**
                                        // （夹取不发生 ⇒ content-y 停在越界值 ⇒ 窗口里什么都不显示）。owner 第 2 条
                                        // 「思考过程没有打字机效果 / 没滚到底部」就是这么来的。直接给真实底部
                                        // （Slint 约定：往下为**负**，到底 = height − content-height）：
                                        // - 生成中思考一直在长 ⇒ 每次变高都重新贴底 ⇒ 一行窗里滚动的就是**最新一行**
                                        //   （要能看到「正在打」的效果）；
                                        // - **展开/折叠不主动滚**（owner 2026-10-16 修正：点开就是「自然展开」，
                                        //   不要顺手跳到底部；展开后用户自己滚）。
                                        init => {
                                            if b.think-live {
                                                self.content-y = min(0px, self.height - self.content-height);
                                            } else {
                                                self.content-y = 0px;
                                            }
                                        }
                                        changed content-height => {
                                            if b.think-live {
                                                self.content-y = min(0px, self.height - self.content-height);
                                            }
                                        }
                                        think-txt := Text {
                                            x: 0px;
                                            width: root.convo-text-width - 12px;
                                            text: b.text;
                                            font-size: 12px;
                                            color: UiTokens.text-dim;
                                            font-family: "ui-monospace, Menlo, Consolas, monospace";
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                        if b.kind == "h1" && b.selectable: ConvoSelectableText {
                            align-right: b.align-right;
                            body: b.plain;  avail: root.convo-text-width;  size: 18px;
                        }
                        if b.kind == "h1" && !b.selectable: StyledText {
                            width: root.convo-text-width;   // 见本区顶部注释
                            horizontal-alignment: b.align-right ? right : left;
                            text: b.styled;
                            default-font-size: 18px;
                            default-color: PixelTheme.text;
                            link-color: UiTokens.info;
                            link-clicked(link) => { root.open-link(link); }
                        }
                        // 字号按稿 `.md h2{font-size:15px}`（旧值 16px）。
                        if b.kind == "h2" && b.selectable: ConvoSelectableText {
                            align-right: b.align-right;
                            body: b.plain;  avail: root.convo-text-width;  size: 15px;
                        }
                        if b.kind == "h2" && !b.selectable: StyledText {
                            width: root.convo-text-width;   // 见本区顶部注释
                            horizontal-alignment: b.align-right ? right : left;
                            text: b.styled;
                            default-font-size: 15px;
                            default-color: PixelTheme.text;
                            link-color: UiTokens.info;
                            link-clicked(link) => { root.open-link(link); }
                        }
                        if b.kind == "h3" && b.selectable: ConvoSelectableText {
                            align-right: b.align-right;
                            body: b.plain;  avail: root.convo-text-width;  size: 14px;
                        }
                        if b.kind == "h3" && !b.selectable: StyledText {
                            width: root.convo-text-width;   // 见本区顶部注释
                            horizontal-alignment: b.align-right ? right : left;
                            text: b.styled;
                            default-font-size: 14px;
                            default-color: PixelTheme.text;
                            link-color: UiTokens.info;
                            link-clicked(link) => { root.open-link(link); }
                        }
                        if b.kind == "code": Rectangle {
                            width: 100%;
                            background: #1c1a17;
                            border-radius: 6px;
                            VerticalBox {
                                spacing: 2px;
                                if b.lang != "": Text {
                                    text: b.lang;
                                    font-size: 10px;
                                    color: #b9ae97;
                                }
                                // 代码块永远是纯文本（没有行内样式）⇒ 恒可选中。
                                // 可用宽 = 块内 416 − 代码框内层 VerticalBox 的左右 padding 16
                                if b.selectable: ConvoSelectableMonoText {
                                    align-right: b.align-right;
                                    body: b.plain;  avail: root.convo-text-width - 16px;
                                    size: 12px;  tone: #f6efe1;
                                }
                                if !b.selectable: Text {
                                    text: b.text;
                                    font-size: 12px;
                                    color: #f6efe1;
                                    horizontal-alignment: b.align-right ? right : left;
                                    font-family: "ui-monospace, Menlo, Consolas, monospace";
                                    wrap: word-wrap;
                                    width: root.convo-text-width - 16px;
                                }
                            }
                        }
                        if b.kind == "quote": Rectangle {
                            width: 100%;
                            background: PixelTheme.bg;
                            // 稿 `.md blockquote{border-left:4px solid var(--accent);
                            // border-radius:0 6px 6px 0}`：**只圆右侧两角**（左侧贴着强调条）。
                            border-radius: 6px;
                            border-top-left-radius: 0px;
                            border-bottom-left-radius: 0px;
                            HorizontalBox {
                                padding-left: 10px;
                                spacing: 0px;
                                Rectangle { width: 4px; background: PixelTheme.accent; }
                                // 可用宽 = 块内 416 − 左 padding 10 − 强调条 4 − 右 padding 8
                                if b.selectable: ConvoSelectableText {
                                    align-right: b.align-right;
                                    body: b.plain;  avail: root.convo-text-width - 22px;
                                    size: 13px;  tone: UiTokens.text-dim;
                                }
                                if !b.selectable: StyledText {
                                    width: root.convo-text-width - 22px;
                                    horizontal-alignment: b.align-right ? right : left;
                                    text: b.styled;
                                    default-font-size: 13px;
                                    default-color: UiTokens.text-dim;
                                    link-color: UiTokens.info;
                                    link-clicked(link) => { root.open-link(link); }
                                }
                            }
                        }
                        if b.kind == "list" || b.kind == "task": HorizontalBox {
                            padding-left: b.level * 16px;
                            spacing: 6px;
                            Text {
                                text: b.marker;
                                font-size: 13px;
                                color: PixelTheme.text;
                            }
                            // 可用宽 = 块内 416 − 缩进 level×16 − 间距 6 − 右 padding 8 − 标记位（≤20，取保守）
                            if b.selectable: ConvoSelectableText {
                                align-right: b.align-right;
                                body: b.plain;
                                avail: root.convo-text-width - b.level * 16px - 34px;
                                size: 13px;
                            }
                            if !b.selectable: StyledText {
                                width: root.convo-text-width - b.level * 16px - 34px;
                                horizontal-alignment: b.align-right ? right : left;
                                text: b.styled;
                                default-font-size: 13px;
                                default-color: PixelTheme.text;
                                link-color: UiTokens.info;
                                link-clicked(link) => { root.open-link(link); }
                            }
                        }
                        // 表格（2026-10-15 重做，**整表一个块**）：
                        // 旧版（`4bb9cbb`）一行一个 Flickable、每列固定 `max(均分,132px)` ⇒
                        //   ① 窄内容列也占 132px 起，列间距巨大；② 每行各自横滑、互不同步；
                        //   ③ 左侧仍有 ~30px 被裁。
                        // 现在：列宽由 Rust 按内容估（`b.col-ws`）⇒ 短列收窄、长格换行；整表只放
                        // **一个** Flickable，所有列一起滑；行高由该行最高格决定（用命名元素算高度，
                        // 别指望裸 `Rectangle` 会被子 `Text` 撑高——图片块就是这么静默少报高度的）。
                        if b.kind == "table": Flickable {
                            width: 100%;
                            // preferred- 而不是 .width/.height 参与 content-*（与附件行同款，
                            // 避免「Flickable ⇄ 子布局」互相求值成环）。
                            height: tbl-grid.preferred-height;
                            content-width: tbl-grid.preferred-width;
                            content-height: tbl-grid.preferred-height;
                            interactive: true;
                            tbl-grid := VerticalBox {
                                spacing: 0px;
                                alignment: start;
                                // 表格线（稿 v19）：**外框粗、内部细**（owner：「现在颠倒了」——
                                // 每格四周都画 1px 时，相邻两格叠出内侧 2px，外沿反而只有 1px）。
                                // 口径：**每条边界只画一次**——格子只画「右边 + 下边」（1px），
                                // 四个外沿另按行列位置叠 2px。
                                for trow[ri] in b.table-rows: HorizontalBox {
                                    spacing: 0px;
                                    height: trow.row-h;
                                    for cell[ci] in trow.cells: Rectangle {
                                        width: b.col-ws[ci];
                                        height: trow.row-h;
                                        background: trow.header ? PixelTheme.bg : transparent;
                                        // 内线：右边（末列加粗成外框 2px）
                                        if ci == b.col-ws.length - 1: Rectangle {
                                            x: parent.width - 2px;
                                            width: 2px;
                                            height: 100%;
                                            background: PixelTheme.edge;
                                        }
                                        if ci < b.col-ws.length - 1: Rectangle {
                                            x: parent.width - 1px;
                                            width: 1px;
                                            height: 100%;
                                            background: PixelTheme.edge;
                                        }
                                        // 内线：下边（末行加粗成外框 2px）
                                        if ri == b.table-rows.length - 1: Rectangle {
                                            y: parent.height - 2px;
                                            width: 100%;
                                            height: 2px;
                                            background: PixelTheme.edge;
                                        }
                                        if ri < b.table-rows.length - 1: Rectangle {
                                            y: parent.height - 1px;
                                            width: 100%;
                                            height: 1px;
                                            background: PixelTheme.edge;
                                        }
                                        // 外框：首行上边 / 首列左边（2px）
                                        if ri == 0: Rectangle {
                                            y: 0px;
                                            width: 100%;
                                            height: 2px;
                                            background: PixelTheme.edge;
                                        }
                                        if ci == 0: Rectangle {
                                            x: 0px;
                                            width: 2px;
                                            height: 100%;
                                            background: PixelTheme.edge;
                                        }
                                        // 单元格内容（Rust 侧 `inlineflow` 排好的片段，绝对定位）
                                        for p in trow.flows[ci]: Rectangle {
                                            x: 5px + p.x;
                                            y: 4px + p.y;
                                            width: p.w;
                                            height: p.h;
                                            if !p.is-math: Text {
                                                text: p.text;
                                                font-size: 12px;
                                                color: PixelTheme.text;
                                                wrap: no-wrap;
                                            }
                                            if p.is-math: Image {
                                                source: p.img;
                                                width: 100%;
                                                height: 100%;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if b.kind == "hr": Rectangle {
                            width: 100%;
                            height: 2px;
                            background: PixelTheme.edge;
                        }
                        // 数学（块级 `$$…$$`）：**真排版**（KaTeX 的 Rust 移植，见图 `src/mathrender.rs`）。
                        // 失败时（`img-ok` 假）回落等宽源码：公式排不出来最多不好看，**不能少字**。
                        // 行内公式仍走行内码（`.slint` 的文字流里放不进图片，见 mathrender 顶注）。
                        if b.kind == "math" && b.img-ok: Rectangle {
                            width: 100%;
                            // 自然尺寸显示；过宽时等比缩到气泡内（`img-aspect` = 高/宽）。
                            height: math-img.height + 12px;
                            // 稿 v15：公式块**不要独立底色**（与消息区一致）——以前是暖黄，看起来发黄。
                            background: transparent;
                            border-radius: 6px;
                            math-img := Image {
                                source: b.img;
                                width: min(b.img-w, root.convo-text-width - 16px);
                                height: self.width * b.img-aspect;
                                x: (parent.width - self.width) / 2;
                                y: 6px;
                                image-fit: contain;
                            }
                        }
                        // 排版失败/markdown 里混了非法 TeX ⇒ 等宽显示原始 TeX（至少不丢内容）。
                        if b.kind == "math" && !b.img-ok: Rectangle {
                            width: 100%;
                            height: math-txt.preferred-height + 16px;
                            background: transparent;
                            border-radius: 6px;
                            math-txt := Text {
                                x: 8px;
                                width: root.convo-text-width - 16px;
                                text: b.text;
                                font-family: "ui-monospace, Menlo, Consolas, monospace";
                                font-size: 12.5px;
                                color: PixelTheme.text;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        // 图片（2026-10-15 修）：裸 `Rectangle` 不会被子 `Image` 撑高（实测该块只向
                        // 布局报 ~30px，图片却实画 ~200px ⇒ 后面的文字被图片盖住、滞底也算不到底）。
                        // 现在高度显式由「视口宽 × 源宽高比」算，夹在 [120, 360]；未知比例回落 200px。
                        // 设计稿 `.media img{width:100%;height:auto}` 的口径 = 按比例、不裁剪（contain）。
                        // 图片（2026-10-16 owner 口径）：**遵守 markdown 规范**——只有图本身，
                        // 无边框、无 caption、无「打开」按钮；**右键 = 复制图片**（左键不做事）。
                        // 高度仍按「视口宽 × 源宽高比」显式算（裸容器不会被 `Image` 撑高）。
                        if b.kind == "image" && b.img-ok: Rectangle {
                            width: 100%;
                            height: max(
                                120px,
                                min(360px, root.convo-text-width * b.img-aspect)
                            );
                            background: transparent;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: b.img;
                                image-fit: contain;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(e) => {
                                    // Slint 1.18 没有 `right-clicked`，只能看 `pointer-event` 的 button/kind。
                                    if e.button == right && e.kind == up {
                                        root.copy-image(b.src);
                                    }
                                }
                            }
                            Tooltip { text: @markdown("右键复制图片"); }
                        }
                        // 加载不出来（路径不存在 / 远程还没下好）：只给一行**提示**，不可点（不提供「打开」）。
                        if b.kind == "image" && !b.img-ok: Rectangle {
                            width: 100%;
                            height: 20px;
                            background: transparent;
                            Text {
                                text: "🖼 " + b.alt + "（图片打不开）";
                                width: 100%;
                                font-size: 12px;
                                color: UiTokens.text-dim;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        // 音视频（稿 v15）：**不做卡片、不做按钮**——只给一行可点的提示，
                        // 点击用系统播放器打开。Slint 没有 `audio`/`video` 元素（§6），
                        // 内联播放做不到；但「带边框的卡片 + 按钮」显然与 markdown/设计稿不符。
                        // 音视频（稿 v16）：**内联播放器卡片**——封面/画面 + 控件 + 说明条。
                        // Slint 没有 audio/video 元素（§6）：播放由 `src/mediaplay.rs` 用本机
                        // ffmpeg（视频逐帧流）与 ffplay/afplay（音频）驱动，帧以 RGBA 交给这里。
                        // 音视频（稿 v16/v17）：**内联播放器**。
                        // · 视频 = 封面/画面 + 中央 ▶ + 控件条（▶/⏸ + 进度 + 时间）+ 说明条；
                        // · 音频 = **只要一个播放/暂停钮 + 名称**（owner 口径：音频不必有进度条）。
                        // Slint 没有 audio/video 元素：播放由 `src/mediaplay.rs` 用本机 ffmpeg/ffplay
                        // 驱动，帧以 RGBA 交给这里。
                        // ⚠️ 卡片内部**不要靠 preferred-宽推算**（`horizontal-stretch` / 裸容器）：
                        // 最大化后消息区变宽时那样的宽度不会跟着走（owner 2026-10-16 真机截图：
                        // 音频卡不铺满、视频卡反而更宽）。可见宽一律写成 `convo-text-width` 的表达式。
                        if b.kind == "video": Rectangle {
                            width: 100%;
                            height: video-col.preferred-height;
                            border-width: 2px;
                            border-color: PixelTheme.edge;
                            border-radius: 6px;
                            background: PixelTheme.bg;
                            video-col := VerticalBox {
                                spacing: 0px;
                                // 画面（封面 / 当前帧）。
                                Rectangle {
                                    width: 100%;
                                    height: b.img-ok
                                        ? max(120px, min(320px, root.convo-text-width * b.img-aspect))
                                        : 120px;
                                    background: #1c1a17;
                                    if b.img-ok: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: b.img;
                                        image-fit: contain;
                                    }
                                    if !b.img-ok: Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "🎬";
                                        font-size: 26px;
                                        color: #f6efe1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    if !b.media-playing: Rectangle {
                                        width: 46px;
                                        height: 46px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2;
                                        background: #ffc61ad9;
                                        border-width: 2px;
                                        border-color: PixelTheme.edge;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "▶";
                                            font-size: 20px;
                                            color: PixelTheme.text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.media-toggle(b.src); }
                                    }
                                }
                                // 控件条：▶/⏸ + 进度条（**显式宽**）+ 时间。
                                HorizontalBox {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 8px;
                                    Text {
                                        text: b.media-playing ? "⏸" : "▶";
                                        font-size: 13px;
                                        color: PixelTheme.text;
                                        vertical-alignment: center;
                                    }
                                    // 进度条宽 = 卡片内可用宽 − ▶(14) − 时间(56) − 三段 spacing(24)；
                                    // 用显式宽而不是 `horizontal-stretch`（见上面 ⚠️）。
                                    Rectangle {
                                        width: max(40px, root.convo-text-width - 110px);
                                        height: 8px;
                                        background: PixelTheme.panel;
                                        border-width: 2px;
                                        border-color: PixelTheme.edge;
                                        border-radius: 3px;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 100%;
                                            width: (parent.width - 4px) * b.media-progress;
                                            background: PixelTheme.accent;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.media-seek(b.src, self.mouse-x / self.width);
                                            }
                                        }
                                    }
                                    Text {
                                        text: b.media-time;
                                        font-size: 11px;
                                        color: UiTokens.text-dim;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.media-toggle(b.src); }
                                    }
                                }
                                // 稿 `.cap`：说明条。
                                Rectangle { width: 100%; height: 2px; background: PixelTheme.edge; }
                                Rectangle {
                                    width: 100%;
                                    height: 18px;
                                    background: PixelTheme.panel;
                                    Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        text: "video · " + b.alt;
                                        font-size: 11px;
                                        color: UiTokens.text-dim;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        // 音频（稿 v18）：**正方形方块**（owner 口径「音频用正方形就可以了，为啥要长条」）
                        // —— 56×56、2px 描边、圆角 6、暖底，居中 ▶/⏸；名称走 Tooltip 不占版面。
                        // 方块跟着左右分栏走（用户靠右 / 怹靠左）。
                        if b.kind == "audio": Rectangle {
                            width: 100%;
                            height: 56px;
                            background: transparent;
                            audio-tile := Rectangle {
                                width: 56px;
                                height: 56px;
                                x: b.align-right ? parent.width - self.width : 0px;
                                border-width: 2px;
                                border-color: PixelTheme.edge;
                                border-radius: 6px;
                                background: PixelTheme.bg;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: b.media-playing ? "⏸" : "▶";
                                    font-size: 18px;
                                    color: PixelTheme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.media-toggle(b.src); }
                            }
                            Tooltip { text: @markdown("audio · \{b.alt}"); }
                        }
                        if b.kind == "p" && b.selectable: ConvoSelectableText {
                            align-right: b.align-right;
                            body: b.plain;  avail: root.convo-text-width;  size: 13px;
                        }
                        // 含行内公式的段落（`mathp`）：坐标由 Rust 用 parley 混排（见 inlineflow.rs），
                        // 这里只绝对定位。整段是一个图/字混排的盒子，**不可拖选**（owner 已确认取舍）。
                        if b.kind == "mathp": Rectangle {
                            width: 100%;
                            height: b.flow-h;
                            for p in b.flow: Rectangle {
                                x: p.x;
                                y: p.y;
                                width: p.w;
                                height: p.h;
                                if !p.is-math: Text {
                                    text: p.text;
                                    font-size: b.flow-size;
                                    color: PixelTheme.text;
                                    wrap: no-wrap;
                                }
                                if p.is-math: Image {
                                    source: p.img;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }
                        }
                        if b.kind == "p" && !b.selectable: StyledText {
                            width: root.convo-text-width;   // 见本区顶部注释
                            horizontal-alignment: b.align-right ? right : left;
                            text: b.styled;
                            default-font-size: 13px;
                            default-color: PixelTheme.text;
                            link-color: UiTokens.info;
                            link-clicked(link) => { root.open-link(link); }
                        }
                        // 助手轮动作行（稿 v11.1 `.acts`，卡 `abb-v11-message-actions`）：
                        // `⧉ 复制` / `⟳ 重新生成` / `🔊 朗读`；朗读进行中该行的按钮变 `⏹ 停止朗读`。
                        // 消息动作（稿 v14 `.acts`）：**只留图标**，文案走 Tooltip（owner 口径：
                        // 按钮上不要文字）。图标仍用能渲染的：`📋`/`↻`/`🔊`——原稿 `⧉`(U+29C9)/
                        // `⟳`(U+27F3) 系统 UI 字体没有，真机会画方框。
                        if b.kind == "acts": HorizontalLayout {
                            width: 100%;
                            spacing: 6px;
                            // 稿 `.acts{margin:6px 0 0}`：上间距 6px（用 padding-top 表达）
                            padding-top: 6px;
                            alignment: start;
                            ActsIcon {
                                icon: "📋";  tip: "复制整轮正文";
                                clicked => { root.copy_turn(b.turn); }
                            }
                            ActsIcon {
                                icon: "↻";  tip: "用该轮的用户提示重跑";
                                clicked => { root.regen_turn(b.turn); }
                            }
                            ActsIcon {
                                icon: b.turn == root.speaking-turn ? "⏹" : "🔊";
                                tip: b.turn == root.speaking-turn ? "停止朗读" : "朗读这一轮";
                                clicked => { root.speak_turn(b.turn); }
                            }
                        }
                    }
                    if root.busy: HorizontalBox {
                        // 「正在输入」+ 光标（稿 `.tbar` / `.caret-t`）。v20 起**没有** `⏹ 停止`
                        //——它合并进输入区主按钮（见 `send-btn`），同一条动作不留两个入口。
                        spacing: 8px;
                        vertical-stretch: 0;
                        Text {
                            text: "正在输入";
                            font-size: 11.5px;
                            font-weight: 700;
                            color: UiTokens.info;
                            vertical-alignment: center;
                        }
                        // 光标：条目不断追加本身已构成打字机感，光标用静态蓝块（Slint
                        // 无内置无限闪烁动画，不为了动效引入定时器）。
                        Rectangle {
                            width: 8px;
                            height: 15px;
                            background: UiTokens.info;
                            border-radius: 1px;
                        }
                        // 稿 v20：这里**不再有** ⏹ 停止——它合并进输入区主按钮
                        //（同一个动作只留一个入口）。本行只说明「正在输入」+ 光标。
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            // ── v11（卡 `abb-v11-resizable-split`）：内容区 ↔ 输入区之间的分割条（稿 `.split`）──
            // 位置就在这两区**之间**（稿 v11.1 的修正）——不是窗口底边的系统缩放，也不是输入框内部。
            //
            // 拖动回调把**指针相对消息区顶边的 y** 原样交给 Rust（策略/夹取都在
            // `syschat::SplitDrag`）：
            //   `split-bar.absolute-position.y + hit.mouse-y - flick.absolute-position.y`
            // 前两项相加 = 指针的**窗口坐标 y**（`mouse-y` 是相对本元素的坐标，由 slint-core 在
            // 每次事件分发时刷新，grab 期间也刷新——`input.rs::handle_mouse_grab` 会走
            // `input_event_filter_before_children`）；再减去消息区顶边（拖动期间它**不动**，固定
            // 构件之上）就得到「divider 该在哪」。这样拖动是**绝对定位**、不累加增量 ⇒ 不可能漂。
            split-bar := Rectangle {
                height: root.split-h;
                vertical-stretch: 0;
                // 稿 v15：分割区**只留一根线**——底色与下侧输入区同色（`bg`），
                // 否则白底 + 输入区暖底会造出“第二条线”的观感。
                background: (split-hit.has-hover || root.split-dragging) ? PixelTheme.hover : PixelTheme.bg;
                // 稿 `.split{border-top:2px}`：把分割条与消息区隔开的那条线。
                // v11c（owner 真机复查）：「内容区 ↔ 输入区」那条把手原来看起来有**三**条线——
                // ①这条顶边 ②中间的 38×2 抓手 ③输入区自己的顶边（下面那条已删）。口径改成
                // **只有一条线**：只留这条顶边（2px），中间抓手不再画自己的线，10px 仍整个是热区
                // （`split-hit` 不变，hover 变色 / ns-resize 光标 / 拖动都照旧）。
                Rectangle { y: 0px; width: 100%; height: 2px; background: PixelTheme.edge; }
                split-hit := TouchArea {
                    mouse-cursor: ns-resize;
                    // 按下即设 dragging，直到松手/取消；悬停时的 move 不动。
                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                            root.split-dragging = true;
                            root.split-drag-to(split-bar.absolute-position.y + self.mouse-y - flick.absolute-position.y);
                        } else if ev.kind == PointerEventKind.move && root.split-dragging {
                            root.split-drag-to(split-bar.absolute-position.y + self.mouse-y - flick.absolute-position.y);
                        } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                            // 松开/取消（比如窗口失焦）都算一次拖动结束：比例待落盘。
                            if root.split-dragging {
                                root.split-dragging = false;
                                root.split-drag-end();
                            }
                        }
                    }
                }
            }

            // 输入区（稿 v10 `.composer-zone` / `.composer` / `.crow` / `.fnbar` / `.ib` / `.send`）──
            // 稿 v9 第 2 条要求：**取消框外图标列**，输入区只有一个整体框
            //（`.composer-zone` padding 10px），框内自上而下 = 待发附件行 → 文本区 → 功能区一行。
            // 功能区**整体靠右**：`[😊][📎][✂][🗑][⋯]` + `发送`（稿 v10：🗑 并入功能区、
            // 发送收小到 30px）。稿第 288 行要求删掉的「长提示文案」不再渲染。
            composer-zone := Rectangle {
                // v11：输入区高由 Rust 按比例写（`composer-h` = 可分配带 − 分割条 − 消息区高，
                // 且不小于 `syschat::split_composer_min_h`）。
                // ⚠️ 用 `min-height` 而不是 `height`：Slint 不许同一元素同时写两个（编译期报错），
                // 而 `min-height` 同时还能当**硬下限**——内容（待发附件行）比它高时布局会把输入区
                // 撑着、让**消息区**先让位，而不是把输入框压扁。`LayoutInfo::preferred_bounded`
                // 会把 preferred 抬到不低于 min ⇒ 没有剩余空间时输入区正好是这个高。
                min-height: root.composer-h;
                background: PixelTheme.bg;
                // 底部两角跟窗口内面板同半径（owner：「底部还不圆角」）——输入区是最后一层，
                // 不补这两个角就会把根 Rectangle 的圆角盖成直角。
                border-bottom-left-radius: 8px;
                border-bottom-right-radius: 8px;
                // v11c（owner 真机复查）：输入区**不再画自己的顶边**。原来它与上面分割条的顶边 +
                // 中间的抓手叠成三条线（这就是「分割条看起来有 3 条线」的来源之一），现只保留
                // 分割条顶上那 2px。
                // ⚠️ 将来若要把它加回来：**不要**写 `x: -2px; width: parent.width + 4px` 去「盖住
                // 窗口黑描边」——实测会触发 Slint 的 width ←→ layoutinfo 绑定循环（编译器警告明确
                // 写「可能运行时 panic」）。两端那 2px 就是窗口黑描边本身。
                // ⚠️ 必须是 `composer-zone :=`（分割条的可分配带 = 三块真实几何之和要用它的高）。
                // 同状态行：用现代 Layout（旧 Box 自带 8px padding，会把 zone 的 10px 内边距
                // 撑成 18px、顶部分隔线也内缩，破坏稿 `.composer-zone{padding:10px}`）。
                VerticalLayout {
                    // `.composer-zone{padding:10px}` + 上面那条 2px 分隔线：内容距 zone 顶边 12px、
                    // 左/右/下各 10px（与加分割条之前**逐像素一致**：2 + 10 = 12）。
                    padding-top: 12px;
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-bottom: 10px;
                    // 不给 `alignment`：它会让布局**只按 preferred 摆**（实测：写了 end 之后
                    // 下一条的 `vertical-stretch: 1` 被忽略、输入框不吃多出来的高度）。
                    composer := Rectangle {
                        width: 100%;
                        // 拖动分割条把输入区拉高 ⇒ 多出来的高度归**文本区**（见 `area` 的 `area-h`），
                        // 而不是在分隔线与输入框之间留一块空白（那看起来像「拖了没反应」）。
                        // 这里是 `width: 100%` 的普通子元素：高度由内容决定，正好等于
                        // `composer-h − 22`（zone 的上下 padding）——不留剩余空间。
                        background: PixelTheme.panel;
                        border-width: 2px;
                        border-color: PixelTheme.edge;
                        border-radius: 8px;
                        VerticalLayout {
                            // 稿 `.composer{padding:8px;border:2px}`（全局 `box-sizing:border-box`）⇒
                            // 内容距**外沿** 10px。Slint 的 `border-width` **不占布局**（边框画在
                            // 内边距之上，不算尺寸），所以要让内容也距外沿 10px，这里得写 10px：
                            // 写成 8px 时整个输入框矮 4px、内容贴边 2px（实测）。
                            padding: 10px;
                            spacing: 8px;

                            // 待发附件行（框内顶部）：最多 3 个，其余折叠为 `+N`；点开看全部。
                            // 用横向 Flickable 兜底「附件多到一行放不下」（Slint 无 flex-wrap）。
                            if root.attach-count > 0: Flickable {
                                height: 68px;
                                vertical-stretch: 0;
                                content-width: pending-row.preferred-width;
                                content-height: self.height;
                                pending-row := HorizontalBox {
                                    padding: 8px;
                                    spacing: 8px;
                                    // 图片：52×52 缩略图（左下角类型徽标；加载失败回落字形）。
                                    // 图片/文件分两个 `for` —— 布局里 `visible: false` 不占位，
                                    // 比「每行套一层 Rectangle + if」的隐式尺寸更可预测。
                                    for r in root.pending-rows: Rectangle {
                                        visible: r.is-image;
                                        width: 52px;
                                        height: 52px;
                                        background: PixelTheme.hover;
                                        border-width: 2px;
                                        border-color: PixelTheme.edge;
                                        border-radius: 6px;
                                        if r.thumb-ok: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: r.thumb;
                                            image-fit: cover;
                                        }
                                        if !r.thumb-ok: Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "🖼";
                                            font-size: 18px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        // 左下角名称/类型徽标（稿 `.pthumb .badge`）
                                        Rectangle {
                                            x: 3px;
                                            y: parent.height - self.height - 3px;
                                            width: badge.preferred-width + 8px;
                                            height: 14px;
                                            background: #1c1a17c4;
                                            border-radius: 3px;
                                            badge := Text {
                                                text: r.ext;
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        PendingRemoveBadge {
                                            x: parent.width - 10px;
                                            y: -7px;
                                            remove => { root.attach-remove(r.index); }
                                        }
                                    }
                                    // 非图片：文件 chip（图标 + 名称 elide）
                                    for r in root.pending-rows: Rectangle {
                                        visible: !r.is-image;
                                        height: 52px;
                                        width: min(file-row.preferred-width, 180px);
                                        background: PixelTheme.bg;
                                        border-width: 2px;
                                        border-color: PixelTheme.edge;
                                        border-radius: 6px;
                                        file-row := HorizontalBox {
                                            padding: 6px;
                                            spacing: 7px;
                                            Rectangle {
                                                width: 22px;
                                                height: 22px;
                                                background: PixelTheme.accent;
                                                border-width: 2px;
                                                border-color: PixelTheme.edge;
                                                border-radius: 4px;
                                                Text {
                                                    width: 100%;
                                                    height: 100%;
                                                    text: r.ext;
                                                    font-size: 8px;
                                                    font-weight: 800;
                                                    color: PixelTheme.on-accent;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: r.name;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: PixelTheme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        PendingRemoveBadge {
                                            x: parent.width - 10px;
                                            y: -7px;
                                            remove => { root.attach-remove(r.index); }
                                        }
                                    }
                                    // 折叠指示 `+N`（N==0 不渲染）；点它展开全部。
                                    if !root.pending-expanded && root.pending-more > 0: Rectangle {
                                        width: 52px;
                                        height: 52px;
                                        background: PixelTheme.hover;
                                        border-width: 2px;
                                        border-color: PixelTheme.edge;
                                        border-radius: 6px;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: root.pending-more-text;
                                            font-size: 13px;
                                            font-weight: 800;
                                            color: PixelTheme.text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            enabled: !root.busy;
                                            mouse-cursor: pointer;
                                            clicked => { root.pending-toggle(); }
                                        }
                                    }
                                    // 展开态下的收起入口（稿未画；无折叠则无需收起）
                                    if root.pending-expanded && root.attach-count > 3: Rectangle {
                                        width: 52px;
                                        height: 52px;
                                        background: PixelTheme.hover;
                                        border-width: 2px;
                                        border-color: PixelTheme.edge;
                                        border-radius: 6px;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "收起";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: PixelTheme.text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            enabled: !root.busy;
                                            mouse-cursor: pointer;
                                            clicked => { root.pending-toggle(); }
                                        }
                                    }
                                }
                            }

                            // 文本区（稿 `.area`）：无自绘边框（描边归整体框），回车发送。
                            // 稿 `.area{min-height:66px;max-height:130px}`；本实现是**单行**
                            // 输入框（既有行为，不在本卡改动面），默认高取稿的下限 66px。
                            // v11：**高由 Rust 写**（`area-h` = 66 + 输入区拉高后的富余）——于是
                            // 「输入区变高」在屏幕上是**文本区/输入框变高**（而不是留一块空白）。
                            // 为什么不用 `vertical-stretch`：实测这个 Rectangle（及其父 `composer`）
                            // 上的 stretch 不生效（多出来的高度被布局丢在下面），显式高才可靠。
                            // ⚠️ 写 `height`（不是 `min-height`）：只写 min-height 时，Slint 布局按
                            // 子项的 **preferred**（Rectangle = 0）算父布局的 preferred，实测这个区
                            // 只能拿到 62px（少了 4px，整个输入框跟着矮 4px）。
                            area := Rectangle {
                                height: root.area-h;
                                background: transparent;
                                area-input := TextInput {
                                    x: 2px;
                                    y: 4px;
                                    width: parent.width - 4px;
                                    height: parent.height - 8px;
                                    text <=> root.draft;
                                    font-size: 13px;
                                    color: PixelTheme.text;
                                    single-line: true;
                                    vertical-alignment: top;
                                    // 卡 d10：生成中**保持可编辑**（owner 口径：输入要支持插入/打断）。
                                    // 落点是插入还是排队由 Rust 侧 `syschat::SendPump` 判定，
                                    // 状态行显示「已插入」/「已排队」。
                                    accepted => {
                                        if root.draft != "" { root.send(root.draft); }
                                    }
                                }
                                if root.draft == "" && !area-input.has-focus: Text {
                                    x: 4px;
                                    y: 6px;
                                    // 卡 d10：生成中不再是“等待回复…”（输入框已可用）。
                                    text: root.busy
                                        ? "生成中：回车插话（打断本轮）· 点 ⏹ 停止"
                                        : "给怹发消息，回车发送";
                                    font-size: 13px;
                                    color: PixelTheme.dim;
                                }
                            }

                            // 功能区（稿 `.crow{display:flex;align-items:center;gap:8px}`）：
                            // **整体靠右** = 左侧一个占空的伸缩块 + `.fnbar` + 发送。
                            // 顺序照稿 v10：`[😊 表情][📎 附件][✂ 截图][🗑 清空][⋯ 更多]` + `发送`。
                            // `cross-axis-alignment: center` = 稿的 `align-items:center`：
                            // 发送 30px、图标 24px，居中后同一水平线（不能靠默认的 stretch）。
                            // （旧 `HorizontalBox` 自带 8px padding，会把发送钮顶离输入框底边，
                            // 故这里也用现代 Layout。）
                            crow := HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                // 左端占空：把功能区推向右端（稿里的 `<span class="grow">`）。
                                // 只给 `horizontal-stretch`——**不能**再写 `width: 0px`：显式宽度会
                                // 被当成固定尺寸，伸缩因子失效（实测功能区会被顶到最左边）。
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                // `.fnbar{display:flex;gap:4px}`：五枚 24×24 图标钮，间距 4px。
                                fnbar := HorizontalLayout {
                                    spacing: 4px;
                                    // 😊 表情：打开内置 emoji 面板（分组 + 翻页，插入到草稿末尾）。
                                    emoji-btn := ComposerIcon {
                                        icon: "😊";
                                        tip: "表情";
                                        clicked => {
                                            root.more-open = false;
                                            root.emoji-open = true;
                                            root.emoji-opened();
                                        }
                                    }
                                    // 📎 附件：接既有 attach-pick（可多选）；生成中也可用
                                    // （卡的待发附件会随本轮发送/排队项一起带上）。
                                    // 提示里带上另外两条**同样可用**的入口（C2 批 C）：Finder 拖进窗口、
                                    // Finder 里 ⌘C 后 ⌘V。⚠️ 别在这里写死「浏览器里的图拖不进来」——
                                    // 那是上游 winit 只认 `NSFilenamesPboardType` 推出来的**待验**后果
                                    // （源码已实核，行为未实测，见 `src/ui.rs` 拖放钩子上的注释与交接文档 §6）。
                                    ComposerIcon {
                                        icon: "📎";
                                        tip: "添加附件（可多选，也可拖入窗口或 ⌘V 粘贴）";
                                        clicked => { root.attach-pick(); }
                                    }
                                    ComposerIcon {
                                        icon: "✂";
                                        // 卡 `abb-v11-screenshot`：真截屏（选区/选窗）——走 composer-todo
                                        // 交 Rust 采集（`screenshot::capture`，macOS `screencapture -i`），
                                        // 落进待发附件。缺「屏幕录制」授权时状态行给可读引导。
                                        tip: "截图（选区/选窗，进待发附件）";
                                        clicked => { root.composer-todo("截图"); }
                                    }
                                    // 🗑 清空当前会话：v10 从「发送右侧」搬进功能区（稿 v10 第 1 条）。
                                    ComposerIcon {
                                        icon: "🗑";
                                        tip: "清空当前会话";
                                        enabled: !root.busy;
                                        clicked => { root.reset-history(); }
                                    }
                                    more-btn := ComposerIcon {
                                        icon: "⋯";
                                        tip: "更多（含定时发送）";
                                        clicked => {
                                            root.emoji-open = false;
                                            root.more-open = true;
                                            root.more-opened();
                                        }
                                    }
                                    // 📌 置顶：always-on-top，**持久**（写 config.json）。
                                    // 注意与「点托盘图标」的区别：托盘点击只把窗口提到前台一次，
                                    // 不改变这里的置顶状态（见 ui.rs 的 show_window_and_focus）。
                                    ComposerIcon {
                                        icon: "📌";
                                        active: root.pinned;
                                        tip: root.pinned
                                            ? "取消置顶（当前已置顶）"
                                            : "置顶窗口（重启后保持）";
                                        clicked => { root.toggle-pin(); }
                                    }
                                }
                                // 发送按钮（稿 v10 `.send{height:30px;padding:0 14px;font-size:12px;
                                // border-radius:6px}`）：内边距 14×2 ⇒ 宽 = 文案宽 + 28。
                                // 稿 v20：**发送与停止合并成一个主按钮**（两态）。
                                // 空闲 = 「发送」（accent 底）；生成中 = 「⏹ 停止」（panel 底 + 描边）。
                                // 点它：空闲 ⇒ 发送；生成中 ⇒ 停止。消息区「正在输入」条上那个 ⏹ 已删
                                //（同一条动作不在两处出现 = 少一个「点了没反应」的入口）。
                                // 生成中要「插话」走**回车**（有能力则注入在途回合并打断当前思路，
                                // 否则排队；落点由 Rust 的 `SendPump` 判定，提示语如实说）。
                                send-btn := Rectangle {
                                    width: send-text.preferred-width + 28px;
                                    height: 30px;
                                    background: root.busy ? PixelTheme.panel : PixelTheme.accent;
                                    border-width: 2px;
                                    border-color: PixelTheme.edge;
                                    border-radius: 6px;
                                    // 卡 d10：生成中也可发送（内容非空即可）——落点由 Rust 判定。
                                    // 生成中永远可点（那是「停止」），空闲时要有内容才可点。
                                    opacity: (root.busy || root.draft != "") ? 1.0 : 0.5;
                                    send-text := Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.busy ? "⏹ 停止" : "发送";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: root.busy ? PixelTheme.text : PixelTheme.on-accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        enabled: root.busy || root.draft != "";
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if root.busy {
                                                root.stop-streaming();
                                            } else {
                                                root.send(root.draft);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 稿 v10：标题栏内联控件条（①②③④ 一行）──────────────────
        // 顺序照稿 `#win` 的 titlebar 段：
        //   [logo][标题]  ①②③④  [—][⤢][✕]
        //   ① 新建会话（气泡图标） ② 历史会话（🗂 图标） ③ 模型 chip（仍带文案） ④ ⚙设置
        // 它在根 Rectangle 里、VerticalLayout **之后** ⇒ 画在标题栏上层，但不占布局高度。
        // `y: 6px` / `height: 26px` = 稿 `.tb-btn{height:26px}`，且与 `PixelTitleBar` 内部那排
        // 窗口按钮**同一条基线**（titlebar 顶在根 padding 2px 处，内部按钮 `y: 4px`、高 26px
        // ⇒ 绝对 6..32）——"一行、同高 26px、垂直居中"的机器化落点。
        // x 由 Rust 计划给（右缘停在最左那颗窗口按钮左侧 8px；会不会压到标题文字也由它保证）。
        // ⚠️ 必须是 `HorizontalLayout`（现代名）而不是 `HorizontalBox`（旧别名）：旧别名自带
        // `padding: StyleMetrics.layout-padding`（8px），会把整条控件条内容**右下各推 8px**——
        // 实测项高虽然仍是 26px，但落在绝对 y 14..40（而不是 6..32）：既与窗口按钮错位，
        // 又会跨过标题栏底部分隔线。
        if root.titlebar-strip-x >= 0px: HorizontalLayout {
            x: root.titlebar-strip-x;
            y: 6px;
            height: 26px;
            spacing: 6px;
            // ①新建会话（稿 v9 第 1 条：14px 对话气泡图标；v10 稿 v8 第 2 条：只要图标）。
            // **唯一入口**（v10 已把输入区左侧的 `＋` 拆掉）⇒ 换档时最后才让位（`titlebar_plan`）。
            TitlebarIconButton {
                bubble: true;
                tip: "新建会话（历史保留）";
                enabled: !root.busy;
                clicked => { root.new-session(); }
            }
            // ②历史会话（稿 v10：只有 🗂 图标；点开列历史会话、可切回继续聊）。
            // v11：点开的是窗内自绘 `MenuPanel`（`session-menu-open`），不再是 `PopupWindow`。
            if root.titlebar-session-w > 0px: session-btn := SessionIconButton {
                width: root.titlebar-session-w;
                open: root.session-menu-open;
                enabled: !root.busy;
                clicked => {
                    root.model-menu-open = false;
                    root.emoji-open = false;
                    root.more-open = false;
                    root.session-menu-open = !root.session-menu-open;
                    // 点开时通知 Rust：复位到普通视图 + 刷新行（面板关着时列表可能变了：
                    // 新会话 / 归档 / 切回）。收起不需要通知。
                    if root.session-menu-open { root.session-menu-opened(); }
                }
            }
            // ③模型 chip（稿 `.chipbtn.accent`）：v11 换成自绘 `ModelChip` + `MenuPanel`
            //（`PixelMenu` 没有 accent 面，也撑不起「标题 + footer + 当前项 ✓ / 其它项 provider」）。
            if root.titlebar-model-w > 0px: model-btn := ModelChip {
                width: root.titlebar-model-w;
                text: root.titlebar-model-text;
                open: root.model-menu-open;
                enabled: !root.busy;
                clicked => {
                    root.session-menu-open = false;
                    root.emoji-open = false;
                    root.more-open = false;
                    root.model-menu-open = !root.model-menu-open;
                }
            }
            // ④⚙设置（稿 `.tb-btn[data-m="4"]`）——唤起既有设置窗（需求 #3）
            if root.titlebar-settings-w > 0px: TitlebarIconButton {
                tip: "打开设置";
                enabled: !root.busy;
                clicked => { root.open-settings(); }
            }
        }

        // 无边框窗口缩放热区。owner 2026-10-13：「窗口不能缩放的吗？」——对话窗此前没接缩放。
        //
        // v11c（owner 真机复查：「窗口还是不能缩放，最大化也没实现」）——这条已废：
        //   - D6 实核的结论仍成立：macOS 的 `winit drag_resize_window` 直接 `NotSupported`
        //     （winit 0.30.13 `platform_impl/macos/window_delegate.rs:1179`），所以 D6 选择了
        //     「macOS 一律不画热区」；代价是**完全不能缩放**（`no-frame` 窗系统也不给边角手柄）。
        //   - 现在改成：热区**全平台都画**，macOS 走 `self-managed: true` 的**自管缩放**
        //     （`ui::SelfResize` 跟指针算尺寸，见 `ResizeZone`）。
        // 热区是整窗 overlay（north 条 y 0..6、左右条 6px 整高、四角 14×14）——在 macOS 上它
        // 确实压在标题栏顶部/两端；这是「能缩放」的代价，也是 macOS 窗口的常规语义
        // （三颗窗口钮的点击中心在 y≈19，不在 14px 角块里，由无头事件注入用例钉住）。
        // 放在 VerticalLayout 之后 = 更上层。
        if root.resize-hit-areas : WindowResizeZones {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            self-managed: root.resize-self-managed;
            begin-resize(dir) => { root.begin-resize(dir); }
            self-resize-begin(dir, x, y) => { root.self-resize-begin(dir, x, y); }
        }

        // ── 卡 d9：表情面板 /「更多（定时）」菜单（根级 overlay，画在功能钮**上方**）──────
        //
        // v11（卡 `abb-v11-popup-anchor`）：锚点从「输入框顶边」改为「**对应按钮**的矩形」——
        // 旧写法（`y: composer.absolute-position.y - h - 6`）让面板底边离按钮还有「待发附件行 +
        // 文本区」那么高（默认布局 100+ px），就是 owner 说的「飘太远」。现在四个值（x/y/w/h）
        // 全由 Rust 写：`syschat::pop_anchor`（右缘与按钮右缘对齐、底边在按钮顶边上方 6px、
        // 靠窗边整体内移不出窗）+ `emoji_pop_*` / `more_pop_h`（面板尺寸）。
        //
        // 为什么不用 PopupWindow：它的 `close-policy: close-on-click-outside` 在**按下**就关
        //（slint-core `window.rs` 的 `CloseOnClickOutside` 判 `pressed_event`），而按钮的
        // `clicked` 在**松开**才到 → 「再点按钮」永远只会重开、收不起来（实测语义，不是猜）。
        // 改成「面板 + 一层整窗透明 TouchArea」：点面板外（含按钮本身）→ 关；再点按钮时
        // 已无遮挡 → 正常打开。两面板互斥由按钮处理器保证。
        // ── 划词工具条（类似飞书）：整窗透明吸收层 + 工具条本体 ──────────────────
        // 放在面板 backdrop **之前** ⇒ 表情/会话面板打开时画在工具条之上，不会被盖住；
        // 工具条自身在吸收层之后 ⇒ 条上的点击不会被吸收层吃掉。
        if root.sel-toolbar-shown: Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: transparent;
            // 点条外任意处 = 收起（与飞书一致；不改变文本选区，用户可以继续操作）。
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.sel-toolbar-visible = false; }
            }
        }
        if root.sel-toolbar-shown: SelectionToolbar {
            anchor-x: root.sel-toolbar-x;
            anchor-y: root.sel-toolbar-y;
            avail-width: root.width;
            copy-clicked => { root.sel-toolbar-visible = false; root.sel-copy(); }
            quote-clicked => { root.sel-toolbar-visible = false; root.sel-quote(); }
            speak-clicked => { root.sel-toolbar-visible = false; root.sel-speak(); }
            close-clicked => { root.sel-toolbar-visible = false; }
        }

        if root.emoji-open || root.more-open || root.session-menu-open || root.model-menu-open: Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: transparent;
            // 点面板外（含按钮本身）收起：四个面板互斥，一次全关。
            // 面板开着时点**另一个** chip/图标钮：那一下被本 backdrop 吃掉 ⇒ 先收起（等于
            // 「点外部收起」，与 d9 的表情/更多同一口径）；再点一次才展开另一个。
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.emoji-open = false;
                    root.more-open = false;
                    root.session-menu-open = false;
                    root.model-menu-open = false;
                }
            }
        }

        // ── v11（卡 `abb-v11-panels-align`）：历史会话 / 模型列表两个自绘面板 ────────
        // 位置由 Rust 按 `syschat::menu_anchor` 算后写进 `*-menu-x/y`（右缘跟按钮右缘对齐、
        // 顶边在按钮下缘 6px、靠窗边整体内移）。声明在这里（backdrop 之后）= 画在 backdrop 上层。
        // 稿 `.menu` 的标题/footer/右侧 tag 都在这两个面板里；`PixelMenu` 撑不起这套结构。
        session-panel := MenuPanel {
            // 用 `visible` 而不是 `if`：`if` 分支里的 id 不能在组件外读（Slint 编译期报
            // 「Cannot access id」），而 `dbg-session-menu-*` 需要量它的真实宽高。
            // 绝对定位的子元素不参与兄弟布局，隐藏时也不收事件 ⇒ 两种写法等价。
            visible: root.session-menu-open;
            x: root.session-menu-x;
            y: root.session-menu-y;
            // 文案（含「已归档（N）」的条数）由 Rust 算：`syschat::session_panel_text`（纯函数带单测）。
            heading: root.session-panel-copy.heading;
            foot: root.session-panel-copy.foot;
            rows: root.session-rows;
            current: root.session-index;
            extra-text: root.session-panel-copy.extra_text;
            extra-tag: root.session-panel-copy.extra_tag;
            extra-text2: root.session-panel-copy.extra2_text;
            extra-tag2: root.session-panel-copy.extra2_tag;
            enabled: !root.busy;
            picked(i) => { root.session-menu-open = false; root.session-pick(i); }
            // 归档/返回都不在这里关面板：归档要收起（列表变了），返回要保持开着——由 Rust 判。
            extra-clicked => { root.session-extra(); }
            extra-clicked2 => { root.session-extra2(); }
        }
        model-panel := MenuPanel {
            visible: root.model-menu-open;
            x: root.model-menu-x;
            y: root.model-menu-y;
            heading: "选择模型（本会话生效）";
            foot: "仅列出「设置 → 供应商」里已配置的模型";
            rows: root.model-rows;
            current: root.model-index;
            enabled: !root.busy;
            picked(i) => { root.model-menu-open = false; root.model-pick(i); }
        }

        if root.emoji-open: Rectangle {
            x: root.emoji-pop-x;
            y: root.emoji-pop-y;
            width: root.emoji-pop-w;
            height: root.emoji-pop-h;
            background: PixelTheme.panel;
            border-width: 2px;
            border-color: PixelTheme.edge;
            border-radius: 8px;
            // 吃掉面板空白处的点击，别让它穿到后面的整窗 backdrop 上把面板关了。
            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                // 分组 tab（顺序/名称由 Rust 给，点一个换一组）
                HorizontalLayout {
                    height: 24px;
                    spacing: 4px;
                    for c[idx] in root.emoji-cats: Rectangle {
                        horizontal-stretch: 1;
                        height: 24px;
                        background: idx == root.emoji-cat-index ? PixelTheme.accent : (tab-hit.has-hover ? PixelTheme.hover : PixelTheme.bg);
                        border-width: 2px;
                        border-color: PixelTheme.edge;
                        border-radius: 4px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: c;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: idx == root.emoji-cat-index ? PixelTheme.on-accent : PixelTheme.text;
                        }
                        tab-hit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.emoji-cat(idx); }
                        }
                    }
                }
                // 8 列 × 4 行（与 `emoji.rs` 的 GRID_COLS / GRID_ROWS 及 PAGE_SIZE 一致）。
                GridLayout {
                    spacing: 2px;
                    for e[idx] in root.emoji-cells: Rectangle {
                        row: idx / 8;
                        col: Math.mod(idx, 8);
                        width: 34px;
                        height: 34px;
                        background: cell-hit.has-hover ? PixelTheme.hover : transparent;
                        border-radius: 4px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: e;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cell-hit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.emoji-pick(e); }
                        }
                    }
                }
                // 翻页（页数与可用性由 Rust 算：`emoji.rs` 纯函数）
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    ComposerIcon {
                        icon: "◀";
                        tip: "上一页";
                        enabled: root.emoji-prev-enabled;
                        clicked => { root.emoji-page(-1); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        height: 100%;
                        text: root.emoji-page-label;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: PixelTheme.dim;
                    }
                    ComposerIcon {
                        icon: "▶";
                        tip: "下一页";
                        enabled: root.emoji-next-enabled;
                        clicked => { root.emoji-page(1); }
                    }
                }
            }
        }

        if root.more-open: Rectangle {
            x: root.more-pop-x;
            y: root.more-pop-y;
            width: root.more-pop-w;
            // 高度由 Rust 给（`syschat::more_pop_h(sched-count)`，与锚点算术同源）——
            // 否则「面板底边贴按钮上方」里的面板高只能靠 Slint 反向回报，多一条反馈。
            height: root.more-pop-h;
            background: PixelTheme.panel;
            border-width: 2px;
            border-color: PixelTheme.edge;
            border-radius: 8px;
            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Text {
                    height: 20px;
                    text: "定时发送（到点自动发出）";
                    font-size: 10px;
                    color: PixelTheme.dim;
                    vertical-alignment: center;
                }
                for p[idx] in root.sched-preset-labels: MenuRow {
                    text: p;
                    clicked => { root.sched-preset(idx); }
                }
                if root.sched-count > 0: Text {
                    height: 18px;
                    text: "待发（点 ✕ 取消）";
                    font-size: 10px;
                    color: PixelTheme.dim;
                    vertical-alignment: center;
                }
                for it[idx] in root.sched-items: Rectangle {
                    height: 26px;
                    background: transparent;
                    border-radius: 4px;
                    Text {
                        x: 6px;
                        width: parent.width - 34px;
                        height: 100%;
                        text: it;
                        font-size: 11px;
                        color: PixelTheme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        x: parent.width - 26px;
                        y: 3px;
                        width: 20px;
                        height: 20px;
                        background: rm-hit.has-hover ? PixelTheme.hover : PixelTheme.bg;
                        border-width: 2px;
                        border-color: PixelTheme.edge;
                        border-radius: 4px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "✕";
                            font-size: 10px;
                            color: PixelTheme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        rm-hit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.sched-cancel(idx); }
                        }
                    }
                }
                if root.sched-count > 1: MenuRow {
                    text: root.sched-cancel-all-label;
                    clicked => { root.sched-cancel-all(); }
                }
            }
        }
    }

    // ── v11（卡 `abb-v11-resizable-split`）：内容区 ↔ 输入区的分割条 ─────────────
    // 稿 v11.1 的 `.split`：夹在 `.convo` 与 `.composer-zone` **之间**（不是窗口底边的系统缩放，
    // 也不是输入框内部）。拖动改两区高度比例，比例持久化。
    //
    // 分工：「比例 → 两区高度」的算术全在 Rust（`syschat::split_convo_h` / `split_clamp_convo_h`，
    // 纯函数带单测）；这里只画 + 把「可分配带」与「指针位置」报给 Rust。
    // **可分配带**（= 窗高 − 标题栏/状态行等固定构件 − 分割条）= 三块的真实几何之和（下面
    // `split-band-watch`）：不在这里镜像布局常量，布局改了自动跟上。
    // 两区高**都由 Rust 写**（比例 ↔ 像素在 `syschat::split_convo_h` / `split_composer_h`，
    // 纯函数带单测）：`convo-h` 给消息区、`composer-h` 给输入区。默认值是**默认窗（520×560）的
    // 那一档**（可分配带 482 = 326 + 10 + 146），这样窗口在拿到第一次回调前也不会错位。
    in property <length> convo-h: 326px;
    in property <length> composer-h: 146px;
    in property <length> split-h: 10px;           // 由 Rust 写（= `syschat::SPLIT_HANDLE_H`，稿 `.split{height:10px}`）
    // 文本区高（稿 `.area{min-height:66px}` 起）：由 Rust 写 —— 输入区被拉高时富余高度进这里，
    // 于是「两区比例变了」在屏幕上是**文本区变高**（详见 `syschat::split_area_h`）。
    in property <length> area-h: 66px;
    // 拖动中（TouchArea 的 hover 也可能发 move ⇒ 用这个标志把「悬停」与「拖动」分开）
    in-out property <bool> split-dragging: false;
    callback split-band-changed(length);   // 可分配带变化 ⇒ Rust 按比例重算两区高
    callback split-drag-to(length);        // 参数 = 指针相对**消息区顶边**的 y（Rust 侧只管夹取）
    callback split-drag-end();             // 松手：比例待落盘（去抖）
    // **可分配带** = 消息区 + 分割条 + 输入区 = 窗高 − 固定构件（根 layout padding 上下各 2 +
    // 标题栏 34（上游 `PixelTitleBar` 固定高）+ 标题栏底分隔线 2 + 状态行 38（= 上面那条
    // `min-height: 38px`））。
    // 为什么写成「窗高 − 固定构件」、而不是「三块高度之和」：三块里有**两块的 min-height 是
    // Rust 按这个带算出来的** ⇒ 自指，换窗高时分母永远分不到新高度（实测：820 高窗下带高恒为
    // 482）。这里只依赖 `root.height` 与几个字面量 ⇒ **第一次求值就是对的**，不会先报一个错值
    // 再纠正（那会闪一帧）。字面量就是上面那几行的构件，改它们时由无头渲染台的三块之和断言兜住。
    property <length> split-band-watch: root.height - 4px - 34px - 2px - 38px;
    changed split-band-watch => {
        root.split-band-changed(split-band-watch);
    };
    // 请求滞底：Rust 递增 scroll-epoch（追加消息/打开对话框）→ 把 content-y 设成**越界**负值。
    // Flickable 的 in-bound change tracker 会把它延迟夹取到真实底部（flickable.rs:80-120），
    // 且该 tracker 依赖 content-height：内容随后变高时会再夹一次，故新消息总能滚进视野。
    // ⚠️ content-y 必须保持**无绑定**（本组件不绑它，也不用 ScrollView/ScrollBar——
    //    它们会给 content-y 加绑定）。一旦有绑定，`!y.has_binding()` 为假 ⇒ 夹取被跳过。
    // 两个信号要分开（owner 第 5 条踩出来的）：
    // - `scroll-epoch`：**显式**跳转（发消息 / 打开会话 / 追加历史）⇒ **无条件**到底，
    //   并给 latch 让「布局还没定高」的情况随后补上。
    // - `follow-epoch`：**流式每拍**⇒ 只在「已经贴底」时跟随。生成中你往上翻看已生成的内容，
    //   不该每一拍把你拽回去；你手动滚回底部，下一拍自动恢复跟随（容差 8px）。
    changed scroll-epoch => {
        // ⚠️ **不要**写 `-999999px` 让 Slint「延迟夹取」落到底——**实测夹取根本不发生**：
        // `ABB_SYSCHAT_DEBUG=1` 的现场日志（1135/1135 行）显示，生成中每 50ms 重写一次越界值，
        // `content-y` 就长期停在 `-999999`（模型有 14 行、内容高 1460 / 视口 326），
        // 视口落在内容外 ⇒ **消息区整片空白**（owner 反复报的白屏，状态行还停在「正在思考」），
        // 连 `turn-end` 之后都不恢复。**直接给真实底部**，值恒在合法区间 ⇒ 无此路径。
        //
        // ⚠️ Slint 的约定（踩过）：**往下滚 `content-y` 是负值**，到底 = `height - content-height`
        // （实测 326−1460 = −1134）。写成正数会被夹回 0 = 等于没滚（上一版就是这么错的一次）。
        root.stick-latch = true;
        flick.content-y = min(0px, flick.height - flick.content-height);
    }
    // 消息区一滚，工具条就离开选区了 ⇒ 直接收起（与飞书一致）。
    // `changed` 只能盯单个属性，故用 watch 单值转接（同 `titlebar-watch` 的手法）。
    property <length> sel-scroll-watch: flick.content-y;
    changed sel-scroll-watch => {
        root.sel-toolbar-visible = false;
    }
    changed follow-epoch => {
        root.stick-latch = flick.content-y <= flick.height - flick.content-height + 8px;
        if (root.stick-latch) {
            flick.content-y = min(0px, flick.height - flick.content-height);
        }
    }
}
