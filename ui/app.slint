// Agent Bridge — Slint 托盘 + 设置窗（macOS 菜单栏 accessory 应用）。
// 托盘模式对齐 ../brewfs（同为 Slint 1.17 SystemTrayIcon 的可用工程）：图标 @image-url、
// 托盘常驻、设置窗 show/hide。
// 注意（Slint 1.17 实测坑，勿改回 enabled 绑定）：托盘菜单项的 `enabled` 标量绑定在属性
//   变化后**不会**重建原生 NSMenu（PropertyTracker 依赖注册不全，首次求值后冻结；title 会变
//   但 enabled 不变）。可靠做法是**结构性** `if cond: MenuItem{...}`——条件翻转触发菜单重建
//   （appkit.rs 对 if/for 结构变化会 detach+重建 NSMenu，已实测生效）。故启停按钮用互斥 if。
import { LineEdit, ComboBox, Button, CheckBox, ScrollView, VerticalBox, HorizontalBox, GridBox, ListView, Palette } from "std-widgets.slint";

// 托盘菜单里逐 bot 状态行：文字 + 状态小圆点图标（后端会转成 muda::IconMenuItem）。
export struct BotMenuRow {
    title: string,
    icon: image,
}

// 托盘：SystemTrayIcon 是内置元素（macOS → NSStatusItem）。
export component Tray inherits SystemTrayIcon {
    // 托盘图标随整体状态变色：online=绿 / connecting=黄 / offline=红 / none=原灰白
    in-out property <string> tray-status: "none";
    icon: root.tray-status == "online" ? @image-url("tray-green.png") :
          root.tray-status == "connecting" ? @image-url("tray-yellow.png") :
          root.tray-status == "offline" ? @image-url("tray-red.png") :
          @image-url("tray-dark.png");
    tooltip: "ABB";

    in-out property <[BotMenuRow]> bots-menu: [];  // 逐 bot 状态行（文字 + 状态图标）
    in-out property <image> icon-online: @image-url("tray-green.png");
    in-out property <image> icon-connecting: @image-url("tray-yellow.png");
    in-out property <image> icon-offline: @image-url("tray-red.png");
    in-out property <image> icon-disabled: @image-url("tray-gray.png");
    in-out property <bool> service-running: false;
    in-out property <bool> configured: false;
    in-out property <bool> autostart: false;

    callback start-service();
    callback stop-service();
    callback restart-service();
    callback open-settings();
    callback open-logs();
    callback open-folder();
    callback toggle-autostart(bool);
    callback quit-app();

    // 左键点图标 = 打开设置（对齐 brewfs：clicked → show-window）
    clicked => { root.open-settings(); }

    Menu {
        // Bot 状态：分区标题（仅在有 bot 时出现）+ 逐 bot 行直接铺在主菜单（不嵌套子菜单）。
        if root.bots-menu.length > 0: MenuItem { title: "Bot 状态"; enabled: false; }
        for st in root.bots-menu: MenuItem { title: st.title; icon: st.icon; enabled: false; }
        if root.bots-menu.length > 0: MenuSeparator {}
        // 启停互斥（结构性，见文件头注释：enabled 绑定不可靠，用 if 翻转重建）
        if !root.service-running: MenuItem { title: "启动"; activated => { root.start-service(); } }
        if root.service-running: MenuItem { title: "停止"; activated => { root.stop-service(); } }
        if root.service-running: MenuItem { title: "重启"; activated => { root.restart-service(); } }
        MenuSeparator {}
        MenuItem { title: "设置…"; activated => { root.open-settings(); } }
        MenuItem { title: "打开日志"; activated => { root.open-logs(); } }
        MenuItem { title: "打开桥目录"; activated => { root.open-folder(); } }
        MenuSeparator {}
        // 开机自启：结构性 if（同启停，enabled/checkbox 绑定不可靠），点一下切换
        if !root.autostart: MenuItem { title: "开机自动启动：关"; activated => { root.toggle-autostart(true); } }
        if root.autostart: MenuItem { title: "开机自动启动：开"; activated => { root.toggle-autostart(false); } }
        MenuSeparator {}
        MenuItem { title: "退出"; activated => { root.quit-app(); } }
    }
}

// 一个已授权用户（owner_open_id 白名单是事实源，name 供展示）
export struct OwnerRow {
    name: string,        // 展示名（飞书反查；查不到=open_id）
    open_id: string,     // 飞书 open_id（事实键）
}

// 互斥选项行（后端三选一 / 对话权限二选一）：checked 由 Rust 按选中 bot 重算后整体替换
// model → for 循环重建 CheckBox 实例，绕开「用户交互移除 checked 绑定、状态残留到其它 bot」的坑。
export struct OptionRow {
    name: string,
    checked: bool,
}

// 单个 bot 行的数据（与 Rust 侧 BotRow 对应）
// #64 批次 B：仓库级 worker 行（github bot 的 worker 角色表）
export struct GhWorkerRow {
    repo: string,       // owner/repo 或 owner/*
    backend: string,    // claude/codex/pi（覆盖 bot 默认后端）
    role: string,       // 角色名（双写署名 + prompt 身份）
    triggers: string,   // 触发关键词（逗号分隔；空 = @bot 默认触发）
}

export struct BotRow {
    name: string,        // 显示名
    kind: string,        // feishu | wechat | dingtalk
    enabled: bool,       // 是否启用（false 则 service 不启动此 bot）
    backend: string,     // 该 bot 的默认后端 claude | codex（跟着 bot 走，不是全局）
    provider: string,    // 该 bot 的模型供应商名（""=跟随全局 default_provider）
    owner-open-id: string, // 飞书：owner（管理员）白名单（逗号分隔 open_id）；微信 bot 不用
    owners: [OwnerRow],  // 飞书：owner 展示名（手填的没名字，列表备用；实际以输入框为准）
    granted: [OwnerRow], // 飞书：授权者列表（授权码添加，名字 + open_id）
    open-access: bool,   // 飞书：true=任何人都可以对话；false=仅授权用户（owner+授权者）
    app-id: string,
    app-secret: string,
    bot-name: string,    // 运行时获取的 bot 名
    bot-open-id: string,
    ding-user-id: string,    // 钉钉：旧单值 owner staffId（迁移到 ding-owner-ids）
    ding-owner-ids: string,  // 钉钉：owner（管理员）白名单（逗号分隔 staffId）
    ding-granted: [OwnerRow], // 钉钉：授权者列表（授权码添加，名字 + staffId）
    ding-open-access: bool,  // 钉钉：true=任何人都可以对话；false=仅授权用户
    ding-robot-code: string, // 钉钉：机器人编码（空=默认 AppKey）
    gh-token: string,       // GitHub 能力：PAT token（空=不启用；附挂在任意 kind 的 bot 上）
    gh-repos: string,       // 仓库白名单：owner/repo 或 owner/*，逗号分隔
    gh-notify-chat: string, // 新 issue 通知目标会话（该 bot 自己的群/私聊 chat_id）
    gh-username: string,    // 自己的 GitHub login：新 issue 通知过滤「自问自答」回声
    gh-mention-map: string, // @提及映射：login:chat_id 对（评论 @提及 私信通知目标）
    gh-workers: [GhWorkerRow], // #64 批次 B：仓库级 worker 角色表
    restrict-granted: bool, // 授权者 agent 会话隔离（true=受限模式，安全默认；false=与 owner 同权限）
}

// 单个模型供应商行的数据（与 Rust 侧 ProviderRow 对应）
export struct ProviderRow {
    name: string,        // 唯一键
    kind: string,        // anthropic | openai-chat | openai-responses
    base-url: string,
    api-key: string,     // 密码框、加载后留空（编辑时重输=覆盖，留空=保留旧值）
    model: string,
    is-default: bool,    // 是否为全局默认供应商
}

// 微信扫码登录二维码弹窗：直接在 GUI 里显示二维码，避免依赖系统看图。
export component QrDialog inherits Window {
    title: "微信扫码登录";
    width: 360px;
    height: 440px;
    preferred-width: 360px;
    preferred-height: 440px;
    background: Palette.background;
    in-out property <image> qr-image;
    in-out property <string> tip: "请用微信扫描二维码";
    callback close-clicked();

    // 根 Rectangle 铺满不透明背景：透明标题栏 + 内容铺满时防止「窗口透明只剩红绿灯」
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background;
        VerticalBox {
            padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;
            spacing: 12px;
            alignment: center;
        Text { text: root.tip; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
        Rectangle {
            background: white;
            border-radius: 8px;
            min-height: 300px;
            Image {
                source: root.qr-image;
                width: 300px;
                height: 300px;
                image-fit: contain;
            }
        }
        Text { text: "扫不上就点「取消」重新获取"; font-size: 11px; color: #888; horizontal-alignment: center; }
        HorizontalBox {
            alignment: center;
            Button { text: "取消"; clicked => { root.close-clicked(); } }
            }
        }
    }
}

// 设置窗：微软电脑管家式布局 —— 左侧导航 + 首页仪表盘 + 卡片化三个配置页。
// 底部共享状态行 + 保存/取消。页面切换用 current-page 结构性 if（与托盘菜单同手法）。

// ═══════════ 复用小组件（干净扁平：SVG 单色图标 + 1px 描边卡片，深浅色自适应） ═══════════

// 单色 SVG 图标：颜色随 Palette 着色（colorize），避免 Unicode 字符在字体里缺字形渲染成方框。
component ImageIcon inherits Image {
    in property <image> icon;
    in property <brush> tint: Palette.foreground.with-alpha(0.7);
    source: root.icon;
    colorize: root.tint;
    width: 18px;
    height: 18px;
    image-fit: contain;
}

// 左侧导航项：SVG 图标 + 文字；选中态 = accent 淡底 + accent 文字。
component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked();
    height: 38px;
    border-radius: 8px;
    background: root.selected ? Palette.accent-background.with-alpha(0.12) : transparent;
    TouchArea {
        clicked => { root.clicked(); }
        HorizontalBox {
            padding-left: 10px;
            spacing: 10px;
            alignment: start;
            ImageIcon {
                icon: root.icon;
                tint: root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.65);
            }
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: root.selected ? 600 : 400;
                color: root.selected ? Palette.accent-background : Palette.foreground;
                vertical-alignment: center;
            }
        }
    }
}

// 状态小胶囊：半透明底 + 语义色文字（比实底更柔和）。
component StatusPill inherits Rectangle {
    in property <string> text: "";
    in property <bool> ok: false;
    in property <bool> warn: false;
    width: 84px;
    height: 22px;
    border-radius: 11px;
    background: root.ok ? #0b8a3e22 : (root.warn ? #b86f0022 : #d1343822);
    Text {
        text: root.text;
        color: root.ok ? #0b8a3e : (root.warn ? #b86f00 : #d13438);
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// 待处理建议行：左文案 + 右侧「去处理」小按钮，点击跳对应页（火绒「主页建议」同款交互）。
component ProblemRow inherits HorizontalBox {
    in property <string> text: "";
    in property <string> action: "去处理 ›";
    callback clicked();
    height: 28px;
    spacing: 8px;
    Text {
        text: root.text;
        font-size: 12.5px;
        color: Palette.foreground;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Rectangle {
        width: 84px;
        height: 24px;
        border-radius: 12px;
        background: #b86f0018;
        TouchArea {
            clicked => { root.clicked(); }
            Text {
                text: root.action;
                font-size: 11px;
                font-weight: 600;
                color: #b86f00;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
}

// 首页快捷操作卡：SVG 图标 + 标题 + 说明 + 动作文案；1px 描边取代阴影，更干净。
component QuickCard inherits Rectangle {
    in property <string> title: "";
    in property <string> desc: "";
    in property <image> icon;
    in property <string> action-label: "前往 ›";
    callback clicked();
    height: 122px;
    horizontal-stretch: 1;
    border-radius: 12px;
    background: Palette.background;
    TouchArea {
        clicked => { root.clicked(); }
        VerticalBox {
            padding: 14px;
            spacing: 6px;
            ImageIcon { icon: root.icon; tint: Palette.accent-background; }
            Text { text: root.title; font-size: 13px; font-weight: 600; color: Palette.foreground; }
            Text { text: root.desc; font-size: 11px; color: Palette.foreground.with-alpha(0.55); wrap: word-wrap; }
            Text { text: root.action-label; font-size: 11px; font-weight: 600; color: Palette.accent-background; }
        }
    }
}

// 通用确认弹窗：关闭/取消时未保存编辑、以及打开时发现草稿，两种场景复用。
// 文案/按钮由 Rust 侧按场景设置（title-text/message/primary/discard/stay；show-stay=false 隐藏中间按钮）。
export component UnsavedDialog inherits Window {
    title: root.title-text;
    width: 460px;
    height: 200px;
    preferred-width: 460px;
    preferred-height: 200px;
    background: Palette.background;
    in-out property <string> title-text: "未保存的修改";
    in-out property <string> message: "保存会写入配置，服务在跑时会重启使其生效。";
    in-out property <string> primary-text: "保存并关闭";
    in-out property <string> discard-text: "不保存";
    in-out property <string> stay-text: "取消";
    in-out property <bool> show-stay: true;
    callback save-close();    // 主操作（保存并关闭 / 恢复草稿）
    callback discard-close(); // 次操作（不保存关闭 / 丢弃草稿）
    callback stay();          // 留在设置窗

    // 根 Rectangle 铺满不透明背景（同 QrDialog：透明标题栏 + 内容铺满防透明坑）
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background;
        VerticalBox {
            padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;
            spacing: 10px;
        Text {
            text: root.title-text;
            font-size: 15px;
            font-weight: 700;
            color: Palette.foreground;
            horizontal-alignment: center;
        }
        Text {
            text: root.message;
            font-size: 12.5px;
            color: Palette.foreground.with-alpha(0.7);
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            Button { text: root.discard-text; clicked => { root.discard-close(); } }
            if root.show-stay: Button { text: root.stay-text; clicked => { root.stay(); } }
            Button { text: root.primary-text; primary: true; clicked => { root.save-close(); } }
            }
        }
    }
}

// 设置窗主体。
export component SettingsWindow inherits Window {
    // 打开时由 Rust 侧提升为 regular 策略（带 dock 图标 + 置前聚焦），关掉降回 accessory。
    // 不用 always-on-top：那会浮在别的 app 之上却没焦点，别扭。标题带实时 bot 数。
    title: root.window-title;
    // 窗口 + Dock 图标（提升为 regular 后 Dock 用）。1024px 源，macOS 自动缩放。
    icon: @image-url("../app-assets/icon-1024.png");
    // 显式 width/height（固定尺寸，PCM 同款不可缩放）：Window 若不显式给尺寸，会用内容 preferred 算，
    // 而设置窗初始 bots 为空、selected=-1 时内容高度算成 0 → 窗口塌成标题栏。
    width: 980px;
    height: 680px;
    background: Palette.alternate-background;

    in-out property <string> window-title: "ABB 设置";
    // 应用版本号（Rust 侧 env!("CARGO_PKG_VERSION") 注入；空 = 不显示）
    in-out property <string> version: "";
    // 当前页：0=首页 1=机器人配置 2=环境配置 3=模型供应商
    in-out property <int> current-page: 0;
    // 首页 hero / 状态卡用的结构化状态（running-line 保留给底部状态行）
    in-out property <bool> service-running: false;
    in-out property <bool> autostart: false;
    in-out property <int> bot-count: 0;
    in-out property <int> online-count: 0;
    in-out property <string> running-line: "";   // 底部运行概览（N 个 bot 在线…）；status-line 非空时优先显示 status-line
    in-out property <[BotRow]> bots: [];
    in-out property <int> selected: -1;   // 当前选中的 bot 下标，-1=无
    in-out property <string> status-line;
    in-out property <bool> status-is-error: true;   // true=红（报错）/ false=绿（成功/信息）
    // 跨会话投递总开关（#21）：打开后 agent 可用 `$ABB_BIN deliver` 投递到其它 bot 的会话。
    in-out property <bool> cross-delivery-enabled: false;

    // 环境配置（依赖检测）：各项是否在本机可执行路径上
    in-out property <bool> claude-installed: false;
    in-out property <bool> codex-installed: false;
    in-out property <bool> pi-installed: false;
    in-out property <bool> prime-agent-installed: false;
    in-out property <bool> node-installed: false;
    in-out property <bool> python-installed: false;
    in-out property <bool> lark-installed: false;
    in-out property <bool> dingtalk-installed: false; // dingtalk-cli (dws)
    // claude/codex/pi/prime-agent 任一未装 = true：环境配置页顶部显示醒目横幅（首次启动也据此自动弹出设置窗引导安装）。
    in-out property <bool> missing-agent: false;
    // 正在安装的依赖 id（""=空闲）。用于禁用其它安装按钮 + 显示进度文案。
    in-out property <string> dep-busy: "";
    in-out property <string> dep-detail: ""; // 安装失败详情（多行完整原因；状态行只放短摘要）

    // 系统权限（仅 macOS）：完全磁盘/辅助功能/屏幕录制/自动化/摄像头/麦克风。0=未授权 1=被拒绝 2=已授权
    in-out property <int> perm-full-disk: 0;
    in-out property <int> perm-accessibility: 0;
    in-out property <int> perm-screen: 0;
    in-out property <int> perm-automation: 0;
    in-out property <int> perm-camera: 0;
    in-out property <int> perm-microphone: 0;
    // Windows 专用：是否以管理员身份运行（0=否 2=是）
    in-out property <int> perm-admin: 0;
    // 平台：macos | windows | linux（决定权限区显示什么）
    in-out property <string> platform: "macos";
    // 权限请求子进程是否在跑（防连点；同时给个进度提示）
    in-out property <bool> perm-busy: false;
    // 是否为 macOS（非 mac 不显示系统权限区，显示「仅 macOS 需要」）
    in-out property <bool> perms-supported: false;

    // 模型供应商配置
    in-out property <[ProviderRow]> providers: [];
    in-out property <int> provider-selected: -1;
    in-out property <[string]> provider-names: [];   // 供 bot 页的供应商下拉（[""] + 各 name）
    // 当前选中 bot 的未过期授权码展示：owner-code-info=管理员码行、grant-code-info=普通授权码行
    // （"授权码：xxxx（剩 N 分钟）"；无则空）。生成后/热刷新更新。
    in-out property <string> owner-code-info: "";
    in-out property <string> grant-code-info: "";
    // 互斥 CheckBox 的勾选状态（Rust 侧按选中 bot 重算；slint 表达式绑定会被用户交互破坏——
    // 点击后 in-out 属性绑定失效、状态残留到其它 bot，故用显式 property 驱动）
    in-out property <[OptionRow]> backend-options: [
        { name: "claude", checked: true },
        { name: "codex", checked: false },
        { name: "pi", checked: false },
        { name: "prime-agent", checked: false },
    ];
    in-out property <[OptionRow]> access-options: [
        { name: "仅授权用户", checked: true },
        { name: "任何人都可以对话", checked: false },
    ];
    in-out property <[OptionRow]> ding-access-options: [
        { name: "仅授权用户", checked: true },
        { name: "任何人都可以对话", checked: false },
    ];

    callback save-clicked();
    callback cancel-clicked();
    callback start-service();       // 首页 hero：启动后台服务
    callback stop-service();        // 首页 hero：停止后台服务
    callback restart-service();     // 预留：与托盘一致
    callback open-logs();           // 首页 hero：打开日志目录
    callback fetch-bot-info(int);          // 对某个 bot 拉 name/open_id（飞书）
    callback wx-login(int);                // 对某个 bot 微信扫码登录
    callback add-bot();
    callback remove-bot(int);
    callback selection-changed(int);   // 切中别的 bot：让 Rust 侧重建 model 强制刷新编辑区（ComboBox current-value 不随 model 变，需 model 变更通知）

    // 编辑区变更时回写 bots[selected]。**只回写被改的那一个字段**（field+value）——
    // 旧版 bot-edited 一次传全部字段、未改字段从 model 读，而 model 在编辑后不同步（过期），
    // 连改两个字段会用过期值把前一个字段的修改静默回滚。按字段回写则无此问题。
    callback bot-field-edited(int, string, string); // idx, field(name/kind/backend/provider/owner/app_id/app_secret), value
    callback backend-option-toggled(int);  // 后端选项下标（0=claude 1=codex 2=pi 3=prime-agent）
    callback access-option-toggled(int);   // 飞书对话权限下标（0=仅授权 1=任何人）
    callback ding-access-option-toggled(int); // 钉钉对话权限下标
    callback generate-owner-code(int, string); // 生成授权码：bot idx + role（"owner"=管理员码 / "granted"=普通码），覆盖同类型旧码
    callback copy-owner-code(string);          // 复制指定 role 的授权码到剪贴板
    callback remove-granted(int, int); // 取消授权：bot idx + 授权者下标（从授权者白名单移除）
    callback set-bot-enabled(int, bool); // 启用/停用某 bot（保存重启后生效）
    callback set-restrict-granted(int, bool); // 授权者 agent 隔离开关（true=受限模式，保存后即时生效）
    callback set-cross-delivery(bool);   // 跨会话投递总开关（保存重启后生效）
    callback open-install-docs(string); // 缺失依赖时打开官方安装文档（url）
    callback recheck-deps();            // 重新检测依赖是否已装
    callback install-dep(string);       // 安装某个依赖（claude/codex/pi/node/python3/lark-cli/dingtalk-cli）
    callback install-all-missing();     // #60 一键安装全部缺失组件（node 前置自动装）
    callback open-perm-settings(string); // 打开某项系统权限对应的设置面板（full-disk/accessibility/screen/automation）
    callback request-perms();           // 触发屏幕录制/摄像头/麦克风授权弹框（拉起子进程逐项请求）
    callback restart-service-request(); // 环境页授权后一键重启服务（权限对运行中进程不实时刷新）
    callback relaunch-as-admin();       // Windows：以管理员身份重启（弹 UAC）
    callback gh-worker-edit(int, string, string); // #64 批次 B：worker 行字段编辑（idx/字段名/值）
    callback gh-worker-add();            // #64 批次 B：添加 worker（空行）
    callback gh-worker-del(int);         // #64 批次 B：删除 worker

    // 供应商编辑（同样 per-field 回写纪律，禁止整行回写）
    callback provider-field-edited(int, string, string); // idx, field(name/kind/base_url/api_key/model), value
    callback provider-selection-changed(int);
    callback add-provider();
    callback remove-provider(int);
    callback set-default-provider(int);
    callback test-provider(int);

    // 首页「待处理」卡用到的统计（纯表达式，跟随各 *_installed / perm-* 属性自动更新）
    property <int> missing-deps: (root.claude-installed ? 0 : 1)
        + (root.codex-installed ? 0 : 1)
        + (root.pi-installed ? 0 : 1)
        + (root.prime-agent-installed ? 0 : 1)
        + (root.node-installed ? 0 : 1)
        + (root.python-installed ? 0 : 1)
        + (root.lark-installed ? 0 : 1)
        + (root.dingtalk-installed ? 0 : 1);
    property <int> missing-perms: root.perms-supported && root.platform == "macos" ?
        (root.perm-full-disk != 2 ? 1 : 0) + (root.perm-accessibility != 2 ? 1 : 0)
        + (root.perm-screen != 2 ? 1 : 0) + (root.perm-automation != 2 ? 1 : 0)
        + (root.perm-camera != 2 ? 1 : 0) + (root.perm-microphone != 2 ? 1 : 0)
        : (root.perms-supported && root.platform == "windows" ? (root.perm-admin != 2 ? 1 : 0) : 0);

    // 关键：内容必须包在一个显式铺满窗口的根 Rectangle 里。
    // 直接把 HorizontalBox 当 Window 子元素时，在某些路径下其尺寸算成 0 → 整个内容区不渲染（黑/空），
    // 只剩系统画的标题栏。根 Rectangle width/height:100% 强制铺满，布局才有确定容器。
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.alternate-background;

        VerticalBox {
            // 关键：VerticalBox/HorizontalBox 自带 StyleMetrics.layout-padding（fluent=8px），
            // 不归零会让内容四周多出 16px，顶部透出根背景形成「标题栏白条」。全部归零，
            // 由各分区自己的 padding 精确控制。
            padding: 0;
            // ── 主体：左导航栏 + 页面区 ──
            HorizontalBox {
                vertical-stretch: 1;
                spacing: 0;
                padding: 0;

                // 左导航栏（PCM 侧边栏）：白底 + 右侧分隔线，首页/机器人/环境/供应商。
                Rectangle {
                    width: 160px;
                    background: Palette.background;
                    // 内容铺满整窗（fullsize_content_view）：红绿灯浮在左栏左上角
                    // （x≈8-56, y≈8-22），顶部留 34px 让位，Logo 紧接其下。
                    VerticalBox {
                        padding-top: 34px; padding-right: 10px; padding-bottom: 12px; padding-left: 10px;
                        spacing: 4px;
                        HorizontalBox {
                            padding-top: 0;
                            padding-left: 8px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 8px;
                                background: @linear-gradient(135deg, #0078d4, #00bcf2);
                                Text { text: "A"; color: white; font-weight: 800; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            }
                            Text { text: "ABB"; font-size: 15px; font-weight: 700; color: Palette.foreground; vertical-alignment: center; }
                        }
                        NavItem { label: "首页"; icon: @image-url("icons/home.svg"); selected: root.current-page == 0; clicked => { root.current-page = 0; } }
                        NavItem {
                            label: "机器人配置";
                            icon: @image-url("icons/bot.svg");
                            selected: root.current-page == 1;
                            clicked => { root.current-page = 1; }
                        }
                        NavItem {
                            label: "环境配置";
                            icon: @image-url("icons/shield.svg");
                            selected: root.current-page == 2;
                            clicked => { root.current-page = 2; }
                        }
                        NavItem {
                            label: "模型供应商";
                            icon: @image-url("icons/chip.svg");
                            selected: root.current-page == 3;
                            clicked => { root.current-page = 3; }
                        }
                        Rectangle { vertical-stretch: 1; }
                        VerticalBox {
                            spacing: 3px;
                            Text { text: "菜单栏常驻 · 本地 AI 桥"; font-size: 11px; color: Palette.foreground.with-alpha(0.45); }
                            if root.version != "": Text {
                                text: "v" + root.version;
                                font-size: 10px;
                                color: Palette.foreground.with-alpha(0.35);
                            }
                        }
                    }
                }

                // 页面区：结构性 if 切页（同托盘菜单手法，属性翻转会重建子树）。
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                                        // ═══════════ 首页：hero + 待处理建议 + 快捷卡（PCM「首页/智能提醒」同款） ═══════════
                    if root.current-page == 0: VerticalBox {
                        width: 100%;
                        height: 100%;
                        padding-top: 28px; padding-right: 22px; padding-bottom: 20px; padding-left: 22px;
                        spacing: 16px;
                        alignment: start;

                        // 页头
                        HorizontalBox {
                            spacing: 8px;
                            VerticalBox {
                                horizontal-stretch: 1;
                                Text { text: "首页"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                                Text { text: "你的 AI 助理管家 — 一眼看清运行状态"; font-size: 12px; color: Palette.foreground.with-alpha(0.55); }
                            }
                        }

                        // hero：状态 + 大按钮（PCM「立即加速」同款）。未运行时可从这里直接启动（原来只能去托盘）。
                        Rectangle {
                            height: 132px;
                            border-radius: 14px;
                            background: Palette.accent-background;
                            HorizontalBox {
                                padding-top: 16px; padding-right: 24px; padding-bottom: 16px; padding-left: 24px;
                                spacing: 16px;
                                VerticalBox {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text {
                                        text: root.service-running
                                            ? "服务运行中 · " + root.bot-count + " 个机器人 · " + root.online-count + " 在线"
                                            : "服务已停止";
                                        font-size: 19px;
                                        font-weight: 700;
                                        color: Palette.accent-foreground;
                                    }
                                    Text {
                                        text: root.service-running
                                            ? "飞书 / 微信 / 钉钉消息自动转给本地 Claude / Codex 处理"
                                            : "点右侧「启动服务」，或在托盘菜单点「启动」";
                                        font-size: 12.5px;
                                        color: Palette.accent-foreground.with-alpha(0.75);
                                        wrap: word-wrap;
                                    }
                                    // 状态点（Defender 式「一目了然」）：在线/离线一眼可见；用文字点而非胶囊，避免在 accent 底上发闷
                                    HorizontalBox {
                                        spacing: 12px;
                                        Text { text: root.service-running ? "● 服务运行中" : "● 服务已停止"; font-size: 11.5px; font-weight: 600; color: Palette.accent-foreground; vertical-alignment: center; }
                                        if root.online-count > 0: Text { text: "● " + root.online-count + " 在线"; font-size: 11.5px; color: Palette.accent-foreground.with-alpha(0.85); vertical-alignment: center; }
                                        if root.bot-count - root.online-count > 0: Text { text: "● " + (root.bot-count - root.online-count) + " 离线"; font-size: 11.5px; color: Palette.accent-foreground.with-alpha(0.85); vertical-alignment: center; }
                                    }
                                }
                                VerticalBox {
                                    alignment: center;
                                    spacing: 8px;
                                    // 启停互斥：结构性 if（同托盘菜单，enabled 绑定在原生菜单/样式上不可靠）
                                    if !root.service-running: Rectangle {
                                        width: 140px;
                                        height: 36px;
                                        border-radius: 9px;
                                        background: white;
                                        TouchArea {
                                            clicked => { root.start-service(); }
                                            Text { text: "启动服务"; color: #111; font-weight: 700; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                        }
                                    }
                                    if root.service-running: Rectangle {
                                        width: 140px;
                                        height: 36px;
                                        border-radius: 9px;
                                        background: white;
                                        TouchArea {
                                            clicked => { root.stop-service(); }
                                            Text { text: "停止服务"; color: #111; font-weight: 700; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                        }
                                    }
                                    Rectangle {
                                        width: 140px;
                                        height: 32px;
                                        border-radius: 9px;
                                        background: Palette.accent-foreground.with-alpha(0.15);
                                        TouchArea {
                                            clicked => { root.open-logs(); }
                                            Text { text: "打开日志"; color: Palette.accent-foreground; font-size: 12.5px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                        }
                                    }
                                }
                            }
                        }

                        // 待处理建议（火绒「主页建议」/ PCM「智能提醒」同款）：只有异常才出现，每行点一下直达对应页。
                        if root.missing-deps > 0 || root.missing-perms > 0 || root.bot-count - root.online-count > 0: Rectangle {
                            border-radius: 12px;
                            background: #fff8e6;
                            VerticalBox {
                                padding-top: 12px; padding-right: 16px; padding-bottom: 10px; padding-left: 16px;
                                spacing: 4px;
                                HorizontalBox {
                                    spacing: 8px;
                                    ImageIcon { icon: @image-url("icons/alert.svg"); tint: #b86f00; width: 18px; height: 18px; }
                                    Text { text: "待处理"; font-size: 13px; font-weight: 700; color: #8a5a00; vertical-alignment: center; }
                                }
                                if root.missing-deps > 0: ProblemRow {
                                    text: "依赖未装齐（" + root.missing-deps + " 项）— 机器人将无法处理消息";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.missing-perms > 0: ProblemRow {
                                    text: "有 " + root.missing-perms + " 项系统权限未授权";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.bot-count - root.online-count > 0: ProblemRow {
                                    text: "" + (root.bot-count - root.online-count) + " 个机器人离线";
                                    clicked => { root.current-page = 1; }
                                }
                            }
                        }

                        // 快捷操作卡（PCM 四宫格同款）：加机器人 / 环境体检 / 权限中心 / 跨会话投递。
                        HorizontalBox {
                            spacing: 14px;
                            QuickCard {
                                title: "添加机器人";
                                desc: "接入飞书 / 微信 / 钉钉，30 秒上手";
                                icon: @image-url("icons/plus.svg");
                                clicked => { root.current-page = 1; root.add-bot(); }
                            }
                            QuickCard {
                                title: "环境体检";
                                desc: "Claude Code / Codex / Node.js 依赖检测";
                                icon: @image-url("icons/search.svg");
                                clicked => { root.current-page = 2; root.recheck-deps(); }
                            }
                            QuickCard {
                                title: "权限中心";
                                desc: "磁盘 / 辅助功能 / 屏幕录制一键授权";
                                icon: @image-url("icons/lock.svg");
                                action-label: "去授权 ›";
                                clicked => { root.current-page = 2; }
                            }
                            // 跨会话投递是开关不是跳转，卡片内直接放 CheckBox
                            Rectangle {
                                height: 122px;
                                horizontal-stretch: 1;
                                border-radius: 12px;
                                background: Palette.background;
                                VerticalBox {
                                    padding: 14px;
                                    spacing: 6px;
                                    ImageIcon { icon: @image-url("icons/switch.svg"); tint: Palette.accent-background; }
                                    CheckBox {
                                        text: "跨会话投递";
                                        checked: root.cross-delivery-enabled;
                                        toggled => { root.set-cross-delivery(self.checked); }
                                    }
                                    Text { text: "允许 agent 把结果投递到其它 bot 的会话"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); wrap: word-wrap; }
                                    Text { text: root.cross-delivery-enabled ? "已开启" : "已关闭"; font-size: 11px; font-weight: 600; color: #0a6fc2; }
                                }
                            }
                        }
                    }

// ═══════════ 机器人配置：左列表 + 右编辑（卡片面板） ═══════════
                    if root.current-page == 1: VerticalBox {
                        width: 100%;
                        height: 100%;
                        padding-top: 20px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
                        spacing: 10px;

                        VerticalBox {
                            Text { text: "机器人配置"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                            Text { text: "管理接入的飞书 / 微信 / 钉钉机器人"; font-size: 12px; color: Palette.foreground.with-alpha(0.55); }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 12px;
                            background: Palette.background;
                            HorizontalBox {
                                spacing: 0;
                                // ── 左：bot 列表 ──
                                VerticalBox {
                                    spacing: 6px;
                                    width: 190px;
                                    padding: 8px;
                                    Rectangle {
                                        background: Palette.alternate-background;
                                        border-radius: 10px;
                                        vertical-stretch: 1;
                                        ListView {
                                            for bot[idx] in root.bots: Rectangle {
                                                height: 38px;
                                                background: idx == root.selected ? Palette.selection-background : transparent;
                                                border-radius: 8px;
                                                TouchArea {
                                                    clicked => { root.selected = idx; root.selection-changed(idx); }
                                                    VerticalBox {
                                                        padding-left: 10px;
                                                        spacing: 2px;
                                                        Text {
                                                            // 停用的 bot 前缀 ⚪ 并显灰，一眼可辨（启用的维持原色）
                                                            text: (bot.enabled ? "" : "⚪ ") + (bot.name == "" ? "(未命名)" : bot.name);
                                                            color: idx == root.selected ? Palette.selection-foreground : (bot.enabled ? Palette.foreground : #aaa);
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: bot.kind + (bot.enabled ? "" : " · 停用");
                                                            font-size: 11px;
                                                            color: idx == root.selected ? Palette.selection-foreground.with-alpha(0.8) : #888;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalBox {
                                        spacing: 8px;
                                        Button { text: "＋ 添加"; clicked => { root.add-bot(); } }
                                        Button {
                                            text: "－ 删除";
                                            enabled: root.selected >= 0;
                                            clicked => { root.remove-bot(root.selected); }
                                        }
                                    }
                                }
                                // ── 右：编辑选中 bot ──
                                VerticalBox {
                                    spacing: 5px;
                                    horizontal-stretch: 1;
                                    padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px;
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            width: 100%; // 钳制内容宽度=视口宽：禁止横向滚动，超宽行裁剪而不撑出滚动条
                                            spacing: 8px;
                                            alignment: start;
                                            GridBox {
                                                spacing: 5px;
                                                vertical-stretch: 0;
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Rectangle { width: 80px; }
                                                    CheckBox {
                                                        text: "启用此 bot";
                                                        checked: root.bots[root.selected].enabled;
                                                        toggled => { root.set-bot-enabled(root.selected, self.checked); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "名称"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].name;
                                                        placeholder-text: "如：庆小丰（隔离目录名）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "name", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "类型"; width: 80px; vertical-alignment: center; }
                                                    ComboBox {
                                                        model: ["feishu", "wechat", "dingtalk", "github"];
                                                        current-value: root.bots[root.selected].kind;
                                                        horizontal-stretch: 1;
                                                        selected => { root.bot-field-edited(root.selected, "kind", self.current-value); }
                                                    }
                                                }
                                                // 默认后端跟着 bot 走（per-bot，不是全局）：改飞书 bot 不影响微信 bot。
                                                // 勾选态由 backend-options model 驱动（for 循环重建实例），不依赖会被
                                                // 用户交互破坏的 checked 绑定（实测「微信选 pi 飞书也选中」）。
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "默认后端"; width: 80px; vertical-alignment: center; }
                                                    // 勾选框组必须包进 HorizontalBox 成一个格子：Row 的子元素是 GridBox
                                                    // 共享列（label/字段/按钮），直接铺开会把 codex/pi 排进按钮列甚至面板外。
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.backend-options: CheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.backend-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                // 模型供应商（per-bot 覆盖；""=跟随全局默认）。下拉项 = [""] + provider-names
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "模型供应商"; width: 80px; vertical-alignment: center; }
                                                    ComboBox {
                                                        model: root.provider-names;
                                                        current-value: root.bots[root.selected].provider;
                                                        horizontal-stretch: 1;
                                                        selected => { root.bot-field-edited(root.selected, "provider", self.current-value); }
                                                    }
                                                }
                                                // 授权者 agent 隔离（安全默认开启；三种 kind 都显示）：
                                                // true=授权者会话只能读写本工作区、不能联网（受限模式）；
                                                // false=授权者与 owner 同权限（信任团队成员时放宽）。
                                                // 勾选态走独立 callback（同 set-bot-enabled 模式，避开 CheckBox
                                                // checked 绑定被用户交互破坏的坑）。
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "授权者隔离"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        CheckBox {
                                                            text: "授权者 agent 受限模式";
                                                            checked: root.bots[root.selected].restrict-granted;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.set-restrict-granted(root.selected, self.checked); }
                                                        }
                                                    }
                                                }
                                                // ── 飞书字段（owner/授权者/对话权限）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "对话权限"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.access-options: CheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.access-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "Owner（管理员）"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].owner-open-id;
                                                        placeholder-text: "ou_xxx（管理员 open_id，逗号分隔多个）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "owner", self.text); }
                                                    }
                                                    Button {
                                                        text: "生成管理员授权码";
                                                        enabled: !root.bots[root.selected].open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "已授权用户"; width: 80px; vertical-alignment: center; }
                                                    if root.bots[root.selected].granted.length == 0: Text {
                                                        text: "暂无（点「生成授权码」邀请）";
                                                        color: #888;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    if root.bots[root.selected].granted.length > 0: Text {
                                                        text: "共 " + root.bots[root.selected].granted.length + " 人，逐一取消见下";
                                                        color: #888;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "生成授权码";
                                                        enabled: !root.bots[root.selected].open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "granted"); }
                                                    }
                                                }
                                                for granted[gi] in root.bots[root.selected].granted: Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: granted.name + "（" + granted.open-id + "）";
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "取消授权";
                                                        clicked => { root.remove-granted(root.selected, gi); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu" && root.owner-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.owner-code-info;
                                                        color: #b80;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu" && root.grant-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.grant-code-info;
                                                        color: #b80;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("granted"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu" && root.bots[root.selected].open-access: Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: "公开模式：任何人都可以对话，无需授权（授权码已禁用）";
                                                        color: #888;
                                                        font-size: 11px;
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "App ID"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].app-id;
                                                        placeholder-text: "cli_xxxxxxxx";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "app_id", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "App Secret"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].app-secret;
                                                        input-type: password;
                                                        placeholder-text: "飞书应用密钥";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "app_secret", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Rectangle { width: 80px; }
                                                    HorizontalBox {
                                                        spacing: 8px;
                                                        Text { text: "bot：" + root.bots[root.selected].bot-name + "  " + root.bots[root.selected].bot-open-id; font-size: 11px; color: Palette.foreground.with-alpha(0.6); vertical-alignment: center; wrap: word-wrap; }
                                                        Button { text: "自动获取"; clicked => { root.fetch-bot-info(root.selected); } }
                                                    }
                                                }
                                                // ── 微信字段（扫码登录，无需 app_id/secret）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "wechat": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.bots[root.selected].bot-name == ""
                                                            ? "未登录。点下方按钮，用微信扫码登录。"
                                                            : "已登录：" + root.bots[root.selected].bot-name;
                                                        wrap: word-wrap;
                                                        color: root.bots[root.selected].bot-name == "" ? #888 : #060;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "wechat": Row {
                                                    Rectangle { width: 80px; }
                                                    Button { text: "📱 扫码登录微信"; clicked => { root.wx-login(root.selected); } }
                                                }
                                                // ── 钉钉字段（企业内部应用机器人，Stream 模式长连接，无需公网地址）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "App Key"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].app-id;
                                                        placeholder-text: "钉钉应用 AppKey（dingxxxx）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "app_id", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "App Secret"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].app-secret;
                                                        input-type: password;
                                                        placeholder-text: "钉钉应用 AppSecret";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "app_secret", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "机器人编码"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].ding-robot-code;
                                                        placeholder-text: "留空=默认 AppKey（个别后台单独展示才填）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "ding_robot_code", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "对话权限"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.ding-access-options: CheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.ding-access-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "Owner（管理员）"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].ding-owner-ids;
                                                        placeholder-text: "员工 staffId（管理员，逗号分隔多个）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "ding_owner_ids", self.text); }
                                                    }
                                                    Button {
                                                        text: "生成管理员授权码";
                                                        enabled: !root.bots[root.selected].ding-open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "已授权用户"; width: 80px; vertical-alignment: center; }
                                                    if root.bots[root.selected].ding-granted.length == 0: Text {
                                                        text: "暂无（点「生成授权码」邀请）";
                                                        color: #888;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    if root.bots[root.selected].ding-granted.length > 0: Text {
                                                        text: "共 " + root.bots[root.selected].ding-granted.length + " 人，逐一取消见下";
                                                        color: #888;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "生成授权码";
                                                        enabled: !root.bots[root.selected].ding-open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "granted"); }
                                                    }
                                                }
                                                for dg[gi] in root.bots[root.selected].ding-granted: Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: dg.name + "（" + dg.open-id + "）";
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "取消授权";
                                                        clicked => { root.remove-granted(root.selected, gi); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk" && root.owner-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.owner-code-info;
                                                        color: #b80;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk" && root.grant-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.grant-code-info;
                                                        color: #b80;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("granted"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk" && root.bots[root.selected].ding-open-access: Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: "公开模式：任何人都可以对话，无需授权（授权码已禁用）";
                                                        color: #888;
                                                        font-size: 11px;
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: "要求：企业自建应用已添加「机器人」能力，消息接收模式选 Stream 模式；群聊需 @ 机器人。";
                                                        font-size: 11px;
                                                        color: #888;
                                                        wrap: word-wrap;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                // ── GitHub 能力（附挂在任意 bot 上，非独立类型）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "github": Row {
                                                    Text { text: "GitHub Token"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].gh-token;
                                                        input-type: password;
                                                        placeholder-text: "ghp_xxx（GitHub PAT，空=不启用）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "gh_token", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "github": Row {
                                                    Text { text: "仓库白名单"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].gh-repos;
                                                        placeholder-text: "owner/repo 或 owner/*，逗号分隔（空=不限制）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "gh_repos", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "github": Row {
                                                    Text { text: "通知群"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].gh-notify-chat;
                                                        placeholder-text: "bot_key:chat_id（跨 bot 通知目标，如 mybot:oc_xxx）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "gh_notify_chat", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "github": Row {
                                                    Text { text: "GitHub 用户名"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].gh-username;
                                                        placeholder-text: "自己的 GitHub login（通知过滤自问自答，须与 token 账号一致）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "gh_username", self.text); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "github": Row {
                                                    Text { text: "提及映射"; width: 80px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.bots[root.selected].gh-mention-map;
                                                        placeholder-text: "login:bot_key:chat_id，逗号分隔（评论 @提及 私信通知目标）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.bot-field-edited(root.selected, "gh_mention_map", self.text); }
                                                    }
                                                }
                                                // #64 批次 B：仓库级 worker 角色表（账号是账号、仓库是仓库、worker 跟着仓库走）
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "github": Row {
                                                    Text { text: "仓库 worker"; width: 80px; font-size: 11px; color: #888; vertical-alignment: center; }
                                                    VerticalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 3px;
                                                        for w[i] in root.bots[root.selected].gh-workers: Rectangle {
                                                            height: 28px;
                                                            HorizontalBox {
                                                                spacing: 3px;
                                                                LineEdit {
                                                                    text: w.repo;
                                                                    placeholder-text: "owner/repo 或 *";
                                                                    width: 96px;
                                                                    edited => { root.gh-worker-edit(i, "repo", self.text); }
                                                                }
                                                                ComboBox {
                                                                    model: ["claude", "codex", "pi", "prime-agent"];
                                                                    current-value: w.backend;
                                                                    width: 80px;
                                                                    selected => { root.gh-worker-edit(i, "backend", self.current-value); }
                                                                }
                                                                LineEdit {
                                                                    text: w.role;
                                                                    placeholder-text: "角色";
                                                                    width: 56px;
                                                                    edited => { root.gh-worker-edit(i, "role", self.text); }
                                                                }
                                                                LineEdit {
                                                                    text: w.triggers;
                                                                    placeholder-text: "触发词（空=@bot）";
                                                                    horizontal-stretch: 1;
                                                                    edited => { root.gh-worker-edit(i, "triggers", self.text); }
                                                                }
                                                                Button {
                                                                    text: "✕";
                                                                    width: 26px;
                                                                    clicked => { root.gh-worker-del(i); }
                                                                }
                                                            }
                                                        }
                                                        Button {
                                                            text: "＋ 添加 worker（角色）";
                                                            horizontal-stretch: 1;
                                                            clicked => { root.gh-worker-add(); }
                                                        }
                                                    }
                                                }
                                            }
                                            if root.selected < 0: Text { text: "← 选择或添加一个机器人"; color: #888; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ═══════════ 环境配置：依赖 + 权限（卡片化） ═══════════
                    if root.current-page == 2: VerticalBox {
                        width: 100%;
                        height: 100%;
                        padding-top: 28px; padding-right: 22px; padding-bottom: 20px; padding-left: 22px;
                        spacing: 14px;

                        VerticalBox {
                            Text { text: "环境配置"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                            Text { text: "依赖检测与系统权限"; font-size: 12px; color: Palette.foreground.with-alpha(0.55); }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalBox {
                                spacing: 14px;
                                alignment: start;

                                // 未安装 agent 的醒目横幅（#8 M0 自动引导）
                                if root.missing-agent: Rectangle {
                                    vertical-stretch: 0;
                                    background: #fff3cd;
                                    border-radius: 10px;
                                    HorizontalBox {
                                        padding-top: 10px; padding-right: 14px; padding-bottom: 10px; padding-left: 14px;
                                        spacing: 8px;
                                        Text {
                                            text: "⚠️ 未检测到 Claude Code / Codex CLI：机器人收到消息后将无法处理。请点「一键安装」自动补齐（无 Node.js 会自动先装）。";
                                            color: #664d03;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        if root.missing-deps > 0: Button {
                                            text: "一键安装全部缺失（" + root.missing-deps + " 项）";
                                            enabled: root.dep-busy == "";
                                            clicked => { root.install-all-missing(); }
                                        }
                                    }
                                }

                                // ── 依赖卡片 ──
                                Rectangle {
                                    vertical-stretch: 0;
                                    border-radius: 12px;
                                    background: Palette.background;
                                    VerticalBox {
                                        padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
                                        spacing: 6px;
                                        HorizontalBox {
                                            spacing: 8px;
                                            Text { text: "依赖（本机 agent 运行环境）"; font-weight: 700; color: Palette.foreground; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            // #60：标题行入口——横幅只在 agent 缺失时可见，
                                            // 只缺 node/lark 等也要有一键装入口
                                            if root.missing-deps > 0: Button {
                                                text: "一键安装缺失";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-all-missing(); }
                                            }
                                            Button { text: "重新检测"; clicked => { root.recheck-deps(); } }
                                        }
                                        if root.dep-busy != "": Text {
                                            text: "⏳ 正在安装 " + root.dep-busy + " …（可能要几分钟，期间请勿重复点）";
                                            color: #b80;
                                            wrap: word-wrap;
                                        if root.dep-detail != "": Rectangle {
                                            background: #fff1f0;
                                            border-radius: 8px;
                                            HorizontalBox {
                                                padding: 8px;
                                                Text {
                                                    text: root.dep-detail;
                                                    color: #d13438;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                        }
                                        // claude
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Claude Code"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.claude-installed ? "已安装" : "未安装"; ok: root.claude-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.claude-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("claude"); }
                                            }
                                            if !root.claude-installed: Button { text: "文档"; clicked => { root.open-install-docs("https://docs.claude.com/en/docs/claude-code/setup"); } }
                                        }
                                        if !root.claude-installed: Text { text: "curl -fsSL https://claude.ai/install.sh | bash"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                        // codex
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Codex CLI"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.codex-installed ? "已安装" : "未安装"; ok: root.codex-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.codex-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("codex"); }
                                            }
                                            if !root.codex-installed: Button { text: "文档"; clicked => { root.open-install-docs("https://github.com/openai/codex"); } }
                                        }
                                        if !root.codex-installed: Text { text: "npm install -g @openai/codex"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                        // pi
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Pi (pi-coding-agent)"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.pi-installed ? "已安装" : "未安装"; ok: root.pi-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.pi-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("pi"); }
                                            }
                                            if !root.pi-installed: Button { text: "文档"; clicked => { root.open-install-docs("https://pi.dev"); } }
                                        }
                                        if !root.pi-installed: Text { text: "curl -fsSL https://pi.dev/install.sh | sh"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                        // prime-agent
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "prime-agent"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.prime-agent-installed ? "已安装" : "未安装"; ok: root.prime-agent-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.prime-agent-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("prime-agent"); }
                                            }
                                            if !root.prime-agent-installed: Button { text: "文档"; clicked => { root.open-install-docs("https://github.com/PrimeIntellect-ai/prime-agent"); } }
                                        }
                                        if !root.prime-agent-installed: Text { text: "curl -fsSL https://app.primeintellect.ai/prime-agent/install.sh | sh"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                        // nodejs
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Node.js"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.node-installed ? "已安装" : "未安装"; ok: root.node-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.node-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("node"); }
                                            }
                                        }
                                        if !root.node-installed: Text { text: "brew install node"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                        // python3
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Python 3"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.python-installed ? "已安装" : "未安装"; ok: root.python-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.python-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("python3"); }
                                            }
                                        }
                                        if !root.python-installed: Text { text: "brew install python"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                        // lark-cli
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "lark-cli"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.lark-installed ? "已安装" : "未安装"; ok: root.lark-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.lark-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("lark-cli"); }
                                            }
                                        }
                                        if !root.lark-installed: Text { text: "npm install -g @larksuite/cli"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                        // dingtalk-cli
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "dingtalk-cli"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.dingtalk-installed ? "已安装" : "未安装"; ok: root.dingtalk-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.dingtalk-installed: Button {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("dingtalk-cli"); }
                                            }
                                            if !root.dingtalk-installed: Button { text: "文档"; clicked => { root.open-install-docs("https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli"); } }
                                        }
                                        if !root.dingtalk-installed: Text { text: "npm install -g dingtalk-workspace-cli"; font-size: 11px; color: Palette.foreground.with-alpha(0.55); }
                                    }
                                }

                                // ── 系统权限卡片（仅支持平台才显示）──
                                if root.perms-supported: Rectangle {
                                    vertical-stretch: 0;
                                    border-radius: 12px;
                                    background: Palette.background;
                                    VerticalBox {
                                        padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
                                        spacing: 6px;
                                        HorizontalBox {
                                            spacing: 8px;
                                            Text { text: "系统权限"; font-weight: 700; color: Palette.foreground; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            // 授权提示按钮只在 macOS 显示（Windows 走管理员重启）
                                            if root.platform == "macos": Button { text: "📹 请求授权"; enabled: !root.perm-busy; clicked => { root.request-perms(); } }
                                        }
                                        if root.perms-supported && root.platform == "macos" && root.perm-busy: Text {
                                            text: "⏳ 正在逐项弹系统授权框（屏幕录制→摄像头→麦克风），请在弹框里点「允许」。完成后点「重新检测」刷新。";
                                            font-size: 11px; color: #b80; wrap: word-wrap;
                                        }
                                        // Windows：管理员身份
                                        if root.perms-supported && root.platform == "windows": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "管理员身份"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill { text: root.perm-admin == 2 ? "已提权" : "未提权"; ok: root.perm-admin == 2; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-admin != 2: Button { text: "以管理员重启"; clicked => { root.relaunch-as-admin(); } }
                                        }
                                        if root.perms-supported && root.platform == "windows" && root.perm-admin != 2: Text {
                                            text: "Windows 无需逐项授权；以管理员身份运行即可完全控制本机（文件/鼠标键盘/屏幕/摄像头/麦克风）。点击上方按钮会弹 UAC 确认框。";
                                            font-size: 11px; color: #888; wrap: word-wrap;
                                        }
                                        // macOS 六项权限
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "完全磁盘访问"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill {
                                                text: root.perm-full-disk == 2 ? "已授权" : (root.perm-full-disk == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-full-disk == 2;
                                                warn: root.perm-full-disk == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-full-disk != 2: Button { text: "去授权"; clicked => { root.open-perm-settings("full-disk"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "辅助功能"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill {
                                                text: root.perm-accessibility == 2 ? "已授权" : (root.perm-accessibility == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-accessibility == 2;
                                                warn: root.perm-accessibility == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-accessibility != 2: Button { text: "去授权"; clicked => { root.open-perm-settings("accessibility"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "屏幕录制"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill {
                                                text: root.perm-screen == 2 ? "已授权" : (root.perm-screen == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-screen == 2;
                                                warn: root.perm-screen == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-screen != 2: Button { text: "去授权"; clicked => { root.open-perm-settings("screen"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "自动化"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill {
                                                text: root.perm-automation == 2 ? "已授权" : (root.perm-automation == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-automation == 2;
                                                warn: root.perm-automation == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-automation != 2: Button { text: "去授权"; clicked => { root.open-perm-settings("automation"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "摄像头"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill {
                                                text: root.perm-camera == 2 ? "已授权" : (root.perm-camera == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-camera == 2;
                                                warn: root.perm-camera == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-camera != 2: Button { text: "去授权"; clicked => { root.open-perm-settings("camera"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "麦克风"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: Palette.foreground; }
                                            StatusPill {
                                                text: root.perm-microphone == 2 ? "已授权" : (root.perm-microphone == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-microphone == 2;
                                                warn: root.perm-microphone == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-microphone != 2: Button { text: "去授权"; clicked => { root.open-perm-settings("microphone"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos" && (root.perm-full-disk != 2 || root.perm-screen != 2 || root.perm-camera != 2 || root.perm-microphone != 2): Text {
                                            text: "💡 未授权项：「完全磁盘访问」可点「去授权」后在面板里 ＋ 添加本程序；「屏幕录制/摄像头/麦克风」须先点上方「📹 请求…」按钮触发系统弹框（否则设置列表里看不到本程序）。改完可能需要重启服务生效。";
                                            font-size: 11px;
                                            color: #b80;
                                            wrap: word-wrap;
                                        }
                                        if root.perms-supported: HorizontalBox {
                                            spacing: 8px;
                                            Text {
                                                text: "授权/改权限后，运行中的服务要重启才认：";
                                                font-size: 11px; color: #888; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
                                            }
                                            Button { text: "🔁 重启服务生效"; clicked => { root.restart-service-request(); } }
                                        }
                                    }
                                }
                                if !root.perms-supported: Text {
                                    text: "系统权限检测仅 macOS 需要（本机为其它系统）。";
                                    font-size: 11px;
                                    color: #888;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "说明：claude/codex 由「模型供应商配置」提供凭证，不再在运行期弹授权；pi/prime-agent 用自己的登录态（~/.pi、~/.prime，配了供应商则注入对应 key）。nodejs 是 codex/prime-agent/lark-cli 的前置；接入飞书 bot 时会自动装 lark 技能。";
                                    font-size: 11px;
                                    color: #888;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ═══════════ 模型供应商：左列表 + 右编辑（卡片面板） ═══════════
                    if root.current-page == 3: VerticalBox {
                        width: 100%;
                        height: 100%;
                        padding-top: 28px; padding-right: 22px; padding-bottom: 20px; padding-left: 22px;
                        spacing: 14px;

                        VerticalBox {
                            Text { text: "模型供应商"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                            Text { text: "Claude / Codex 或任意 OpenAI 兼容供应商"; font-size: 12px; color: Palette.foreground.with-alpha(0.55); }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 12px;
                            background: Palette.background;
                            HorizontalBox {
                                spacing: 0;
                                // ── 左：供应商列表 ──
                                VerticalBox {
                                    spacing: 8px;
                                    width: 210px;
                                    padding: 10px;
                                    Rectangle {
                                        background: Palette.alternate-background;
                                        border-radius: 10px;
                                        vertical-stretch: 1;
                                        ListView {
                                            for prov[idx] in root.providers: Rectangle {
                                                height: 44px;
                                                background: idx == root.provider-selected ? Palette.selection-background : transparent;
                                                border-radius: 8px;
                                                TouchArea {
                                                    clicked => { root.provider-selected = idx; root.provider-selection-changed(idx); }
                                                    VerticalBox {
                                                        padding-left: 10px;
                                                        spacing: 2px;
                                                        Text {
                                                            text: prov.name == "" ? "(未命名)" : prov.name;
                                                            color: idx == root.provider-selected ? Palette.selection-foreground : Palette.foreground;
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: prov.kind + (prov.is-default ? " · 默认" : "");
                                                            font-size: 11px;
                                                            color: idx == root.provider-selected ? Palette.selection-foreground.with-alpha(0.8) : #888;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalBox {
                                        spacing: 8px;
                                        Button { text: "＋ 添加"; clicked => { root.add-provider(); } }
                                        Button {
                                            text: "－ 删除";
                                            enabled: root.provider-selected >= 0;
                                            clicked => { root.remove-provider(root.provider-selected); }
                                        }
                                    }
                                }
                                // ── 右：编辑选中供应商 ──
                                VerticalBox {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    padding-top: 12px; padding-right: 14px; padding-bottom: 12px; padding-left: 14px;
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            spacing: 10px;
                                            alignment: start;
                                            GridBox {
                                                spacing: 6px;
                                                vertical-stretch: 0;
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "名称"; width: 96px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.providers[root.provider-selected].name;
                                                        placeholder-text: "唯一键，如 my-claude";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "name", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "类型"; width: 96px; vertical-alignment: center; }
                                                    ComboBox {
                                                        model: ["anthropic", "openai-chat", "openai-responses"];
                                                        current-value: root.providers[root.provider-selected].kind;
                                                        horizontal-stretch: 1;
                                                        selected => { root.provider-field-edited(root.provider-selected, "kind", self.current-value); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "Base URL"; width: 96px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.providers[root.provider-selected].base-url;
                                                        placeholder-text: "如 https://api.anthropic.com 或 https://api.openai.com/v1";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "base_url", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "API Key"; width: 96px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.providers[root.provider-selected].api-key;
                                                        input-type: password;
                                                        placeholder-text: "sk-...（留空=保留已存密钥）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "api_key", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "模型"; width: 96px; vertical-alignment: center; }
                                                    LineEdit {
                                                        text: root.providers[root.provider-selected].model;
                                                        placeholder-text: "如 claude-sonnet-4-5 / gpt-5（空=后端默认）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "model", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Rectangle { width: 96px; }
                                                    HorizontalBox {
                                                        spacing: 8px;
                                                        Button {
                                                            text: root.providers[root.provider-selected].is-default ? "★ 已是默认" : "设为默认";
                                                            enabled: !root.providers[root.provider-selected].is-default;
                                                            clicked => { root.set-default-provider(root.provider-selected); }
                                                        }
                                                        Button { text: "测试连接"; clicked => { root.test-provider(root.provider-selected); } }
                                                    }
                                                }
                                            }
                                            if root.provider-selected < 0: Text { text: "← 选择或添加一个供应商"; color: #888; }

                                            Text {
                                                text: "只支持 Anthropic 原生（claude / pi / prime-agent）与 OpenAI 兼容（codex / pi / prime-agent：chat / responses 两种接口）。claude 后端需 anthropic 型，codex 后端需 openai 型；pi/prime-agent 两种都吃（key 走对应 env）。桥内配置优先于 CC Switch。";
                                                font-size: 11px;
                                                color: #888;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── 底部共享：状态行 + 保存/取消（钉底；首页无表单，保存/取消只出现在配置页）──
            Rectangle {
                height: 46px;
                background: Palette.background;
                HorizontalBox {
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 8px;
                    Text {
                        // 有临时状态（保存/测试结果）优先显示；平时显示服务运行概览行
                        text: root.status-line != "" ? root.status-line : root.running-line;
                        color: root.status-line != "" && root.status-is-error ? #c00 : #2a7d2f;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.current-page != 0: Button { text: "关闭"; clicked => { root.cancel-clicked(); } }
                    if root.current-page != 0: Button {
                        text: root.service-running ? "保存并重启服务" : "保存";
                        primary: true;
                        clicked => { root.save-clicked(); }
                    }
                }
            }
        }
    }   // 关闭根 Rectangle（包内容防塌缩）
}
