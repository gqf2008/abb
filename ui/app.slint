// Agent Bridge — Slint 托盘 + 设置窗（macOS 菜单栏 accessory 应用）。
// 托盘模式对齐 ../brewfs（同为 Slint 1.17 SystemTrayIcon 的可用工程）：图标 @image-url、
// 托盘常驻、设置窗 show/hide。
// 注意（Slint 1.17 实测坑，勿改回 enabled 绑定）：托盘菜单项的 `enabled` 标量绑定在属性
//   变化后**不会**重建原生 NSMenu（PropertyTracker 依赖注册不全，首次求值后冻结；title 会变
//   但 enabled 不变）。可靠做法是**结构性** `if cond: MenuItem{...}`——条件翻转触发菜单重建
//   （appkit.rs 对 if/for 结构变化会 detach+重建 NSMenu，已实测生效）。故启停按钮用互斥 if。
import { LineEdit, ComboBox, Button, CheckBox, ScrollView, VerticalBox, HorizontalBox, GridBox, ListView, Palette } from "std-widgets.slint";
// 视觉改造（像素风）：slint-pixel 组件库。试点从环境配置页开始（PixelButton/
// PixelScrollPanel），推广后逐步移除 std 控件。
import { PixelBadge, PixelButton, PixelCard, PixelCheckBox, PixelComboBox, PixelScrollPanel, PixelSelect, PixelTabs, PixelTextArea, PixelTextInput, PixelTheme, PixelTitleBar } from "@slint_pixel";

// 托盘菜单里逐 bot 状态行：文字 + 状态小圆点图标（后端会转成 muda::IconMenuItem）。
// ═══════════ 设计令牌（UI/UX 审查）：语义色集中定义，替换全部硬编码彩色 ═══════════
// 原则：基础层走 PixelTheme（黑白像素体系）；状态语义色/文字层级走本令牌。
// 全部色值收敛于此，改一处全局生效；已按 PixelTheme.scheme 内置暗色适配值
// （未来开暗色模式时零改动兼容）。色值对比度按白底验算：
//   ok #0b8a3e ≈4.5:1 / info #0a6fc2 ≈5.2:1 / warn #b86f00 ≈3.9:1（配加粗）/ error #d13438 ≈4.9:1
//   text-dim #5c5c5c ≈4.6:1（替代原 #888/#aaa，原值不达 WCAG AA 正文 4.5:1）
export global UiTokens {
    // 语义状态色
    in property <color> ok: PixelTheme.scheme == "dark" ? #4caf50 : #0b8a3e;      // 成功/已安装/已授权
    in property <color> info: PixelTheme.scheme == "dark" ? #5ab0e8 : #0a6fc2;    // 信息/进行中/链接
    in property <color> warn: PixelTheme.scheme == "dark" ? #e0a800 : #b86f00;    // 警示/待处理（强调用加粗）
    in property <color> error: PixelTheme.scheme == "dark" ? #ff6b6b : #d13438;   // 错误/危险/超限
    // 语义色浅底（提示卡/横幅背景）
    in property <color> warn-bg: PixelTheme.scheme == "dark" ? #33280a : #fff8e6;    // 待处理卡底色
    in property <color> banner-bg: PixelTheme.scheme == "dark" ? #332b0a : #fff3cd;  // 环境横幅底色
    in property <color> error-bg: PixelTheme.scheme == "dark" ? #3a1212 : #fff1f0;   // 安装失败详情底色
    // 文字层级
    in property <color> text-dim: PixelTheme.scheme == "dark" ? #9a9a9a : #5c5c5c;        // 次要说明/占位（替代 #888）
    in property <color> text-disabled: PixelTheme.scheme == "dark" ? #6b6b6b : #9a9a9a;   // 停用/禁用态（弱化）
}

export struct BotMenuRow {
    title: string,
    icon: image,
}

// 托盘：SystemTrayIcon 是内置元素（macOS → NSStatusItem）。
export component Tray inherits SystemTrayIcon {
    // 托盘图标随整体状态变色：online=绿 / connecting=黄 / offline=红 / none=原灰白
    // #74 未读红点：unread-count>0 时换用 Rust 侧运行时合成的红点版图标
    // （合成选型：托盘图标是 16-22px 小图，加 4 张红点版资产与运行时合成二选一——
    // 运行时合成无新资产、不随源图配色漂移，且能复用既有 get_icon_online 等取图，
    // 代价是一次性合成代码；这里走合成，见 ui.rs composite_tray_dot）。
    in-out property <int> unread-count: 0;
    in-out property <string> tray-status: "none";
    in-out property <image> icon-online-dot: @image-url("tray-green.png");
    in-out property <image> icon-connecting-dot: @image-url("tray-yellow.png");
    in-out property <image> icon-offline-dot: @image-url("tray-red.png");
    in-out property <image> icon-dark-dot: @image-url("tray-dark.png");
    // 属性驱动而非 Rust 侧直接 set_icon：icon 是 tray-status/unread-count 的绑定，
    // 直接 set_icon 会破坏绑定（后续状态变化不再刷新图标）。
    icon: root.unread-count > 0 ?
        (root.tray-status == "online" ? root.icon-online-dot :
         root.tray-status == "connecting" ? root.icon-connecting-dot :
         root.tray-status == "offline" ? root.icon-offline-dot :
         root.icon-dark-dot) :
        (root.tray-status == "online" ? @image-url("tray-green.png") :
         root.tray-status == "connecting" ? @image-url("tray-yellow.png") :
         root.tray-status == "offline" ? @image-url("tray-red.png") :
         @image-url("tray-dark.png"));
    tooltip: "ABB";

    in-out property <[BotMenuRow]> bots-menu: [];  // 逐 bot 状态行（文字 + 状态图标）
    in-out property <image> icon-online: @image-url("tray-green.png");
    in-out property <image> icon-connecting: @image-url("tray-yellow.png");
    in-out property <image> icon-offline: @image-url("tray-red.png");
    in-out property <image> icon-disabled: @image-url("tray-gray.png");
    in-out property <image> icon-dark: @image-url("tray-dark.png");
    in-out property <bool> service-running: false;
    in-out property <bool> configured: false;
    in-out property <bool> autostart: false;
    in-out property <string> version: "";          // 当前版本号（Rust 启动时注入，菜单里常驻显示）
    // 版本升级：0=未查 1=检查中 2=已最新 3=有新版本 4=下载安装中 5=下载/安装失败 6=检查失败
    // （结构性 if 重建菜单，见文件头注释：enabled 绑定不可靠）
    in-out property <int> update-state: 0;
    in-out property <string> update-version: "";   // 发现的新版本号（state=3/4 用）
    in-out property <bool> update-can-install: false; // 本机平台有安装包（Linux 无 → 只提示）
    in-out property <string> update-progress: "";  // 下载安装中的进度文案（连接中…/45%（3.6/7.9 MB）/正在安装…）

    callback start-service();
    callback stop-service();
    callback restart-service();
    callback open-settings();
    callback open-logs();
    callback open-folder();
    callback toggle-autostart(bool);
    callback check-update();     // 手动检查更新（托盘菜单）
    callback install-update();   // 点「升级」：下载+安装+重启
    callback quit-app();

    // 左键点图标 = 打开设置（对齐 brewfs：clicked → show-window）
    clicked => { root.open-settings(); }

    Menu {
        // Bot 状态：分区标题（仅在有 bot 时出现）+ 逐 bot 行直接铺在主菜单（不嵌套子菜单）。
        if root.bots-menu.length > 0: MenuItem { title: "Bot 状态"; enabled: false; }
        for st in root.bots-menu: MenuItem { title: st.title; icon: st.icon; enabled: false; }
        if root.bots-menu.length > 0: MenuSeparator {}
        // 启停互斥（结构性，见文件头注释：enabled 绑定不可靠，用 if 翻转重建）
        if !root.service-running: MenuItem { title: "启动"; activated => { root.start-service(); } }
        if root.service-running: MenuItem { title: "停止"; activated => { root.stop-service(); } }
        if root.service-running: MenuItem { title: "重启"; activated => { root.restart-service(); } }
        MenuSeparator {}
        MenuItem { title: "设置…"; activated => { root.open-settings(); } }
        MenuItem { title: "打开日志"; activated => { root.open-logs(); } }
        MenuItem { title: "打开桥目录"; activated => { root.open-folder(); } }
        MenuSeparator {}
        // 开机自启：结构性 if（同启停，enabled/checkbox 绑定不可靠），点一下切换
        if !root.autostart: MenuItem { title: "开机自动启动：关"; activated => { root.toggle-autostart(true); } }
        if root.autostart: MenuItem { title: "开机自动启动：开"; activated => { root.toggle-autostart(false); } }
        MenuSeparator {}
        // ── 版本升级：永远只一项，标题常驻当前版本；可点的态点击即动作（结构性 if 重建，见文件头注释）──
        if root.update-state == 0: MenuItem { title: "版本 v" + root.version + " · 检查更新…"; activated => { root.check-update(); } }
        if root.update-state == 1: MenuItem { title: "版本 v" + root.version + " · 正在检查更新…"; enabled: false; }
        if root.update-state == 2: MenuItem { title: "版本 v" + root.version + " · 已是最新 ✓（点击重查）"; activated => { root.check-update(); } }
        if root.update-state == 3 && root.update-can-install: MenuItem { title: "⬆ 升级到新版本 v" + root.update-version + "（当前 v" + root.version + "）"; activated => { root.install-update(); } }
        if root.update-state == 3 && !root.update-can-install: MenuItem { title: "有新版本 v" + root.update-version + "（当前 v" + root.version + " · 请从源码更新，点击重查）"; activated => { root.check-update(); } }
        if root.update-state == 4: MenuItem { title: "正在下载安装 v" + root.update-version + "：" + root.update-progress; enabled: false; }
        if root.update-state == 5: MenuItem { title: "下载/安装失败，点击重试 v" + root.update-version + "（当前 v" + root.version + "）"; activated => { root.install-update(); } }
        if root.update-state == 6: MenuItem { title: "版本 v" + root.version + " · 检查失败，点击重试"; activated => { root.check-update(); } }
        MenuSeparator {}
        MenuItem { title: "退出"; activated => { root.quit-app(); } }
    }
}

// 一个已授权用户（owner_open_id 白名单是事实源，name 供展示）
export struct OwnerRow {
    name: string,        // 展示名（飞书反查；查不到=open_id）
    open_id: string,     // 飞书 open_id（事实键）
}

// 互斥选项行（后端三选一 / 对话权限二选一）：checked 由 Rust 按选中 bot 重算后整体替换
// model → for 循环重建 CheckBox 实例，绕开「用户交互移除 checked 绑定、状态残留到其它 bot」的坑。
export struct OptionRow {
    name: string,
    checked: bool,
}

// 编辑框/下拉的单元素行（value 存显示值）：交互（输入/选择）同样移除 text/value 绑定，
// 直接绑 root.bots[selected].x 会在切 bot 后残留上一 bot 的值；走单元素 model +
// for 循环重建实例（refresh_editors 装载/切 bot 时整体替换），与 OptionRow 同款绕法。
export struct EditorRow {
    value: string,
}

// 单个 bot 行的数据（与 Rust 侧 BotRow 对应）
export struct BotRow {
    name: string,        // 显示名
    kind: string,        // feishu | wechat | dingtalk
    enabled: bool,       // 是否启用（false 则 service 不启动此 bot）
    backend: string,     // 该 bot 的默认后端 claude | codex（跟着 bot 走，不是全局）
    provider: string,    // 该 bot 的模型供应商名（""=跟随全局 default_provider）
    owner-open-id: string, // 飞书：owner（管理员）白名单（逗号分隔 open_id）；微信 bot 不用
    owners: [OwnerRow],  // 飞书：owner 展示名（手填的没名字，列表备用；实际以输入框为准）
    granted: [OwnerRow], // 飞书：授权者列表（授权码添加，名字 + open_id）
    open-access: bool,   // 飞书：true=任何人都可以对话；false=仅授权用户（owner+授权者）
    app-id: string,
    app-secret: string,
    bot-name: string,    // 运行时获取的 bot 名
    bot-open-id: string,
    ding-user-id: string,    // 钉钉：旧单值 owner staffId（迁移到 ding-owner-ids）
    ding-owner-ids: string,  // 钉钉：owner（管理员）白名单（逗号分隔 staffId）
    ding-granted: [OwnerRow], // 钉钉：授权者列表（授权码添加，名字 + staffId）
    ding-open-access: bool,  // 钉钉：true=任何人都可以对话；false=仅授权用户
    ding-robot-code: string, // 钉钉：机器人编码（空=默认 AppKey）
    restrict-granted: bool, // 授权者 agent 会话隔离（true=受限模式，安全默认；false=与 owner 同权限）
    tidy-enabled: bool, // 每日工作目录整理（默认关：孤儿会话/临时文件/超期历史/文档归档 + git 留痕）
}

// 单个模型供应商行的数据（与 Rust 侧 ProviderRow 对应）
export struct ProviderRow {
    name: string,        // 唯一键
    kind: string,        // anthropic | openai-chat | openai-responses
    base-url: string,
    api-key: string,     // 密码框、加载后留空（编辑时重输=覆盖，留空=保留旧值）
    model: string,
    is-default: bool,    // 是否为全局默认供应商
}

// 虚拟 Bot 登记行（#75，与 Rust 侧 VirtualBotRow 对应）
export struct VirtualBotRow {
    role-name: string,   // 角色名（=平台群名）
    platform: string,    // 飞书 / 钉钉（微信排除）
    chat-id: string,     // 平台群会话 id（编辑/解散用）
    created-at: string,  // 登记时间（已格式化 YYYY-MM-DD HH:MM）
}

// 角色模板行（#75）：内置 + 自定义（前 builtin-count 个为内置，不可编辑/删除）
export struct RoleTemplateRow {
    name: string,
    prompt: string,
    checked: bool,   // 模板批量创建时是否勾选
}

// #74 历史记录页的单条消息（与 Rust 侧 HistoryRow 对应）
export struct HistoryRow {
    id: int,             // 消息库行 id（选中/详情定位用）
    bot: string,         // bot 展示名（config 反查，查不到用 key）
    kind: string,        // 平台（飞书/钉钉）
    sender: string,      // 发送者展示名（config 授权名单反查，查不到用 id）
    time: string,        // MM-DD HH:MM
    direction: string,   // 用户 / 回复
    preview: string,     // 摘要（列表行）
    text: string,        // 完整文本（详情区）
}

// 微信扫码登录二维码弹窗：直接在 GUI 里显示二维码，避免依赖系统看图。
export component QrDialog inherits Window {
    title: "微信扫码登录";
    width: 360px;
    height: 440px;
    preferred-width: 360px;
    preferred-height: 440px;
    background: PixelTheme.bg;
    in-out property <image> qr-image;
    in-out property <string> tip: "请用微信扫描二维码";
    callback close-clicked();

    // 根 Rectangle 铺满不透明背景：透明标题栏 + 内容铺满时防止「窗口透明只剩红绿灯」
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;
            spacing: 12px;
            alignment: center;
        Text { text: root.tip; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
        Rectangle {
            background: white;
            border-radius: 4px;
            min-height: 300px;
            Image {
                source: root.qr-image;
                width: 300px;
                height: 300px;
                image-fit: contain;
            }
        }
        Text { text: "扫不上就点「取消」重新获取"; font-size: 12px; color: UiTokens.text-dim; horizontal-alignment: center; }
        HorizontalBox {
            alignment: center;
            PixelButton { text: "取消"; clicked => { root.close-clicked(); } }
            }
        }
    }
}

// #74 授权者私聊提醒弹窗（toast）：屏幕右上角弹出，展示 unread.json 里最近几条
// （发送者/摘要/时间，最新在上，最多 8 条），约 5 秒自动收起；点条目 → 打开设置窗
// 历史记录页（弹窗内容即「已读」，收起后 unread.json 已清）。
// no-frame 无系统标题栏（toast 不该有标题栏）；根 Rectangle 铺满不透明背景防透明坑
// （同 QrDialog 纪律）。
export struct NotifyRow {
    sender: string,   // 展示名（GUI 经 config 授权者名单反查，查不到用 id）
    bot: string,      // bot 展示名（经 config 反查，查不到用 key）
    preview: string,
    time: string,     // MM-DD HH:MM
}
export component NotificationsWindow inherits Window {
    title: "新消息提醒";
    width: 340px;
    height: 88px;
    preferred-width: 340px;
    preferred-height: 88px;
    no-frame: true;
    background: PixelTheme.bg;
    in-out property <[NotifyRow]> items: [];
    callback open-history();   // 点面板：打开设置窗历史记录页（已读）
    callback dismiss();        // 手动收起（5s 自动收起在 Rust 侧走同一路径）

    // 8-20 用户反馈：toast 是"小面板"——88px 高，标题行（含条数）+ 最新一条摘要，
    // 整面板可点（点击 = 已读 + 跳历史页）；更多条数在标题里提示。
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        // 整面板点击热区（声明在底层，文字在上层可读）
        TouchArea { clicked => { root.open-history(); } }
        VerticalBox {
            padding: 10px;
            spacing: 4px;
            Text {
                text: root.items.length > 1 ? "🔔 多条新消息" : "🔔 新消息提醒";
                font-size: 12px;
                font-weight: 700;
                color: PixelTheme.text;
            }
            Text {
                text: root.items.length > 0
                    ? root.items[0].sender + "：" + root.items[0].preview
                    : "";
                font-size: 12px;
                overflow: elide;
                width: 100%;
                color: PixelTheme.text.with-alpha(0.85);
            }
        }
    }
}

// 设置窗：微软电脑管家式布局 —— 左侧导航 + 首页仪表盘 + 卡片化三个配置页。
// 底部共享状态行 + 保存/取消。页面切换用 current-page 结构性 if（与托盘菜单同手法）。

// ═══════════ 复用小组件（干净扁平：SVG 单色图标 + 1px 描边卡片，深浅色自适应） ═══════════

// 单色 SVG 图标：颜色随 Palette 着色（colorize），避免 Unicode 字符在字体里缺字形渲染成方框。
component ImageIcon inherits Image {
    in property <image> icon;
    in property <brush> tint: PixelTheme.text.with-alpha(0.7);
    source: root.icon;
    colorize: root.tint;
    width: 18px;
    height: 18px;
    image-fit: contain;
}

// ═══════════ 全局页面样式（所有 tab 页统一，改一处全生效） ═══════════
// 页面根容器：padding 20 + spacing 14（各页切换视觉稳定）。
// 不设 alignment：VerticalBox 默认让 vertical-stretch>0 的子元素（机器人/环境/供应商页
// 的列表+编辑区）拉伸填满主体；首页内容少且全 fixed/无 stretch 时自然顶对齐 + 底留白
// （靠 PageHeader 的 vertical-stretch:0 避免 PageHeader 被分配剩余空间把内容顶下去）。
component PageContainer inherits VerticalBox {
    width: 100%;
    height: 100%;
    padding: 20px;
    spacing: 14px;
    @children
}

// 页头：标题 + 副标题（统一字号/间距/颜色）
// vertical-stretch: 0 —— 页头不参与剩余空间拉伸，保持 natural 高（标题+副标题），
// 避免首页内容少时 PageHeader 被分配剩余空间撑高、把 hero/快捷卡顶到中下部。
component PageHeader inherits VerticalBox {
    in property <string> title: "";
    in property <string> subtitle: "";
    spacing: 4px;
    vertical-stretch: 0;
    Text { text: root.title; font-size: 18px; font-weight: 700; color: PixelTheme.text; }
    Text { text: root.subtitle; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
}

// 状态小胶囊：半透明底 + 语义色文字（比实底更柔和）。
// 状态徽章：slint-pixel PixelBadge 外壳（像素阴影块 + 边框），ok/warn 语义色映射。
component StatusPill inherits PixelBadge {
    in property <bool> ok: false;
    in property <bool> warn: false;
    width: 84px;
    font-size: 12px;
    face: root.ok ? UiTokens.ok : (root.warn ? UiTokens.warn : UiTokens.error);
    text-color: #ffffff;
    border: PixelTheme.edge;
}

// 待处理建议行：左文案 + 右侧「去处理」小按钮，点击跳对应页（火绒「主页建议」同款交互）。
component ProblemRow inherits HorizontalBox {
    in property <string> text: "";
    in property <string> action: "去处理 ›";
    callback clicked();
    height: 28px;
    spacing: 8px;
    Text {
        text: root.text;
        font-size: 13px;
        color: PixelTheme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Rectangle {
        width: 84px;
        height: 24px;
        border-radius: 4px;
        background: UiTokens.warn-bg;
        TouchArea {
            clicked => { root.clicked(); }
            Text {
                text: root.action;
                font-size: 12px;
                font-weight: 600;
                color: UiTokens.warn;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
}

// 首页快捷操作卡：slint-pixel PixelCard 外壳（阴影块 + 硬边框像素观感），
// 内容（icon/desc/action）在 PixelCard 插槽内自排；TouchArea 覆盖整卡响应点击。
component QuickCard inherits Rectangle {
    in property <string> title: "";
    in property <string> desc: "";
    in property <image> icon;
    in property <string> action-label: "前往 ›";
    callback clicked();
    height: 122px;
    horizontal-stretch: 1;
    PixelCard {
        width: 100%;
        height: 100%;
        title: root.title;
        title-color: PixelTheme.text;
        VerticalLayout {
            spacing: 6px;
            ImageIcon { icon: root.icon; tint: PixelTheme.accent; }
            Text { text: root.desc; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); wrap: word-wrap; }
            Text { text: root.action-label; font-size: 12px; font-weight: 600; color: PixelTheme.accent; }
        }
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// 通用确认弹窗：关闭/取消时未保存编辑、以及打开时发现草稿，两种场景复用。
// 文案/按钮由 Rust 侧按场景设置（title-text/message/primary/discard/stay；show-stay=false 隐藏中间按钮）。
export component UnsavedDialog inherits Window {
    title: root.title-text;
    width: 460px;
    height: 200px;
    preferred-width: 460px;
    preferred-height: 200px;
    background: PixelTheme.bg;
    in-out property <string> title-text: "未保存的修改";
    in-out property <string> message: "保存会写入配置，服务在跑时会重启使其生效。";
    in-out property <string> primary-text: "保存并关闭";
    in-out property <string> discard-text: "不保存";
    in-out property <string> stay-text: "取消";
    in-out property <bool> show-stay: true;
    callback save-close();    // 主操作（保存并关闭 / 恢复草稿）
    callback discard-close(); // 次操作（不保存关闭 / 丢弃草稿）
    callback stay();          // 留在设置窗

    // 根 Rectangle 铺满不透明背景（同 QrDialog：透明标题栏 + 内容铺满防透明坑）
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;
            spacing: 10px;
        Text {
            text: root.title-text;
            font-size: 15px;
            font-weight: 700;
            color: PixelTheme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.message;
            font-size: 13px;
            color: PixelTheme.text.with-alpha(0.7);
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            PixelButton { text: root.discard-text; clicked => { root.discard-close(); } }
            if root.show-stay: PixelButton { text: root.stay-text; clicked => { root.stay(); } }
            PixelButton { text: root.primary-text; variant: "primary"; clicked => { root.save-close(); } }
            }
        }
    }
}

// 通用确认弹窗（#75）：取消登记（轻确认）/ 解散群（danger=红色主按钮强确认）复用。
// 文案与按钮由 Rust 侧按场景设置（title-text/message/confirm-text/danger）。
export component ConfirmDialog inherits Window {
    title: root.title-text;
    width: 460px;
    height: 210px;
    preferred-width: 460px;
    preferred-height: 210px;
    background: PixelTheme.bg;
    in-out property <string> title-text: "确认操作";
    in-out property <string> message: "";
    in-out property <string> confirm-text: "确认";
    in-out property <string> cancel-text: "取消";
    in-out property <bool> danger: false;   // true=主按钮红色（强确认）
    // busy（8-20）：确认后转"执行中"（按钮禁用，防连点）；结果回来由 Rust 侧
    // 更新 message/按钮文案——成功即关，失败显示错误让用户看到（不再静默关窗）
    in-out property <bool> busy: false;
    // failed（8-20）：操作失败态——主按钮变「重试」（action 保留可重发），
    // 取消按钮禁用（成功才能正常关闭；红点 X 仍是放弃出口）
    in-out property <bool> failed: false;
    callback confirmed();
    callback canceled();

    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;
            spacing: 10px;
        Text {
            text: root.title-text;
            font-size: 15px;
            font-weight: 700;
            color: PixelTheme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.message;
            font-size: 13px;
            color: PixelTheme.text.with-alpha(0.7);
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            PixelButton { text: root.cancel-text; enabled: !root.busy && !root.failed; clicked => { root.canceled(); } }
            PixelButton { text: root.confirm-text; variant: root.danger ? "danger" : "primary"; enabled: !root.busy; clicked => { root.confirmed(); } }
            }
        }
    }
}

// 虚拟 Bot 创建/编辑/登记弹窗（#75）。
// 模式：0=自定义创建 1=模板批量创建 2=手动登记（降级路径） 3=编辑。
// 数据流：Rust 侧读写 in-out 属性（预填/校验计数/进度/结果），slint 只负责布局与交互。
// 群名 ≤60、提示词 ≤100 为飞书群名/群描述限制（钉钉暂同）——字符计数由 Rust 侧按
// 字符数（非字节）计算后回填（slint 的 string.length 在中文上不可靠，双保险）。
export component VirtualBotDialog inherits Window {
    title: root.window-title;
    width: 620px;
    height: 680px;
    preferred-width: 620px;
    preferred-height: 680px;
    background: PixelTheme.bg;

    in-out property <string> window-title: "创建虚拟 Bot";
    in-out property <string> bot-label: "";        // 归属 bot 展示名
    in-out property <string> platform-label: "";   // 飞书 / 钉钉
    // 模式：0=自定义创建 1=模板批量创建 2=手动登记 3=编辑
    in-out property <int> mode: 0;
    in-out property <string> name-input: "";
    in-out property <string> prompt-input: "";
    in-out property <string> prefix-input: "";     // 模板批量：群名前缀（可选）
    in-out property <[RoleTemplateRow]> templates: [];
    in-out property <int> builtin-count: 0;        // 前 N 个为内置模板（不可编辑/删除）
    in-out property <int> selected-count: 0;       // 勾选模板数（Rust 维护，summary 用）
    // 模板编辑内嵌表单（template-editing=true 时显示；idx=-1=新建）
    in-out property <bool> template-editing: false;
    in-out property <int> template-edit-idx: -1;
    in-out property <string> template-edit-name: "";
    in-out property <string> template-edit-prompt: "";
    // 手动登记（降级路径）：chat_id 输入
    in-out property <string> register-chat-id: "";
    // 编辑模式：目标 chat_id（保存 = PATCH 平台 + 登记同步）
    in-out property <string> edit-chat-id: "";
    // 进度与结果（创建中 2/4 → 逐群汇总）
    in-out property <bool> busy: false;
    in-out property <string> progress-text: "";
    in-out property <[string]> results: [];
    // 字符计数（Rust 侧 chars().count() 回填；中文安全）
    in-out property <int> name-count: 0;
    in-out property <int> prompt-count: 0;
    // 表单校验提示
    in-out property <string> hint-text: "";
    in-out property <bool> hint-error: false;

    callback close-clicked();
    callback create-clicked();        // Rust 按 mode 分发：创建/批量/登记/保存编辑
    callback mode-switched(int);
    callback name-edited();
    callback prompt-edited();
    callback generate-prompt();       // ✨ 生成提示词（根据群名，LLM 生成群介绍）
    callback template-toggled(int);
    callback template-save-clicked();
    callback template-cancel-clicked();
    callback template-edit-clicked(int);
    callback template-delete-clicked(int);

    // 创建/保存按钮可用性（busy 时全部禁用防连点；字符计数由 Rust 回填，见 name-edited）
    property <bool> create-ok: !root.busy && (
        root.mode == 0 ? (root.name-count > 0 && root.name-count <= 60 && root.prompt-count <= 100)
        : root.mode == 1 ? root.selected-count > 0
        : root.mode == 2 ? (root.name-count > 0 && root.name-count <= 60 && root.register-chat-id != "")
        : (root.name-count > 0 && root.name-count <= 60 && root.prompt-count <= 100));

    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        VerticalBox {
            padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
            spacing: 8px;

            // ── 标题行：归属 bot + 平台 ──
            HorizontalBox {
                spacing: 8px;
                ImageIcon { icon: @image-url("icons/bot.svg"); tint: PixelTheme.accent; vertical-alignment: center; }
                Text {
                    text: root.window-title + "（" + root.bot-label + " · " + root.platform-label + "）";
                    font-size: 15px;
                    font-weight: 700;
                    color: PixelTheme.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            // ── 模式切换（编辑模式隐藏：固定为保存流） ──
            if root.mode != 3: HorizontalBox {
                spacing: 8px;
                PixelButton { text: "自定义创建"; size: "small"; variant: root.mode == 0 ? "primary" : "default"; enabled: !root.busy; clicked => { root.mode = 0; root.mode-switched(0); } }
                PixelButton { text: "从模板批量创建"; size: "small"; variant: root.mode == 1 ? "primary" : "default"; enabled: !root.busy; clicked => { root.mode = 1; root.mode-switched(1); } }
                PixelButton { text: "手动登记"; size: "small"; variant: root.mode == 2 ? "primary" : "default"; enabled: !root.busy; clicked => { root.mode = 2; root.mode-switched(2); } }
            }

            // ── 模式 0/3：自定义创建 / 编辑 ──
            if root.mode == 0 || root.mode == 3: VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群名（角色名）"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.name-input;
                        placeholder: "如：后端开发（≤60 字符）";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.name-input = self.text; root.name-edited(); }
                    }
                    Text { text: root.name-count + "/60"; font-size: 12px; color: root.name-count > 60 ? UiTokens.error : UiTokens.text-dim; vertical-alignment: center; }
                    // 「✨ 生成」：根据群名让 LLM 写系统提示词（≤100 字符，回填下方输入框）
                    PixelButton {
                        text: root.busy ? "生成中…" : "✨ 生成";
                        size: "small";
                        variant: "ghost";
                        enabled: !root.busy && root.name-input != "";
                        clicked => { root.generate-prompt(); }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "提示词（群介绍）"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: top; }
                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        // 多行文本域（8-20 需求）：system prompt 通常是多行角色设定
                        PixelTextArea {
                            text: root.prompt-input;
                            placeholder: "system prompt，≤100 字符（如：你是后端开发工程师……）";
                            frame-height: 110px;
                            enabled: !root.busy;
                            edited => { root.prompt-input = self.text; root.prompt-edited(); }
                        }
                        Text {
                            text: root.prompt-count + "/100";
                            font-size: 12px;
                            color: root.prompt-count > 100 ? UiTokens.error : UiTokens.text-dim;
                        }
                    }
                }
                if root.mode == 3: Text {
                    text: "保存 = 平台改群名/群介绍（PATCH）+ 本地登记同步。改名会改变 deliver 的 @角色名 寻址。";
                    font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                }
                // 预览卡：所见即所得（群资料卡样式）
                Rectangle {
                    border-radius: 4px;
                    background: PixelTheme.panel;
                    border-width: 1px;
                    border-color: PixelTheme.edge;
                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "预览（群资料卡）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                        HorizontalBox {
                            spacing: 10px;
                            Rectangle {
                                width: 42px; height: 42px;
                                border-radius: 21px;
                                background: PixelTheme.accent;
                                HorizontalBox {
                                    width: 100%; height: 100%;
                                    alignment: center;
                                    ImageIcon { icon: @image-url("icons/bot.svg"); tint: #fff; }
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                Text { text: root.name-input == "" ? "（群名）" : root.name-input; font-weight: 600; font-size: 13px; color: PixelTheme.text; }
                                Text { text: root.prompt-input == "" ? "（群介绍）" : root.prompt-input; font-size: 12px; color: PixelTheme.text.with-alpha(0.6); wrap: word-wrap; }
                            }
                        }
                    }
                }
            }

            // ── 模式 1：模板批量创建 ──
            if root.mode == 1: VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群名前缀"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.prefix-input;
                        placeholder: "可选，如：智能硬件项目 → 群名「智能硬件项目·后端开发」";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.prefix-input = self.text; }
                    }
                }
                Text { text: "勾选要创建的角色群（内置 + 自定义模板）："; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); }
                // 模板列表：勾选 + 自定义模板的编辑/删除
                Rectangle {
                    height: 150px;
                    border-radius: 4px;
                    background: PixelTheme.panel;
                    border-width: 1px;
                    border-color: PixelTheme.edge;
                    PixelScrollPanel {
                        VerticalBox {
                            width: 100%;
                            spacing: 2px;
                            for t[i] in root.templates: HorizontalBox {
                                height: 30px;
                                spacing: 8px;
                                PixelCheckBox {
                                    text: t.name;
                                    checked: t.checked;
                                    enabled: !root.busy;
                                    toggled => { root.template-toggled(i); }
                                }
                                Text {
                                    text: t.prompt;
                                    font-size: 11px;
                                    color: PixelTheme.text.with-alpha(0.5);
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if i >= root.builtin-count: PixelButton { text: "编辑"; size: "small"; enabled: !root.busy; clicked => { root.template-edit-clicked(i); } }
                                if i >= root.builtin-count: PixelButton { text: "删"; size: "small"; enabled: !root.busy; clicked => { root.template-delete-clicked(i); } }
                            }
                        }
                    }
                }
                // 模板编辑内嵌表单（新建/编辑自定义模板）
                if root.template-editing: Rectangle {
                    border-radius: 4px;
                    background: PixelTheme.bg;
                    border-width: 1px;
                    border-color: PixelTheme.accent;
                    VerticalBox {
                        padding: 8px;
                        spacing: 5px;
                        Text { text: root.template-edit-idx < 0 ? "＋ 自定义模板" : "编辑自定义模板"; font-size: 12px; font-weight: 700; color: PixelTheme.text; }
                        PixelTextInput {
                            text: root.template-edit-name;
                            placeholder: "模板名（≤60 字符，不可与内置/其它自定义重名）";
                            edited => { root.template-edit-name = self.text; }
                        }
                        PixelTextInput {
                            text: root.template-edit-prompt;
                            placeholder: "提示词（≤100 字符）";
                            edited => { root.template-edit-prompt = self.text; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            PixelButton { text: "取消"; size: "small"; clicked => { root.template-cancel-clicked(); } }
                            PixelButton { text: "保存模板"; size: "small"; variant: "primary"; clicked => { root.template-save-clicked(); } }
                        }
                    }
                }
                if !root.template-editing: PixelButton { text: "＋ 自定义模板"; size: "small"; variant: "ghost"; clicked => { root.template-edit-clicked(-1); } }
                Text {
                    text: "将创建 " + root.selected-count + " 个群" + (root.prefix-input == "" ? "" : "（前缀「" + root.prefix-input + "·」）");
                    font-size: 12px;
                    font-weight: 600;
                    color: root.selected-count > 0 ? UiTokens.info : UiTokens.text-dim;
                }
            }

            // ── 模式 2：手动登记（降级路径：平台手动建群后登记 chat_id） ──
            if root.mode == 2: VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群名（角色名）"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.name-input;
                        placeholder: "如：后端开发（≤60 字符）";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.name-input = self.text; root.name-edited(); }
                    }
                    Text { text: root.name-count + "/60"; font-size: 12px; color: root.name-count > 60 ? UiTokens.error : UiTokens.text-dim; vertical-alignment: center; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "群 chat_id"; width: 90px; font-size: 12px; color: PixelTheme.text.with-alpha(0.7); vertical-alignment: center; }
                    PixelTextInput {
                        text: root.register-chat-id;
                        placeholder: "飞书 oc_xxx / 钉钉 cidxxx（群消息日志里有）";
                        horizontal-stretch: 1;
                        enabled: !root.busy;
                        edited => { root.register-chat-id = self.text; }
                    }
                }
                Text {
                    text: root.platform-label == "钉钉" ? "降级路径：机器人建群失败时，在钉钉手动建群（群名=角色名），把群内消息日志里的 chat_id 填这里。钉钉群无「群介绍」字段，角色提示词只能注入群名。" : "降级路径：API 建群失败时，平台手动建群（群名=角色名、群介绍=提示词），把 chat_id 填这里。";
                    font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                }
            }

            // ── 校验提示 ──
            if root.hint-text != "": Text {
                text: root.hint-text;
                font-size: 12px;
                color: root.hint-error ? UiTokens.error : UiTokens.text-dim;
                wrap: word-wrap;
            }

            // ── 进度与结果（busy 或已有结果时显示） ──
            if root.busy || root.results.length > 0: Rectangle {
                border-radius: 4px;
                background: PixelTheme.panel;
                border-width: 1px;
                border-color: PixelTheme.edge;
                VerticalBox {
                    padding: 8px;
                    spacing: 4px;
                    if root.busy: Text { text: root.progress-text; font-size: 12px; font-weight: 600; color: UiTokens.info; }
                    PixelScrollPanel {
                        height: 110px;
                        VerticalBox {
                            width: 100%;
                            spacing: 2px;
                            for r[i] in root.results: Text { text: r; font-size: 12px; color: PixelTheme.text.with-alpha(0.8); wrap: word-wrap; }
                        }
                    }
                }
            }

            // ── 底部按钮 ──
            HorizontalBox {
                alignment: center;
                spacing: 10px;
                PixelButton {
                    text: root.mode == 0 ? "创建群" : (root.mode == 1 ? "批量创建" : (root.mode == 2 ? "登记" : "保存修改"));
                    enabled: root.create-ok;
                    clicked => { root.create-clicked(); }
                }
                PixelButton { text: "关闭"; variant: "ghost"; enabled: !root.busy; clicked => { root.close-clicked(); } }
            }
        }
    }
}

// 设置窗主体。
export component SettingsWindow inherits Window {
    // 像素风自绘窗口：无系统边框/红绿灯，PixelTitleBar 自绘标题栏（拖拽/最小化/最大化/关闭）
    no-frame: true;
    // 打开时由 Rust 侧提升为 regular 策略（带 dock 图标 + 置前聚焦），关掉降回 accessory。
    // 不用 always-on-top：那会浮在别的 app 之上却没焦点，别扭。标题带实时 bot 数。
    title: root.window-title;
    // 窗口 + Dock 图标（提升为 regular 后 Dock 用）。1024px 源，macOS 自动缩放。
    icon: @image-url("../app-assets/icon-1024.png");
    // 可缩放窗口（8-20 用户实测决策）：不设固定 width/height 绑定——固定尺寸与
    // set_maximized 冲突（最大化后被 size 拉回，视觉"越点越小"）。preferred-* 定初始
    // 尺寸，min-* 防内容塌陷（初始 bots 为空时内容高度算 0 的坑由 min-height 兜住）。
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 880px;
    min-height: 620px;
    background: PixelTheme.panel;

    in-out property <string> window-title: "ABB 设置";
    // 应用版本号（Rust 侧 env!("CARGO_PKG_VERSION") 注入；空 = 不显示）
    in-out property <string> version: "";
    // 当前页：0=首页 1=机器人配置 2=环境配置 3=模型供应商
    in-out property <int> current-page: 0;
    // 首页 hero / 状态卡用的结构化状态（running-line 保留给底部状态行）
    in-out property <bool> service-running: false;
    in-out property <bool> autostart: false;
    in-out property <int> bot-count: 0;
    in-out property <int> online-count: 0;
    in-out property <string> running-line: "";   // 底部运行概览（N 个 bot 在线…）；status-line 非空时优先显示 status-line
    in-out property <[BotRow]> bots: [];
    in-out property <int> selected: -1;   // 当前选中的 bot 下标，-1=无
    // 三个独立开关（启用/授权者隔离/每日整理）的显示态。刻意不直接绑
    // root.bots[selected].x 或独立 bool property：PixelCheckBox 交互内部赋值
    // 会移除 checked 绑定（无论绑什么），切 bot 后残留上一 bot 的状态（#80 回归：
    // 点 A 的每日整理 B 也显示改）。绕法同 backend-options：单元素 model +
    // for 循环重建实例，由 Rust 侧在装载/切 bot/写回时整体替换 model。
    in-out property <[OptionRow]> enabled-options: [];
    in-out property <[OptionRow]> restrict-options: [];
    in-out property <[OptionRow]> tidy-options: [];
    // 文本编辑框/下拉的单元素 model（name/provider/owner/app_id/app_secret/
    // ding_robot_code/ding_owner_ids 各一）：输入/选择交互断绑后显示不跟随，切 bot
    // 时由 refresh_editors 整体替换 model → for 重建实例（同 OptionRow 绕法）。
    in-out property <[EditorRow]> name-editor-options: [];
    in-out property <[EditorRow]> provider-editor-options: [];
    in-out property <[EditorRow]> owner-editor-options: [];
    in-out property <[EditorRow]> app-id-editor-options: [];
    in-out property <[EditorRow]> app-secret-editor-options: [];
    in-out property <[EditorRow]> ding-robot-code-editor-options: [];
    in-out property <[EditorRow]> ding-owner-ids-editor-options: [];
    in-out property <string> status-line;
    in-out property <bool> status-is-error: true;   // true=红（报错）/ false=绿（成功/信息）
    // 跨会话投递总开关（#21）：打开后 agent 可用 `$ABB_BIN deliver` 投递到其它 bot 的会话。
    in-out property <bool> cross-delivery-enabled: false;
    // #74 历史记录页：提醒总开关 / 保留期（天）/ 消息列表（Rust 侧整体替换 model 刷新）
    in-out property <bool> notify-enabled: true;
    in-out property <int> history-retention-days: 30;
    in-out property <bool> session-gc-enabled: false;   // 每日会话归纳清理（#78，默认关）
    in-out property <int> session-gc-days: 7;           // 过期判定天数（3/7/14/30）
    in-out property <[HistoryRow]> history-rows: [];
    // 虚拟 Bot 手动刷新进行中（#75）：禁用刷新按钮防连点 + 按钮文字"同步中"
    in-out property <bool> vb-syncing: false;
    in-out property <int> history-selected: -1;

    // 环境配置（依赖检测）：各项是否在本机可执行路径上
    in-out property <bool> claude-installed: false;
    in-out property <bool> codex-installed: false;
    // #93 codex 最低版本锁定：codex-version=检测到的版本串；codex-ok=已装且版本 >= MIN_CODEX_VERSION。
    in-out property <string> codex-version: "";
    in-out property <bool> codex-ok: false;
    in-out property <bool> pi-installed: false;
    in-out property <bool> node-installed: false;
    in-out property <bool> python-installed: false;
    in-out property <bool> lark-installed: false;
    in-out property <bool> dingtalk-installed: false; // dingtalk-cli (dws)
    // #105 git 三态：git-version=检测到的版本串；git-ok=已装且版本 >= MIN_GIT_VERSION。
    in-out property <bool> git-installed: false;
    in-out property <string> git-version: "";
    in-out property <bool> git-ok: false;
    // claude/codex/pi 任一未装 = true：环境配置页顶部显示醒目横幅（首次启动也据此自动弹出设置窗引导安装）。
    in-out property <bool> missing-agent: false;
    // 正在安装的依赖 id（""=空闲）。用于禁用其它安装按钮 + 显示进度文案。
    in-out property <string> dep-busy: "";
    in-out property <string> dep-detail: ""; // 安装失败详情（分类 + 怎么办 + 原始错误）
    // 最近一次一键安装的失败项数（>0 = 首页「待处理」卡显示安装失败行，点击切环境配置页）。
    in-out property <int> dep-failed-count: 0;

    // 系统权限（仅 macOS）：完全磁盘/辅助功能/屏幕录制/自动化/摄像头/麦克风。0=未授权 1=被拒绝 2=已授权
    in-out property <int> perm-full-disk: 0;
    in-out property <int> perm-accessibility: 0;
    in-out property <int> perm-screen: 0;
    in-out property <int> perm-automation: 0;
    in-out property <int> perm-camera: 0;
    in-out property <int> perm-microphone: 0;
    // Windows 专用：是否以管理员身份运行（0=否 2=是）
    in-out property <int> perm-admin: 0;
    // 平台：macos | windows | linux（决定权限区显示什么）
    in-out property <string> platform: "macos";
    // 权限请求子进程是否在跑（防连点；同时给个进度提示）
    in-out property <bool> perm-busy: false;
    // 是否为 macOS（非 mac 不显示系统权限区，显示「仅 macOS 需要」）
    in-out property <bool> perms-supported: false;

    // 模型供应商配置
    in-out property <[ProviderRow]> providers: [];
    in-out property <int> provider-selected: -1;
    in-out property <[string]> provider-names: [];   // 供 bot 页的供应商下拉（[""] + 各 name）
    // 当前选中 bot 的未过期授权码展示：owner-code-info=管理员码行、grant-code-info=普通授权码行
    // （"授权码：xxxx（剩 N 分钟）"；无则空）。生成后/热刷新更新。
    in-out property <string> owner-code-info: "";
    in-out property <string> grant-code-info: "";
    // 互斥 CheckBox 的勾选状态（Rust 侧按选中 bot 重算；slint 表达式绑定会被用户交互破坏——
    // 点击后 in-out 属性绑定失效、状态残留到其它 bot，故用显式 property 驱动）
    in-out property <[OptionRow]> backend-options: [
        { name: "claude", checked: true },
        { name: "codex", checked: false },
        { name: "pi", checked: false },
    ];
    in-out property <[OptionRow]> access-options: [
        { name: "仅授权用户", checked: true },
        { name: "任何人都可以对话", checked: false },
    ];
    in-out property <[OptionRow]> ding-access-options: [
        { name: "仅授权用户", checked: true },
        { name: "任何人都可以对话", checked: false },
    ];
    // 虚拟 Bot（#75）：当前选中 bot 的登记列表（Rust 按选中 bot 刷新）
    in-out property <[VirtualBotRow]> virtual-bots: [];
    // ⋯ 菜单展开的行下标（-1=收起；点击行内「⋯」切换）
    in-out property <int> vb-menu-open: -1;

    callback save-clicked();
    callback cancel-clicked();
    callback start-service();       // 首页 hero：启动后台服务
    callback stop-service();        // 首页 hero：停止后台服务
    callback restart-service();     // 预留：与托盘一致
    callback open-logs();           // 首页 hero：打开日志目录
    callback fetch-bot-info(int);          // 对某个 bot 拉 name/open_id（飞书）
    callback wx-login(int);                // 对某个 bot 微信扫码登录
    callback add-bot();
    callback remove-bot(int);
    callback selection-changed(int);   // 切中别的 bot：让 Rust 侧重建 model 强制刷新编辑区（ComboBox current-value 不随 model 变，需 model 变更通知）

    // 编辑区变更时回写 bots[selected]。**只回写被改的那一个字段**（field+value）——
    // 旧版 bot-edited 一次传全部字段、未改字段从 model 读，而 model 在编辑后不同步（过期），
    // 连改两个字段会用过期值把前一个字段的修改静默回滚。按字段回写则无此问题。
    callback bot-field-edited(int, string, string); // idx, field(name/kind/backend/provider/owner/app_id/app_secret), value
    callback backend-option-toggled(int);  // 后端选项下标（0=claude 1=codex 2=pi）
    callback access-option-toggled(int);   // 飞书对话权限下标（0=仅授权 1=任何人）
    callback ding-access-option-toggled(int); // 钉钉对话权限下标
    callback generate-owner-code(int, string); // 生成授权码：bot idx + role（"owner"=管理员码 / "granted"=普通码），覆盖同类型旧码
    callback copy-owner-code(string);          // 复制指定 role 的授权码到剪贴板
    callback remove-granted(int, int); // 取消授权：bot idx + 授权者下标（从授权者白名单移除）
    callback set-bot-enabled(int, bool); // 启用/停用某 bot（保存重启后生效）
    callback set-restrict-granted(int, bool); // 授权者 agent 隔离开关（true=受限模式，保存后即时生效）
    callback set-tidy-enabled(int, bool); // 每日工作目录整理开关（默认关，保存后即时生效）
    callback set-cross-delivery(bool);   // 跨会话投递总开关（保存重启后生效）
    callback open-url(string); // 打开外部链接（依赖文档 / 申请 token 等，默认浏览器）
    callback recheck-deps();            // 重新检测依赖是否已装
    callback install-dep(string);       // 安装某个依赖（claude/codex/pi/node/python3/lark-cli/dingtalk-cli/git）
    callback install-all-missing();     // #60 一键安装全部缺失组件（node 前置自动装）
    // 像素自绘标题栏回调（Rust 侧 install_title_bar_controls_no_quit 接线：
    // 关闭=隐藏窗口不退出——托盘应用惯例）
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback open-perm-settings(string); // 打开某项系统权限对应的设置面板（full-disk/accessibility/screen/automation）
    callback request-perms();           // 触发屏幕录制/摄像头/麦克风授权弹框（拉起子进程逐项请求）
    callback restart-service-request(); // 环境页授权后一键重启服务（权限对运行中进程不实时刷新）
    callback relaunch-as-admin();       // Windows：以管理员身份重启（弹 UAC）

    // 供应商编辑（同样 per-field 回写纪律，禁止整行回写）
    callback provider-field-edited(int, string, string); // idx, field(name/kind/base_url/api_key/model), value
    callback provider-selection-changed(int);
    callback add-provider();
    callback remove-provider(int);
    callback set-default-provider(int);
    callback test-provider(int);

    // 虚拟 Bot（#75）：登记列表操作（i=virtual-bots 行下标；create 用选中 bot 下标）
    callback virtual-bot-create(int);     // 「＋ 创建虚拟 Bot」→ 弹窗（自定义/模板/登记）
    callback virtual-bot-edit(int);       // 编辑登记（预填弹窗 → PATCH + 登记同步）
    callback virtual-bot-deregister(int); // ⋯ 菜单：取消登记（轻确认）
    callback virtual-bot-disband(int);    // ⋯ 菜单：解散群（红色强确认，仅飞书）
    callback virtual-bot-refresh();       // ⟳ 刷新：验证登记群存在性（平台解散兜底 + 历史归档）
    // #74 历史记录页
    callback history-selection-changed(int);   // 选中某条 → Rust 侧记录（详情在 slint 内由 model 直接取）
    callback clear-history();                  // 「清除全部历史」→ Rust 侧弹二次确认
    callback set-notify-enabled(bool);         // 提醒开关 → Rust 侧写工作副本（保存时落盘）
    callback set-history-retention(int);       // 保留期下拉下标（0=7天 1=30天 2=90天）
    callback set-session-gc-enabled(bool);     // 会话归纳清理开关（#78 默认关）
    callback set-session-gc-days(int);         // 过期天数下拉下标（0=3 1=7 2=14 3=30）

    // 首页「待处理」卡用到的统计（纯表达式，跟随各 *_installed / perm-* 属性自动更新）
    // #93：codex 版本过低也算待处理（codex-ok = 已装且版本满足）。
    property <int> missing-deps: (root.claude-installed ? 0 : 1)
        + (root.codex-ok ? 0 : 1)
        + (root.pi-installed ? 0 : 1)
        + (root.node-installed ? 0 : 1)
        + (root.python-installed ? 0 : 1)
        + (root.lark-installed ? 0 : 1)
        + (root.dingtalk-installed ? 0 : 1)
        + (root.git-ok ? 0 : 1);
    property <int> missing-perms: root.perms-supported && root.platform == "macos" ?
        (root.perm-full-disk != 2 ? 1 : 0) + (root.perm-accessibility != 2 ? 1 : 0)
        + (root.perm-screen != 2 ? 1 : 0) + (root.perm-automation != 2 ? 1 : 0)
        + (root.perm-camera != 2 ? 1 : 0) + (root.perm-microphone != 2 ? 1 : 0)
        : (root.perms-supported && root.platform == "windows" ? (root.perm-admin != 2 ? 1 : 0) : 0);

    // 关键：内容必须包在一个显式铺满窗口的根 Rectangle 里。
    // 直接把 HorizontalBox 当 Window 子元素时，在某些路径下其尺寸算成 0 → 整个内容区不渲染（黑/空），
    // 只剩系统画的标题栏。根 Rectangle width/height:100% 强制铺满，布局才有确定容器。
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.panel;

        VerticalBox {
            // 关键：VerticalBox/HorizontalBox 自带 StyleMetrics.layout-padding（fluent=8px），
            // 不归零会让内容四周多出 16px，顶部透出根背景形成「标题栏白条」。全部归零，
            // 由各分区自己的 padding 精确控制。
            padding: 0;
            // ── 像素自绘标题栏（no-frame）：拖拽/最小化/最大化/关闭（窗口可缩放，三按钮全开）──
            PixelTitleBar {
                title: root.window-title;
                logo: @image-url("../app-assets/icon-1024.png");
                has-logo: true;
                drag-start => { root.drag-start(); }
                minimize => { root.minimize(); }
                toggle-maximize => { root.toggle-maximize(); }
                close-window => { root.close-window(); }
            }
            // ── 顶部 Tab 栏（菜单改 tab）：在 VerticalBox 层（titlebar 与主体之间），
            // 占满整行——错误地放进主体 HorizontalBox 会与页面区并排（左侧列） ──
            Rectangle {
                height: 40px;
                background: PixelTheme.bg;
                HorizontalBox {
                    padding-left: 6px;
                    padding-right: 10px;
                    spacing: 0px;
                    PixelTabs {
                        // horizontal-stretch 占满整行：5 tab 均分窗口宽（tab 下面才是内容区）
                        horizontal-stretch: 1;
                        tabs: ["首页", "机器人配置", "环境配置", "模型供应商", "历史记录"];
                        active: root.current-page;
                        changed(i) => { root.current-page = i; }
                    }
                }
            }
            // ── 主体：页面区 ──
            HorizontalBox {
                vertical-stretch: 1;
                spacing: 0;
                padding: 0;

                // 页面区：结构性 if 切页（同托盘菜单手法，属性翻转会重建子树）。
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                                        // ═══════════ 首页：hero + 待处理建议 + 快捷卡（PCM「首页/智能提醒」同款） ═══════════
                    if root.current-page == 0: PageContainer {
                        // 页头（与其他页同结构）
                        PageHeader { title: "首页"; subtitle: "你的 AI 助理管家 — 一眼看清运行状态"; }

                        // hero：状态 + 大按钮（PCM「立即加速」同款）。未运行时可从这里直接启动（原来只能去托盘）。
                        Rectangle {
                            height: 132px;
                            border-radius: 8px;
                            background: PixelTheme.accent;
                            HorizontalBox {
                                padding-top: 16px; padding-right: 24px; padding-bottom: 16px; padding-left: 24px;
                                spacing: 16px;
                                VerticalBox {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text {
                                        text: root.service-running
                                            ? "服务运行中 · " + root.bot-count + " 个机器人 · " + root.online-count + " 在线"
                                            : "服务已停止";
                                        font-size: 19px;
                                        font-weight: 700;
                                        color: PixelTheme.bg;
                                    }
                                    Text {
                                        text: root.service-running
                                            ? "飞书 / 微信 / 钉钉消息自动转给本地 Claude / Codex 处理"
                                            : "点右侧「启动服务」，或在托盘菜单点「启动」";
                                        font-size: 13px;
                                        color: PixelTheme.bg.with-alpha(0.75);
                                        wrap: word-wrap;
                                    }
                                    // 状态点（Defender 式「一目了然」）：在线/离线一眼可见；用文字点而非胶囊，避免在 accent 底上发闷
                                    HorizontalBox {
                                        spacing: 12px;
                                        Text { text: root.service-running ? "● 服务运行中" : "● 服务已停止"; font-size: 12px; font-weight: 600; color: PixelTheme.bg; vertical-alignment: center; }
                                        if root.online-count > 0: Text { text: "● " + root.online-count + " 在线"; font-size: 12px; color: PixelTheme.bg.with-alpha(0.85); vertical-alignment: center; }
                                        if root.bot-count - root.online-count > 0: Text { text: "● " + (root.bot-count - root.online-count) + " 离线"; font-size: 12px; color: PixelTheme.bg.with-alpha(0.85); vertical-alignment: center; }
                                    }
                                }
                                VerticalBox {
                                    alignment: center;
                                    spacing: 8px;
                                    // 启停互斥：结构性 if（同托盘菜单，enabled 绑定在原生菜单/样式上不可靠）
                                    if !root.service-running: PixelButton {
                                        text: "启动服务";
                                        variant: "primary";
                                        clicked => { root.start-service(); }
                                    }
                                    if root.service-running: PixelButton {
                                        text: "停止服务";
                                        clicked => { root.stop-service(); }
                                    }
                                    Rectangle {
                                        width: 140px;
                                        height: 32px;
                                        border-radius: 4px;
                                        background: PixelTheme.bg.with-alpha(0.15);
                                        TouchArea {
                                            clicked => { root.open-logs(); }
                                            Text { text: "打开日志"; color: PixelTheme.bg; font-size: 13px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                        }
                                    }
                                }
                            }
                        }

                        // 待处理建议（火绒「主页建议」/ PCM「智能提醒」同款）：只有异常才出现，每行点一下直达对应页。
                        if root.dep-failed-count > 0 || root.missing-deps > 0 || root.missing-perms > 0 || root.bot-count - root.online-count > 0: Rectangle {
                            border-radius: 4px;
                            background: UiTokens.warn-bg;
                            VerticalBox {
                                padding-top: 12px; padding-right: 16px; padding-bottom: 10px; padding-left: 16px;
                                spacing: 4px;
                                HorizontalBox {
                                    spacing: 8px;
                                    ImageIcon { icon: @image-url("icons/alert.svg"); tint: UiTokens.warn; width: 18px; height: 18px; }
                                    Text { text: "待处理"; font-size: 13px; font-weight: 700; color: UiTokens.warn; vertical-alignment: center; }
                                }
                                if root.dep-failed-count > 0: ProblemRow {
                                    text: "一键安装失败 " + root.dep-failed-count + " 项 — 点击查看详情与处理指引";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.missing-deps > 0: ProblemRow {
                                    text: "依赖未装齐（" + root.missing-deps + " 项）— 机器人将无法处理消息";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.missing-perms > 0: ProblemRow {
                                    text: "有 " + root.missing-perms + " 项系统权限未授权";
                                    clicked => { root.current-page = 2; }
                                }
                                if root.bot-count - root.online-count > 0: ProblemRow {
                                    text: "" + (root.bot-count - root.online-count) + " 个机器人离线";
                                    clicked => { root.current-page = 1; }
                                }
                            }
                        }

                        // 快捷操作卡（一行 4 个平铺）：加机器人 / 环境体检 / 权限中心 / 跨会话投递。
                        HorizontalBox {
                            spacing: 12px;
                            QuickCard {
                                title: "添加机器人";
                                desc: "接入飞书 / 微信 / 钉钉，30 秒上手";
                                icon: @image-url("icons/plus.svg");
                                clicked => { root.current-page = 1; root.add-bot(); }
                            }
                            QuickCard {
                                title: "环境体检";
                                desc: "Claude Code / Codex / Node.js 依赖检测";
                                icon: @image-url("icons/search.svg");
                                clicked => { root.current-page = 2; root.recheck-deps(); }
                            }
                            QuickCard {
                                title: "权限中心";
                                desc: "磁盘 / 辅助功能 / 屏幕录制一键授权";
                                icon: @image-url("icons/lock.svg");
                                action-label: "去授权 ›";
                                clicked => { root.current-page = 2; }
                            }
                            // 跨会话投递是开关不是跳转，卡片内直接放 CheckBox（PixelCard 外壳）
                            PixelCard {
                                height: 122px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    spacing: 6px;
                                    ImageIcon { icon: @image-url("icons/switch.svg"); tint: PixelTheme.accent; }
                                    PixelCheckBox {
                                        text: "跨会话投递";
                                        checked: root.cross-delivery-enabled;
                                        toggled => { root.set-cross-delivery(self.checked); }
                                    }
                                    Text { text: "允许 agent 把结果投递到其它 bot 的会话"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); wrap: word-wrap; }
                                    Text { text: root.cross-delivery-enabled ? "已开启" : "已关闭"; font-size: 12px; font-weight: 600; color: UiTokens.info; }
                                }
                            }
                        }
                        // 占底部剩余空间：首页内容少（hero+快捷卡全 fixed）时把内容顶到上面，
                        // 不被默认布局推到中下部；其它页有 vertical-stretch:1 列表填满，不需此 spacer。
                        Rectangle { vertical-stretch: 1; }
                    }

// ═══════════ 机器人配置：左列表 + 右编辑（卡片面板） ═══════════
                    if root.current-page == 1: PageContainer {
                        PageHeader { title: "机器人配置"; subtitle: "管理接入的飞书 / 微信 / 钉钉机器人"; }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 4px;
                            background: PixelTheme.bg;
                            HorizontalBox {
                                spacing: 0;
                                // ── 左：bot 列表 ──
                                VerticalBox {
                                    spacing: 6px;
                                    width: 190px;
                                    padding: 8px;
                                    Rectangle {
                                        background: PixelTheme.panel;
                                        border-radius: 4px;
                                        vertical-stretch: 1;
                                        PixelScrollPanel {
                                            vertical-stretch: 1;
                                            VerticalBox {
                                                spacing: 2px;
                                                for bot[idx] in root.bots: Rectangle {
                                                height: 38px;
                                                background: idx == root.selected ? PixelTheme.accent : transparent;
                                                border-radius: 0px;
                                                TouchArea {
                                                    clicked => { root.selected = idx; root.selection-changed(idx); }
                                                    VerticalBox {
                                                        padding-left: 10px;
                                                        spacing: 2px;
                                                        Text {
                                                            // 停用的 bot 前缀 ⚪ 并显灰，一眼可辨（启用的维持原色）
                                                            text: (bot.enabled ? "" : "⚪ ") + (bot.name == "" ? "(未命名)" : bot.name);
                                                            color: idx == root.selected ? PixelTheme.bg : (bot.enabled ? PixelTheme.text : UiTokens.text-disabled);
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: bot.kind + (bot.enabled ? "" : " · 停用");
                                                            font-size: 12px;
                                                            color: idx == root.selected ? PixelTheme.bg.with-alpha(0.85) : UiTokens.text-dim;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                    HorizontalBox {
                                        spacing: 8px;
                                        PixelButton { text: "＋ 添加"; clicked => { root.add-bot(); } }
                                        PixelButton {
                                            text: "－ 删除";
                                            enabled: root.selected >= 0;
                                            clicked => { root.remove-bot(root.selected); }
                                        }
                                    }
                                }
                                // ── 右：编辑选中 bot ──
                                VerticalBox {
                                    spacing: 5px;
                                    horizontal-stretch: 1;
                                    padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            width: 100%; // 钳制内容宽度=视口宽：禁止横向滚动，超宽行裁剪而不撑出滚动条
                                            spacing: 8px;
                                            alignment: start;
                                            GridBox {
                                                spacing: 5px;
                                                vertical-stretch: 0;
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Rectangle { width: 80px; }
                                                    // for 循环必须独占容器（slint 限制：RepeatedItemTree 不能直接占 grid 单元格）
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.enabled-options: PixelCheckBox {
                                                            text: "启用此 bot";
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.set-bot-enabled(root.selected, self.checked); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "名称"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.name-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "如：庆小丰（隔离目录名）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "name", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "类型"; width: 80px; vertical-alignment: center; }
                                                    PixelComboBox {
                                                        model: ["feishu", "wechat", "dingtalk"];
                                                        index: root.bots[root.selected].kind == "feishu" ? 0 : root.bots[root.selected].kind == "wechat" ? 1 : 2;
                                                        horizontal-stretch: 1;
                                                        selected(idx) => { root.bot-field-edited(root.selected, "kind", self.model[idx]); }
                                                    }
                                                }
                                                // 默认后端跟着 bot 走（per-bot，不是全局）：改飞书 bot 不影响微信 bot。
                                                // 勾选态由 backend-options model 驱动（for 循环重建实例），不依赖会被
                                                // 用户交互破坏的 checked 绑定（实测「微信选 pi 飞书也选中」）。
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "默认后端"; width: 80px; vertical-alignment: center; }
                                                    // 勾选框组必须包进 HorizontalBox 成一个格子：Row 的子元素是 GridBox
                                                    // 共享列（label/字段/按钮），直接铺开会把 codex/pi 排进按钮列甚至面板外。
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.backend-options: PixelCheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.backend-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                // 模型供应商（per-bot 覆盖；""=跟随全局默认）。下拉项 = [""] + provider-names
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "模型供应商"; width: 80px; vertical-alignment: center; }
                                                    // provider 下拉：PixelSelect（value 字符串驱动，动态 options）
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.provider-editor-options: PixelSelect {
                                                            options: root.provider-names;
                                                            value: opt.value;
                                                            horizontal-stretch: 1;
                                                            changed(v) => { root.bot-field-edited(root.selected, "provider", v); }
                                                        }
                                                    }
                                                }
                                                // 授权者 agent 隔离（安全默认开启；三种 kind 都显示）：
                                                // true=授权者会话只能读写本工作区、不能联网（受限模式）；
                                                // false=授权者与 owner 同权限（信任团队成员时放宽）。
                                                // 勾选态走独立 callback（同 set-bot-enabled 模式，避开 CheckBox
                                                // checked 绑定被用户交互破坏的坑）。
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "授权者隔离"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.restrict-options: PixelCheckBox {
                                                            text: "授权者 agent 受限模式";
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.set-restrict-granted(root.selected, self.checked); }
                                                        }
                                                    }
                                                }
                                                // 每日工作目录整理（默认关）：孤儿会话文件/临时文件/超期历史截断/
                                                // 文档归档 + git 留痕。同独立 callback 模式（避开 CheckBox 绑定坑）。
                                                if root.selected >= 0 && root.selected < root.bots.length: Row {
                                                    Text { text: "每日整理"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.tidy-options: PixelCheckBox {
                                                            text: "每日工作目录整理（孤儿会话/临时文件/超期历史/文档归档 + git 留痕）";
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.set-tidy-enabled(root.selected, self.checked); }
                                                        }
                                                    }
                                                }
                                                // ── 飞书字段（owner/授权者/对话权限）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "对话权限"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.access-options: PixelCheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.access-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "Owner（管理员）"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.owner-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "ou_xxx（管理员 open_id，逗号分隔多个）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "owner", self.text); }
                                                        }
                                                    }
                                                    PixelButton {
                                                        text: "生成管理员授权码";
                                                        enabled: !root.bots[root.selected].open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "已授权用户"; width: 80px; vertical-alignment: center; }
                                                    if root.bots[root.selected].granted.length == 0: Text {
                                                        text: "暂无（点「生成授权码」邀请）";
                                                        color: UiTokens.text-dim;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    if root.bots[root.selected].granted.length > 0: Text {
                                                        text: "共 " + root.bots[root.selected].granted.length + " 人，逐一取消见下";
                                                        color: UiTokens.text-dim;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "生成授权码";
                                                        enabled: !root.bots[root.selected].open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "granted"); }
                                                    }
                                                }
                                                // for 循环必须独占容器（slint 限制：RepeatedItemTree 不能直接占 grid 单元格；
                                                // Row 又只能放 GridLayout 内，故用 HorizontalBox 组合同款横排）
                                                VerticalBox {
                                                    spacing: 4px;
                                                    for granted[gi] in root.bots[root.selected].granted: HorizontalBox {
                                                        Rectangle { width: 80px; }
                                                        Text {
                                                            text: granted.name + "（" + granted.open-id + "）";
                                                            font-size: 12px;
                                                            horizontal-stretch: 1;
                                                            vertical-alignment: center;
                                                        }
                                                        PixelButton {
                                                            text: "取消授权";
                                                            clicked => { root.remove-granted(root.selected, gi); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu" && root.owner-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.owner-code-info;
                                                        color: UiTokens.warn;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu" && root.grant-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.grant-code-info;
                                                        color: UiTokens.warn;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("granted"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu" && root.bots[root.selected].open-access: Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: "公开模式：任何人都可以对话，无需授权（授权码已禁用）";
                                                        color: UiTokens.text-dim;
                                                        font-size: 12px;
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "App ID"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-id-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "cli_xxxxxxxx";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_id", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Text { text: "App Secret"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-secret-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            input-type: "password";
                                                            placeholder: "飞书应用密钥";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_secret", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "feishu": Row {
                                                    Rectangle { width: 80px; }
                                                    HorizontalBox {
                                                        spacing: 8px;
                                                        Text { text: "bot：" + root.bots[root.selected].bot-name + "  " + root.bots[root.selected].bot-open-id; font-size: 12px; color: PixelTheme.text.with-alpha(0.6); vertical-alignment: center; wrap: word-wrap; }
                                                        PixelButton { text: "自动获取"; clicked => { root.fetch-bot-info(root.selected); } }
                                                    }
                                                }
                                                // ── 微信字段（扫码登录，无需 app_id/secret）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "wechat": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.bots[root.selected].bot-name == ""
                                                            ? "未登录。点下方按钮，用微信扫码登录。"
                                                            : "已登录：" + root.bots[root.selected].bot-name;
                                                        wrap: word-wrap;
                                                        color: root.bots[root.selected].bot-name == "" ? UiTokens.text-dim : UiTokens.ok;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "wechat": Row {
                                                    Rectangle { width: 80px; }
                                                    PixelButton { text: "📱 扫码登录微信"; clicked => { root.wx-login(root.selected); } }
                                                }
                                                // ── 钉钉字段（企业内部应用机器人，Stream 模式长连接，无需公网地址）──
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "App Key"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-id-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "钉钉应用 AppKey（dingxxxx）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_id", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "App Secret"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.app-secret-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            input-type: "password";
                                                            placeholder: "钉钉应用 AppSecret";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "app_secret", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "机器人编码"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.ding-robot-code-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "留空=默认 AppKey（个别后台单独展示才填）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "ding_robot_code", self.text); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "对话权限"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        spacing: 12px;
                                                        for opt[i] in root.ding-access-options: PixelCheckBox {
                                                            text: opt.name;
                                                            checked: opt.checked;
                                                            horizontal-stretch: 1;
                                                            toggled => { root.ding-access-option-toggled(i); }
                                                        }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "Owner（管理员）"; width: 80px; vertical-alignment: center; }
                                                    HorizontalBox {
                                                        horizontal-stretch: 1;
                                                        for opt[i] in root.ding-owner-ids-editor-options: PixelTextInput {
                                                            text: opt.value;
                                                            placeholder: "员工 staffId（管理员，逗号分隔多个）";
                                                            horizontal-stretch: 1;
                                                            edited => { root.bot-field-edited(root.selected, "ding_owner_ids", self.text); }
                                                        }
                                                    }
                                                    PixelButton {
                                                        text: "生成管理员授权码";
                                                        enabled: !root.bots[root.selected].ding-open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Text { text: "已授权用户"; width: 80px; vertical-alignment: center; }
                                                    if root.bots[root.selected].ding-granted.length == 0: Text {
                                                        text: "暂无（点「生成授权码」邀请）";
                                                        color: UiTokens.text-dim;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    if root.bots[root.selected].ding-granted.length > 0: Text {
                                                        text: "共 " + root.bots[root.selected].ding-granted.length + " 人，逐一取消见下";
                                                        color: UiTokens.text-dim;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "生成授权码";
                                                        enabled: !root.bots[root.selected].ding-open-access;
                                                        clicked => { root.generate-owner-code(root.selected, "granted"); }
                                                    }
                                                }
                                                for dg[gi] in root.bots[root.selected].ding-granted: Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: dg.name + "（" + dg.open-id + "）";
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "取消授权";
                                                        clicked => { root.remove-granted(root.selected, gi); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk" && root.owner-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.owner-code-info;
                                                        color: UiTokens.warn;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("owner"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk" && root.grant-code-info != "": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: root.grant-code-info;
                                                        color: UiTokens.warn;
                                                        font-size: 12px;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    PixelButton {
                                                        text: "复制";
                                                        clicked => { root.copy-owner-code("granted"); }
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk" && root.bots[root.selected].ding-open-access: Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: "公开模式：任何人都可以对话，无需授权（授权码已禁用）";
                                                        color: UiTokens.text-dim;
                                                        font-size: 12px;
                                                    }
                                                }
                                                if root.selected >= 0 && root.selected < root.bots.length && root.bots[root.selected].kind == "dingtalk": Row {
                                                    Rectangle { width: 80px; }
                                                    Text {
                                                        text: "要求：企业自建应用已添加「机器人」能力，消息接收模式选 Stream 模式；群聊需 @ 机器人。";
                                                        font-size: 12px;
                                                        color: UiTokens.text-dim;
                                                        wrap: word-wrap;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                            }
                                            // ── 虚拟 Bot 区（#75）：平台真实群 + ABB 登记 ──
                                            // 群名=角色名、群介绍=system prompt（平台群资料为准，改群介绍=改角色即时生效）。
                                            // 仅飞书/钉钉显示（微信排除：虚拟 Bot 需要平台群概念）。
                                            if root.selected >= 0 && root.selected < root.bots.length && (root.bots[root.selected].kind == "feishu" || root.bots[root.selected].kind == "dingtalk"): VerticalBox {
                                                spacing: 6px;
                                                HorizontalBox {
                                                    Text { text: "虚拟 Bot"; font-size: 13px; font-weight: 700; color: PixelTheme.text; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    // 手动刷新：平台解散群的兜底（im.chat.deleted 事件未订阅/丢失时）——
                                                    // 验证登记群存在性，已解散的移除登记并归档会话历史。
                                                    // syncing 期间禁用防连点 + 文字变"同步中"（可视反馈）
                                                    PixelButton {
                                                        text: root.vb-syncing ? "⟳ 同步中…" : "⟳ 刷新";
                                                        size: "small";
                                                        variant: "ghost";
                                                        enabled: !root.vb-syncing;
                                                        clicked => { root.virtual-bot-refresh(); }
                                                    }
                                                }
                                                Text {
                                                    text: "平台真实群 + ABB 登记：群名=角色名、群介绍=system prompt（改群介绍=改角色，即时生效）。群内 @ 机器人自动注入角色；AI 可用 deliver --bot <此 bot> --chat @角色名 寻址。";
                                                    font-size: 12px; color: UiTokens.text-dim; wrap: word-wrap;
                                                }
                                                for vb[i] in root.virtual-bots: Rectangle {
                                                    background: PixelTheme.panel;
                                                    border-radius: 4px;
                                                    VerticalBox {
                                                        padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;
                                                        spacing: 6px;
                                                        HorizontalBox {
                                                            spacing: 8px;
                                                            ImageIcon { icon: @image-url("icons/bot.svg"); tint: PixelTheme.accent; vertical-alignment: center; }
                                                            Text { text: vb.role-name; font-weight: 600; font-size: 13px; color: PixelTheme.text; vertical-alignment: center; }
                                                            Text { text: vb.platform; font-size: 12px; color: UiTokens.text-dim; vertical-alignment: center; }
                                                            Rectangle { horizontal-stretch: 1; }
                                                            Text { text: vb.created-at; font-size: 12px; color: UiTokens.text-dim; vertical-alignment: center; }
                                                            PixelButton { text: "编辑"; size: "small"; clicked => { root.virtual-bot-edit(i); } }
                                                            PixelButton { text: "⋯"; size: "small"; clicked => { root.vb-menu-open = root.vb-menu-open == i ? -1 : i; } }
                                                        }
                                                        // ⋯ 菜单（行内展开）：取消登记（轻确认）/ 解散群（强确认，仅飞书有解散 API）
                                                        if root.vb-menu-open == i: HorizontalBox {
                                                            spacing: 8px;
                                                            Rectangle { horizontal-stretch: 1; }
                                                            PixelButton { text: "取消登记"; size: "small"; variant: "ghost"; clicked => { root.virtual-bot-deregister(i); root.vb-menu-open = -1; } }
                                                            if root.bots[root.selected].kind == "feishu": PixelButton { text: "解散群"; size: "small"; variant: "danger"; clicked => { root.virtual-bot-disband(i); root.vb-menu-open = -1; } }
                                                        }
                                                    }
                                                }
                                                if root.virtual-bots.length == 0: Text { text: "暂无登记。点下方按钮一键建群（平台 API 失败时手动建群后「手动登记」）。"; font-size: 12px; color: UiTokens.text-dim; }
                                                PixelButton { text: "＋ 创建虚拟 Bot"; clicked => { root.virtual-bot-create(root.selected); } }
                                                if root.bots[root.selected].kind == "dingtalk": Text {
                                                    text: "钉钉提示：机器人建群能力待平台实测；失败时手动建群（群名=角色名）后走弹窗「手动登记」。钉钉群无「群介绍」字段，角色提示词只能注入群名。";
                                                    font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                                                }
                                            }
                                            if root.selected < 0: Text { text: "← 选择或添加一个机器人"; color: UiTokens.text-dim; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ═══════════ 环境配置：依赖 + 权限（卡片化） ═══════════
                    if root.current-page == 2: PageContainer {
                        PageHeader { title: "环境配置"; subtitle: "依赖检测与系统权限"; }

                        PixelScrollPanel {
                            // 铺满父宽：Rectangle natural 宽=内容宽(~300)，不拉伸则 ScrollView
                            // 视口窄，行右侧「去授权/安装」按钮被裁（width:100% 只等于内容宽）。
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            VerticalBox {
                                // 钳制内容宽=视口（同机器人配置页）：否则内容宽=preferred(~300)，
                                // 权限卡行 Text+StatusPill+按钮(~324) 超宽 → 行右侧「去授权/安装」
                                // 按钮被裁剪看不到（用户报「未授权也没有授权按钮」）。
                                width: 100%;
                                spacing: 14px;
                                alignment: start;

                                // 未安装 agent 的醒目横幅（#8 M0 自动引导）
                                if root.missing-agent: Rectangle {
                                    vertical-stretch: 0;
                                    background: UiTokens.banner-bg;
                                    border-radius: 4px;
                                    HorizontalBox {
                                        padding-top: 10px; padding-right: 14px; padding-bottom: 10px; padding-left: 14px;
                                        spacing: 8px;
                                        Text {
                                            text: "⚠️ 未检测到 Claude Code / Codex CLI：机器人收到消息后将无法处理。请点「一键安装」自动补齐（无 Node.js 会自动先装）。";
                                            color: UiTokens.warn;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        if root.missing-deps > 0: PixelButton {
                                            text: "一键安装全部缺失（" + root.missing-deps + " 项）";
                                            enabled: root.dep-busy == "";
                                            clicked => { root.install-all-missing(); }
                                        }
                                    }
                                }

                                // ── 依赖卡片 ──
                                Rectangle {
                                    vertical-stretch: 0;
                                    border-radius: 4px;
                                    background: PixelTheme.bg;
                                    VerticalBox {
                                        padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
                                        spacing: 6px;
                                        HorizontalBox {
                                            spacing: 8px;
                                            Text { text: "依赖（本机 agent 运行环境）"; font-weight: 700; color: PixelTheme.text; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            // #60：标题行入口——横幅只在 agent 缺失时可见，
                                            // 只缺 node/lark 等也要有一键装入口
                                            if root.missing-deps > 0: PixelButton {
                                                text: "一键安装缺失";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-all-missing(); }
                                            }
                                            PixelButton { text: "重新检测"; clicked => { root.recheck-deps(); } }
                                        }
                                        if root.dep-busy != "": Text {
                                            text: "⏳ 正在安装 " + root.dep-busy + " …（可能要几分钟，期间请勿重复点）";
                                            color: UiTokens.warn;
                                            wrap: word-wrap;
                                        }
                                        // 安装失败详情区（与 busy 提示为**兄弟**节点——失败路径先清
                                        // busy 再设 detail，嵌套在 busy 内会让错误区永不渲染，审查 C1）
                                        if root.dep-detail != "": Rectangle {
                                            // 分类 + 怎么办 + 原始错误。醒目样式：粗边框 + 大字号
                                            // ——失败即所见（ui.rs 失败时自动切到本页）。
                                            border-width: 2px;
                                            border-color: UiTokens.error;
                                            background: UiTokens.error-bg;
                                            border-radius: 4px;
                                            VerticalBox {
                                                padding: 10px;
                                                spacing: 6px;
                                                Text {
                                                    text: "⚠️ 安装失败";
                                                    font-size: 14px;
                                                    font-weight: 700;
                                                    color: UiTokens.error;
                                                }
                                                Text {
                                                    text: root.dep-detail;
                                                    color: UiTokens.error;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                        // claude
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Claude Code"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.claude-installed ? "已安装" : "未安装"; ok: root.claude-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.claude-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("claude"); }
                                            }
                                            if !root.claude-installed: PixelButton { text: "文档"; clicked => { root.open-url("https://docs.claude.com/en/docs/claude-code/setup"); } }
                                        }
                                        if !root.claude-installed: Text { text: "curl -fsSL https://claude.ai/install.sh | bash"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // codex
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Codex CLI"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            if root.codex-ok: StatusPill { text: "已安装"; ok: true; }
                                            if root.codex-installed && !root.codex-ok: StatusPill { text: "版本过低"; ok: false; warn: true; }
                                            if !root.codex-installed: StatusPill { text: "未安装"; ok: false; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.codex-ok: PixelButton {
                                                text: root.codex-installed ? "升级" : "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("codex"); }
                                            }
                                            if !root.codex-installed: PixelButton { text: "文档"; clicked => { root.open-url("https://github.com/openai/codex"); } }
                                        }
                                        // #93：版本满足显示实际版本；版本过低给升级指引；未装保留 npm 命令提示
                                        if root.codex-ok && root.codex-version != "": Text { text: "已安装 v\{root.codex-version}（最低要求 v0.140）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        if root.codex-installed && !root.codex-ok: Text { text: "当前 v\{root.codex-version} 低于最低要求 v0.140（与沙箱能力对齐），请升级"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        if !root.codex-installed: Text { text: "npm install -g @openai/codex"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // pi
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Pi (pi-coding-agent)"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.pi-installed ? "已安装" : "未安装"; ok: root.pi-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.pi-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("pi"); }
                                            }
                                            if !root.pi-installed: PixelButton { text: "文档"; clicked => { root.open-url("https://pi.dev"); } }
                                        }
                                        if !root.pi-installed: Text { text: "curl -fsSL https://pi.dev/install.sh | sh"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // nodejs
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Node.js"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.node-installed ? "已安装" : "未安装"; ok: root.node-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.node-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("node"); }
                                            }
                                        }
                                        if !root.node-installed: Text { text: "brew install node"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // python3
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Python 3"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.python-installed ? "已安装" : "未安装"; ok: root.python-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.python-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("python3"); }
                                            }
                                        }
                                        if !root.python-installed: Text { text: "brew install python"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // lark-cli
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "lark-cli"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.lark-installed ? "已安装" : "未安装"; ok: root.lark-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.lark-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("lark-cli"); }
                                            }
                                        }
                                        if !root.lark-installed: Text { text: "npm install -g @larksuite/cli"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // dingtalk-cli
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "dingtalk-cli"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.dingtalk-installed ? "已安装" : "未安装"; ok: root.dingtalk-installed; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.dingtalk-installed: PixelButton {
                                                text: "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("dingtalk-cli"); }
                                            }
                                            if !root.dingtalk-installed: PixelButton { text: "文档"; clicked => { root.open-url("https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli"); } }
                                        }
                                        if !root.dingtalk-installed: Text { text: "npm install -g dingtalk-workspace-cli"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        // git（#105：删除保护 git 留痕 / tidy 每日整理依赖；最低版本 v2.30）
                                        HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "Git"; width: 120px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            if root.git-ok: StatusPill { text: "已安装"; ok: true; }
                                            if root.git-installed && !root.git-ok: StatusPill { text: "版本过低"; ok: false; warn: true; }
                                            if !root.git-installed: StatusPill { text: "未安装"; ok: false; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if !root.git-ok: PixelButton {
                                                text: root.git-installed ? "升级" : "安装";
                                                enabled: root.dep-busy == "";
                                                clicked => { root.install-dep("git"); }
                                            }
                                            if !root.git-installed: PixelButton { text: "文档"; clicked => { root.open-url("https://git-scm.com/downloads"); } }
                                        }
                                        // #105：版本满足显示实际版本；版本过低给升级指引；未装保留官方下载链接
                                        if root.git-ok && root.git-version != "": Text { text: "已安装 v\{root.git-version}（最低要求 v2.30）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        if root.git-installed && !root.git-ok: Text { text: "当前 v\{root.git-version} 低于最低要求 v2.30，请升级"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                        if !root.git-installed: Text { text: "git-scm.com/downloads（Windows 静默安装 /VERYSILENT）"; font-size: 12px; color: PixelTheme.text.with-alpha(0.55); }
                                    }
                                }

                                // ── 系统权限卡片（仅支持平台才显示）──
                                if root.perms-supported: Rectangle {
                                    vertical-stretch: 0;
                                    border-radius: 4px;
                                    background: PixelTheme.bg;
                                    VerticalBox {
                                        padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px;
                                        spacing: 6px;
                                        HorizontalBox {
                                            spacing: 8px;
                                            Text { text: "系统权限"; font-weight: 700; color: PixelTheme.text; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            // 授权提示按钮只在 macOS 显示（Windows 走管理员重启）
                                            if root.platform == "macos": PixelButton { text: "📹 请求授权"; enabled: !root.perm-busy; clicked => { root.request-perms(); } }
                                        }
                                        if root.perms-supported && root.platform == "macos" && root.perm-busy: Text {
                                            text: "⏳ 正在逐项弹系统授权框（屏幕录制→摄像头→麦克风），请在弹框里点「允许」。完成后点「重新检测」刷新。";
                                            font-size: 12px; color: UiTokens.warn; wrap: word-wrap;
                                        }
                                        // Windows：管理员身份
                                        if root.perms-supported && root.platform == "windows": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "管理员身份"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill { text: root.perm-admin == 2 ? "已提权" : "未提权"; ok: root.perm-admin == 2; }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-admin != 2: PixelButton { text: "以管理员重启"; clicked => { root.relaunch-as-admin(); } }
                                        }
                                        if root.perms-supported && root.platform == "windows" && root.perm-admin != 2: Text {
                                            text: "Windows 无需逐项授权；以管理员身份运行即可完全控制本机（文件/鼠标键盘/屏幕/摄像头/麦克风）。点击上方按钮会弹 UAC 确认框。";
                                            font-size: 12px; color: UiTokens.text-dim; wrap: word-wrap;
                                        }
                                        // macOS 六项权限
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "完全磁盘访问"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-full-disk == 2 ? "已授权" : (root.perm-full-disk == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-full-disk == 2;
                                                warn: root.perm-full-disk == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-full-disk != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("full-disk"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "辅助功能"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-accessibility == 2 ? "已授权" : (root.perm-accessibility == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-accessibility == 2;
                                                warn: root.perm-accessibility == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-accessibility != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("accessibility"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "屏幕录制"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-screen == 2 ? "已授权" : (root.perm-screen == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-screen == 2;
                                                warn: root.perm-screen == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-screen != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("screen"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "自动化"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-automation == 2 ? "已授权" : (root.perm-automation == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-automation == 2;
                                                warn: root.perm-automation == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-automation != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("automation"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "摄像头"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-camera == 2 ? "已授权" : (root.perm-camera == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-camera == 2;
                                                warn: root.perm-camera == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-camera != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("camera"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos": HorizontalBox {
                                            height: 34px;
                                            spacing: 10px;
                                            Text { text: "麦克风"; width: 130px; font-weight: 600; font-size: 13px; vertical-alignment: center; color: PixelTheme.text; }
                                            StatusPill {
                                                text: root.perm-microphone == 2 ? "已授权" : (root.perm-microphone == 1 ? "被拒绝" : "未授权");
                                                ok: root.perm-microphone == 2;
                                                warn: root.perm-microphone == 1;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.perm-microphone != 2: PixelButton { text: "去授权"; clicked => { root.open-perm-settings("microphone"); } }
                                        }
                                        if root.perms-supported && root.platform == "macos" && (root.perm-full-disk != 2 || root.perm-screen != 2 || root.perm-camera != 2 || root.perm-microphone != 2): Text {
                                            text: "💡 未授权项：「完全磁盘访问」可点「去授权」后在面板里 ＋ 添加本程序；「屏幕录制/摄像头/麦克风」须先点上方「📹 请求…」按钮触发系统弹框（否则设置列表里看不到本程序）。改完可能需要重启服务生效。";
                                            font-size: 12px;
                                            color: UiTokens.warn;
                                            wrap: word-wrap;
                                        }
                                        if root.perms-supported: HorizontalBox {
                                            spacing: 8px;
                                            Text {
                                                text: "授权/改权限后，运行中的服务要重启才认：";
                                                font-size: 12px; color: UiTokens.text-dim; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
                                            }
                                            PixelButton { text: "🔁 重启服务生效"; clicked => { root.restart-service-request(); } }
                                        }
                                    }
                                }
                                if !root.perms-supported: Text {
                                    text: "系统权限检测仅 macOS 需要（本机为其它系统）。";
                                    font-size: 12px;
                                    color: UiTokens.text-dim;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "说明：claude/codex 由「模型供应商配置」提供凭证，不再在运行期弹授权；pi 用自己的登录态（~/.pi，配了供应商则注入对应 key）。nodejs 是 codex/lark-cli 的前置；接入飞书 bot 时会自动装 lark 技能。";
                                    font-size: 12px;
                                    color: UiTokens.text-dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ═══════════ 模型供应商：左列表 + 右编辑（卡片面板） ═══════════
                    if root.current-page == 3: PageContainer {
                        PageHeader { title: "模型供应商"; subtitle: "Claude / Codex 或任意 OpenAI 兼容供应商"; }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 4px;
                            background: PixelTheme.bg;
                            HorizontalBox {
                                spacing: 0;
                                // ── 左：供应商列表 ──
                                VerticalBox {
                                    spacing: 8px;
                                    width: 210px;
                                    padding: 10px;
                                    Rectangle {
                                        background: PixelTheme.panel;
                                        border-radius: 4px;
                                        vertical-stretch: 1;
                                        PixelScrollPanel {
                                            vertical-stretch: 1;
                                            VerticalBox {
                                                spacing: 2px;
                                                for prov[idx] in root.providers: Rectangle {
                                                height: 44px;
                                                background: idx == root.provider-selected ? PixelTheme.accent : transparent;
                                                border-radius: 0px;
                                                TouchArea {
                                                    clicked => { root.provider-selected = idx; root.provider-selection-changed(idx); }
                                                    VerticalBox {
                                                        padding-left: 10px;
                                                        spacing: 2px;
                                                        Text {
                                                            text: prov.name == "" ? "(未命名)" : prov.name;
                                                            color: idx == root.provider-selected ? PixelTheme.bg : PixelTheme.text;
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: prov.kind + (prov.is-default ? " · 默认" : "");
                                                            font-size: 12px;
                                                            color: idx == root.provider-selected ? PixelTheme.bg.with-alpha(0.85) : UiTokens.text-dim;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                    HorizontalBox {
                                        spacing: 8px;
                                        PixelButton { text: "＋ 添加"; clicked => { root.add-provider(); } }
                                        PixelButton {
                                            text: "－ 删除";
                                            enabled: root.provider-selected >= 0;
                                            clicked => { root.remove-provider(root.provider-selected); }
                                        }
                                    }
                                }
                                // ── 右：编辑选中供应商 ──
                                VerticalBox {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    padding-top: 12px; padding-right: 14px; padding-bottom: 12px; padding-left: 14px;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            spacing: 10px;
                                            alignment: start;
                                            GridBox {
                                                spacing: 6px;
                                                vertical-stretch: 0;
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "名称"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].name;
                                                        placeholder: "唯一键，如 my-claude";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "name", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "类型"; width: 96px; vertical-alignment: center; }
                                                    PixelComboBox {
                                                        model: ["anthropic", "openai-chat", "openai-responses"];
                                                        index: root.providers[root.provider-selected].kind == "anthropic" ? 0 : root.providers[root.provider-selected].kind == "openai-chat" ? 1 : 2;
                                                        horizontal-stretch: 1;
                                                        selected(idx) => { root.provider-field-edited(root.provider-selected, "kind", self.model[idx]); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "Base URL"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].base-url;
                                                        placeholder: "如 https://api.anthropic.com 或 https://api.openai.com/v1";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "base_url", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "API Key"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].api-key;
                                                        input-type: "password";
                                                        placeholder: "sk-...（留空=保留已存密钥）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "api_key", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Text { text: "模型"; width: 96px; vertical-alignment: center; }
                                                    PixelTextInput {
                                                        text: root.providers[root.provider-selected].model;
                                                        placeholder: "如 claude-sonnet-4-5 / gpt-5（空=后端默认）";
                                                        horizontal-stretch: 1;
                                                        edited => { root.provider-field-edited(root.provider-selected, "model", self.text); }
                                                    }
                                                }
                                                if root.provider-selected >= 0 && root.provider-selected < root.providers.length: Row {
                                                    Rectangle { width: 96px; }
                                                    HorizontalBox {
                                                        spacing: 8px;
                                                        PixelButton {
                                                            text: root.providers[root.provider-selected].is-default ? "★ 已是默认" : "设为默认";
                                                            enabled: !root.providers[root.provider-selected].is-default;
                                                            clicked => { root.set-default-provider(root.provider-selected); }
                                                        }
                                                        PixelButton { text: "测试连接"; clicked => { root.test-provider(root.provider-selected); } }
                                                    }
                                                }
                                            }
                                            if root.provider-selected < 0: Text { text: "← 选择或添加一个供应商"; color: UiTokens.text-dim; }

                                            Text {
                                                text: "只支持 Anthropic 原生（claude / pi）与 OpenAI 兼容（codex / pi：chat / responses 两种接口）。claude 后端需 anthropic 型，codex 后端需 openai 型；pi 两种都吃（key 走对应 env）。桥内配置优先于 CC Switch。";
                                                font-size: 12px;
                                                color: UiTokens.text-dim;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ═══════════ 历史记录：授权者私聊消息 + bot 回复（#74） ═══════════
                if root.current-page == 4: PageContainer {
                    PageHeader { title: "历史记录"; subtitle: "授权者私聊本机器人的消息与回复（默认保留 30 天，可手动清除）"; }

                    // 顶部工具行：提醒开关 + 保留期下拉 + 手动清除
                    Rectangle {
                        vertical-stretch: 0;
                        background: PixelTheme.bg;
                        border-radius: 4px;
                        HorizontalBox {
                            padding: 10px;
                            spacing: 12px;
                            PixelCheckBox {
                                text: "消息提醒";
                                checked: root.notify-enabled;
                                toggled => { root.notify-enabled = self.checked; root.set-notify-enabled(self.checked); }
                            }
                            Text {
                                text: "保留期";
                                font-size: 12px;
                                vertical-alignment: center;
                                color: PixelTheme.text;
                            }
                            PixelComboBox {
                                width: 110px;
                                model: ["7 天", "30 天", "90 天"];
                                index: root.history-retention-days == 7 ? 0 : root.history-retention-days == 90 ? 2 : 1;
                                selected(idx) => { root.set-history-retention(idx); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            PixelButton {
                                text: "🗑 清除全部历史";
                                clicked => { root.clear-history(); }
                            }
                        }
                    }
                    // 第二行：每日会话归纳清理（#78，全局开关默认关——破坏性 + 每会话一次 LLM 调用）
                    Rectangle {
                        vertical-stretch: 0;
                        background: PixelTheme.bg;
                        border-radius: 4px;
                        HorizontalBox {
                            padding: 10px;
                            spacing: 12px;
                            PixelCheckBox {
                                text: "每日会话归纳清理";
                                checked: root.session-gc-enabled;
                                toggled => { root.session-gc-enabled = self.checked; root.set-session-gc-enabled(self.checked); }
                            }
                            Text {
                                text: "过期判定";
                                font-size: 12px;
                                vertical-alignment: center;
                                color: PixelTheme.text;
                            }
                            PixelComboBox {
                                width: 110px;
                                model: ["3 天", "7 天", "14 天", "30 天"];
                                index: root.session-gc-days == 3 ? 0 : root.session-gc-days == 14 ? 2 : root.session-gc-days == 30 ? 3 : 1;
                                selected(idx) => { root.set-session-gc-days(idx); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "超过该天数未活跃的会话，由 bot 后端 agent 归纳成摘要存档（summaries/）并清理工作区内的历史/会话文件；摘要下次会话自动注入衔接上下文。仅清理本 bot 工作区，不触碰后端私有目录。";
                                font-size: 12px;
                                color: UiTokens.text-dim;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // 主体：左列表 + 右详情（同供应商页布局）
                    Rectangle {
                        vertical-stretch: 1;
                        background: PixelTheme.bg;
                        border-radius: 4px;
                        HorizontalBox {
                            spacing: 0;
                            // ── 左：消息列表（时间/平台/发送者/摘要）──
                            VerticalBox {
                                width: 300px;
                                padding: 10px;
                                spacing: 8px;
                                Rectangle {
                                    background: PixelTheme.panel;
                                    border-radius: 4px;
                                    vertical-stretch: 1;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;
                                        VerticalBox {
                                            spacing: 2px;
                                            for h[idx] in root.history-rows: Rectangle {
                                                height: 46px;
                                                background: idx == root.history-selected ? PixelTheme.accent : transparent;
                                                TouchArea {
                                                    clicked => { root.history-selected = idx; root.history-selection-changed(idx); }
                                                    VerticalBox {
                                                        padding-left: 10px;
                                                        spacing: 2px;
                                                        Text {
                                                            text: h.time + "  " + h.sender + "  " + h.bot + "  " + h.kind + "  " + h.direction;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            overflow: elide;
                                                            width: 100%;
                                                            color: idx == root.history-selected ? PixelTheme.bg : PixelTheme.text;
                                                        }
                                                        Text {
                                                            text: h.preview;
                                                            font-size: 12px;
                                                            overflow: elide;
                                                            width: 100%;
                                                            color: idx == root.history-selected ? PixelTheme.bg.with-alpha(0.85) : PixelTheme.text.with-alpha(0.6);
                                                        }
                                                    }
                                                }
                                            }
                                            if root.history-rows.length == 0: Text {
                                                text: "暂无记录：授权者私聊本机器人后，消息与回复会显示在这里";
                                                font-size: 12px;
                                                color: UiTokens.text-dim;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                            // ── 右：详情（完整文本）──
                            VerticalBox {
                                horizontal-stretch: 1;
                                padding-top: 14px; padding-right: 14px; padding-bottom: 14px; padding-left: 14px;
                                spacing: 8px;
                                Text {
                                    text: root.history-selected >= 0 && root.history-selected < root.history-rows.length
                                        ? root.history-rows[root.history-selected].time + " · " + root.history-rows[root.history-selected].bot
                                            + " · " + root.history-rows[root.history-selected].sender
                                            + " · " + root.history-rows[root.history-selected].direction
                                        : "← 选择左侧一条消息查看完整内容";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: PixelTheme.text;
                                }
                                Rectangle {
                                    background: PixelTheme.panel;
                                    border-radius: 4px;
                                    vertical-stretch: 1;
                                    PixelScrollPanel {
                                        vertical-stretch: 1;
                                        Text {
                                            text: root.history-selected >= 0 && root.history-selected < root.history-rows.length
                                                ? root.history-rows[root.history-selected].text : "";
                                            font-size: 12px;
                                            color: PixelTheme.text;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── 底部共享：状态行 + 保存/取消（钉底；首页无表单，保存/取消只出现在配置页）──
            Rectangle {
                height: 46px;
                background: PixelTheme.bg;
                HorizontalBox {
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 8px;
                    Text {
                        // 有临时状态（保存/测试结果）优先显示；平时显示服务运行概览行
                        text: root.status-line != "" ? root.status-line : root.running-line;
                        color: root.status-line != "" && root.status-is-error ? UiTokens.error : UiTokens.ok;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.current-page != 0: PixelButton { text: "关闭"; clicked => { root.cancel-clicked(); } }
                    if root.current-page != 0: PixelButton {
                        text: root.service-running ? "保存并重启服务" : "保存";
                        variant: "primary";
                        clicked => { root.save-clicked(); }
                    }
                }
            }
        }
    }   // 关闭根 Rectangle（包内容防塌缩）
}
