<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>ABB</string>
  <key>CFBundleDisplayName</key><string>ABB</string>
  <key>CFBundleIdentifier</key><string>com.sqb.abb</string>
  <key>CFBundleExecutable</key><string>agent-bridge</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>2.0.3</string>
  <key>CFBundleShortVersionString</key><string>2.0.3</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <!-- #251 TCC 用途文案：agent 子进程（ffmpeg/语音链路）访问相机/麦克风/AppleEvents
       时系统弹窗展示的说明；hardened runtime 下须与 abb.entitlements 配套，
       缺 entitlement 则 tccd 直接 deny 且不弹窗（#251 根因）。 -->
  <key>NSCameraUsageDescription</key>
  <string>ABB 的机器人技能（拍照、视觉理解）需要访问摄像头。</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>ABB 的机器人技能（语音识别、录音）需要访问麦克风。</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>ABB 需要自动化控制本机应用（锁屏辅助、剪贴板与系统集成）。</string>
</dict>
</plist>
